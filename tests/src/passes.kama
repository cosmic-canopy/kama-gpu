// The cases of GPU-4's fourth part, its third step (AGENTS.gpu.md item 12, decisions 5, 9, 10, 13 and 14), a step a tick
// on every leg: render passes made from WebGPU's description, drawn and read back; what WebGPU refuses of them, at the
// encoder's `finish`; and what the package refuses first, reported at `finish` too, where a browser throws or wgpu-native
// takes what WebGPU refuses. The device is given no feature.
//
// They report through `Verdicts`, which the check reads each tick, as the pipeline cases do.

import {
    core::println,
    std::collections::DynamicArray,
    gpu::Instance, gpu::AdapterOptions, gpu::AdapterRequest, gpu::AdapterStatus, gpu::PowerPreference,
    gpu::Device, gpu::Queue, gpu::DeviceRequest, gpu::DeviceStatus, gpu::GpuError,
    gpu::DeviceErrors, gpu::GpuErrorKind, gpu::CommandEncoder, gpu::CommandBuffer, gpu::RenderPass, gpu::Color,
    gpu::RenderPassDescriptor, gpu::ColorAttachment, gpu::LoadOp, gpu::StoreOp, gpu::DepthStencilAttachment,
    gpu::DepthLoad, gpu::DepthAccess, gpu::StencilLoad, gpu::StencilAccess,
    gpu::Buffer, gpu::BufferDescriptor, gpu::BufferUsage, gpu::BufferRead, gpu::ReadStatus,
    gpu::Texture, gpu::TextureDescriptor, gpu::TextureViewDescriptor, gpu::TextureView, gpu::TextureFormat,
    gpu::TextureUsage, gpu::TextureDimension, gpu::CompareFunction, gpu::FrontFace,
    gpu::ShaderModuleDescriptor, gpu::ShaderModule,
    gpu::StencilFaceState, gpu::DepthStencilState, gpu::ColorTargetState, gpu::VertexState, gpu::FragmentState,
    gpu::Layout, gpu::RenderPipelineDescriptor, gpu::RenderPipeline,
    gpu::BindGroupLayout, gpu::BindGroupLayoutDescriptor, gpu::BindingLayout, gpu::BufferBindingLayout,
    gpu::PipelineLayout, gpu::PipelineLayoutDescriptor, gpu::BindGroup, gpu::BindGroupDescriptor, gpu::BindingResource,
    gpu::BufferBinding, gpu::ShaderStage, gpu::VertexBufferLayout, gpu::VertexFormat, gpu::VertexStepMode,
    gpu::IndexFormat, gpu::BlendState, gpu::BlendComponent, gpu::BlendFactor,
    gpu::ErrorScope, gpu::ErrorFilter, gpu::ScopePop, gpu::PopStatus,
    Verdicts, readOptions,
};
export { PassRun };

comptime int32 SETTLE = 60;   // the most ticks a case waits for an error the browser owes
comptime int32 QUIET = 10;    // the ticks a case waits to see that no error comes
comptime uint32 SIDE = 4;     // a target is SIDE by SIDE texels
comptime uint32 ROW = 256;    // a copied row's bytes: WebGPU's alignment

// `vs0` covers the target with one counter-clockwise triangle at a depth of 0.25, its position invariant so two
// pipelines place it at the same depth (a depth prepass's equal test); `vsSlope` is that triangle with its depth rising
// from 0 at the target's left edge to 0.5 at its right, a slope of 0.125 a texel that a depth bias scales. `fs` writes
// (1, 0.5, 0.25, 1), and `fs1` white to location 1 alone. For the pass's commands: `vsBuf` reads a vertex buffer's
// position, `vsInst` adds an instance's shift to it, `fsu0` and `fsu1` write group 0's and group 1's uniform, and
// `fsWhite` writes white.
fn string passWgsl() {
    return "struct VOut { @invariant @builtin(position) pos: vec4f };\n"
        + "@vertex fn vs0(@builtin(vertex_index) i: u32) -> VOut {\n"
        + "  var p = array<vec2f, 3>(vec2f(-1.0, -1.0), vec2f(3.0, -1.0), vec2f(-1.0, 3.0));\n"
        + "  var o: VOut; o.pos = vec4f(p[i], 0.25, 1.0); return o; }\n"
        + "@vertex fn vsSlope(@builtin(vertex_index) i: u32) -> VOut {\n"
        + "  var p = array<vec2f, 3>(vec2f(-1.0, -1.0), vec2f(3.0, -1.0), vec2f(-1.0, 3.0));\n"
        + "  var o: VOut; o.pos = vec4f(p[i], 0.25 + 0.25 * p[i].x, 1.0); return o; }\n"
        + "@fragment fn fs() -> @location(0) vec4f { return vec4f(1.0, 0.5, 0.25, 1.0); }\n"
        + "@fragment fn fs1() -> @location(1) vec4f { return vec4f(1.0, 1.0, 1.0, 1.0); }\n"
        + "@vertex fn vsBuf(@location(0) p: vec2f) -> VOut { var o: VOut; o.pos = vec4f(p, 0.25, 1.0); return o; }\n"
        + "@vertex fn vsInst(@location(0) p: vec2f, @location(1) shift: vec2f) -> VOut {\n"
        + "  var o: VOut; o.pos = vec4f(p + shift, 0.25, 1.0); return o; }\n"
        + "@group(0) @binding(0) var<uniform> u0: vec4f;\n"
        + "@group(1) @binding(0) var<uniform> u1: vec4f;\n"
        + "@fragment fn fsu0() -> @location(0) vec4f { return u0; }\n"
        + "@fragment fn fsu1() -> @location(0) vec4f { return u1; }\n"
        + "@fragment fn fsWhite() -> @location(0) vec4f { return vec4f(1.0, 1.0, 1.0, 1.0); }\n";
}

// NaN and the infinities, made at run time: kama refuses a constant division by zero.
fn float64 notANumber() {
    float64 zero = 0.0;
    return zero / zero;
}
fn float64 infinity(float64 sign) {
    float64 zero = 0.0;
    return sign / zero;
}
fn float32 notANumber32() {
    float32 zero = 0.0;
    return zero / zero;
}
fn float32 infinity32(float32 sign) {
    float32 zero = 0.0;
    return sign / zero;
}

// Whether this leg's render pass errors name the pass: Dawn's do, and wgpu's never do, natively (kyoten's
// .scratch/gpu4-part4/FINDINGS.md) and in Firefox (`--unnamed-pass-errors`), whose words say "In a pass parameter". A
// case holds each leg to what it does, so the day wgpu names the pass, it fails.
@compileFor(ARCH_WASM32)
fn bool passesNamed() { return true; }
@compileFor(!ARCH_WASM32)
fn bool passesNamed() { return false; }

// The clear colour the read-back cases use, each channel a whole number of 255ths: (51, 102, 153, 204).
fn Color fifths() { return Color.of(r: 0.2, g: 0.4, b: 0.6, a: 0.8); }
fn Color nothing() { return Color.of(r: 0.0, g: 0.0, b: 0.0, a: 0.0); }

type resource PassRun {
    int32 stage = 0;
    int32 waited = 0;
    bool optional;       // `--adapter-optional`: no adapter here is a skip
    bool named;          // this leg's pass errors name the pass
    bool sliceChecked;   // this leg refuses a depth slice of 2^32 - 2 on a 2D view (Firefox takes it)
    Verdicts found;
    Optional<Instance> instance = Optional::None;
    Optional<AdapterRequest> adapterRequest = Optional::None;
    Optional<DeviceRequest> deviceRequest = Optional::None;
    Optional<Device> device = Optional::None;
    Optional<Queue> queue = Optional::None;
    Optional<ShaderModule> shaders = Optional::None;   // passWgsl's module
    Optional<Buffer> readback = Optional::None;        // a drawn target's copy
    Optional<BufferRead> reading = Optional::None;
    Optional<ScopePop> around = Optional::None;        // a scope popped around a refused encoder's finish

    public ctor make(bool adapterOptional, bool unnamedPassErrors, bool uncheckedDepthSlice) {
        this.optional = adapterOptional;
        this.named = passesNamed() && !unnamedPassErrors;
        this.sliceChecked = !uncheckedDepthSlice;
        this.found = Verdicts.make();
    }

    public fn ref Verdicts verdicts() { return this.found; }

    // One tick's step: true once every case has run.
    public unsafe fn bool step() {
        this.waited = this.waited + 1;
        if (this.stage == 0) { this.open(); }
        else if (this.stage == 1) { this.awaitAdapter(); }
        else if (this.stage == 2) { this.awaitDevice(); }
        else if (this.stage == 10) { this.goodPasses(); }
        else if (this.stage == 11) { this.awaitNone(name: "passes WebGPU takes begin, end and finish with no error: a colour cleared and stored, loaded, discarded, resolved, a 3D view's slice, an empty colour attachment, depth alone cleared and read-only, both aspects, stencil alone, and stencil read-only on a format with no stencil", next: 20); }
        else if (this.stage == 20) { this.render(kind: 0, next: 21); }
        else if (this.stage == 21) { this.awaitPixel(name: "a colour attachment cleared reads back its clear colour, every channel its own", want: pixel(r: 51, g: 102, b: 153, a: 204), next: 25); }
        else if (this.stage == 25) { this.render(kind: 0, next: 26); }
        else if (this.stage == 26) { this.awaitTwice(next: 30); }
        else if (this.stage == 30) { this.render(kind: 1, next: 31); }
        else if (this.stage == 31) { this.awaitPixel(name: "a colour attachment loaded keeps what an earlier pass stored", want: pixel(r: 51, g: 102, b: 153, a: 204), next: 40); }
        else if (this.stage == 40) { this.render(kind: 2, next: 41); }
        else if (this.stage == 41) { this.awaitPixel(name: "a colour attachment discarded reads back zero", want: pixel(r: 0, g: 0, b: 0, a: 0), next: 50); }
        else if (this.stage == 50) { this.render(kind: 3, next: 51); }
        else if (this.stage == 51) { this.awaitPixel(name: "four samples cleared and discarded are resolved into the resolve target", want: pixel(r: 51, g: 102, b: 153, a: 204), next: 60); }
        else if (this.stage == 60) { this.render(kind: 4, next: 61); }
        else if (this.stage == 61) { this.awaitPixel(name: "a 3D view's depth slice 1 is cleared, and slice 0 keeps its own clear", want: pixel(r: 51, g: 102, b: 153, a: 204), next: 70); }
        else if (this.stage == 70) { this.render(kind: 5, next: 71); }
        else if (this.stage == 71) { this.awaitPixel(name: "an empty colour attachment keeps its place: a pipeline with an empty first target draws location 1 into the second", want: pixel(r: 255, g: 255, b: 255, a: 255), next: 80); }
        else if (this.stage == 80) { this.render(kind: 6, next: 81); }
        else if (this.stage == 81) { this.awaitPixel(name: "a depth cleared to 0.5 lets a triangle at 0.25 through a less test", want: pixel(r: 255, g: 128, b: 64, a: 255), next: 90); }
        else if (this.stage == 90) { this.render(kind: 7, next: 91); }
        else if (this.stage == 91) { this.awaitPixel(name: "a depth prepass is stored, and a later pass that loads it draws where an equal test passes", want: pixel(r: 255, g: 128, b: 64, a: 255), next: 100); }
        else if (this.stage == 100) { this.render(kind: 8, next: 101); }
        else if (this.stage == 101) { this.awaitPixel(name: "a read-only depth is tested against what an earlier pass stored", want: pixel(r: 255, g: 128, b: 64, a: 255), next: 110); }
        else if (this.stage == 110) { this.render(kind: 9, next: 111); }
        else if (this.stage == 111) { this.awaitPixel(name: "a stencil cleared to 1 fails an equal test against the reference 0", want: pixel(r: 0, g: 0, b: 0, a: 0), next: 120); }
        else if (this.stage == 120) { this.render(kind: 10, next: 121); }
        else if (this.stage == 121) { this.awaitPixel(name: "a stencil loaded keeps the 1 an earlier pass stored", want: pixel(r: 0, g: 0, b: 0, a: 0), next: 130); }
        else if (this.stage == 130) { this.render(kind: 11, next: 131); }
        else if (this.stage == 131) { this.awaitPixel(name: "a front face meets the front stencil test, not the back: Never in front and Always behind draws nothing", want: pixel(r: 0, g: 0, b: 0, a: 0), next: 140); }
        else if (this.stage == 140) { this.render(kind: 12, next: 141); }
        else if (this.stage == 141) { this.awaitPixel(name: "a depth bias slope scale of 4 pushes a sloped triangle behind a depth of 0.5", want: pixel(r: 0, g: 0, b: 0, a: 0), next: 150); }
        else if (this.stage == 150) { this.render(kind: 13, next: 151); }
        else if (this.stage == 151) { this.awaitPixel(name: "a back face meets the back stencil test, not the front: with clockwise front faces, Always in front and Never behind draws nothing", want: pixel(r: 0, g: 0, b: 0, a: 0), next: 200); }
        else if (this.stage == 200) { this.refused(kind: 0, label: "nan colour", next: 201); }
        else if (this.stage == 201) { this.awaitOne(name: "a NaN clear colour is a validation error at finish in the package's words, not the end of a web program", label: "nan colour", says: "not a finite number", next: 210); }
        else if (this.stage == 210) { this.refused(kind: 1, label: "infinite colour", next: 211); }
        else if (this.stage == 211) { this.awaitOne(name: "an infinite clear colour is a validation error at finish in the package's words, not the end of a web program", label: "infinite colour", says: "not a finite number", next: 220); }
        else if (this.stage == 220) { this.refused(kind: 2, label: "nan depth", next: 221); }
        else if (this.stage == 221) { this.awaitOne(name: "a NaN depth clear value is a validation error at finish in the package's words, not the end of a web program", label: "nan depth", says: "not a finite number", next: 230); }
        else if (this.stage == 230) { this.refused(kind: 3, label: "infinite depth", next: 231); }
        else if (this.stage == 231) { this.awaitOne(name: "a -inf depth clear value is a validation error at finish in the package's words, not the end of a web program", label: "infinite depth", says: "not a finite number", next: 240); }
        else if (this.stage == 240) { this.refused(kind: 4, label: "stencil without stencil", next: 241); }
        else if (this.stage == 241) { this.awaitOne(name: "stencil ops on a Depth24Plus view are a validation error at finish in the package's words, where wgpu-native takes them", label: "stencil without stencil", says: "has no stencil", next: 250); }
        else if (this.stage == 250) { this.refused(kind: 5, label: "depth without depth", next: 251); }
        else if (this.stage == 251) { this.awaitOne(name: "depth ops on a Stencil8 view are a validation error at finish in the package's words, where wgpu-native takes them", label: "depth without depth", says: "has no depth", next: 260); }
        else if (this.stage == 260) { this.refused(kind: 6, label: "after a bad copy", next: 261); }
        else if (this.stage == 261) { this.awaitEarlier(next: 270); }
        else if (this.stage == 270) { this.refused(kind: 7, label: "before a bad copy", next: 271); }
        else if (this.stage == 271) { this.awaitOne(name: "a refused pass before the encoder's own error: the refusal is the one reported", label: "before a bad copy", says: "not a finite number", next: 280); }
        else if (this.stage == 280) { this.refused(kind: 8, label: "scoped", next: 281); }
        else if (this.stage == 281) { this.awaitScoped(next: 300); }
        else if (this.stage == 300) { this.misused(kind: 0, label: "slice of 2D", next: 301); }
        else if (this.stage == 301) { this.awaitNamed(name: "a depth slice on a 2D view is a validation error at finish", label: "slice of 2D", next: 310); }
        else if (this.stage == 310) { this.misused(kind: 1, label: "slice of the rest", next: 311); }
        else if (this.stage == 311) { this.awaitSliceOfTheRest(next: 320); }
        else if (this.stage == 320) { this.misused(kind: 2, label: "depth of 2", next: 321); }
        else if (this.stage == 321) { this.awaitNamed(name: "a depth clear value of 2 is a validation error at finish", label: "depth of 2", next: 330); }
        else if (this.stage == 330) { this.misused(kind: 3, label: "depth unsaid", next: 331); }
        else if (this.stage == 331) { this.awaitNamed(name: "a depth format given no depth access is a validation error at finish", label: "depth unsaid", next: 340); }
        else if (this.stage == 340) { this.misused(kind: 4, label: "bare pass", next: 341); }
        else if (this.stage == 341) { this.awaitNamed(name: "a pass with no attachments is a validation error at finish", label: "bare pass", next: 400); }
        else if (this.stage == 400) { this.render(kind: 20, next: 401); }
        else if (this.stage == 401) { this.awaitPixel(name: "a vertex buffer bound from an offset, for a size, is drawn from there", want: pixel(r: 255, g: 128, b: 64, a: 255), next: 410); }
        else if (this.stage == 410) { this.render(kind: 21, next: 411); }
        else if (this.stage == 411) { this.awaitPixel(name: "a vertex buffer in slot 1 stepped per instance shifts the second instance onto the target, and the first off it", want: pixel(r: 255, g: 128, b: 64, a: 255), next: 420); }
        else if (this.stage == 420) { this.render(kind: 22, next: 421); }
        else if (this.stage == 421) { this.awaitPixel(name: "an indexed draw reads its index buffer from an offset, in Uint16, from its first index, each index added to its base vertex, from its first instance", want: pixel(r: 255, g: 128, b: 64, a: 255), next: 430); }
        else if (this.stage == 430) { this.render(kind: 23, next: 431); }
        else if (this.stage == 431) { this.awaitPixel(name: "a bind group set at index 1 is read by the shader's group 1", want: pixel(r: 0, g: 255, b: 0, a: 255), next: 440); }
        else if (this.stage == 440) { this.render(kind: 24, next: 441); }
        else if (this.stage == 441) { this.awaitPixel(name: "a dynamic offset of 256 reads the uniform 256 bytes into its buffer", want: pixel(r: 0, g: 0, b: 255, a: 255), next: 450); }
        else if (this.stage == 450) { this.render(kind: 25, next: 451); }
        else if (this.stage == 451) { this.awaitPixel(name: "a blend of white times the blend constant writes the constant, every channel its own", want: pixel(r: 51, g: 102, b: 153, a: 204), next: 460); }
        else if (this.stage == 460) { this.render(kind: 26, next: 461); }
        else if (this.stage == 461) { this.awaitCorners(name: "a viewport of the bottom-right quarter draws there and not at the top left", topLeft: pixel(r: 0, g: 0, b: 0, a: 0), bottomRight: pixel(r: 255, g: 128, b: 64, a: 255), next: 470); }
        else if (this.stage == 470) { this.render(kind: 27, next: 471); }
        else if (this.stage == 471) { this.awaitPixel(name: "a viewport's depth range from 0.6 to 1 maps a depth of 0.25 to 0.7, behind a depth of 0.5", want: pixel(r: 0, g: 0, b: 0, a: 0), next: 480); }
        else if (this.stage == 480) { this.render(kind: 28, next: 481); }
        else if (this.stage == 481) { this.awaitCorners(name: "a scissor of the bottom-right quarter draws there and not at the top left", topLeft: pixel(r: 0, g: 0, b: 0, a: 0), bottomRight: pixel(r: 255, g: 128, b: 64, a: 255), next: 490); }
        else if (this.stage == 490) { this.render(kind: 29, next: 491); }
        else if (this.stage == 491) { this.awaitPixel(name: "a stencil reference of 1 passes an equal test against a stencil cleared to 1", want: pixel(r: 255, g: 128, b: 64, a: 255), next: 500); }
        else if (this.stage == 500) { this.commandRefused(kind: 0, label: "nan blend", next: 501); }
        else if (this.stage == 501) { this.awaitOne(name: "a NaN blend constant is a validation error at finish in the package's words, not the end of a web program", label: "nan blend", says: "not a finite number", next: 510); }
        else if (this.stage == 510) { this.commandRefused(kind: 1, label: "infinite blend", next: 511); }
        else if (this.stage == 511) { this.awaitOne(name: "an infinite blend constant is a validation error at finish in the package's words, not the end of a web program", label: "infinite blend", says: "not a finite number", next: 520); }
        else if (this.stage == 520) { this.commandRefused(kind: 2, label: "nan viewport", next: 521); }
        else if (this.stage == 521) { this.awaitOne(name: "a NaN viewport x is a validation error at finish in the package's words, not the end of a web program", label: "nan viewport", says: "not a finite number", next: 530); }
        else if (this.stage == 530) { this.commandRefused(kind: 3, label: "infinite depth range", next: 531); }
        else if (this.stage == 531) { this.awaitOne(name: "an infinite viewport maxDepth is a validation error at finish in the package's words, not the end of a web program", label: "infinite depth range", says: "not a finite number", next: 540); }
        else if (this.stage == 540) { this.commandRefused(kind: 4, label: "huge draw", next: 541); }
        else if (this.stage == 541) { this.awaitHuge(name: "a draw of 2^31 vertices", label: "huge draw", next: 550); }
        else if (this.stage == 550) { this.commandRefused(kind: 5, label: "huge instancing", next: 551); }
        else if (this.stage == 551) { this.awaitHuge(name: "an indexed draw of 2^31 instances", label: "huge instancing", next: 600); }
        else if (this.stage == 600) { this.commandMisused(kind: 0, label: "slot 2^31", next: 601); }
        else if (this.stage == 601) { this.awaitNamed(name: "a vertex buffer slot of 2^31 is a validation error at finish, not the end of a web program", label: "slot 2^31", next: 610); }
        else if (this.stage == 610) { this.commandMisused(kind: 2, label: "vertex offset 2^60", next: 611); }
        else if (this.stage == 611) { this.awaitNamed(name: "a vertex buffer offset of 2^60 is a validation error at finish, not the end of a web program", label: "vertex offset 2^60", next: 615); }
        else if (this.stage == 615) { this.commandMisused(kind: 3, label: "vertex size 2^60", next: 616); }
        else if (this.stage == 616) { this.awaitNamed(name: "a vertex buffer size of 2^60 is a validation error at finish, not the end of a web program", label: "vertex size 2^60", next: 620); }
        else if (this.stage == 620) { this.commandMisused(kind: 4, label: "index offset 2^60", next: 621); }
        else if (this.stage == 621) { this.awaitNamed(name: "an index buffer offset of 2^60 is a validation error at finish, not the end of a web program", label: "index offset 2^60", next: 625); }
        else if (this.stage == 625) { this.commandMisused(kind: 5, label: "group 2^31", next: 626); }
        else if (this.stage == 626) { this.awaitNamed(name: "a bind group index of 2^31 is a validation error at finish, not the end of a web program", label: "group 2^31", next: 630); }
        else if (this.stage == 630) { this.commandMisused(kind: 6, label: "scissor x 2^31", next: 631); }
        else if (this.stage == 631) { this.awaitNamed(name: "a scissor x of 2^31 is a validation error at finish, not the end of a web program", label: "scissor x 2^31", next: 635); }
        else if (this.stage == 635) { this.commandMisused(kind: 7, label: "scissor 2^32 - 1 wide", next: 636); }
        else if (this.stage == 636) { this.awaitNamed(name: "a scissor 2^32 - 1 wide and high is a validation error at finish, not the end of a web program", label: "scissor 2^32 - 1 wide", next: 640); }
        else if (this.stage == 640) { this.commandMisused(kind: 8, label: "slot past the limit", next: 641); }
        else if (this.stage == 641) { this.awaitNamed(name: "a vertex buffer slot past maxVertexBuffers is a validation error at finish", label: "slot past the limit", next: 645); }
        else if (this.stage == 645) { this.commandMisused(kind: 9, label: "an offset too many", next: 646); }
        else if (this.stage == 646) { this.awaitNamed(name: "two dynamic offsets for a group with one dynamic buffer are a validation error at finish", label: "an offset too many", next: 650); }
        else if (this.stage == 650) { this.commandMisused(kind: 10, label: "depth range reversed", next: 651); }
        else if (this.stage == 651) { this.awaitNamed(name: "a viewport's minDepth above its maxDepth is a validation error at finish", label: "depth range reversed", next: 655); }
        else if (this.stage == 655) { this.commandMisused(kind: 11, label: "no index buffer", next: 656); }
        else if (this.stage == 656) { this.awaitNamed(name: "an indexed draw with no index buffer is a validation error at finish", label: "no index buffer", next: 660); }
        else if (this.stage == 660) { this.commandMisused(kind: 12, label: "index range too short", next: 661); }
        else if (this.stage == 661) { this.awaitNamed(name: "an index buffer bound for 2 bytes under a draw of 3 indices is a validation error at finish", label: "index range too short", next: 999); }
        return this.stage >= 999;
    }

    unsafe fn void next(int32 to) { this.stage = to; this.waited = 0; }

    unsafe fn void open() {
        Result<Instance, GpuError> made = Instance.make();
        match (give made) {
            case Ok(value: inst): {
                this.adapterRequest = Optional::Some(value: inst.requestAdapter(options: AdapterOptions.make(power: PowerPreference::Default)));
                this.instance = Optional::Some(value: give inst);
                this.next(to: 1);
            }
            case Err(error: e): { string why = e.message(); this.found.add(name: "an instance for the pass cases", why: give why); this.next(to: 999); }
        };
    }

    unsafe fn void awaitAdapter() {
        if (this.adapterRequest.isNone()) { this.next(to: 999); return; }
        AdapterStatus s = match (this.adapterRequest) {
            case Some(value: r): r.poll();
            case None: AdapterStatus::Failed(error: GpuError::Taken);
        };
        bool pending = match (s) { case Pending: true; case _: false; };
        if (!pending) { this.adapterRequest = Optional::None; }
        match (give s) {
            case Pending: { }
            case Ready(adapter: a): {
                this.deviceRequest = Optional::Some(value: a.requestDevice(options: readOptions()));
                this.next(to: 2);
            }
            case Failed(error: e): {
                bool none = match (e) { case NoAdapter(words: w): true; case _: false; };
                if (none && this.optional) {
                    println(s: "skip the pass cases: there is no WebGPU adapter here (--adapter-optional)");
                } else {
                    string why = e.message();
                    this.found.add(name: "an adapter for the pass cases", why: give why);
                }
                this.next(to: 999);
            }
        };
    }

    unsafe fn void awaitDevice() {
        if (this.deviceRequest.isNone()) { this.next(to: 999); return; }
        DeviceStatus s = match (this.deviceRequest) {
            case Some(value: r): r.poll();
            case None: DeviceStatus::Failed(error: GpuError::Taken);
        };
        bool pending = match (s) { case Pending: true; case _: false; };
        if (!pending) { this.deviceRequest = Optional::None; }
        match (give s) {
            case Pending: { }
            case Ready(device: d, queue: q): {
                ShaderModuleDescriptor m = ShaderModuleDescriptor.make(wgsl: passWgsl());
                m.label(text: "pass stages");
                this.shaders = Optional::Some(value: d.createShaderModule(descriptor: give m));
                this.device = Optional::Some(value: give d);
                this.queue = Optional::Some(value: give q);
                this.next(to: 10);
            }
            case Failed(error: e): { string why = e.message(); this.found.add(name: "a device for the pass cases", why: give why); this.next(to: 999); }
        };
    }

    // An empty command buffer submitted: on the web, what lets a pending error through to the channel.
    unsafe fn void flush() {
        match (this.device) {
            case Some(value: d): {
                match (this.queue) {
                    case Some(value: q): { CommandEncoder enc = d.createCommandEncoder(); CommandBuffer cb = give enc.finish(); q.submit(commands: give cb); }
                    case None: { this.found.add(name: "a pass case flushes through the run's queue", why: "the queue is gone (stage ${this.stage})"); }
                };
            }
            case None: { }
        };
    }

    unsafe fn Optional<DeviceErrors> drain() {
        match (this.device) {
            case Some(value: d): { return Optional::Some(value: d.takeErrors()); }
            case None: { return Optional::None; }
        };
    }

    // Once QUIET ticks have passed, the channel holds nothing.
    unsafe fn void awaitNone(const ref string name, int32 next) {
        if (this.waited < QUIET) { return; }
        Optional<DeviceErrors> got = this.drain();
        string why = match (got) {
            case Some(value: errs): errs.isEmpty() ? "" : "the channel holds " + described(errs: errs);
            case None: "no device";
        };
        this.found.add(name: copy name, why: give why);
        this.next(to: next);
    }

    // Once an error arrives, or SETTLE ticks pass: one validation error, its words naming `label` (and saying `says`).
    unsafe fn void awaitOne(const ref string name, const ref string label, const ref string says, int32 next) {
        Optional<DeviceErrors> got = this.drain();
        bool none = match (got) { case Some(value: errs): errs.isEmpty(); case None: true; };
        if (none && this.waited < SETTLE) { return; }
        string why = match (got) {
            case Some(value: errs): oneNaming(errs: errs, label: label, says: says);
            case None: "no device";
        };
        this.found.add(name: copy name, why: give why);
        this.next(to: next);
    }

    // Once an error arrives, or SETTLE ticks pass: one validation error, which names the pass `label` on a leg whose
    // pass errors name the pass, and does not on one whose never do.
    unsafe fn void awaitNamed(const ref string name, const ref string label, int32 next) {
        Optional<DeviceErrors> got = this.drain();
        bool none = match (got) { case Some(value: errs): errs.isEmpty(); case None: true; };
        if (none && this.waited < SETTLE) { return; }
        string why = match (got) {
            case Some(value: errs): oneNaming(errs: errs, label: this.named ? label : "", says: "");
            case None: "no device";
        };
        if (why.isEmpty() && !this.named) {
            string words = match (got) { case Some(value: errs): errs.reports()[0].message(); case None: ""; };
            if (words.contains(substring: label)) { why = "this leg's pass errors are held to not naming the pass, and this one does: " + words; }
        }
        string held = this.named ? ", naming the pass's label" : ", not naming the pass, as wgpu's never do";
        this.found.add(name: name + held, why: give why);
        this.next(to: next);
    }

    // A depth slice of 2^32 - 1 on a 2D view: one validation error, a slice given where none is allowed, not webgpu.h's
    // "no slice"; and in Firefox, which takes a slice of 2^32 - 2 there, nothing.
    unsafe fn void awaitSliceOfTheRest(int32 next) {
        if (this.sliceChecked) {
            this.awaitNamed(name: "a depth slice of 2^32 - 1 on a 2D view is a validation error at finish, not webgpu.h's no slice", label: "slice of the rest", next: next);
        } else {
            this.awaitNone(name: "a depth slice of 2^32 - 1 on a 2D view is taken, as Firefox takes a slice of 2^32 - 2 there (--unchecked-depth-slice)", next: next);
        }
    }

    // Passes WebGPU takes, each begun, ended and finished, and the command buffers dropped: no error.
    unsafe fn void goodPasses() {
        match (this.device) {
            case Some(value: d): {
                int32 kind = 0;
                while (kind < GOOD_KINDS) {
                    CommandEncoder encoder = d.createCommandEncoder();
                    RenderPass pass = encoder.beginRenderPass(descriptor: goodPass(d: d, kind: kind));
                    give pass.end();
                    CommandBuffer done = give encoder.finish();
                    kind = kind + 1;
                }
            }
            case None: { }
        };
        this.flush();
        this.next(to: 11);
    }

    // `recorded`'s `kind` drawn, its target copied out, submitted and mapped.
    unsafe fn void render(int32 kind, int32 next) {
        Optional<Buffer> copied = Optional::None;
        Optional<BufferRead> started = Optional::None;
        match (this.device) {
            case Some(value: d): {
                match (this.shaders) {
                    case Some(value: m): {
                        uint64 bytes = cast<uint64>(ROW) * cast<uint64>(SIDE);
                        Buffer b = d.createBuffer(descriptor: BufferDescriptor.make(size: bytes, usage: BufferUsage::MapRead | BufferUsage::CopyDst));
                        CommandEncoder encoder = d.createCommandEncoder();
                        match (this.queue) {
                            case Some(value: q): { recorded(d: d, q: q, m: m, encoder: encoder, kind: kind, into: b); }
                            case None: { }
                        };
                        CommandBuffer commands = give encoder.finish();
                        match (this.queue) {
                            case Some(value: q): { q.submit(commands: give commands); }
                            case None: { CommandBuffer unsent = give commands; }
                        };
                        started = Optional::Some(value: b.mapRead(offset: 0, size: bytes));
                        copied = Optional::Some(value: give b);
                    }
                    case None: { }
                };
            }
            case None: { }
        };
        this.readback = give copied;
        this.reading = give started;
        this.next(to: next);
    }

    // The copied target's first texel is `want`, and the channel is empty.
    unsafe fn void awaitPixel(const ref string name, DynamicArray<uint8> want, int32 next) {
        match (this.device) { case Some(value: d): { d.poll(wait: true); } case None: { } };
        ReadStatus s = match (this.reading) {
            case Some(value: r): r.poll();
            case None: ReadStatus::Failed(error: GpuError::Taken);
        };
        bool pending = match (s) { case Pending: true; case _: false; };
        if (pending && this.waited < SETTLE) { return; }
        string why = match (s) {
            case Pending: "the map did not finish";
            case Failed(error: e): e.message();
            case Ready: "";
        };
        if (why.isEmpty()) {
            DynamicArray<uint8> got = match (this.reading) { case Some(value: r): firstTexel(r: r); case None: DynamicArray.empty(); };
            why = sameBytes(got: got, want: want);
        }
        Optional<DeviceErrors> errs = this.drain();
        string heard = match (errs) {
            case Some(value: e): e.isEmpty() ? "" : "the channel holds " + described(errs: e);
            case None: "";
        };
        if (why.isEmpty()) { why = copy heard; }
        this.reading = Optional::None;
        this.readback = Optional::None;
        this.found.add(name: copy name, why: give why);
        this.next(to: next);
    }

    // An encoder whose pass the package refuses (`refusedPass`'s `kind`), finished and its command buffer dropped. Kind
    // 6 has the encoder's own error first (a copy into a buffer without CopyDst), kind 7 after the pass, and kind 8 has
    // a scope open around the whole encoder, popped once it is finished.
    unsafe fn void refused(int32 kind, const ref string label, int32 next) {
        Optional<ScopePop> popped = Optional::None;
        match (this.device) {
            case Some(value: d): {
                Texture target = colorTarget(d: d);
                Buffer noCopy = d.createBuffer(descriptor: BufferDescriptor.make(size: cast<uint64>(ROW) * cast<uint64>(SIDE), usage: BufferUsage::MapRead));
                Optional<ErrorScope> catching = Optional::None;
                if (kind == 8) { catching = Optional::Some(value: d.pushErrorScope(filter: ErrorFilter::Validation)); }
                CommandEncoder encoder = d.createCommandEncoder();
                if (kind == 6) { encoder.copyTextureToBuffer(texture: target, buffer: noCopy, width: SIDE, height: SIDE, bytesPerRow: ROW); }
                RenderPass pass = encoder.beginRenderPass(descriptor: refusedPass(d: d, kind: kind, label: label));
                give pass.end();
                if (kind == 7) { encoder.copyTextureToBuffer(texture: target, buffer: noCopy, width: SIDE, height: SIDE, bytesPerRow: ROW); }
                CommandBuffer done = give encoder.finish();
                match (give catching) {
                    case Some(value: c): {
                        Result<ScopePop, GpuError> ended = give c.pop();
                        match (give ended) { case Ok(value: p): { popped = Optional::Some(value: give p); } case Err(error: e): { } };
                    }
                    case None: { }
                };
            }
            case None: { }
        };
        this.around = give popped;
        this.flush();
        this.next(to: next);
    }

    // Once an error arrives, or SETTLE ticks pass: one validation error, the encoder's own copy error, not the refusal
    // of the pass recorded after it (each backend has its own words for the copy).
    unsafe fn void awaitEarlier(int32 next) {
        Optional<DeviceErrors> got = this.drain();
        bool none = match (got) { case Some(value: errs): errs.isEmpty(); case None: true; };
        if (none && this.waited < SETTLE) { return; }
        string why = match (got) {
            case Some(value: errs): oneNaming(errs: errs, label: "", says: "");
            case None: "no device";
        };
        if (why.isEmpty()) {
            string words = match (got) { case Some(value: errs): errs.reports()[0].message(); case None: ""; };
            if (words.contains(substring: "not a finite number")) { why = "the refusal was reported, not the earlier error: " + words; }
        }
        this.found.add(name: "a refused pass after the encoder's own error: that earlier error is the one reported, as WebGPU's order has it", why: give why);
        this.next(to: next);
    }

    // The scope around a refused encoder caught the refusal, in the package's words, and the channel holds nothing.
    unsafe fn void awaitScoped(int32 next) {
        PopStatus s = match (this.around) { case Some(value: p): p.poll(); case None: PopStatus::Failed(error: GpuError::Taken); };
        bool pending = match (s) { case Pending: true; case _: false; };
        if ((pending || this.waited < QUIET) && this.waited < SETTLE) { return; }
        string why = "";
        match (give s) {
            case Pending: { why = "the pop was not answered"; }
            case Failed(error: e): { string failed = e.message(); why = "the pop failed: " + failed; }
            case Ready(caught: c): {
                match (c) {
                    case Some(value: r): {
                        string words = r.message();
                        if (!words.contains(substring: "not a finite number")) { why = "it caught another error: " + words; }
                    }
                    case None: { why = "it caught nothing"; }
                };
            }
        };
        Optional<DeviceErrors> errs = this.drain();
        string heard = match (errs) {
            case Some(value: e): e.isEmpty() ? "" : "the channel holds " + described(errs: e);
            case None: "";
        };
        if (why.isEmpty()) { why = copy heard; }
        this.around = Optional::None;
        this.found.add(name: "a scope open around an encoder catches its pass's refusal at finish, in the package's words, and the channel holds nothing", why: give why);
        this.next(to: next);
    }

    // A ready read asked for its bytes twice answers the whole range both times, the same bytes. On the web a browser
    // refuses a second mapped range over the first, which the seam once asked for at each call.
    unsafe fn void awaitTwice(int32 next) {
        match (this.device) { case Some(value: d): { d.poll(wait: true); } case None: { } };
        ReadStatus s = match (this.reading) {
            case Some(value: r): r.poll();
            case None: ReadStatus::Failed(error: GpuError::Taken);
        };
        bool pending = match (s) { case Pending: true; case _: false; };
        if (pending && this.waited < SETTLE) { return; }
        string why = match (s) {
            case Pending: "the map did not finish";
            case Failed(error: e): e.message();
            case Ready: "";
        };
        if (why.isEmpty()) {
            DynamicArray<uint8> once = match (this.reading) { case Some(value: r): r.bytes(); case None: DynamicArray.empty(); };
            DynamicArray<uint8> again = match (this.reading) { case Some(value: r): r.bytes(); case None: DynamicArray.empty(); };
            isize whole = cast<isize>(ROW) * cast<isize>(SIDE);
            isize first = once.length();
            if (first != whole) { why = "the first answer is ${first} bytes, not ${whole}"; }
            else { why = sameBytes(got: again, want: once); }
        }
        this.reading = Optional::None;
        this.readback = Optional::None;
        this.found.add(name: "a mapped read asked for its bytes twice answers the same bytes both times, on every leg", why: give why);
        this.next(to: next);
    }

    // The copied target's first texel is `topLeft` and its last `bottomRight`, and the channel is empty.
    unsafe fn void awaitCorners(const ref string name, DynamicArray<uint8> topLeft, DynamicArray<uint8> bottomRight, int32 next) {
        match (this.device) { case Some(value: d): { d.poll(wait: true); } case None: { } };
        ReadStatus s = match (this.reading) {
            case Some(value: r): r.poll();
            case None: ReadStatus::Failed(error: GpuError::Taken);
        };
        bool pending = match (s) { case Pending: true; case _: false; };
        if (pending && this.waited < SETTLE) { return; }
        string why = match (s) {
            case Pending: "the map did not finish";
            case Failed(error: e): e.message();
            case Ready: "";
        };
        if (why.isEmpty()) {
            DynamicArray<uint8> first = match (this.reading) { case Some(value: r): texelAt(r: r, x: 0, y: 0); case None: DynamicArray.empty(); };
            DynamicArray<uint8> last = match (this.reading) { case Some(value: r): texelAt(r: r, x: SIDE - 1, y: SIDE - 1); case None: DynamicArray.empty(); };
            string atFirst = sameBytes(got: first, want: topLeft);
            string atLast = sameBytes(got: last, want: bottomRight);
            if (!atFirst.isEmpty()) { why = "the top-left texel: " + atFirst; }
            else if (!atLast.isEmpty()) { why = "the bottom-right texel: " + atLast; }
        }
        Optional<DeviceErrors> errs = this.drain();
        string heard = match (errs) {
            case Some(value: e): e.isEmpty() ? "" : "the channel holds " + described(errs: e);
            case None: "";
        };
        if (why.isEmpty()) { why = copy heard; }
        this.reading = Optional::None;
        this.readback = Optional::None;
        this.found.add(name: copy name, why: give why);
        this.next(to: next);
    }

    // A pass whose command the package refuses (`refusedCommand`'s `kind`), begun on a cleared target and labelled
    // `label`, then ended and finished, its command buffer dropped.
    unsafe fn void commandRefused(int32 kind, const ref string label, int32 next) {
        match (this.device) {
            case Some(value: d): {
                Texture color = colorTarget(d: d);
                CommandEncoder encoder = d.createCommandEncoder();
                RenderPassDescriptor p = passOf(attachment: ColorAttachment.clearing(view: wholeView(t: color), color: nothing()));
                p.label(text: copy label);
                RenderPass pass = encoder.beginRenderPass(descriptor: give p);
                refusedCommand(pass: pass, kind: kind);
                give pass.end();
                CommandBuffer done = give encoder.finish();
            }
            case None: { }
        };
        this.flush();
        this.next(to: next);
    }

    // A draw whose count is 2^31 or more, in a pass with no pipeline: on the web, where emdawnwebgpu cannot hand a
    // browser such a count, refused in the package's words; natively, where WebGPU's own draw takes it, passed on, and
    // the missing pipeline is the backend's error.
    unsafe fn void awaitHuge(const ref string name, const ref string label, int32 next) {
        if (hugeCountsRefused()) {
            this.awaitOne(name: name + " is refused on the web in the package's words, which emdawnwebgpu cannot hand a browser", label: label, says: "2^31 or more", next: next);
            return;
        }
        Optional<DeviceErrors> got = this.drain();
        bool none = match (got) { case Some(value: errs): errs.isEmpty(); case None: true; };
        if (none && this.waited < SETTLE) { return; }
        string why = match (got) {
            case Some(value: errs): oneNaming(errs: errs, label: "", says: "");
            case None: "no device";
        };
        if (why.isEmpty()) {
            string words = match (got) { case Some(value: errs): errs.reports()[0].message(); case None: ""; };
            if (words.contains(substring: "2^31 or more")) { why = "the package refused it natively: " + words; }
        }
        this.found.add(name: name + " is passed on natively, as WebGPU takes it: the missing pipeline is the backend's error", why: give why);
        this.next(to: next);
    }

    // A pass whose command WebGPU refuses (`misusedCommand`'s `kind`), begun on a cleared target and labelled `label`.
    unsafe fn void commandMisused(int32 kind, const ref string label, int32 next) {
        match (this.device) {
            case Some(value: d): {
                match (this.shaders) {
                    case Some(value: m): {
                        Texture color = colorTarget(d: d);
                        CommandEncoder encoder = d.createCommandEncoder();
                        RenderPassDescriptor p = passOf(attachment: ColorAttachment.clearing(view: wholeView(t: color), color: nothing()));
                        p.label(text: copy label);
                        RenderPass pass = encoder.beginRenderPass(descriptor: give p);
                        misusedCommand(d: d, m: m, pass: pass, kind: kind);
                        give pass.end();
                        CommandBuffer done = give encoder.finish();
                    }
                    case None: { }
                };
            }
            case None: { }
        };
        this.flush();
        this.next(to: next);
    }

    // An encoder whose pass WebGPU refuses (`misusedPass`'s `kind`), finished and its command buffer dropped.
    unsafe fn void misused(int32 kind, const ref string label, int32 next) {
        match (this.device) {
            case Some(value: d): {
                CommandEncoder encoder = d.createCommandEncoder();
                RenderPass pass = encoder.beginRenderPass(descriptor: misusedPass(d: d, kind: kind, label: label));
                give pass.end();
                CommandBuffer done = give encoder.finish();
            }
            case None: { }
        };
        this.flush();
        this.next(to: next);
    }
}

comptime int32 GOOD_KINDS = 12;

// A SIDE by SIDE target of `format`, its usage `usage`, `layers` deep in `dim`, at `samples`.
unsafe fn Texture madeTexture(ref Device d, TextureFormat format, TextureUsage usage, TextureDimension dim, uint32 layers, uint32 samples) {
    TextureDescriptor t = TextureDescriptor.make(width: SIDE, height: SIDE, format: format, usage: usage);
    t.dimension(kind: dim);
    t.depthOrArrayLayers(count: layers);
    t.sampleCount(count: samples);
    return d.createTexture(descriptor: give t);
}
unsafe fn Texture colorTarget(ref Device d) {
    return madeTexture(d: d, format: TextureFormat::RGBA8Unorm, usage: TextureUsage::RenderAttachment | TextureUsage::CopySrc,
                       dim: TextureDimension::D2, layers: 1, samples: 1);
}
unsafe fn Texture depthTarget(ref Device d, TextureFormat format) {
    return madeTexture(d: d, format: format, usage: TextureUsage::RenderAttachment, dim: TextureDimension::D2, layers: 1, samples: 1);
}
unsafe fn TextureView wholeView(ref Texture t) { return t.createView(descriptor: TextureViewDescriptor.make()); }

// One colour attachment, and a pass of it.
fn RenderPassDescriptor passOf(ColorAttachment attachment) {
    RenderPassDescriptor p = RenderPassDescriptor.make();
    p.color(attachment: give attachment);
    return p;
}
// A pass of a colour attachment cleared to nothing and a depth-stencil attachment.
unsafe fn RenderPassDescriptor withDepth(ref Texture color, DepthStencilAttachment depth) {
    RenderPassDescriptor p = passOf(attachment: ColorAttachment.clearing(view: wholeView(t: color), color: nothing()));
    p.depthStencil(attachment: give depth);
    return p;
}
// A pass of a depth-stencil attachment alone.
fn RenderPassDescriptor depthAlone(DepthStencilAttachment depth) {
    RenderPassDescriptor p = RenderPassDescriptor.make();
    p.depthStencil(attachment: give depth);
    return p;
}

// The passes WebGPU takes, by kind.
unsafe fn RenderPassDescriptor goodPass(ref Device d, int32 kind) {
    Texture color = colorTarget(d: d);
    if (kind == 0) { return passOf(attachment: ColorAttachment.clearing(view: wholeView(t: color), color: fifths())); }
    if (kind == 1) { return passOf(attachment: ColorAttachment.make(view: wholeView(t: color), load: LoadOp::Load, store: StoreOp::Store)); }
    if (kind == 2) { return passOf(attachment: ColorAttachment.make(view: wholeView(t: color), load: LoadOp::Clear(color: fifths()), store: StoreOp::Discard)); }
    if (kind == 3) {
        Texture four = madeTexture(d: d, format: TextureFormat::RGBA8Unorm, usage: TextureUsage::RenderAttachment, dim: TextureDimension::D2, layers: 1, samples: 4);
        ColorAttachment a = ColorAttachment.make(view: wholeView(t: four), load: LoadOp::Clear(color: fifths()), store: StoreOp::Discard);
        a.resolveTarget(view: wholeView(t: color));
        return passOf(attachment: give a);
    }
    if (kind == 4) {
        Texture deep = madeTexture(d: d, format: TextureFormat::RGBA8Unorm, usage: TextureUsage::RenderAttachment, dim: TextureDimension::D3, layers: 2, samples: 1);
        ColorAttachment a = ColorAttachment.clearing(view: wholeView(t: deep), color: fifths());
        a.depthSlice(slice: 1);
        return passOf(attachment: give a);
    }
    if (kind == 5) {
        RenderPassDescriptor p = RenderPassDescriptor.make();
        p.emptyColor();
        p.color(attachment: ColorAttachment.clearing(view: wholeView(t: color), color: fifths()));
        return p;
    }
    if (kind == 6) {
        Texture depth = depthTarget(d: d, format: TextureFormat::Depth24Plus);
        return depthAlone(depth: DepthStencilAttachment.clearingDepth(view: wholeView(t: depth), value: 1.0));
    }
    if (kind == 7) {
        Texture depth = depthTarget(d: d, format: TextureFormat::Depth24Plus);
        DepthStencilAttachment a = DepthStencilAttachment.make(view: wholeView(t: depth));
        a.depth(access: DepthAccess::ReadOnly);
        return withDepth(color: color, depth: give a);
    }
    if (kind == 8) {
        Texture both = depthTarget(d: d, format: TextureFormat::Depth24PlusStencil8);
        DepthStencilAttachment a = DepthStencilAttachment.make(view: wholeView(t: both));
        a.depth(access: DepthAccess::ReadWrite(load: DepthLoad::Load, store: StoreOp::Discard));
        a.stencil(access: StencilAccess::ReadWrite(load: StencilLoad::Clear(value: 7), store: StoreOp::Store));
        return withDepth(color: color, depth: give a);
    }
    if (kind == 9) {
        Texture stencil = depthTarget(d: d, format: TextureFormat::Stencil8);
        DepthStencilAttachment a = DepthStencilAttachment.make(view: wholeView(t: stencil));
        a.stencil(access: StencilAccess::ReadWrite(load: StencilLoad::Load, store: StoreOp::Store));
        return depthAlone(depth: give a);
    }
    if (kind == 10) {
        Texture depth = depthTarget(d: d, format: TextureFormat::Depth24Plus);
        DepthStencilAttachment a = DepthStencilAttachment.clearingDepth(view: wholeView(t: depth), value: 0.0);
        a.stencil(access: StencilAccess::ReadOnly);
        return depthAlone(depth: give a);
    }
    // both aspects of Depth24PlusStencil8 read-only
    Texture both = depthTarget(d: d, format: TextureFormat::Depth24PlusStencil8);
    DepthStencilAttachment a = DepthStencilAttachment.make(view: wholeView(t: both));
    a.depth(access: DepthAccess::ReadOnly);
    a.stencil(access: StencilAccess::ReadOnly);
    return withDepth(color: color, depth: give a);
}

// The read-back cases, recorded into `encoder`: each ends with its colour copied into `into`.
unsafe fn void recorded(ref Device d, ref Queue q, ref ShaderModule m, ref CommandEncoder encoder, int32 kind, const ref Buffer into) {
    Texture color = colorTarget(d: d);
    if (kind >= 20) {
        commanded(d: d, q: q, m: m, encoder: encoder, kind: kind, color: color);
    } else if (kind == 0) {
        // cleared, every channel its own
        RenderPass pass = encoder.beginRenderPass(descriptor: passOf(attachment: ColorAttachment.clearing(view: wholeView(t: color), color: fifths())));
        give pass.end();
    } else if (kind == 1) {
        // cleared and stored, then loaded and stored by a pass that draws nothing
        RenderPass first = encoder.beginRenderPass(descriptor: passOf(attachment: ColorAttachment.clearing(view: wholeView(t: color), color: fifths())));
        give first.end();
        RenderPass second = encoder.beginRenderPass(descriptor: passOf(attachment: ColorAttachment.make(view: wholeView(t: color), load: LoadOp::Load, store: StoreOp::Store)));
        give second.end();
    } else if (kind == 2) {
        // cleared and discarded
        RenderPass pass = encoder.beginRenderPass(descriptor: passOf(attachment: ColorAttachment.make(view: wholeView(t: color), load: LoadOp::Clear(color: fifths()), store: StoreOp::Discard)));
        give pass.end();
    } else if (kind == 3) {
        // four samples cleared, discarded, and resolved into the target
        Texture four = madeTexture(d: d, format: TextureFormat::RGBA8Unorm, usage: TextureUsage::RenderAttachment, dim: TextureDimension::D2, layers: 1, samples: 4);
        ColorAttachment a = ColorAttachment.make(view: wholeView(t: four), load: LoadOp::Clear(color: fifths()), store: StoreOp::Discard);
        a.resolveTarget(view: wholeView(t: color));
        RenderPass pass = encoder.beginRenderPass(descriptor: passOf(attachment: give a));
        give pass.end();
    } else if (kind == 4) {
        // a 3D target's slice 0 cleared, then slice 1 cleared to another colour; slice 0 is copied
        Texture deep = madeTexture(d: d, format: TextureFormat::RGBA8Unorm, usage: TextureUsage::RenderAttachment | TextureUsage::CopySrc,
                                   dim: TextureDimension::D3, layers: 2, samples: 1);
        ColorAttachment zero = ColorAttachment.clearing(view: wholeView(t: deep), color: fifths());
        zero.depthSlice(slice: 0);
        RenderPass first = encoder.beginRenderPass(descriptor: passOf(attachment: give zero));
        give first.end();
        ColorAttachment one = ColorAttachment.clearing(view: wholeView(t: deep), color: Color.of(r: 1.0, g: 1.0, b: 1.0, a: 1.0));
        one.depthSlice(slice: 1);
        RenderPass second = encoder.beginRenderPass(descriptor: passOf(attachment: give one));
        give second.end();
        encoder.copyTextureToBuffer(texture: deep, buffer: into, width: SIDE, height: SIDE, bytesPerRow: ROW);
        return;
    } else if (kind == 5) {
        // an empty first attachment, and a pipeline with an empty first target writing location 1 into the second
        RenderPassDescriptor p = RenderPassDescriptor.make();
        p.emptyColor();
        p.color(attachment: ColorAttachment.clearing(view: wholeView(t: color), color: nothing()));
        RenderPipeline second = d.createRenderPipeline(descriptor: passPipeline(m: m, kind: 7));
        RenderPass pass = encoder.beginRenderPass(descriptor: give p);
        pass.setPipeline(pipeline: second);
        pass.draw(vertexCount: 3, instanceCount: 1, firstVertex: 0, firstInstance: 0);
        give pass.end();
    } else if (kind == 6) {
        // depth cleared to 0.5, a triangle at 0.25 through a less test
        Texture depth = depthTarget(d: d, format: TextureFormat::Depth32Float);
        RenderPipeline tested = d.createRenderPipeline(descriptor: passPipeline(m: m, kind: 1));
        RenderPass pass = encoder.beginRenderPass(descriptor: withDepth(color: color, depth: DepthStencilAttachment.clearingDepth(view: wholeView(t: depth), value: 0.5)));
        pass.setPipeline(pipeline: tested);
        pass.draw(vertexCount: 3, instanceCount: 1, firstVertex: 0, firstInstance: 0);
        give pass.end();
    } else if (kind == 7) {
        // a depth prepass at 0.25 over a depth of 1, stored; then the depth loaded and the triangle drawn with an equal test
        Texture depth = depthTarget(d: d, format: TextureFormat::Depth32Float);
        RenderPipeline prepass = d.createRenderPipeline(descriptor: passPipeline(m: m, kind: 2));
        RenderPipeline equal = d.createRenderPipeline(descriptor: passPipeline(m: m, kind: 3));
        RenderPass first = encoder.beginRenderPass(descriptor: depthAlone(depth: DepthStencilAttachment.clearingDepth(view: wholeView(t: depth), value: 1.0)));
        first.setPipeline(pipeline: prepass);
        first.draw(vertexCount: 3, instanceCount: 1, firstVertex: 0, firstInstance: 0);
        give first.end();
        DepthStencilAttachment loaded = DepthStencilAttachment.make(view: wholeView(t: depth));
        loaded.depth(access: DepthAccess::ReadWrite(load: DepthLoad::Load, store: StoreOp::Store));
        RenderPass second = encoder.beginRenderPass(descriptor: withDepth(color: color, depth: give loaded));
        second.setPipeline(pipeline: equal);
        second.draw(vertexCount: 3, instanceCount: 1, firstVertex: 0, firstInstance: 0);
        give second.end();
    } else if (kind == 8) {
        // depth cleared to 0.5 and stored; then read-only, a triangle at 0.25 through a less test that writes no depth
        Texture depth = depthTarget(d: d, format: TextureFormat::Depth32Float);
        RenderPipeline tested = d.createRenderPipeline(descriptor: passPipeline(m: m, kind: 1));
        RenderPass first = encoder.beginRenderPass(descriptor: depthAlone(depth: DepthStencilAttachment.clearingDepth(view: wholeView(t: depth), value: 0.5)));
        give first.end();
        DepthStencilAttachment readOnly = DepthStencilAttachment.make(view: wholeView(t: depth));
        readOnly.depth(access: DepthAccess::ReadOnly);
        RenderPass second = encoder.beginRenderPass(descriptor: withDepth(color: color, depth: give readOnly));
        second.setPipeline(pipeline: tested);
        second.draw(vertexCount: 3, instanceCount: 1, firstVertex: 0, firstInstance: 0);
        give second.end();
    } else if (kind == 9) {
        // stencil cleared to 1, a triangle through an equal test against the reference 0
        Texture stencil = depthTarget(d: d, format: TextureFormat::Stencil8);
        RenderPipeline equal = d.createRenderPipeline(descriptor: passPipeline(m: m, kind: 4));
        DepthStencilAttachment cleared = DepthStencilAttachment.make(view: wholeView(t: stencil));
        cleared.stencil(access: StencilAccess::ReadWrite(load: StencilLoad::Clear(value: 1), store: StoreOp::Store));
        RenderPass pass = encoder.beginRenderPass(descriptor: withDepth(color: color, depth: give cleared));
        pass.setPipeline(pipeline: equal);
        pass.draw(vertexCount: 3, instanceCount: 1, firstVertex: 0, firstInstance: 0);
        give pass.end();
    } else if (kind == 10) {
        // stencil cleared to 1 and stored; then loaded, a triangle through an equal test against the reference 0
        Texture stencil = depthTarget(d: d, format: TextureFormat::Stencil8);
        RenderPipeline equal = d.createRenderPipeline(descriptor: passPipeline(m: m, kind: 4));
        DepthStencilAttachment cleared = DepthStencilAttachment.make(view: wholeView(t: stencil));
        cleared.stencil(access: StencilAccess::ReadWrite(load: StencilLoad::Clear(value: 1), store: StoreOp::Store));
        RenderPass first = encoder.beginRenderPass(descriptor: depthAlone(depth: give cleared));
        give first.end();
        DepthStencilAttachment loaded = DepthStencilAttachment.make(view: wholeView(t: stencil));
        loaded.stencil(access: StencilAccess::ReadWrite(load: StencilLoad::Load, store: StoreOp::Store));
        RenderPass second = encoder.beginRenderPass(descriptor: withDepth(color: color, depth: give loaded));
        second.setPipeline(pipeline: equal);
        second.draw(vertexCount: 3, instanceCount: 1, firstVertex: 0, firstInstance: 0);
        give second.end();
    } else if (kind == 11 || kind == 13) {
        // stencil cleared to 0; the front face Never, the back Always; or, with clockwise front faces, the triangle a
        // back face, Always in front and Never behind
        Texture stencil = depthTarget(d: d, format: TextureFormat::Stencil8);
        RenderPipeline faces = d.createRenderPipeline(descriptor: passPipeline(m: m, kind: kind == 11 ? 5 : 8));
        DepthStencilAttachment cleared = DepthStencilAttachment.make(view: wholeView(t: stencil));
        cleared.stencil(access: StencilAccess::ReadWrite(load: StencilLoad::Clear(value: 0), store: StoreOp::Store));
        RenderPass pass = encoder.beginRenderPass(descriptor: withDepth(color: color, depth: give cleared));
        pass.setPipeline(pipeline: faces);
        pass.draw(vertexCount: 3, instanceCount: 1, firstVertex: 0, firstInstance: 0);
        give pass.end();
    } else {
        // depth cleared to 0.5, the sloped triangle (0.0625 at the first texel) biased by a slope scale of 4
        Texture depth = depthTarget(d: d, format: TextureFormat::Depth32Float);
        RenderPipeline sloped = d.createRenderPipeline(descriptor: passPipeline(m: m, kind: 6));
        RenderPass pass = encoder.beginRenderPass(descriptor: withDepth(color: color, depth: DepthStencilAttachment.clearingDepth(view: wholeView(t: depth), value: 0.5)));
        pass.setPipeline(pipeline: sloped);
        pass.draw(vertexCount: 3, instanceCount: 1, firstVertex: 0, firstInstance: 0);
        give pass.end();
    }
    encoder.copyTextureToBuffer(texture: color, buffer: into, width: SIDE, height: SIDE, bytesPerRow: ROW);
}

// The read-back cases' pipelines, by kind: 1 a less test on Depth32Float writing no depth; 2 a depth-only prepass
// writing depth; 3 an equal test writing no depth; 4 a stencil equal test on both faces of Stencil8; 5 Never in front
// and Always behind; 6 the sloped triangle, biased by a slope scale of 4, through a less test; 7 an empty first target
// and `fs1` into the second; 8 clockwise front faces, Always in front and Never behind.
unsafe fn RenderPipelineDescriptor passPipeline(ref ShaderModule m, int32 kind) {
    string entry = kind == 6 ? "vsSlope" : "vs0";
    RenderPipelineDescriptor p = RenderPipelineDescriptor.make(layout: Layout::Auto, vertex: VertexState.make(module: copy m, entryPoint: give entry));
    if (kind != 2) {
        FragmentState f = FragmentState.make(module: copy m, entryPoint: kind == 7 ? "fs1" : "fs");
        if (kind == 7) { f.emptyTarget(); }
        f.target(state: ColorTargetState.make(format: TextureFormat::RGBA8Unorm));
        p.fragment(state: give f);
    }
    if (kind == 1 || kind == 6) {
        DepthStencilState s = DepthStencilState.make(format: TextureFormat::Depth32Float, depthWriteEnabled: false, depthCompare: CompareFunction::Less);
        if (kind == 6) { s.depthBiasSlopeScale = 4.0; }
        p.depthStencil(state: s);
    } else if (kind == 2) {
        p.depthStencil(state: DepthStencilState.make(format: TextureFormat::Depth32Float, depthWriteEnabled: true, depthCompare: CompareFunction::Less));
    } else if (kind == 3) {
        p.depthStencil(state: DepthStencilState.make(format: TextureFormat::Depth32Float, depthWriteEnabled: false, depthCompare: CompareFunction::Equal));
    } else if (kind == 4 || kind == 5) {
        DepthStencilState s = DepthStencilState.make(format: TextureFormat::Stencil8, depthWriteEnabled: false, depthCompare: CompareFunction::Always);
        s.stencilFront.compare = kind == 4 ? CompareFunction::Equal : CompareFunction::Never;
        s.stencilBack.compare = kind == 4 ? CompareFunction::Equal : CompareFunction::Always;
        p.depthStencil(state: s);
    } else if (kind == 8) {
        DepthStencilState s = DepthStencilState.make(format: TextureFormat::Stencil8, depthWriteEnabled: false, depthCompare: CompareFunction::Always);
        s.stencilFront.compare = CompareFunction::Always;
        s.stencilBack.compare = CompareFunction::Never;
        p.depthStencil(state: s);
        p.primitiveMut().frontFace = FrontFace::CW;
    }
    return p;
}

// The passes the package refuses, by kind: 0 a NaN green; 1 an infinite alpha; 2 a NaN depth clear value; 3 a -inf
// one; 4 stencil ops on Depth24Plus; 5 depth ops on Stencil8; 6 to 8 a NaN red, for the order and the scope.
unsafe fn RenderPassDescriptor refusedPass(ref Device d, int32 kind, const ref string label) {
    Texture color = colorTarget(d: d);
    RenderPassDescriptor p = RenderPassDescriptor.make();
    if (kind == 0) {
        p = passOf(attachment: ColorAttachment.clearing(view: wholeView(t: color), color: Color.of(r: 0.0, g: notANumber(), b: 0.0, a: 1.0)));
    } else if (kind == 1) {
        p = passOf(attachment: ColorAttachment.clearing(view: wholeView(t: color), color: Color.of(r: 0.0, g: 0.0, b: 0.0, a: infinity(sign: 1.0))));
    } else if (kind == 2 || kind == 3) {
        Texture depth = depthTarget(d: d, format: TextureFormat::Depth24Plus);
        float32 v = kind == 2 ? notANumber32() : infinity32(sign: -1.0);
        p = withDepth(color: color, depth: DepthStencilAttachment.clearingDepth(view: wholeView(t: depth), value: v));
    } else if (kind == 4) {
        Texture depth = depthTarget(d: d, format: TextureFormat::Depth24Plus);
        DepthStencilAttachment a = DepthStencilAttachment.clearingDepth(view: wholeView(t: depth), value: 1.0);
        a.stencil(access: StencilAccess::ReadWrite(load: StencilLoad::Clear(value: 0), store: StoreOp::Store));
        p = withDepth(color: color, depth: give a);
    } else if (kind == 5) {
        Texture stencil = depthTarget(d: d, format: TextureFormat::Stencil8);
        DepthStencilAttachment a = DepthStencilAttachment.make(view: wholeView(t: stencil));
        a.stencil(access: StencilAccess::ReadWrite(load: StencilLoad::Clear(value: 0), store: StoreOp::Store));
        a.depth(access: DepthAccess::ReadWrite(load: DepthLoad::Clear(value: 1.0), store: StoreOp::Store));
        p = withDepth(color: color, depth: give a);
    } else {
        p = passOf(attachment: ColorAttachment.clearing(view: wholeView(t: color), color: Color.of(r: notANumber(), g: 0.0, b: 0.0, a: 1.0)));
    }
    p.label(text: copy label);
    return p;
}

// The passes WebGPU refuses, by kind: 0 a depth slice on a 2D view; 1 a slice of 2^32 - 1 on one, webgpu.h's "no
// slice"; 2 a depth clear value of 2; 3 a Depth24Plus attachment given no depth access; 4 no attachments.
unsafe fn RenderPassDescriptor misusedPass(ref Device d, int32 kind, const ref string label) {
    Texture color = colorTarget(d: d);
    RenderPassDescriptor p = RenderPassDescriptor.make();
    if (kind == 0 || kind == 1) {
        ColorAttachment a = ColorAttachment.clearing(view: wholeView(t: color), color: nothing());
        a.depthSlice(slice: kind == 0 ? 0 : 0xFFFFFFFF);
        p = passOf(attachment: give a);
    } else if (kind == 2) {
        Texture depth = depthTarget(d: d, format: TextureFormat::Depth24Plus);
        p = withDepth(color: color, depth: DepthStencilAttachment.clearingDepth(view: wholeView(t: depth), value: 2.0));
    } else if (kind == 3) {
        Texture depth = depthTarget(d: d, format: TextureFormat::Depth24Plus);
        p = withDepth(color: color, depth: DepthStencilAttachment.make(view: wholeView(t: depth)));
    }
    p.label(text: copy label);
    return p;
}

// The little-endian bytes of `values`, each a float32.
fn DynamicArray<uint8> floatBytes(const ref DynamicArray<float32> values) {
    DynamicArray<uint8> written = DynamicArray.empty();
    isize i = 0;
    while (i < values.length()) {
        uint32 bits = bitcast<uint32>(values[i]);
        written.add(item: truncate<uint8>(bits));
        written.add(item: truncate<uint8>(bits >> 8));
        written.add(item: truncate<uint8>(bits >> 16));
        written.add(item: truncate<uint8>(bits >> 24));
        i = i + 1;
    }
    return written;
}
// The little-endian bytes of `values`, each a uint16 index.
fn DynamicArray<uint8> indexBytes(const ref DynamicArray<uint16> values) {
    DynamicArray<uint8> written = DynamicArray.empty();
    isize i = 0;
    while (i < values.length()) {
        written.add(item: truncate<uint8>(values[i]));
        written.add(item: truncate<uint8>(values[i] >> 8));
        i = i + 1;
    }
    return written;
}
fn DynamicArray<float32> floats(float32 a, float32 b) {
    DynamicArray<float32> v = DynamicArray.empty();
    v.add(item: a);
    v.add(item: b);
    return v;
}
fn void addPair(ref DynamicArray<float32> v, float32 a, float32 b) {
    v.add(item: a);
    v.add(item: b);
}
// The triangle that covers the target, as three float32x2 positions.
fn void addCover(ref DynamicArray<float32> v) {
    addPair(v: v, a: -1.0, b: -1.0);
    addPair(v: v, a: 3.0, b: -1.0);
    addPair(v: v, a: -1.0, b: 3.0);
}
// A buffer of `usage` holding `bytes`, written through `q`.
unsafe fn Buffer holding(ref Device d, ref Queue q, BufferUsage usage, const ref DynamicArray<uint8> bytes) {
    Buffer b = d.createBuffer(descriptor: BufferDescriptor.make(size: cast<uint64>(bytes.length()), usage: usage | BufferUsage::CopyDst));
    q.writeBuffer(buffer: b, offset: 0, data: bytes.view());
    return b;
}
// A group layout of one uniform buffer, dynamic or not, at binding 0, read by the fragment stage; and one with nothing.
unsafe fn BindGroupLayout uniformLayout(ref Device d, bool dynamic) {
    BufferBindingLayout u = BufferBindingLayout.make();
    u.hasDynamicOffset = dynamic;
    BindGroupLayoutDescriptor l = BindGroupLayoutDescriptor.make();
    l.entry(binding: 0, visibility: ShaderStage::Fragment, layout: BindingLayout::Buffer(layout: u));
    return d.createBindGroupLayout(descriptor: give l);
}
unsafe fn BindGroupLayout emptyLayout(ref Device d) { return d.createBindGroupLayout(descriptor: BindGroupLayoutDescriptor.make()); }
// A bind group of `layout` holding `size` bytes of `buffer` at binding 0; and one holding nothing.
unsafe fn BindGroup uniformGroup(ref Device d, ref BindGroupLayout layout, ref Buffer buffer, uint64 size) {
    BindGroupDescriptor g = BindGroupDescriptor.make(layout: copy layout);
    g.entry(binding: 0, resource: BindingResource::Buffer(binding: BufferBinding.range(buffer: copy buffer, offset: 0, size: size)));
    return d.createBindGroup(descriptor: give g);
}
unsafe fn BindGroup emptyGroup(ref Device d, ref BindGroupLayout layout) { return d.createBindGroup(descriptor: BindGroupDescriptor.make(layout: copy layout)); }

// The commands' pipelines, by kind, drawing into RGBA8Unorm: 0 `vsBuf`, a position from slot 0; 1 `vsInst`, a
// position from slot 0 per vertex and a shift from slot 1 per instance; 2 `fsu0` or 3 `fsu1` through `layout`; 4 white
// blended as the source times the constant; 5 `vs0` with nothing read.
unsafe fn RenderPipelineDescriptor commandPipeline(ref ShaderModule m, int32 kind, Layout layout) {
    string entry = kind == 0 ? "vsBuf" : kind == 1 ? "vsInst" : "vs0";
    VertexState v = VertexState.make(module: copy m, entryPoint: give entry);
    if (kind == 0 || kind == 1) {
        VertexBufferLayout at = VertexBufferLayout.make(arrayStride: 8);
        at.attribute(format: VertexFormat::Float32x2, offset: 0, shaderLocation: 0);
        v.buffer(layout: give at);
    }
    if (kind == 1) {
        VertexBufferLayout shift = VertexBufferLayout.make(arrayStride: 8);
        shift.stepMode(mode: VertexStepMode::Instance);
        shift.attribute(format: VertexFormat::Float32x2, offset: 0, shaderLocation: 1);
        v.buffer(layout: give shift);
    }
    RenderPipelineDescriptor p = RenderPipelineDescriptor.make(layout: give layout, vertex: give v);
    string fragment = kind == 2 ? "fsu0" : kind == 3 ? "fsu1" : kind == 4 ? "fsWhite" : "fs";
    FragmentState f = FragmentState.make(module: copy m, entryPoint: give fragment);
    ColorTargetState t = ColorTargetState.make(format: TextureFormat::RGBA8Unorm);
    if (kind == 4) {
        BlendComponent byConstant = BlendComponent.make();
        byConstant.srcFactor = BlendFactor::Constant;
        byConstant.dstFactor = BlendFactor::Zero;
        t.blend = Optional::Some(value: BlendState.make(color: byConstant, alpha: byConstant));
    }
    f.target(state: t);
    p.fragment(state: give f);
    return p;
}

// The commands' read-back cases, recorded into `encoder` with `color` the target (`recorded` copies it out).
unsafe fn void commanded(ref Device d, ref Queue q, ref ShaderModule m, ref CommandEncoder encoder, int32 kind, ref Texture color) {
    if (kind == 20) {
        // three positions at zero (a triangle of nothing), then the covering triangle; bound from its 24th byte, 24 bytes
        DynamicArray<float32> v = DynamicArray.empty();
        addPair(v: v, a: 0.0, b: 0.0);
        addPair(v: v, a: 0.0, b: 0.0);
        addPair(v: v, a: 0.0, b: 0.0);
        addCover(v: v);
        Buffer vb = holding(d: d, q: q, usage: BufferUsage::Vertex, bytes: floatBytes(values: v));
        RenderPipeline p = d.createRenderPipeline(descriptor: commandPipeline(m: m, kind: 0, layout: Layout::Auto));
        RenderPass pass = encoder.beginRenderPass(descriptor: passOf(attachment: ColorAttachment.clearing(view: wholeView(t: color), color: nothing())));
        pass.setPipeline(pipeline: p);
        pass.setVertexBuffer(slot: 0, binding: BufferBinding.range(buffer: copy vb, offset: 24, size: 24));
        pass.draw(vertexCount: 3, instanceCount: 1, firstVertex: 0, firstInstance: 0);
        give pass.end();
    } else if (kind == 21) {
        // the covering triangle in slot 0, and in slot 1 per instance a shift off the target, then none
        DynamicArray<float32> v = DynamicArray.empty();
        addCover(v: v);
        DynamicArray<float32> shifts = floats(a: 10.0, b: 10.0);
        addPair(v: shifts, a: 0.0, b: 0.0);
        addPair(v: shifts, a: 0.0, b: 0.0);
        Buffer vb = holding(d: d, q: q, usage: BufferUsage::Vertex, bytes: floatBytes(values: v));
        Buffer sb = holding(d: d, q: q, usage: BufferUsage::Vertex, bytes: floatBytes(values: shifts));
        RenderPipeline p = d.createRenderPipeline(descriptor: commandPipeline(m: m, kind: 1, layout: Layout::Auto));
        RenderPass pass = encoder.beginRenderPass(descriptor: passOf(attachment: ColorAttachment.clearing(view: wholeView(t: color), color: nothing())));
        pass.setPipeline(pipeline: p);
        pass.setVertexBuffer(slot: 0, binding: BufferBinding.whole(buffer: copy vb));
        pass.setVertexBuffer(slot: 1, binding: BufferBinding.whole(buffer: copy sb));
        pass.draw(vertexCount: 3, instanceCount: 2, firstVertex: 0, firstInstance: 0);
        give pass.end();
    } else if (kind == 22) {
        // positions: three at zero, then the covering triangle; shifts per instance: off the target, then none. The
        // index buffer holds 16 bytes of 9s, then the indices 9, 9, 9, 0, 1, 2 (and two of padding): bound from byte 16,
        // drawn from index 3 with a base vertex of 3, one instance from instance 1
        DynamicArray<float32> v = DynamicArray.empty();
        addPair(v: v, a: 0.0, b: 0.0);
        addPair(v: v, a: 0.0, b: 0.0);
        addPair(v: v, a: 0.0, b: 0.0);
        addCover(v: v);
        DynamicArray<float32> shifts = floats(a: 10.0, b: 10.0);
        addPair(v: shifts, a: 0.0, b: 0.0);
        DynamicArray<uint16> indices = DynamicArray.empty();
        isize i = 0;
        while (i < 8) { indices.add(item: 0x0909); i = i + 1; }
        indices.add(item: 9);
        indices.add(item: 9);
        indices.add(item: 9);
        indices.add(item: 0);
        indices.add(item: 1);
        indices.add(item: 2);
        indices.add(item: 0);
        indices.add(item: 0);
        Buffer vb = holding(d: d, q: q, usage: BufferUsage::Vertex, bytes: floatBytes(values: v));
        Buffer sb = holding(d: d, q: q, usage: BufferUsage::Vertex, bytes: floatBytes(values: shifts));
        Buffer ib = holding(d: d, q: q, usage: BufferUsage::Index, bytes: indexBytes(values: indices));
        RenderPipeline p = d.createRenderPipeline(descriptor: commandPipeline(m: m, kind: 1, layout: Layout::Auto));
        RenderPass pass = encoder.beginRenderPass(descriptor: passOf(attachment: ColorAttachment.clearing(view: wholeView(t: color), color: nothing())));
        pass.setPipeline(pipeline: p);
        pass.setVertexBuffer(slot: 0, binding: BufferBinding.whole(buffer: copy vb));
        pass.setVertexBuffer(slot: 1, binding: BufferBinding.whole(buffer: copy sb));
        pass.setIndexBuffer(binding: BufferBinding.rest(buffer: copy ib, offset: 16), format: IndexFormat::Uint16);
        pass.drawIndexed(indexCount: 3, instanceCount: 1, firstIndex: 3, baseVertex: 3, firstInstance: 1);
        give pass.end();
    } else if (kind == 23) {
        // an explicit layout of an empty group 0 and a uniform group 1, which holds green
        BindGroupLayout none = emptyLayout(d: d);
        BindGroupLayout uniform = uniformLayout(d: d, dynamic: false);
        PipelineLayoutDescriptor pl = PipelineLayoutDescriptor.make();
        pl.group(layout: copy none);
        pl.group(layout: copy uniform);
        PipelineLayout layout = d.createPipelineLayout(descriptor: give pl);
        DynamicArray<float32> green = floats(a: 0.0, b: 1.0);
        addPair(v: green, a: 0.0, b: 1.0);
        Buffer u = holding(d: d, q: q, usage: BufferUsage::Uniform, bytes: floatBytes(values: green));
        BindGroup g0 = emptyGroup(d: d, layout: none);
        BindGroup g1 = uniformGroup(d: d, layout: uniform, buffer: u, size: 16);
        RenderPipeline p = d.createRenderPipeline(descriptor: commandPipeline(m: m, kind: 3, layout: Layout::Explicit(layout: give layout)));
        RenderPass pass = encoder.beginRenderPass(descriptor: passOf(attachment: ColorAttachment.clearing(view: wholeView(t: color), color: nothing())));
        pass.setPipeline(pipeline: p);
        pass.setBindGroup(index: 0, group: g0);
        pass.setBindGroup(index: 1, group: g1);
        pass.draw(vertexCount: 3, instanceCount: 1, firstVertex: 0, firstInstance: 0);
        give pass.end();
    } else if (kind == 24) {
        // a dynamic uniform: red at byte 0 and blue at byte 256, read at a dynamic offset of 256
        BindGroupLayout dynamic = uniformLayout(d: d, dynamic: true);
        PipelineLayoutDescriptor pl = PipelineLayoutDescriptor.make();
        pl.group(layout: copy dynamic);
        PipelineLayout layout = d.createPipelineLayout(descriptor: give pl);
        DynamicArray<float32> both = DynamicArray.empty();
        addPair(v: both, a: 1.0, b: 0.0);
        addPair(v: both, a: 0.0, b: 1.0);
        while (both.length() < 64) { both.add(item: 0.0); }
        addPair(v: both, a: 0.0, b: 0.0);
        addPair(v: both, a: 1.0, b: 1.0);
        while (both.length() < 128) { both.add(item: 0.0); }
        Buffer u = holding(d: d, q: q, usage: BufferUsage::Uniform, bytes: floatBytes(values: both));
        BindGroup g = uniformGroup(d: d, layout: dynamic, buffer: u, size: 16);
        RenderPipeline p = d.createRenderPipeline(descriptor: commandPipeline(m: m, kind: 2, layout: Layout::Explicit(layout: give layout)));
        DynamicArray<uint32> offsets = DynamicArray.empty();
        offsets.add(item: 256);
        RenderPass pass = encoder.beginRenderPass(descriptor: passOf(attachment: ColorAttachment.clearing(view: wholeView(t: color), color: nothing())));
        pass.setPipeline(pipeline: p);
        pass.setBindGroupWithOffsets(index: 0, group: g, offsets: offsets.view());
        pass.draw(vertexCount: 3, instanceCount: 1, firstVertex: 0, firstInstance: 0);
        give pass.end();
    } else if (kind == 25) {
        // white times the blend constant
        RenderPipeline p = d.createRenderPipeline(descriptor: commandPipeline(m: m, kind: 4, layout: Layout::Auto));
        RenderPass pass = encoder.beginRenderPass(descriptor: passOf(attachment: ColorAttachment.clearing(view: wholeView(t: color), color: nothing())));
        pass.setPipeline(pipeline: p);
        pass.setBlendConstant(color: fifths());
        pass.draw(vertexCount: 3, instanceCount: 1, firstVertex: 0, firstInstance: 0);
        give pass.end();
    } else if (kind == 26 || kind == 28) {
        // the covering triangle through a viewport, or a scissor, of the bottom-right quarter
        RenderPipeline p = d.createRenderPipeline(descriptor: commandPipeline(m: m, kind: 5, layout: Layout::Auto));
        RenderPass pass = encoder.beginRenderPass(descriptor: passOf(attachment: ColorAttachment.clearing(view: wholeView(t: color), color: nothing())));
        pass.setPipeline(pipeline: p);
        if (kind == 26) { pass.setViewport(x: 2.0, y: 2.0, width: 2.0, height: 2.0, minDepth: 0.0, maxDepth: 1.0); }
        else { pass.setScissorRect(x: 2, y: 2, width: 2, height: 2); }
        pass.draw(vertexCount: 3, instanceCount: 1, firstVertex: 0, firstInstance: 0);
        give pass.end();
    } else if (kind == 27) {
        // depth cleared to 0.5; a viewport depth range from 0.6 to 1 puts the triangle's 0.25 at 0.7, behind it
        Texture depth = depthTarget(d: d, format: TextureFormat::Depth32Float);
        RenderPipeline tested = d.createRenderPipeline(descriptor: passPipeline(m: m, kind: 1));
        RenderPass pass = encoder.beginRenderPass(descriptor: withDepth(color: color, depth: DepthStencilAttachment.clearingDepth(view: wholeView(t: depth), value: 0.5)));
        pass.setPipeline(pipeline: tested);
        pass.setViewport(x: 0.0, y: 0.0, width: 4.0, height: 4.0, minDepth: 0.6, maxDepth: 1.0);
        pass.draw(vertexCount: 3, instanceCount: 1, firstVertex: 0, firstInstance: 0);
        give pass.end();
    } else {
        // stencil cleared to 1, an equal test against a reference of 1
        Texture stencil = depthTarget(d: d, format: TextureFormat::Stencil8);
        RenderPipeline equal = d.createRenderPipeline(descriptor: passPipeline(m: m, kind: 4));
        DepthStencilAttachment cleared = DepthStencilAttachment.make(view: wholeView(t: stencil));
        cleared.stencil(access: StencilAccess::ReadWrite(load: StencilLoad::Clear(value: 1), store: StoreOp::Store));
        RenderPass pass = encoder.beginRenderPass(descriptor: withDepth(color: color, depth: give cleared));
        pass.setPipeline(pipeline: equal);
        pass.setStencilReference(reference: 1);
        pass.draw(vertexCount: 3, instanceCount: 1, firstVertex: 0, firstInstance: 0);
        give pass.end();
    }
}

// Whether this leg refuses a draw count of 2^31 or more: the web, where emdawnwebgpu hands a browser such a count
// negative and the browser throws.
@compileFor(ARCH_WASM32)
fn bool hugeCountsRefused() { return true; }
@compileFor(!ARCH_WASM32)
fn bool hugeCountsRefused() { return false; }

// The commands the package refuses, by kind: 0 a NaN red blend constant; 1 an infinite blue one; 2 a NaN viewport x;
// 3 an infinite viewport maxDepth; 4 a draw of 2^31 vertices; 5 an indexed draw of 2^31 instances (with no pipeline).
unsafe fn void refusedCommand(ref RenderPass pass, int32 kind) {
    if (kind == 0) { pass.setBlendConstant(color: Color.of(r: notANumber(), g: 0.0, b: 0.0, a: 1.0)); }
    else if (kind == 1) { pass.setBlendConstant(color: Color.of(r: 0.0, g: 0.0, b: infinity(sign: 1.0), a: 1.0)); }
    else if (kind == 2) { pass.setViewport(x: notANumber32(), y: 0.0, width: 4.0, height: 4.0, minDepth: 0.0, maxDepth: 1.0); }
    else if (kind == 3) { pass.setViewport(x: 0.0, y: 0.0, width: 4.0, height: 4.0, minDepth: 0.0, maxDepth: infinity32(sign: 1.0)); }
    else if (kind == 4) { pass.draw(vertexCount: 0x80000000, instanceCount: 1, firstVertex: 0, firstInstance: 0); }
    else { pass.drawIndexed(indexCount: 3, instanceCount: 0x80000000, firstIndex: 0, baseVertex: 0, firstInstance: 0); }
}

// The commands WebGPU refuses, by kind: 0 a vertex slot of 2^31 (one of 2^32 - 1 is clamped to the same slot, and Firefox
// 160 delivers no second error whose words repeat an earlier one's, so the scissor's 2^32 - 1 holds that clamp); 2 a
// vertex offset of 2^60 and 3 a size of 2^60; 4 an index offset of 2^60; 5 a group index of 2^31; 6 a scissor x of 2^31 and 7 a scissor 2^32 - 1
// wide and high (each clamped, where a browser would throw); 8 a vertex slot past maxVertexBuffers; 9 two dynamic
// offsets for one dynamic buffer; 10 a viewport's depth range reversed; 11 an indexed draw with no index buffer; 12 an
// index buffer bound for 2 bytes under a draw of 3 indices.
unsafe fn void misusedCommand(ref Device d, ref ShaderModule m, ref RenderPass pass, int32 kind) {
    Buffer vb = d.createBuffer(descriptor: BufferDescriptor.make(size: 64, usage: BufferUsage::Vertex | BufferUsage::Index));
    uint64 far = 0x1000000000000000;
    if (kind == 0) { pass.setVertexBuffer(slot: 0x80000000, binding: BufferBinding.whole(buffer: copy vb)); }
    else if (kind == 2) { pass.setVertexBuffer(slot: 0, binding: BufferBinding.rest(buffer: copy vb, offset: far)); }
    else if (kind == 3) { pass.setVertexBuffer(slot: 0, binding: BufferBinding.range(buffer: copy vb, offset: 0, size: far)); }
    else if (kind == 4) { pass.setIndexBuffer(binding: BufferBinding.rest(buffer: copy vb, offset: far), format: IndexFormat::Uint16); }
    else if (kind == 5 || kind == 9) {
        BindGroupLayout dynamic = uniformLayout(d: d, dynamic: true);
        Buffer u = d.createBuffer(descriptor: BufferDescriptor.make(size: 512, usage: BufferUsage::Uniform));
        BindGroup g = uniformGroup(d: d, layout: dynamic, buffer: u, size: 16);
        DynamicArray<uint32> offsets = DynamicArray.empty();
        offsets.add(item: 0);
        if (kind == 9) { offsets.add(item: 256); }
        uint32 index = kind == 5 ? 0x80000000 : 0;
        pass.setBindGroupWithOffsets(index: index, group: g, offsets: offsets.view());
    }
    else if (kind == 6) { pass.setScissorRect(x: 0x80000000, y: 0, width: 1, height: 1); }
    else if (kind == 7) { pass.setScissorRect(x: 0, y: 0, width: 0xFFFFFFFF, height: 0xFFFFFFFF); }
    else if (kind == 8) { pass.setVertexBuffer(slot: 8, binding: BufferBinding.whole(buffer: copy vb)); }
    else if (kind == 10) { pass.setViewport(x: 0.0, y: 0.0, width: 4.0, height: 4.0, minDepth: 0.8, maxDepth: 0.2); }
    else {
        RenderPipeline p = d.createRenderPipeline(descriptor: commandPipeline(m: m, kind: 5, layout: Layout::Auto));
        pass.setPipeline(pipeline: p);
        if (kind == 12) { pass.setIndexBuffer(binding: BufferBinding.range(buffer: copy vb, offset: 0, size: 2), format: IndexFormat::Uint16); }
        pass.drawIndexed(indexCount: 3, instanceCount: 1, firstIndex: 0, baseVertex: 0, firstInstance: 0);
    }
}

// The four bytes of the RGBA8Unorm texel at (`x`, `y`) of a mapped copy.
unsafe fn DynamicArray<uint8> texelAt(const ref BufferRead r, uint32 x, uint32 y) {
    DynamicArray<uint8> all = r.bytes();
    DynamicArray<uint8> four = DynamicArray.empty();
    isize at = cast<isize>(y) * cast<isize>(ROW) + cast<isize>(x) * 4;
    isize i = 0;
    while (i < 4 && at + i < all.length()) { four.add(item: all[at + i]); i = i + 1; }
    return four;
}

// The red, green, blue and alpha bytes of one RGBA8Unorm texel.
fn DynamicArray<uint8> pixel(uint8 r, uint8 g, uint8 b, uint8 a) {
    DynamicArray<uint8> p = DynamicArray.empty();
    p.add(item: r);
    p.add(item: g);
    p.add(item: b);
    p.add(item: a);
    return p;
}

// The first texel's four bytes of a mapped copy.
unsafe fn DynamicArray<uint8> firstTexel(const ref BufferRead r) {
    DynamicArray<uint8> all = r.bytes();
    DynamicArray<uint8> four = DynamicArray.empty();
    isize i = 0;
    while (i < 4 && i < all.length()) { four.add(item: all[i]); i = i + 1; }
    return four;
}

fn string sameBytes(const ref DynamicArray<uint8> got, const ref DynamicArray<uint8> want) {
    if (got.length() != want.length()) {
        isize g = got.length();
        isize w = want.length();
        return "${g} bytes, not ${w}";
    }
    isize i = 0;
    while (i < got.length()) {
        if (got[i] != want[i]) {
            uint8 a = got[i];
            uint8 b = want[i];
            return "byte ${i} is ${a}, not ${b}";
        }
        i = i + 1;
    }
    return "";
}

// The channel's reports, for a failure's words.
fn string described(const ref DeviceErrors errs) {
    isize n = errs.reports().length();
    if (n == 0) { return "nothing"; }
    string first = errs.reports()[0].message();
    return "${n} report(s), the first: ${first}";
}

// "" when `errs` holds one validation error whose words name `label`, and say `says` when it is not "".
fn string oneNaming(const ref DeviceErrors errs, const ref string label, const ref string says) {
    if (errs.reports().length() != 1) { return "want one error; " + described(errs: errs); }
    bool validation = match (errs.reports()[0].kind()) { case Validation: true; case _: false; };
    string words = errs.reports()[0].message();
    if (!validation) { return "not a validation error: ${words}"; }
    if (!words.contains(substring: label)) { return "its words do not name `${label}`: ${words}"; }
    if (!says.isEmpty() && !words.contains(substring: says)) { return "its words do not say `${says}`: ${words}"; }
    return "";
}
