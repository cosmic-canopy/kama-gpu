// What the tests reach past the safe API for, through externs of their own, as any program may: `adopt` takes over a
// reference, so adopting a device the package also holds needs an `AddRef` first, and the seam counts its live device
// state blocks, so a test can see one outlive its device and be freed with its last handle. @kama/window's seam counts
// its live window records the same way, so a test can see a surface hold its window. Adopting a surface the package
// also holds needs an `AddRef` the same way.

export { addDeviceRef, addSurfaceRef, statesAlive, windowRecords, minimise, heapInUse };

extern "gpuseam.h";
extern "winseam.h";
extern fn int32 winseam_live_records();
extern "gputests.h";
extern fn int32 gputests_minimise(UnsafePtr hwnd, int32 minimised);
extern fn int64 gputests_heap_in_use();

extern fn void wgpuDeviceAddRef(UnsafePtr device);
extern fn void wgpuSurfaceAddRef(UnsafePtr surface);
extern fn int64 gpuseam_states_alive();

unsafe fn void addDeviceRef(UnsafePtr device) { wgpuDeviceAddRef(device: device); }
unsafe fn void addSurfaceRef(UnsafePtr surface) { wgpuSurfaceAddRef(surface: surface); }
unsafe fn int64 statesAlive() { return gpuseam_states_alive(); }
unsafe fn int32 windowRecords() { return winseam_live_records(); }
// Minimises the system window `hwnd` (1) or restores it (0) without activating it, so a test never takes the focus: 1
// when done, -1 where the question is not asked of the system (off Windows, and on the web).
unsafe fn int32 minimise(UnsafePtr hwnd, int32 minimised) { return gputests_minimise(hwnd: hwnd, minimised: minimised); }
// The bytes the C heap holds in use on the web (-1 natively).
unsafe fn int64 heapInUse() { return gputests_heap_in_use(); }
