// The cases of GPU-4's second part (AGENTS.gpu.md item 12, decisions 6 to 9), a step a tick on every leg: samplers,
// bind group layouts, pipeline layouts and bind groups, and what WebGPU refuses of each; and that nothing a program
// passes ends it (decision 9). Every misuse is one
// validation error in the device's channel naming its label, where on the web the browser's own error arrives a tick
// after the device's queue is next used.
//
// They report through `Verdicts`, which the check reads each tick, as the shader cases do.

import {
    core::println,
    std::memory::replace,
    gpu::Instance, gpu::AdapterOptions, gpu::AdapterRequest, gpu::AdapterStatus, gpu::PowerPreference,
    gpu::Device, gpu::Queue, gpu::DeviceRequest, gpu::DeviceStatus, gpu::DeviceOptions, gpu::GpuError,
    gpu::DeviceErrors, gpu::GpuErrorKind, gpu::CommandEncoder, gpu::CommandBuffer,
    gpu::Sampler, gpu::SamplerDescriptor, gpu::AddressMode, gpu::FilterMode, gpu::MipmapFilterMode, gpu::CompareFunction,
    gpu::Buffer, gpu::BufferDescriptor, gpu::BufferUsage, gpu::Texture, gpu::TextureDescriptor, gpu::TextureDimension, gpu::TextureView, gpu::TextureFormat,
    gpu::TextureUsage, gpu::ShaderStage, gpu::Feature,
    gpu::BindGroupLayout, gpu::BindGroupLayoutDescriptor, gpu::BindingLayout, gpu::BufferBindingLayout,
    gpu::BufferBindingType, gpu::SamplerBindingLayout, gpu::SamplerBindingType, gpu::TextureBindingLayout,
    gpu::StorageTextureBindingLayout, gpu::PipelineLayout, gpu::PipelineLayoutDescriptor, gpu::BindGroup,
    gpu::BindGroupDescriptor, gpu::BindingResource, gpu::BufferBinding, gpu::BufferRead, gpu::ReadStatus,
    std::collections::DynamicArray,
    Verdicts, readOptions,
};
export { BindingRun };

comptime int32 SETTLE = 60;   // the most ticks a case waits for an error the browser owes
comptime int32 QUIET = 10;    // the ticks a case waits to see that no error comes

// NaN and the infinities, made at run time: kama refuses a constant division by zero.
fn float32 divided(float32 by) {
    float32 one = 1.0;
    return one / by;
}
// What a refusal's substitute texture answers: 0 wide, 2D, in RGBA8Unorm; or why not.
unsafe fn string attributesOfSubstitute(const ref Texture t) {
    uint32 w = t.width();
    if (w != 0) { return "it is ${w} wide"; }
    if (t.dimension() != TextureDimension::D2) { return "it is not 2D"; }
    Optional<TextureFormat> f = t.format();
    return match (f) {
        case Some(value: got): got == TextureFormat::RGBA8Unorm ? "" : "its format is " + got.name();
        case None: "its format is none webgpu.h names";
    };
}

fn float32 notANumber() {
    float32 zero = 0.0;
    return zero / zero;
}

// One texture made from `descriptor` on `d`, held in `held`, and its attributes held to what was described.
unsafe fn void madeAsDescribed(ref Device d, TextureDescriptor descriptor, string label, uint32 width, uint32 height, uint32 layers,
                         TextureDimension dimension, uint32 mips, uint32 samples, TextureFormat format, TextureUsage usage,
                         ref DynamicArray<Texture> held, ref Verdicts found) {
    descriptor.label(text: copy label);
    Texture t = d.createTexture(descriptor: give descriptor);
    string why = "";
    uint32 w = t.width();
    uint32 h = t.height();
    uint32 l = t.depthOrArrayLayers();
    uint32 m = t.mipLevelCount();
    uint32 s = t.sampleCount();
    if (w != width || h != height || l != layers) { why = "its size reads ${w}x${h}x${l}, not ${width}x${height}x${layers}"; }
    else if (t.dimension() != dimension) { why = "its dimension is not the one described"; }
    else if (m != mips) { why = "it has ${m} mip levels, not ${mips}"; }
    else if (s != samples) { why = "it has ${s} samples, not ${samples}"; }
    else if (t.usage() != usage) { why = "its usage is not the one described"; }
    else {
        Optional<TextureFormat> f = t.format();
        why = match (f) {
            case Some(value: got): got == format ? "" : "its format is " + got.name() + ", not " + format.name();
            case None: "its format is none webgpu.h names";
        };
    }
    string name = format.name();
    found.add(name: "a texture's description reaches the backend: its attributes read back as described ('" + label + "', " + name + " ${width}x${height}x${layers})", why: give why);
    held.add(item: give t);
}

type resource BindingRun {
    int32 stage = 0;
    int32 waited = 0;
    bool optional;   // `--adapter-optional`: no adapter here is a skip
    Verdicts found;
    Optional<Instance> instance = Optional::None;
    Optional<AdapterRequest> adapterRequest = Optional::None;
    Optional<DeviceRequest> deviceRequest = Optional::None;
    Optional<Device> device = Optional::None;
    Optional<Queue> queue = Optional::None;
    Optional<Sampler> refused = Optional::None;   // a sampler refused for a NaN clamp, for a bind group
    Optional<Buffer> written = Optional::None;    // the buffer the write cases write and map
    Optional<BufferRead> reading = Optional::None;
    bool givenBC = false;   // the device was given TextureCompressionBC, which its adapter offered
    Optional<BindGroupLayout> refusedLayout = Optional::None;   // a layout refused for its storage format
    Optional<Texture> refusedTexture = Optional::None;   // a texture refused for its format, for a view
    DynamicArray<Texture> heldTextures = DynamicArray.empty();   // the textures WebGPU takes, until the channel is seen empty

    public ctor make(bool adapterOptional) {
        this.optional = adapterOptional;
        this.found = Verdicts.make();
    }

    public fn ref Verdicts verdicts() { return this.found; }

    // One tick's step: true once every case has run.
    public unsafe fn bool step() {
        this.waited = this.waited + 1;
        if (this.stage == 0) { this.open(); }
        else if (this.stage == 1) { this.awaitAdapter(); }
        else if (this.stage == 2) { this.awaitDevice(); }
        else if (this.stage == 10) { this.goodSamplers(); }
        else if (this.stage == 11) { this.awaitNone(name: "samplers WebGPU takes are made with no error: its defaults, trilinear with anisotropy 16, a comparison, and a +inf max clamp", next: 20); }
        else if (this.stage == 20) { this.anisotropicNearest(); }
        else if (this.stage == 21) { this.awaitOne(name: "a sampler with anisotropy and a nearest filter is a validation error naming its label", label: "aniso nearest", says: "", next: 30); }
        else if (this.stage == 30) { this.lodBackwards(); }
        else if (this.stage == 31) { this.awaitOne(name: "a sampler whose min clamp is above its max is a validation error naming its label", label: "lod backwards", says: "", next: 40); }
        else if (this.stage == 40) { this.lodNan(); }
        else if (this.stage == 41) { this.awaitOne(name: "a NaN LOD clamp is a validation error in the package's words, not the end of the program", label: "nan clamp", says: "not a finite number", next: 50); }
        else if (this.stage == 50) { this.lodMinusInfinity(); }
        else if (this.stage == 51) { this.awaitOne(name: "a -inf LOD clamp is a validation error in the package's words, not the end of the program", label: "minus infinity", says: "not a finite number", next: 60); }
        else if (this.stage == 60) { this.goodLayouts(); }
        else if (this.stage == 61) { this.awaitNone(name: "layouts WebGPU takes are made with no error: a uniform, a sampler, a texture and a storage texture, and a pipeline layout of them", next: 70); }
        else if (this.stage == 70) { this.duplicated(); }
        else if (this.stage == 71) { this.awaitOne(name: "a layout binding one number twice is a validation error naming its label", label: "duplicated", says: "", next: 80); }
        else if (this.stage == 80) { this.goodGroups(); }
        else if (this.stage == 81) { this.awaitNone(name: "bind groups that follow their layouts are made with no error: a buffer whole and in a range, a sampler and a texture", next: 90); }
        else if (this.stage == 90) { this.group(label: "missing", kind: 1); }
        else if (this.stage == 91) { this.awaitOne(name: "a bind group missing a binding is a validation error naming its label", label: "missing", says: "", next: 100); }
        else if (this.stage == 100) { this.group(label: "wrong kind", kind: 2); }
        else if (this.stage == 101) { this.awaitOne(name: "a bind group with a sampler where its layout has a buffer is a validation error naming its label", label: "wrong kind", says: "", next: 110); }
        else if (this.stage == 110) { this.group(label: "empty range", kind: 3); }
        else if (this.stage == 111) { this.awaitOne(name: "a bind group binding 0 bytes of a buffer is a validation error in the package's words, not the end of the program", label: "empty range", says: "binds 0 bytes", next: 120); }
        else if (this.stage == 120) { this.group(label: "far offset", kind: 4); }
        else if (this.stage == 121) { this.awaitOne(name: "a bind group binding at an offset of 2^60 is a validation error naming its label, not the end of the program", label: "far offset", says: "", next: 130); }
        else if (this.stage == 130) { this.group(label: "under a huge minimum", kind: 5); }
        else if (this.stage == 131) { this.awaitOne(name: "a layout's minBindingSize of 2^60 is taken, and a group under it is a validation error naming its label, not the end of the program", label: "under a huge minimum", says: "", next: 140); }
        else if (this.stage == 140) { this.refusedSampler(); }
        else if (this.stage == 141) { this.awaitOne(name: "a refused sampler's error is its own", label: "refused", says: "not a finite number", next: 142); }
        else if (this.stage == 142) { this.group(label: "with a refused sampler", kind: 6); }
        else if (this.stage == 143) { this.awaitOne(name: "the sampler a refusal hands back is invalid: a bind group of it is a validation error naming its label", label: "with a refused sampler", says: "", next: 150); }
        else if (this.stage == 150) { this.fiveGroups(); }
        else if (this.stage == 151) { this.awaitOne(name: "a pipeline layout past maxBindGroups is a validation error naming its label", label: "five groups", says: "", next: 160); }
        else if (this.stage == 160) { this.group(label: "far size", kind: 7); }
        else if (this.stage == 161) { this.awaitOne(name: "a bind group binding 2^60 bytes is a validation error naming its label, not the end of the program", label: "far size", says: "", next: 170); }
        else if (this.stage == 170) { this.vertexStorage(); }
        else if (this.stage == 171) { this.awaitOne(name: "a layout with a writable storage buffer seen by the vertex stage is a validation error naming its label", label: "vertex storage", says: "", next: 180); }
        else if (this.stage == 180) { this.notComparing(); }
        else if (this.stage == 181) { this.awaitOne(name: "a bind group with a plain sampler where its layout wants a comparison one is a validation error naming its label", label: "not comparing", says: "", next: 190); }
        else if (this.stage == 190) { this.write(bytes: counted(n: 16, first: 1), offset: 0, flushed: false, next: 191); }
        else if (this.stage == 191) { this.awaitRead(name: "a write is seen by a map made after it, with no submit between, on every leg", want: counted(n: 16, first: 1), next: 200); }
        else if (this.stage == 200) { this.write(bytes: counted(n: 4, first: 99), offset: 4, flushed: false, next: 201); }
        else if (this.stage == 201) { this.awaitRead(name: "and a second write, at an offset, is seen by the next map", want: secondWrite(), next: 210); }
        else if (this.stage == 210) { this.write(bytes: counted(n: 6, first: 7), offset: 0, flushed: true, next: 211); }
        else if (this.stage == 211) { this.awaitOne(name: "a write of 6 bytes, not a multiple of 4, is a validation error in the package's words, not the end of the program", label: "writeBuffer", says: "not a multiple of 4", next: 212); }
        else if (this.stage == 212) { this.awaitRead(name: "and it writes nothing", want: secondWrite(), next: 220); }
        else if (this.stage == 220) { this.write(bytes: counted(n: 4, first: 5), offset: 1152921504606846976, flushed: true, next: 221); }
        else if (this.stage == 221) { this.awaitOne(name: "a write at an offset of 2^60 is a validation error, not the end of the program", label: "", says: "", next: 230); }
        else if (this.stage == 230) { this.writeUnwritable(); }
        else if (this.stage == 231) { this.awaitOne(name: "a write into a buffer without CopyDst is a validation error naming its label", label: "uniform only", says: "", next: 250); }
        else if (this.stage == 240) { this.write(bytes: counted(n: 16, first: 50), offset: 0, flushed: false, next: 241); }
        else if (this.stage == 241) { this.queue = Optional::None; this.next(to: 242); }
        else if (this.stage == 242) { this.awaitRead(name: "a map made after the queue's last copy is gone still sees the write made through it", want: counted(n: 16, first: 50), next: 999); }
        else if (this.stage == 250) { this.givenFormat(); }
        else if (this.stage == 251) { this.awaitNone(name: "a BC texture is taken on a device given TextureCompressionBC", next: 260); }
        else if (this.stage == 260) { this.gatedTexture(format: TextureFormat::ETC2RGB8Unorm, usage: TextureUsage::TextureBinding, next: 261); }
        else if (this.stage == 261) { this.awaitOne(name: "an ETC2 texture on a device without TextureCompressionETC2 is a validation error in the package's words, not the end of the program", label: "ETC2RGB8Unorm", says: "TextureCompressionETC2", next: 265); }
        else if (this.stage == 265) { this.refusedOwnFormat(); }
        else if (this.stage == 262) { this.viewOfRefused(); }
        else if (this.stage == 263) { this.awaitOne(name: "the texture a refusal hands back is invalid: a view of it is a validation error", label: "", says: "", next: 270); }
        else if (this.stage == 270) { this.gatedTexture(format: TextureFormat::ASTC4x4Unorm, usage: TextureUsage::TextureBinding, next: 271); }
        else if (this.stage == 271) { this.awaitOne(name: "an ASTC texture on a device without TextureCompressionASTC is a validation error in the package's words, not the end of the program", label: "ASTC4x4Unorm", says: "TextureCompressionASTC", next: 280); }
        else if (this.stage == 280) { this.gatedTexture(format: TextureFormat::Depth32FloatStencil8, usage: TextureUsage::RenderAttachment, next: 281); }
        else if (this.stage == 281) { this.awaitOne(name: "a Depth32FloatStencil8 texture on a device without its feature is a validation error in the package's words, not the end of the program", label: "Depth32FloatStencil8", says: "needs the feature Depth32FloatStencil8", next: 290); }
        else if (this.stage == 290) { this.gatedTexture(format: TextureFormat::RGBA16Snorm, usage: TextureUsage::TextureBinding, next: 291); }
        else if (this.stage == 291) { this.awaitOne(name: "a 16-bit norm texture on a device without TextureFormatsTier1 is a validation error in the package's words, not the end of the program", label: "RGBA16Snorm", says: "TextureFormatsTier1", next: 300); }
        else if (this.stage == 300) { this.gatedStorage(); }
        else if (this.stage == 301) { this.awaitOne(name: "a storage texture layout in a format whose feature the device lacks is a validation error in the package's words, not the end of the program", label: "sixteen-bit storage", says: "TextureFormatsTier1", next: 302); }
        else if (this.stage == 302) { this.ofRefusedLayout(); }
        else if (this.stage == 303) { this.awaitOne(name: "the layout a refusal hands back is invalid: a pipeline layout of it is a validation error naming its label", label: "of a refused layout", says: "", next: 310); }
        // textures by description (decision 5), before the queue is dropped at 241
        else if (this.stage == 310) { this.goodTextures(); }
        else if (this.stage == 311) { this.awaitNone(name: "textures WebGPU takes are made from their descriptions with no error: 2D, mipped, multisampled, 3D, 1D, layered, depth, and with an sRGB view format", next: 320); }
        else if (this.stage == 320) { this.badTexture(kind: 1, label: "empty"); }
        else if (this.stage == 321) { this.awaitOne(name: "a texture 0 wide is a validation error naming its label", label: "empty", says: "", next: 330); }
        else if (this.stage == 330) { this.badTexture(kind: 2, label: "too many mips"); }
        else if (this.stage == 331) { this.awaitOne(name: "a texture with more mip levels than its size has is a validation error naming its label", label: "too many mips", says: "", next: 340); }
        else if (this.stage == 340) { this.badTexture(kind: 3, label: "multisampled mips"); }
        else if (this.stage == 341) { this.awaitOne(name: "a multisampled texture with mip levels is a validation error naming its label", label: "multisampled mips", says: "", next: 350); }
        else if (this.stage == 350) { this.badTexture(kind: 4, label: "depth volume"); }
        else if (this.stage == 351) { this.awaitOne(name: "a 3D depth texture is a validation error naming its label", label: "depth volume", says: "", next: 360); }
        else if (this.stage == 360) { this.badTexture(kind: 5, label: "incompatible view"); }
        else if (this.stage == 361) { this.awaitOne(name: "a view format that is not the texture's sRGB or linear twin is a validation error naming its label", label: "incompatible view", says: "", next: 370); }
        else if (this.stage == 370) { this.badTexture(kind: 6, label: "gated view"); }
        else if (this.stage == 371) { this.awaitOne(name: "a view format whose feature the device lacks is a validation error in the package's words, not the end of the program", label: "gated view", says: "a view format of the texture 'gated view' uses the texture format ETC2RGB8Unorm", next: 372); }
        else if (this.stage == 372) { this.refusedAttributes(); }
        else if (this.stage == 380) { this.bcVolume(); }
        else if (this.stage == 381) { this.awaitOne(name: "a 3D BC texture on a device without TextureCompressionBCSliced3D is a validation error naming its label", label: "bc volume", says: "", next: 240); }
        return this.stage >= 999;
    }

    unsafe fn void next(int32 to) { this.stage = to; this.waited = 0; }

    unsafe fn void open() {
        Result<Instance, GpuError> made = Instance.make();
        match (give made) {
            case Ok(value: inst): {
                this.adapterRequest = Optional::Some(value: inst.requestAdapter(options: AdapterOptions.make(power: PowerPreference::Default)));
                this.instance = Optional::Some(value: give inst);
                this.next(to: 1);
            }
            case Err(error: e): { string why = e.message(); this.found.add(name: "an instance for the binding cases", why: give why); this.next(to: 999); }
        };
    }

    unsafe fn void awaitAdapter() {
        if (this.adapterRequest.isNone()) { this.next(to: 999); return; }
        AdapterStatus s = match (this.adapterRequest) {
            case Some(value: r): r.poll();
            case None: AdapterStatus::Failed(error: GpuError::Taken);
        };
        bool pending = match (s) { case Pending: true; case _: false; };
        if (!pending) { this.adapterRequest = Optional::None; }
        match (give s) {
            case Pending: { }
            case Ready(adapter: a): {
                // TextureCompressionBC when the adapter offers it, for a BC texture taken; every other feature is left out,
                // so the formats that need one are refused
                DeviceOptions options = readOptions();
                this.givenBC = a.features().has(feature: Feature::TextureCompressionBC);
                if (this.givenBC) { options.features = options.features.with(feature: Feature::TextureCompressionBC); }
                this.deviceRequest = Optional::Some(value: a.requestDevice(options: options));
                this.next(to: 2);
            }
            case Failed(error: e): {
                bool none = match (e) { case NoAdapter(words: w): true; case _: false; };
                if (none && this.optional) {
                    println(s: "skip the binding cases: there is no WebGPU adapter here (--adapter-optional)");
                } else {
                    string why = e.message();
                    this.found.add(name: "an adapter for the binding cases", why: give why);
                }
                this.next(to: 999);
            }
        };
    }

    unsafe fn void awaitDevice() {
        if (this.deviceRequest.isNone()) { this.next(to: 999); return; }
        DeviceStatus s = match (this.deviceRequest) {
            case Some(value: r): r.poll();
            case None: DeviceStatus::Failed(error: GpuError::Taken);
        };
        bool pending = match (s) { case Pending: true; case _: false; };
        if (!pending) { this.deviceRequest = Optional::None; }
        match (give s) {
            case Pending: { }
            case Ready(device: d, queue: q): {
                this.device = Optional::Some(value: give d);
                this.queue = Optional::Some(value: give q);
                this.next(to: 10);
            }
            case Failed(error: e): { string why = e.message(); this.found.add(name: "a device for the binding cases", why: give why); this.next(to: 999); }
        };
    }

    // An empty command buffer submitted: on the web, what lets a pending error through to the channel.
    unsafe fn void flush() {
        match (this.device) {
            case Some(value: d): {
                match (this.queue) {
                    case Some(value: q): { CommandEncoder enc = d.createCommandEncoder(); CommandBuffer cb = give enc.finish(); q.submit(commands: give cb); }
                    case None: { this.found.add(name: "a binding case flushes through the run's queue", why: "the queue is gone, so on the web the case's error would wait for nothing (stage ${this.stage})"); }
                };
            }
            case None: { }
        };
    }

    unsafe fn Optional<DeviceErrors> drain() {
        match (this.device) {
            case Some(value: d): { return Optional::Some(value: d.takeErrors()); }
            case None: { return Optional::None; }
        };
    }

    // Once QUIET ticks have passed, the channel holds nothing.
    unsafe fn void awaitNone(const ref string name, int32 next) {
        if (this.waited < QUIET) { return; }
        Optional<DeviceErrors> got = this.drain();
        string why = match (got) {
            case Some(value: errs): errs.isEmpty() ? "" : "the channel holds " + described(errs: errs);
            case None: "no device";
        };
        this.found.add(name: copy name, why: give why);
        this.next(to: next);
    }

    // Once an error arrives, or SETTLE ticks pass: one validation error, its words naming `label` (and saying `says`).
    unsafe fn void awaitOne(const ref string name, const ref string label, const ref string says, int32 next) {
        Optional<DeviceErrors> got = this.drain();
        bool none = match (got) { case Some(value: errs): errs.isEmpty(); case None: true; };
        if (none && this.waited < SETTLE) { return; }
        string why = match (got) {
            case Some(value: errs): oneNaming(errs: errs, label: label, says: says);
            case None: "no device";
        };
        this.found.add(name: copy name, why: give why);
        this.next(to: next);
    }

    // Layouts WebGPU takes, and a pipeline layout of two of them: no error.
    unsafe fn void goodLayouts() {
        match (this.device) {
            case Some(value: d): {
                BindGroupLayout first = uniformAndSampler(d: d, minimum: 16);
                BindGroupLayoutDescriptor l = BindGroupLayoutDescriptor.make();
                l.entry(binding: 0, visibility: ShaderStage::Fragment, layout: BindingLayout::Texture(layout: TextureBindingLayout.make()));
                BufferBindingLayout rows = BufferBindingLayout.make();
                rows.kind = BufferBindingType::ReadOnlyStorage;
                l.entry(binding: 1, visibility: ShaderStage::Vertex, layout: BindingLayout::Buffer(layout: rows));
                l.entry(binding: 2, visibility: ShaderStage::Fragment,
                        layout: BindingLayout::StorageTexture(layout: StorageTextureBindingLayout.make(format: TextureFormat::RGBA8Unorm)));
                SamplerBindingLayout comparing = SamplerBindingLayout.make();
                comparing.kind = SamplerBindingType::Comparison;
                l.entry(binding: 3, visibility: ShaderStage::Fragment, layout: BindingLayout::Sampler(layout: comparing));
                l.label(text: "texture, rows, storage and comparison");
                BindGroupLayout second = d.createBindGroupLayout(descriptor: give l);
                PipelineLayoutDescriptor p = PipelineLayoutDescriptor.make();
                p.group(layout: copy first);
                p.group(layout: copy second);
                p.label(text: "two groups");
                PipelineLayout made = d.createPipelineLayout(descriptor: give p);
                PipelineLayout kept = copy made;
            }
            case None: { }
        };
        this.flush();
        this.next(to: 61);
    }

    unsafe fn void duplicated() {
        match (this.device) {
            case Some(value: d): {
                BindGroupLayoutDescriptor l = BindGroupLayoutDescriptor.make();
                l.entry(binding: 0, visibility: ShaderStage::Fragment, layout: BindingLayout::Buffer(layout: BufferBindingLayout.make()));
                l.entry(binding: 0, visibility: ShaderStage::Fragment, layout: BindingLayout::Buffer(layout: BufferBindingLayout.make()));
                l.label(text: "duplicated");
                BindGroupLayout made = d.createBindGroupLayout(descriptor: give l);
            }
            case None: { }
        };
        this.flush();
        this.next(to: 71);
    }

    // Bind groups WebGPU takes: a buffer whole and a range of one, a sampler, and a texture's view; no error.
    unsafe fn void goodGroups() {
        match (this.device) {
            case Some(value: d): {
                BindGroupLayout layout = uniformAndSampler(d: d, minimum: 16);
                Buffer ubo = uniforms(d: d);
                BindGroupDescriptor whole = BindGroupDescriptor.make(layout: copy layout);
                whole.entry(binding: 0, resource: BindingResource::Buffer(binding: BufferBinding.whole(buffer: copy ubo)));
                whole.entry(binding: 1, resource: BindingResource::Sampler(sampler: plainSampler(d: d)));
                whole.label(text: "whole");
                BindGroup a = d.createBindGroup(descriptor: give whole);
                BindGroupDescriptor ranged = BindGroupDescriptor.make(layout: copy layout);
                ranged.entry(binding: 0, resource: BindingResource::Buffer(binding: BufferBinding.range(buffer: copy ubo, offset: 256, size: 64)));
                ranged.entry(binding: 1, resource: BindingResource::Sampler(sampler: plainSampler(d: d)));
                ranged.label(text: "ranged");
                BindGroup b = d.createBindGroup(descriptor: give ranged);
                BindGroupDescriptor rest = BindGroupDescriptor.make(layout: copy layout);
                rest.entry(binding: 0, resource: BindingResource::Buffer(binding: BufferBinding.rest(buffer: copy ubo, offset: 256)));
                rest.entry(binding: 1, resource: BindingResource::Sampler(sampler: plainSampler(d: d)));
                rest.label(text: "the rest");
                BindGroup c = d.createBindGroup(descriptor: give rest);
                BindGroup kept = copy c;

                BindGroupLayoutDescriptor tl = BindGroupLayoutDescriptor.make();
                tl.entry(binding: 0, visibility: ShaderStage::Fragment, layout: BindingLayout::Texture(layout: TextureBindingLayout.make()));
                tl.label(text: "a texture");
                BindGroupLayout textureLayout = d.createBindGroupLayout(descriptor: give tl);
                Texture image = d.createTexture(descriptor: TextureDescriptor.make(width: 4, height: 4, format: TextureFormat::RGBA8Unorm, usage: TextureUsage::TextureBinding));
                BindGroupDescriptor textured = BindGroupDescriptor.make(layout: give textureLayout);
                textured.entry(binding: 0, resource: BindingResource::Texture(view: image.createView()));
                textured.label(text: "textured");
                BindGroup e = d.createBindGroup(descriptor: give textured);
            }
            case None: { }
        };
        this.flush();
        this.next(to: 81);
    }

    // A bind group of the uniform-and-sampler layout that WebGPU refuses: 1 a binding missing, 2 a sampler where the
    // buffer is, 3 an empty range, 4 a range at 2^60, 5 under a layout's minBindingSize of 2^60, 6 a refused sampler.
    unsafe fn void group(const ref string label, int32 kind) {
        Optional<Sampler> refusedOne = replace(place: this.refused, with: Optional::None);
        match (this.device) {
            case Some(value: d): {
                uint64 minimum = kind == 5 ? 1152921504606846976 : 16;
                BindGroupLayout layout = uniformAndSampler(d: d, minimum: minimum);
                Buffer ubo = uniforms(d: d);
                BindGroupDescriptor g = BindGroupDescriptor.make(layout: give layout);
                Sampler second = match (give refusedOne) { case Some(value: s): give s; case None: plainSampler(d: d); };
                if (kind == 2) {
                    Buffer unused = give ubo;
                    g.entry(binding: 0, resource: BindingResource::Sampler(sampler: plainSampler(d: d)));
                } else if (kind == 3) {
                    g.entry(binding: 0, resource: BindingResource::Buffer(binding: BufferBinding.range(buffer: give ubo, offset: 0, size: 0)));
                } else if (kind == 7) {
                    g.entry(binding: 0, resource: BindingResource::Buffer(binding: BufferBinding.range(buffer: give ubo, offset: 0, size: 1152921504606846976)));
                } else if (kind == 4) {
                    g.entry(binding: 0, resource: BindingResource::Buffer(binding: BufferBinding.range(buffer: give ubo, offset: 1152921504606846976, size: 64)));
                } else {
                    g.entry(binding: 0, resource: BindingResource::Buffer(binding: BufferBinding.whole(buffer: give ubo)));
                }
                if (kind == 1) {
                    Sampler unusedSecond = give second;
                } else {
                    g.entry(binding: 1, resource: BindingResource::Sampler(sampler: give second));
                }
                g.label(text: copy label);
                BindGroup made = d.createBindGroup(descriptor: give g);
            }
            case None: { Optional<Sampler> unused = give refusedOne; }
        };
        this.flush();
        this.next(to: this.stage + 1);
    }

    // `bytes` written into the write cases' buffer at `offset`, with no submit after: a 16-byte MapRead | CopyDst buffer
    // labelled "written", made at the first write.
    unsafe fn void write(DynamicArray<uint8> bytes, uint64 offset, bool flushed, int32 next) {
        if (this.written.isNone()) {
            Optional<Buffer> made = Optional::None;
            match (this.device) {
                case Some(value: d): {
                    BufferDescriptor bd = BufferDescriptor.make(size: 16, usage: BufferUsage::MapRead | BufferUsage::CopyDst);
                    bd.label(text: "written");
                    made = Optional::Some(value: d.createBuffer(descriptor: give bd));
                }
                case None: { }
            };
            this.written = give made;
        }
        match (this.written) {
            case Some(value: b): {
                match (this.queue) {
                    case Some(value: q): { q.writeBuffer(buffer: b, offset: offset, data: bytes.view()); }
                    case None: { }
                };
            }
            case None: { }
        };
        // a refused write is flushed, so its error reaches the channel on the web; a taken one is not, so the map that
        // follows sees it with no submit between
        if (flushed) { this.flush(); }
        this.next(to: next);
    }

    // The write cases' buffer mapped and read, with no submit since the last write: its bytes are `want`.
    unsafe fn void awaitRead(const ref string name, DynamicArray<uint8> want, int32 next) {
        if (this.reading.isNone()) {
            Optional<BufferRead> started = Optional::None;
            match (this.written) {
                case Some(value: b): { started = Optional::Some(value: b.mapRead(offset: 0, size: 16)); }
                case None: { }
            };
            this.reading = give started;
        }
        match (this.device) { case Some(value: d): { d.poll(wait: true); } case None: { } };
        ReadStatus s = match (this.reading) {
            case Some(value: r): r.poll();
            case None: ReadStatus::Failed(error: GpuError::Taken);
        };
        bool pending = match (s) { case Pending: true; case _: false; };
        if (pending && this.waited < SETTLE) { return; }
        string why = match (s) {
            case Pending: "the map did not finish";
            case Failed(error: e): e.message();
            case Ready: "";
        };
        if (why.isEmpty()) {
            DynamicArray<uint8> got = match (this.reading) { case Some(value: r): r.bytes(); case None: DynamicArray.empty(); };
            why = sameBytes(got: got, want: want);
        }
        this.reading = Optional::None;   // unmapped, so the next write may land
        this.found.add(name: copy name, why: give why);
        this.next(to: next);
    }

    // A BC texture on a device given TextureCompressionBC: no error. Skipped, and said so, where the adapter has no BC.
    unsafe fn void givenFormat() {
        if (!this.givenBC) {
            println(s: "skip a BC texture taken: this adapter does not offer TextureCompressionBC");
            this.next(to: 260);
            return;
        }
        match (this.device) {
            case Some(value: d): { Texture image = d.createTexture(descriptor: TextureDescriptor.make(width: 4, height: 4, format: TextureFormat::BC1RGBAUnorm, usage: TextureUsage::TextureBinding)); }
            case None: { }
        };
        this.flush();
        this.next(to: 251);
    }

    // A texture in `format`, whose feature the device was not given: refused, where a browser throws (decision 9).
    unsafe fn void gatedTexture(TextureFormat format, TextureUsage usage, int32 next) {
        Optional<Texture> made = Optional::None;
        match (this.device) {
            case Some(value: d): { made = Optional::Some(value: d.createTexture(descriptor: TextureDescriptor.make(width: 4, height: 4, format: format, usage: usage))); }
            case None: { }
        };
        this.refusedTexture = give made;
        this.flush();
        this.next(to: next);
    }

    // A view of the last refused texture: the refusal's handle is invalid, so WebGPU refuses this too.
    unsafe fn void viewOfRefused() {
        Optional<Texture> held = replace(place: this.refusedTexture, with: Optional::None);
        match (give held) {
            case Some(value: image): { TextureView view = image.createView(); }
            case None: { }
        };
        this.flush();
        this.next(to: 263);
    }

    // Textures WebGPU takes, each read back through WebGPU's `GPUTexture` attributes as it was described; held until
    // the channel is seen empty.
    unsafe fn void goodTextures() {
        match (this.device) {
            case Some(value: d): {
                TextureDescriptor plain = TextureDescriptor.make(width: 4, height: 4, format: TextureFormat::RGBA8Unorm, usage: TextureUsage::TextureBinding);
                madeAsDescribed(d: d, descriptor: give plain, label: "plain", width: 4, height: 4, layers: 1, dimension: TextureDimension::D2, mips: 1, samples: 1,
                          format: TextureFormat::RGBA8Unorm, usage: TextureUsage::TextureBinding, held: ref this.heldTextures, found: ref this.found);
                TextureDescriptor mipped = TextureDescriptor.make(width: 8, height: 8, format: TextureFormat::RGBA8Unorm, usage: TextureUsage::TextureBinding | TextureUsage::CopyDst);
                mipped.mipLevelCount(count: 4);
                madeAsDescribed(d: d, descriptor: give mipped, label: "mipped", width: 8, height: 8, layers: 1, dimension: TextureDimension::D2, mips: 4, samples: 1,
                          format: TextureFormat::RGBA8Unorm, usage: TextureUsage::TextureBinding | TextureUsage::CopyDst, held: ref this.heldTextures, found: ref this.found);
                TextureDescriptor multisampled = TextureDescriptor.make(width: 4, height: 4, format: TextureFormat::BGRA8Unorm, usage: TextureUsage::RenderAttachment);
                multisampled.sampleCount(count: 4);
                madeAsDescribed(d: d, descriptor: give multisampled, label: "multisampled", width: 4, height: 4, layers: 1, dimension: TextureDimension::D2, mips: 1, samples: 4,
                          format: TextureFormat::BGRA8Unorm, usage: TextureUsage::RenderAttachment, held: ref this.heldTextures, found: ref this.found);
                TextureDescriptor volume = TextureDescriptor.make(width: 4, height: 4, format: TextureFormat::RGBA8Unorm, usage: TextureUsage::TextureBinding);
                volume.dimension(kind: TextureDimension::D3);
                volume.depthOrArrayLayers(count: 3);
                madeAsDescribed(d: d, descriptor: give volume, label: "volume", width: 4, height: 4, layers: 3, dimension: TextureDimension::D3, mips: 1, samples: 1,
                          format: TextureFormat::RGBA8Unorm, usage: TextureUsage::TextureBinding, held: ref this.heldTextures, found: ref this.found);
                TextureDescriptor line = TextureDescriptor.make(width: 16, height: 1, format: TextureFormat::R8Unorm, usage: TextureUsage::TextureBinding | TextureUsage::CopySrc);
                line.dimension(kind: TextureDimension::D1);
                madeAsDescribed(d: d, descriptor: give line, label: "line", width: 16, height: 1, layers: 1, dimension: TextureDimension::D1, mips: 1, samples: 1,
                          format: TextureFormat::R8Unorm, usage: TextureUsage::TextureBinding | TextureUsage::CopySrc, held: ref this.heldTextures, found: ref this.found);
                TextureDescriptor layered = TextureDescriptor.make(width: 4, height: 4, format: TextureFormat::RGBA16Float, usage: TextureUsage::TextureBinding);
                layered.depthOrArrayLayers(count: 6);
                madeAsDescribed(d: d, descriptor: give layered, label: "layered", width: 4, height: 4, layers: 6, dimension: TextureDimension::D2, mips: 1, samples: 1,
                          format: TextureFormat::RGBA16Float, usage: TextureUsage::TextureBinding, held: ref this.heldTextures, found: ref this.found);
                TextureDescriptor depth = TextureDescriptor.make(width: 8, height: 8, format: TextureFormat::Depth24Plus, usage: TextureUsage::RenderAttachment | TextureUsage::TextureBinding);
                depth.mipLevelCount(count: 2);
                madeAsDescribed(d: d, descriptor: give depth, label: "depth", width: 8, height: 8, layers: 1, dimension: TextureDimension::D2, mips: 2, samples: 1,
                          format: TextureFormat::Depth24Plus, usage: TextureUsage::RenderAttachment | TextureUsage::TextureBinding, held: ref this.heldTextures, found: ref this.found);
                TextureDescriptor twin = TextureDescriptor.make(width: 4, height: 4, format: TextureFormat::RGBA8Unorm, usage: TextureUsage::TextureBinding);
                twin.viewFormat(format: TextureFormat::RGBA8UnormSrgb);
                madeAsDescribed(d: d, descriptor: give twin, label: "srgb views", width: 4, height: 4, layers: 1, dimension: TextureDimension::D2, mips: 1, samples: 1,
                          format: TextureFormat::RGBA8Unorm, usage: TextureUsage::TextureBinding, held: ref this.heldTextures, found: ref this.found);
            }
            case None: { }
        };
        this.flush();
        this.next(to: 311);
    }

    // A texture WebGPU refuses, made from a description wrong in one way (`kind`), named `label`, and kept.
    unsafe fn void badTexture(int32 kind, string label) {
        this.heldTextures = DynamicArray.empty();
        TextureDescriptor t = TextureDescriptor.make(width: 4, height: 4, format: TextureFormat::RGBA8Unorm, usage: TextureUsage::TextureBinding);
        if (kind == 1) { t = TextureDescriptor.make(width: 0, height: 4, format: TextureFormat::RGBA8Unorm, usage: TextureUsage::TextureBinding); }
        else if (kind == 2) { t.mipLevelCount(count: 4); }
        else if (kind == 3) {
            t = TextureDescriptor.make(width: 4, height: 4, format: TextureFormat::RGBA8Unorm, usage: TextureUsage::RenderAttachment);
            t.sampleCount(count: 4);
            t.mipLevelCount(count: 2);
        }
        else if (kind == 4) {
            t = TextureDescriptor.make(width: 4, height: 4, format: TextureFormat::Depth24Plus, usage: TextureUsage::TextureBinding);
            t.dimension(kind: TextureDimension::D3);
        }
        else if (kind == 5) { t.viewFormat(format: TextureFormat::R8Unorm); }
        else if (kind == 6) {
            t.viewFormat(format: TextureFormat::RGBA8UnormSrgb);   // a twin first, so every view format is looked at
            t.viewFormat(format: TextureFormat::ETC2RGB8Unorm);
        }
        t.label(text: give label);
        Optional<Texture> made = Optional::None;
        match (this.device) {
            case Some(value: d): { made = Optional::Some(value: d.createTexture(descriptor: give t)); }
            case None: { TextureDescriptor unused = give t; }
        };
        this.refusedTexture = give made;
        this.flush();
        this.next(to: this.stage + 1);
    }

    // The texture refused for its own format (ETC2) answers its substitute's attributes, not its description's; it is
    // kept for the view made of it next.
    unsafe fn void refusedOwnFormat() {
        string why = match (this.refusedTexture) {
            case Some(value: t): attributesOfSubstitute(t: t);
            case None: "no texture was handed back";
        };
        this.found.add(name: "a texture refused for its own format answers its substitute's attributes: 0 wide, 2D, in RGBA8Unorm, not ETC2", why: give why);
        this.next(to: 262);
    }

    // The texture a view-format refusal handed back answers its substitute's attributes: 0 wide, in RGBA8Unorm.
    unsafe fn void refusedAttributes() {
        string why = match (this.refusedTexture) {
            case Some(value: t): attributesOfSubstitute(t: t);
            case None: "no texture was handed back";
        };
        this.found.add(name: "a refused texture answers its substitute's attributes: 0 wide, 2D, in RGBA8Unorm", why: give why);
        this.refusedTexture = Optional::None;
        this.next(to: 380);
    }

    // A 3D BC texture on a device given TextureCompressionBC alone: WebGPU's validation error. Skipped, and said so,
    // where the adapter has no BC.
    unsafe fn void bcVolume() {
        if (!this.givenBC) {
            println(s: "skip a 3D BC texture: this adapter does not offer TextureCompressionBC");
            this.next(to: 240);
            return;
        }
        TextureDescriptor t = TextureDescriptor.make(width: 4, height: 4, format: TextureFormat::BC1RGBAUnorm, usage: TextureUsage::TextureBinding);
        t.dimension(kind: TextureDimension::D3);
        t.label(text: "bc volume");
        match (this.device) {
            case Some(value: d): { Texture made = d.createTexture(descriptor: give t); }
            case None: { TextureDescriptor unused = give t; }
        };
        this.flush();
        this.next(to: 381);
    }

    // A storage texture layout in RGBA16Snorm, whose feature the device was not given; the layout kept for a pipeline layout.
    unsafe fn void gatedStorage() {
        Optional<BindGroupLayout> made = Optional::None;
        match (this.device) {
            case Some(value: d): {
                BindGroupLayoutDescriptor l = BindGroupLayoutDescriptor.make();
                l.entry(binding: 0, visibility: ShaderStage::Fragment,
                        layout: BindingLayout::StorageTexture(layout: StorageTextureBindingLayout.make(format: TextureFormat::RGBA16Snorm)));
                l.label(text: "sixteen-bit storage");
                made = Optional::Some(value: d.createBindGroupLayout(descriptor: give l));
            }
            case None: { }
        };
        this.refusedLayout = give made;
        this.flush();
        this.next(to: 301);
    }

    // A pipeline layout of the refused layout: the refusal's handle is invalid, so WebGPU refuses this too.
    unsafe fn void ofRefusedLayout() {
        Optional<BindGroupLayout> held = replace(place: this.refusedLayout, with: Optional::None);
        match (this.device) {
            case Some(value: d): {
                match (give held) {
                    case Some(value: l): {
                        PipelineLayoutDescriptor p = PipelineLayoutDescriptor.make();
                        p.group(layout: give l);
                        p.label(text: "of a refused layout");
                        PipelineLayout made = d.createPipelineLayout(descriptor: give p);
                    }
                    case None: { }
                };
            }
            case None: { Optional<BindGroupLayout> unused = give held; }
        };
        this.flush();
        this.next(to: 303);
    }

    // A write into a buffer with no CopyDst, which WebGPU refuses.
    unsafe fn void writeUnwritable() {
        match (this.device) {
            case Some(value: d): {
                BufferDescriptor bd = BufferDescriptor.make(size: 16, usage: BufferUsage::Uniform);
                bd.label(text: "uniform only");
                Buffer b = d.createBuffer(descriptor: give bd);
                DynamicArray<uint8> bytes = counted(n: 16, first: 0);
                match (this.queue) {
                    case Some(value: q): { q.writeBuffer(buffer: b, offset: 0, data: bytes.view()); }
                    case None: { }
                };
            }
            case None: { }
        };
        this.flush();
        this.next(to: 231);
    }

    // A read-write storage buffer seen by the vertex stage, which WebGPU refuses.
    unsafe fn void vertexStorage() {
        match (this.device) {
            case Some(value: d): {
                BindGroupLayoutDescriptor l = BindGroupLayoutDescriptor.make();
                BufferBindingLayout writable = BufferBindingLayout.make();
                writable.kind = BufferBindingType::Storage;
                l.entry(binding: 0, visibility: ShaderStage::Vertex, layout: BindingLayout::Buffer(layout: writable));
                l.label(text: "vertex storage");
                BindGroupLayout made = d.createBindGroupLayout(descriptor: give l);
            }
            case None: { }
        };
        this.flush();
        this.next(to: 171);
    }

    // A comparison sampler's binding given a plain sampler, which WebGPU refuses.
    unsafe fn void notComparing() {
        match (this.device) {
            case Some(value: d): {
                BindGroupLayoutDescriptor l = BindGroupLayoutDescriptor.make();
                SamplerBindingLayout comparing = SamplerBindingLayout.make();
                comparing.kind = SamplerBindingType::Comparison;
                l.entry(binding: 0, visibility: ShaderStage::Fragment, layout: BindingLayout::Sampler(layout: comparing));
                l.label(text: "a comparison");
                BindGroupLayout layout = d.createBindGroupLayout(descriptor: give l);
                BindGroupDescriptor g = BindGroupDescriptor.make(layout: give layout);
                g.entry(binding: 0, resource: BindingResource::Sampler(sampler: plainSampler(d: d)));
                g.label(text: "not comparing");
                BindGroup made = d.createBindGroup(descriptor: give g);
            }
            case None: { }
        };
        this.flush();
        this.next(to: 181);
    }

    // A sampler refused for a NaN clamp, kept for a bind group: its own error first.
    unsafe fn void refusedSampler() {
        Optional<Sampler> made = Optional::None;
        match (this.device) {
            case Some(value: d): {
                SamplerDescriptor s = SamplerDescriptor.make();
                s.lodClamp(min: notANumber(), max: 32.0);
                s.label(text: "refused");
                made = Optional::Some(value: d.createSampler(descriptor: give s));
            }
            case None: { }
        };
        this.refused = give made;
        this.flush();
        this.next(to: 141);
    }

    unsafe fn void fiveGroups() {
        match (this.device) {
            case Some(value: d): {
                BindGroupLayout one = uniformAndSampler(d: d, minimum: 16);
                PipelineLayoutDescriptor p = PipelineLayoutDescriptor.make();
                int32 i = 0;
                while (i < 5) { p.group(layout: copy one); i = i + 1; }
                p.label(text: "five groups");
                PipelineLayout made = d.createPipelineLayout(descriptor: give p);
            }
            case None: { }
        };
        this.flush();
        this.next(to: 151);
    }

    // Samplers WebGPU takes: no error.
    unsafe fn void goodSamplers() {
        match (this.device) {
            case Some(value: d): {
                SamplerDescriptor plain = SamplerDescriptor.make();
                plain.label(text: "default");
                Sampler a = d.createSampler(descriptor: give plain);
                SamplerDescriptor tri = SamplerDescriptor.make();
                tri.addressModes(u: AddressMode::Repeat, v: AddressMode::Repeat, w: AddressMode::MirrorRepeat);
                tri.filters(mag: FilterMode::Linear, min: FilterMode::Linear, mipmap: MipmapFilterMode::Linear);
                tri.maxAnisotropy(count: 16);
                tri.label(text: "trilinear");
                Sampler b = d.createSampler(descriptor: give tri);
                SamplerDescriptor shadow = SamplerDescriptor.make();
                shadow.compare(function: CompareFunction::LessEqual);
                shadow.label(text: "shadow");
                Sampler c = d.createSampler(descriptor: give shadow);
                SamplerDescriptor open = SamplerDescriptor.make();
                open.lodClamp(min: 0.0, max: divided(by: 0.0));
                open.label(text: "unclamped");
                Sampler e = d.createSampler(descriptor: give open);
                Sampler kept = copy e;
            }
            case None: { }
        };
        this.flush();
        this.next(to: 11);
    }

    unsafe fn void anisotropicNearest() {
        match (this.device) {
            case Some(value: d): {
                SamplerDescriptor s = SamplerDescriptor.make();
                s.maxAnisotropy(count: 16);
                s.label(text: "aniso nearest");
                Sampler made = d.createSampler(descriptor: give s);
            }
            case None: { }
        };
        this.flush();
        this.next(to: 21);
    }

    unsafe fn void lodBackwards() {
        match (this.device) {
            case Some(value: d): {
                SamplerDescriptor s = SamplerDescriptor.make();
                s.lodClamp(min: 5.0, max: 1.0);
                s.label(text: "lod backwards");
                Sampler made = d.createSampler(descriptor: give s);
            }
            case None: { }
        };
        this.flush();
        this.next(to: 31);
    }

    unsafe fn void lodNan() {
        match (this.device) {
            case Some(value: d): {
                SamplerDescriptor s = SamplerDescriptor.make();
                s.lodClamp(min: notANumber(), max: 32.0);
                s.label(text: "nan clamp");
                Sampler made = d.createSampler(descriptor: give s);
            }
            case None: { }
        };
        this.flush();
        this.next(to: 41);
    }

    unsafe fn void lodMinusInfinity() {
        match (this.device) {
            case Some(value: d): {
                SamplerDescriptor s = SamplerDescriptor.make();
                s.lodClamp(min: divided(by: -0.0), max: 32.0);
                s.label(text: "minus infinity");
                Sampler made = d.createSampler(descriptor: give s);
            }
            case None: { }
        };
        this.flush();
        this.next(to: 51);
    }
}

// A layout of a uniform buffer seen by both stages and a sampler seen by the fragment stage, its uniform at least
// `minimum` bytes.
unsafe fn BindGroupLayout uniformAndSampler(ref Device d, uint64 minimum) {
    BindGroupLayoutDescriptor l = BindGroupLayoutDescriptor.make();
    BufferBindingLayout uniform = BufferBindingLayout.make();
    uniform.minBindingSize = minimum;
    l.entry(binding: 0, visibility: ShaderStage::Vertex | ShaderStage::Fragment, layout: BindingLayout::Buffer(layout: uniform));
    l.entry(binding: 1, visibility: ShaderStage::Fragment, layout: BindingLayout::Sampler(layout: SamplerBindingLayout.make()));
    l.label(text: "uniform and sampler");
    return d.createBindGroupLayout(descriptor: give l);
}

unsafe fn Buffer uniforms(ref Device d) {
    BufferDescriptor b = BufferDescriptor.make(size: 512, usage: BufferUsage::Uniform | BufferUsage::CopyDst);
    b.label(text: "uniforms");
    return d.createBuffer(descriptor: give b);
}

unsafe fn Sampler plainSampler(ref Device d) {
    SamplerDescriptor s = SamplerDescriptor.make();
    s.label(text: "plain");
    return d.createSampler(descriptor: give s);
}

// `n` bytes counting up from `first`.
fn DynamicArray<uint8> counted(isize n, uint8 first) {
    DynamicArray<uint8> list = DynamicArray.empty();
    isize i = 0;
    while (i < n) { list.add(item: first + truncate<uint8>(i)); i = i + 1; }
    return list;
}

// The write cases' buffer after its second write: 1 to 16, with 99 to 102 at bytes 4 to 7.
fn DynamicArray<uint8> secondWrite() {
    DynamicArray<uint8> list = counted(n: 16, first: 1);
    isize i = 0;
    while (i < 4) { list[4 + i] = 99 + truncate<uint8>(i); i = i + 1; }
    return list;
}

// "" when `got` is `want`, byte for byte.
fn string sameBytes(const ref DynamicArray<uint8> got, const ref DynamicArray<uint8> want) {
    if (got.length() != want.length()) {
        isize g = got.length();
        isize w = want.length();
        return "${g} bytes, not ${w}";
    }
    isize i = 0;
    while (i < got.length()) {
        if (got[i] != want[i]) {
            uint8 a = got[i];
            uint8 b = want[i];
            return "byte ${i} is ${a}, not ${b}";
        }
        i = i + 1;
    }
    return "";
}

// The channel's reports, for a failure's words.
fn string described(const ref DeviceErrors errs) {
    isize n = errs.reports().length();
    if (n == 0) { return "nothing"; }
    string first = errs.reports()[0].message();
    return "${n} report(s), the first: ${first}";
}

// "" when `errs` holds one validation error whose words name `label`, and say `says` when it is not "".
fn string oneNaming(const ref DeviceErrors errs, const ref string label, const ref string says) {
    if (errs.reports().length() != 1) { return "want one error; " + described(errs: errs); }
    bool validation = match (errs.reports()[0].kind()) { case Validation: true; case _: false; };
    string words = errs.reports()[0].message();
    if (!validation) { return "not a validation error: ${words}"; }
    if (!words.contains(substring: label)) { return "its words do not name `${label}`: ${words}"; }
    if (!says.isEmpty() && !words.contains(substring: says)) { return "its words do not say `${says}`: ${words}"; }
    return "";
}
