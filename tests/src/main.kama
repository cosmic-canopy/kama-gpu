// @kama/gpu's tests, one program (AGENTS.package.md): an adapter asked for, answering its info, its limits and its
// features; devices requested from it with WebGPU's defaults, a raised limit, a limit beyond it and a feature it lacks;
// then a 64×64 texture cleared to a known colour, copied to a buffer, mapped and read back, with every handle released by
// its destructor and no uncaptured error.
//
// Before any of that, on every leg and with no GPU: `TextureFormat` both ways with its sRGB and linear forms, and what
// `preferred()` makes of a surface's answer (the web's, this machine's), handed in through `SurfaceCapabilities.of`.
// After it, natively and with a display: a surface on a real window, its capabilities, each configure the package must
// refuse rather than let wgpu-native abort the process, and a grey frame read back through an sRGB view and a linear one.
//
// It is a state machine, an `App` that std::app::run ticks, because on the web the adapter, the devices and the map are
// answered by the browser's event loop, between ticks. Natively the ticks run back to back, faster than the GPU clears
// and copies (measured: 600 non-blocking polls pass before a 64×64 clear's map completes), so it waits on the device
// there with `poll(wait: true)`, which the web leg ignores; the timeout is the clock's, not a tick count.
// A failing case prints its name, and the exit status is 1 when any failed.

import {
    core::println,
    core::env::envOr, core::env::args, core::env::Args,
    std::app::App, std::app::Lifecycle, std::app::run, std::app::quit,
    std::collections::DynamicArray,
    std::memory::Owned, std::memory::replace,
    std::time::Instant, std::time::monotonicNow,
    gpu::Instance, gpu::Adapter, gpu::AdapterOptions, gpu::AdapterRequest, gpu::AdapterStatus, gpu::AdapterInfo,
    gpu::Backend, gpu::Limits, gpu::Feature, gpu::FeatureSet, gpu::DeviceOptions,
    gpu::Device, gpu::Queue, gpu::DeviceRequest, gpu::DeviceStatus, gpu::GpuError,
    gpu::PowerPreference, gpu::Buffer, gpu::BufferDescriptor, gpu::BufferUsage, gpu::BufferRead, gpu::ReadStatus, gpu::Texture, gpu::TextureDescriptor,
    gpu::TextureFormat, gpu::TextureUsage, gpu::ShaderStage, gpu::TextureView, gpu::CommandEncoder, gpu::RenderPass,
    gpu::CommandBuffer, gpu::Color,
    gpu::DeviceErrors, gpu::GpuErrorReport, gpu::GpuErrorKind, gpu::DeviceLoss, gpu::LossReason,
    gpu::ErrorFilter, gpu::ErrorScope, gpu::ScopePop, gpu::PopStatus,
    gpu::Surface, gpu::SurfaceTexture, gpu::SurfaceError, gpu::SurfaceCapabilities, gpu::SurfaceConfig,
    gpu::PresentMode, gpu::AlphaMode, gpu::ConfigureError,
    window::Window, window::WindowError, window::WindowOptions, window::Size, window::NativeWindow,
    addDeviceRef, addSurfaceRef, statesAlive, windowRecords, minimise, quietly, readOptions, heapInUse,
    ShaderRun, Verdicts, BindingRun, PipelineRun,
};

comptime uint32 SIDE = 64;
comptime uint32 ROW = 256;      // 64 texels × 4 bytes: already the 256 a copy's rows are aligned to
comptime int64 TIMEOUT_MS = 10000;
comptime int32 ADAPTERS = 6;    // the clear's device, a raised limit, one past the adapter's, every feature, one it lacks,
                                // and two requests at once

// The clear colour, and the bytes an RGBA8Unorm texel holds for it (0.25, 0.5, 0.75 of 255, rounded either way).
comptime float64 RED = 0.25;
comptime float64 GREEN = 0.5;
comptime float64 BLUE = 0.75;

fn bool near(uint8 got, int32 want) {
    int32 g = cast<int32>(got);
    return g >= want - 1 && g <= want + 1;
}

// ---- limits, compared field by field ---------------------------------------------------------------------------------

// "" when `have` is at least `want` (a maximum), else the field and both numbers.
fn string atLeast(const ref string name, uint64 have, uint64 want) {
    if (have >= want) { return ""; }
    return "${name}: ${have}, below ${want}";
}

// "" when `have` is at most `want` (a minimum alignment, where less is better).
fn string atMost(const ref string name, uint64 have, uint64 want) {
    if (have <= want) { return ""; }
    return "${name}: ${have}, above ${want}";
}

fn string same(const ref string name, uint64 have, uint64 want) {
    if (have == want) { return ""; }
    return "${name}: ${have}, not ${want}";
}

fn string first(const ref DynamicArray<string> faults) {
    foreach (const ref string f in faults.iterConst()) { if (!f.isEmpty()) { return copy f; } }
    return "";
}

fn uint64 w(uint32 v) { return cast<uint64>(v); }

// wgpu-native (v29.0.1.1) does not report `maxBindGroupsPlusVertexBuffers`: an adapter and a device both answer 0 for
// it (measured 2026-11-10). Nor does a device it makes answer WebGPU's `maxImmediateSize` of 64: immediates are a feature
// of its own there, off unless asked, so the device answers 0 while the adapter answers 256 (measured 2026-11-11). The
// package answers what the implementation says, so natively those 0s are accepted, and on the web, where the browser
// reports both (24 and 64), they are held like the rest.
@compileFor(ARCH_WASM32)
fn bool unreported(uint32 v) { return false; }
@compileFor(!ARCH_WASM32)
fn bool unreported(uint32 v) { return v == 0; }

// `maxImmediateSize`'s fault, or "": exactly 0 where the browser has no immediates (`--no-immediates`), else `held`.
fn string immediates(const ref Limits have, bool lacked, string held) {
    if (lacked) { return same(name: "maxImmediateSize (--no-immediates)", have: w(v: have.maxImmediateSize), want: 0); }
    return held;
}

// The first limit of `have` that does not meet `want`, or "": each maximum at least as high, each alignment as low.
// `lacked`: the browser has no immediates (`--no-immediates`).
fn string meets(const ref Limits have, const ref Limits want, bool lacked) {
    DynamicArray<string> f = DynamicArray.empty();
    f.add(item: atLeast(name: "maxTextureDimension1D", have: w(v: have.maxTextureDimension1D), want: w(v: want.maxTextureDimension1D)));
    f.add(item: atLeast(name: "maxTextureDimension2D", have: w(v: have.maxTextureDimension2D), want: w(v: want.maxTextureDimension2D)));
    f.add(item: atLeast(name: "maxTextureDimension3D", have: w(v: have.maxTextureDimension3D), want: w(v: want.maxTextureDimension3D)));
    f.add(item: atLeast(name: "maxTextureArrayLayers", have: w(v: have.maxTextureArrayLayers), want: w(v: want.maxTextureArrayLayers)));
    f.add(item: atLeast(name: "maxBindGroups", have: w(v: have.maxBindGroups), want: w(v: want.maxBindGroups)));
    f.add(item: unreported(v: have.maxBindGroupsPlusVertexBuffers) ? ""
                : atLeast(name: "maxBindGroupsPlusVertexBuffers", have: w(v: have.maxBindGroupsPlusVertexBuffers), want: w(v: want.maxBindGroupsPlusVertexBuffers)));
    f.add(item: atLeast(name: "maxBindingsPerBindGroup", have: w(v: have.maxBindingsPerBindGroup), want: w(v: want.maxBindingsPerBindGroup)));
    f.add(item: atLeast(name: "maxDynamicUniformBuffersPerPipelineLayout", have: w(v: have.maxDynamicUniformBuffersPerPipelineLayout), want: w(v: want.maxDynamicUniformBuffersPerPipelineLayout)));
    f.add(item: atLeast(name: "maxDynamicStorageBuffersPerPipelineLayout", have: w(v: have.maxDynamicStorageBuffersPerPipelineLayout), want: w(v: want.maxDynamicStorageBuffersPerPipelineLayout)));
    f.add(item: atLeast(name: "maxSampledTexturesPerShaderStage", have: w(v: have.maxSampledTexturesPerShaderStage), want: w(v: want.maxSampledTexturesPerShaderStage)));
    f.add(item: atLeast(name: "maxSamplersPerShaderStage", have: w(v: have.maxSamplersPerShaderStage), want: w(v: want.maxSamplersPerShaderStage)));
    f.add(item: atLeast(name: "maxStorageBuffersPerShaderStage", have: w(v: have.maxStorageBuffersPerShaderStage), want: w(v: want.maxStorageBuffersPerShaderStage)));
    f.add(item: atLeast(name: "maxStorageTexturesPerShaderStage", have: w(v: have.maxStorageTexturesPerShaderStage), want: w(v: want.maxStorageTexturesPerShaderStage)));
    f.add(item: atLeast(name: "maxUniformBuffersPerShaderStage", have: w(v: have.maxUniformBuffersPerShaderStage), want: w(v: want.maxUniformBuffersPerShaderStage)));
    f.add(item: atLeast(name: "maxUniformBufferBindingSize", have: have.maxUniformBufferBindingSize, want: want.maxUniformBufferBindingSize));
    f.add(item: atLeast(name: "maxStorageBufferBindingSize", have: have.maxStorageBufferBindingSize, want: want.maxStorageBufferBindingSize));
    f.add(item: atMost(name: "minUniformBufferOffsetAlignment", have: w(v: have.minUniformBufferOffsetAlignment), want: w(v: want.minUniformBufferOffsetAlignment)));
    f.add(item: atMost(name: "minStorageBufferOffsetAlignment", have: w(v: have.minStorageBufferOffsetAlignment), want: w(v: want.minStorageBufferOffsetAlignment)));
    f.add(item: atLeast(name: "maxVertexBuffers", have: w(v: have.maxVertexBuffers), want: w(v: want.maxVertexBuffers)));
    f.add(item: atLeast(name: "maxBufferSize", have: have.maxBufferSize, want: want.maxBufferSize));
    f.add(item: atLeast(name: "maxVertexAttributes", have: w(v: have.maxVertexAttributes), want: w(v: want.maxVertexAttributes)));
    f.add(item: atLeast(name: "maxVertexBufferArrayStride", have: w(v: have.maxVertexBufferArrayStride), want: w(v: want.maxVertexBufferArrayStride)));
    f.add(item: atLeast(name: "maxInterStageShaderVariables", have: w(v: have.maxInterStageShaderVariables), want: w(v: want.maxInterStageShaderVariables)));
    f.add(item: atLeast(name: "maxColorAttachments", have: w(v: have.maxColorAttachments), want: w(v: want.maxColorAttachments)));
    f.add(item: atLeast(name: "maxColorAttachmentBytesPerSample", have: w(v: have.maxColorAttachmentBytesPerSample), want: w(v: want.maxColorAttachmentBytesPerSample)));
    f.add(item: atLeast(name: "maxComputeWorkgroupStorageSize", have: w(v: have.maxComputeWorkgroupStorageSize), want: w(v: want.maxComputeWorkgroupStorageSize)));
    f.add(item: atLeast(name: "maxComputeInvocationsPerWorkgroup", have: w(v: have.maxComputeInvocationsPerWorkgroup), want: w(v: want.maxComputeInvocationsPerWorkgroup)));
    f.add(item: atLeast(name: "maxComputeWorkgroupSizeX", have: w(v: have.maxComputeWorkgroupSizeX), want: w(v: want.maxComputeWorkgroupSizeX)));
    f.add(item: atLeast(name: "maxComputeWorkgroupSizeY", have: w(v: have.maxComputeWorkgroupSizeY), want: w(v: want.maxComputeWorkgroupSizeY)));
    f.add(item: atLeast(name: "maxComputeWorkgroupSizeZ", have: w(v: have.maxComputeWorkgroupSizeZ), want: w(v: want.maxComputeWorkgroupSizeZ)));
    f.add(item: atLeast(name: "maxComputeWorkgroupsPerDimension", have: w(v: have.maxComputeWorkgroupsPerDimension), want: w(v: want.maxComputeWorkgroupsPerDimension)));
    f.add(item: immediates(have: have, lacked: lacked,
                           held: atLeast(name: "maxImmediateSize", have: w(v: have.maxImmediateSize), want: w(v: want.maxImmediateSize))));
    return first(faults: f);
}

// The first limit of `have` that is not `want`'s, or "". `lacked`: the browser has no immediates (`--no-immediates`).
fn string equal(const ref Limits have, const ref Limits want, bool lacked) {
    DynamicArray<string> f = DynamicArray.empty();
    f.add(item: same(name: "maxTextureDimension1D", have: w(v: have.maxTextureDimension1D), want: w(v: want.maxTextureDimension1D)));
    f.add(item: same(name: "maxTextureDimension2D", have: w(v: have.maxTextureDimension2D), want: w(v: want.maxTextureDimension2D)));
    f.add(item: same(name: "maxTextureDimension3D", have: w(v: have.maxTextureDimension3D), want: w(v: want.maxTextureDimension3D)));
    f.add(item: same(name: "maxTextureArrayLayers", have: w(v: have.maxTextureArrayLayers), want: w(v: want.maxTextureArrayLayers)));
    f.add(item: same(name: "maxBindGroups", have: w(v: have.maxBindGroups), want: w(v: want.maxBindGroups)));
    f.add(item: unreported(v: have.maxBindGroupsPlusVertexBuffers) ? ""
                : same(name: "maxBindGroupsPlusVertexBuffers", have: w(v: have.maxBindGroupsPlusVertexBuffers), want: w(v: want.maxBindGroupsPlusVertexBuffers)));
    f.add(item: same(name: "maxBindingsPerBindGroup", have: w(v: have.maxBindingsPerBindGroup), want: w(v: want.maxBindingsPerBindGroup)));
    f.add(item: same(name: "maxDynamicUniformBuffersPerPipelineLayout", have: w(v: have.maxDynamicUniformBuffersPerPipelineLayout), want: w(v: want.maxDynamicUniformBuffersPerPipelineLayout)));
    f.add(item: same(name: "maxDynamicStorageBuffersPerPipelineLayout", have: w(v: have.maxDynamicStorageBuffersPerPipelineLayout), want: w(v: want.maxDynamicStorageBuffersPerPipelineLayout)));
    f.add(item: same(name: "maxSampledTexturesPerShaderStage", have: w(v: have.maxSampledTexturesPerShaderStage), want: w(v: want.maxSampledTexturesPerShaderStage)));
    f.add(item: same(name: "maxSamplersPerShaderStage", have: w(v: have.maxSamplersPerShaderStage), want: w(v: want.maxSamplersPerShaderStage)));
    f.add(item: same(name: "maxStorageBuffersPerShaderStage", have: w(v: have.maxStorageBuffersPerShaderStage), want: w(v: want.maxStorageBuffersPerShaderStage)));
    f.add(item: same(name: "maxStorageTexturesPerShaderStage", have: w(v: have.maxStorageTexturesPerShaderStage), want: w(v: want.maxStorageTexturesPerShaderStage)));
    f.add(item: same(name: "maxUniformBuffersPerShaderStage", have: w(v: have.maxUniformBuffersPerShaderStage), want: w(v: want.maxUniformBuffersPerShaderStage)));
    f.add(item: same(name: "maxUniformBufferBindingSize", have: have.maxUniformBufferBindingSize, want: want.maxUniformBufferBindingSize));
    f.add(item: same(name: "maxStorageBufferBindingSize", have: have.maxStorageBufferBindingSize, want: want.maxStorageBufferBindingSize));
    f.add(item: same(name: "minUniformBufferOffsetAlignment", have: w(v: have.minUniformBufferOffsetAlignment), want: w(v: want.minUniformBufferOffsetAlignment)));
    f.add(item: same(name: "minStorageBufferOffsetAlignment", have: w(v: have.minStorageBufferOffsetAlignment), want: w(v: want.minStorageBufferOffsetAlignment)));
    f.add(item: same(name: "maxVertexBuffers", have: w(v: have.maxVertexBuffers), want: w(v: want.maxVertexBuffers)));
    f.add(item: same(name: "maxBufferSize", have: have.maxBufferSize, want: want.maxBufferSize));
    f.add(item: same(name: "maxVertexAttributes", have: w(v: have.maxVertexAttributes), want: w(v: want.maxVertexAttributes)));
    f.add(item: same(name: "maxVertexBufferArrayStride", have: w(v: have.maxVertexBufferArrayStride), want: w(v: want.maxVertexBufferArrayStride)));
    f.add(item: same(name: "maxInterStageShaderVariables", have: w(v: have.maxInterStageShaderVariables), want: w(v: want.maxInterStageShaderVariables)));
    f.add(item: same(name: "maxColorAttachments", have: w(v: have.maxColorAttachments), want: w(v: want.maxColorAttachments)));
    f.add(item: same(name: "maxColorAttachmentBytesPerSample", have: w(v: have.maxColorAttachmentBytesPerSample), want: w(v: want.maxColorAttachmentBytesPerSample)));
    f.add(item: same(name: "maxComputeWorkgroupStorageSize", have: w(v: have.maxComputeWorkgroupStorageSize), want: w(v: want.maxComputeWorkgroupStorageSize)));
    f.add(item: same(name: "maxComputeInvocationsPerWorkgroup", have: w(v: have.maxComputeInvocationsPerWorkgroup), want: w(v: want.maxComputeInvocationsPerWorkgroup)));
    f.add(item: same(name: "maxComputeWorkgroupSizeX", have: w(v: have.maxComputeWorkgroupSizeX), want: w(v: want.maxComputeWorkgroupSizeX)));
    f.add(item: same(name: "maxComputeWorkgroupSizeY", have: w(v: have.maxComputeWorkgroupSizeY), want: w(v: want.maxComputeWorkgroupSizeY)));
    f.add(item: same(name: "maxComputeWorkgroupSizeZ", have: w(v: have.maxComputeWorkgroupSizeZ), want: w(v: want.maxComputeWorkgroupSizeZ)));
    f.add(item: same(name: "maxComputeWorkgroupsPerDimension", have: w(v: have.maxComputeWorkgroupsPerDimension), want: w(v: want.maxComputeWorkgroupsPerDimension)));
    f.add(item: immediates(have: have, lacked: lacked,
                           held: unreported(v: have.maxImmediateSize) ? ""
                                 : same(name: "maxImmediateSize", have: w(v: have.maxImmediateSize), want: w(v: want.maxImmediateSize))));
    return first(faults: f);
}

// A feature desktop adapters commonly lack, the first of these this adapter lacks; None when it has them all.
fn Optional<Feature> lackedBy(const ref FeatureSet has) {
    DynamicArray<Feature> candidates = DynamicArray.empty();
    candidates.add(item: Feature::TextureCompressionASTC);
    candidates.add(item: Feature::TextureCompressionASTCSliced3D);
    candidates.add(item: Feature::TextureCompressionETC2);
    candidates.add(item: Feature::TextureComponentSwizzle);
    candidates.add(item: Feature::PrimitiveIndex);
    candidates.add(item: Feature::ClipDistances);
    foreach (Feature f in candidates.iterator()) { if (!has.has(feature: f)) { return Optional::Some(value: f); } }
    return Optional::None;
}

// WebGPU says every adapter has `core-features-and-limits`, and the browser lists it. wgpu-native (v29.0.1.1) does not
// (measured 2026-11-10: 14 of webgpu.h's features, that one not among them), so natively an adapter must answer at
// least one feature, and on the web that one.
@compileFor(ARCH_WASM32)
fn string answered(const ref FeatureSet has) {
    return has.has(feature: Feature::CoreFeaturesAndLimits) ? "" : "it does not list CoreFeaturesAndLimits";
}
@compileFor(!ARCH_WASM32)
fn string answered(const ref FeatureSet has) {
    FeatureSet none = FeatureSet.empty();
    string gap = missingFrom(given: none, offered: has);
    return gap.isEmpty() ? "it lists none of webgpu.h's features" : "";
}

// The first feature `offered` has that `given` lacks, or "".
fn string missingFrom(const ref FeatureSet given, const ref FeatureSet offered) {
    DynamicArray<Feature> all = DynamicArray.empty();
    all.add(item: Feature::CoreFeaturesAndLimits);
    all.add(item: Feature::DepthClipControl);
    all.add(item: Feature::Depth32FloatStencil8);
    all.add(item: Feature::TextureCompressionBC);
    all.add(item: Feature::TextureCompressionBCSliced3D);
    all.add(item: Feature::TextureCompressionETC2);
    all.add(item: Feature::TextureCompressionASTC);
    all.add(item: Feature::TextureCompressionASTCSliced3D);
    all.add(item: Feature::TimestampQuery);
    all.add(item: Feature::IndirectFirstInstance);
    all.add(item: Feature::ShaderF16);
    all.add(item: Feature::RG11B10UfloatRenderable);
    all.add(item: Feature::BGRA8UnormStorage);
    all.add(item: Feature::Float32Filterable);
    all.add(item: Feature::Float32Blendable);
    all.add(item: Feature::ClipDistances);
    all.add(item: Feature::DualSourceBlending);
    all.add(item: Feature::Subgroups);
    all.add(item: Feature::TextureFormatsTier1);
    all.add(item: Feature::TextureFormatsTier2);
    all.add(item: Feature::PrimitiveIndex);
    all.add(item: Feature::TextureComponentSwizzle);
    isize n = 0;
    foreach (Feature f in all.iterator()) {
        if (offered.has(feature: f)) {
            n = n + 1;
            if (!given.has(feature: f)) { return "feature ${n} of those offered was not given"; }
        }
    }
    println(s: "info the adapter offers ${n} of webgpu.h's features");
    return "";
}

// One request polled: Pending keeps it in `slot`; a settled one leaves `slot` empty and is handed back.
unsafe fn DeviceStatus pollOne(ref Optional<DeviceRequest> slot) {
    Optional<DeviceRequest> taken = replace(place: slot, with: Optional::None);
    match (give taken) {
        case None: { return DeviceStatus::Failed(error: GpuError::Taken); }
        case Some(value: r): {
            DeviceStatus s = r.poll();
            slot = Optional::Some(value: give r);
            bool pending = match (s) { case Pending: true; case _: false; };
            if (!pending) { slot = Optional::None; }
            return give s;
        }
    };
}

// ---- texture formats, and what a surface answers (every leg, no GPU) --------------------------------------------------

fn bool sameFormat(Optional<TextureFormat> got, TextureFormat want) {
    return match (got) { case Some(value: f): f == want; case None: false; };
}

// "" when `linear` and `srgb` are each other's forms, and each its own.
fn string twins(TextureFormat linear, TextureFormat srgb) {
    string ln = linear.name();
    string sn = srgb.name();
    if (linear.isSrgb()) { return "${ln} says it is sRGB"; }
    if (!srgb.isSrgb()) { return "${sn} says it is not sRGB"; }
    if (!sameFormat(got: linear.srgb(), want: srgb)) { return "${ln}'s sRGB form is not ${sn}"; }
    if (!sameFormat(got: srgb.srgb(), want: srgb)) { return "${sn} is not its own sRGB form"; }
    if (srgb.linear() != linear) { return "${sn}'s linear form is not ${ln}"; }
    if (linear.linear() != linear) { return "${ln} is not its own linear form"; }
    return "";
}

// "" when `f` has no sRGB form and is its own linear form.
fn string loner(TextureFormat f) {
    string n = f.name();
    if (f.isSrgb()) { return "${n} says it is sRGB"; }
    Optional<TextureFormat> s = f.srgb();
    if (s.isSome()) { return "${n} has an sRGB form"; }
    if (f.linear() != f) { return "${n} is not its own linear form"; }
    return "";
}

fn string formatList(const ref DynamicArray<TextureFormat> fs) {
    string acc = "";
    isize i = 0;
    while (i < fs.length()) {
        string n = fs[i].name();
        if (acc.isEmpty()) { acc = copy n; } else { acc = "${acc}, ${n}"; }
        i = i + 1;
    }
    return acc;
}

fn string presentList(const ref DynamicArray<PresentMode> ps) {
    string acc = "";
    isize i = 0;
    while (i < ps.length()) {
        string n = ps[i].name();
        if (acc.isEmpty()) { acc = copy n; } else { acc = "${acc}, ${n}"; }
        i = i + 1;
    }
    return acc;
}

fn string alphaList(const ref DynamicArray<AlphaMode> modes) {
    string acc = "";
    isize i = 0;
    while (i < modes.length()) {
        string n = modes[i].name();
        if (acc.isEmpty()) { acc = copy n; } else { acc = "${acc}, ${n}"; }
        i = i + 1;
    }
    return acc;
}

fn string described(const ref SurfaceConfig c) {
    string f = c.format.name();
    string v = c.viewFormat.name();
    string p = c.present.name();
    string a = c.alpha.name();
    uint64 u = c.usage.bits();
    return "${f} through ${v}, ${p}, ${a}, usage ${u}";
}

// "" when `got` is the config described, with RenderAttachment its usage.
fn string expectConfig(const ref SurfaceConfig got, TextureFormat format, TextureFormat view, PresentMode present,
                       AlphaMode alpha) {
    if (got.format == format && got.viewFormat == view && got.present == present && got.alpha == alpha
        && got.usage == TextureUsage::RenderAttachment) {
        return "";
    }
    string d = described(c: got);
    return "got ${d}";
}

fn DynamicArray<TextureFormat> formats1(TextureFormat a) {
    DynamicArray<TextureFormat> l = DynamicArray.empty();
    l.add(item: a);
    return l;
}

fn DynamicArray<PresentMode> presents1(PresentMode a) {
    DynamicArray<PresentMode> l = DynamicArray.empty();
    l.add(item: a);
    return l;
}

fn DynamicArray<AlphaMode> alphas1(AlphaMode a) {
    DynamicArray<AlphaMode> l = DynamicArray.empty();
    l.add(item: a);
    return l;
}

// "" when every way an acquire can fail has its words. The match is exhaustive, so a variant added, or one left over
// that neither leg's webgpu.h reports (OutOfMemory, item 7), fails the build.
fn string acquireFailures() {
    DynamicArray<SurfaceError> all = DynamicArray.empty();
    all.add(item: SurfaceError::Occluded);
    all.add(item: SurfaceError::Outdated);
    all.add(item: SurfaceError::Lost);
    all.add(item: SurfaceError::Timeout);
    all.add(item: SurfaceError::Failed);
    all.add(item: SurfaceError::Closed);
    all.add(item: SurfaceError::NotConfigured);
    isize i = 0;
    while (i < all.length()) {
        string kind = match (all[i]) {
            case Occluded: "Occluded";
            case Outdated: "Outdated";
            case Lost: "Lost";
            case Timeout: "Timeout";
            case Failed: "Failed";
            case Closed: "Closed";
            case NotConfigured: "NotConfigured";
        };
        string words = all[i].message();
        if (words.isEmpty()) { return "${kind} has no words"; }
        i = i + 1;
    }
    return "";
}

// WebGPU's flag sets, each a type of its own (AGENTS.gpu.md item 12, decision 6); that one cannot stand for another, and
// that no empty set can be written, is tests/xfail/usage_mixed's. "" when each set's bits are webgpu.h's.
fn string flagBits() {
    uint64 b = (BufferUsage::MapRead | BufferUsage::CopyDst).bits();
    uint64 v = (BufferUsage::Vertex | BufferUsage::Index | BufferUsage::Uniform | BufferUsage::Storage
                | BufferUsage::Indirect | BufferUsage::MapWrite | BufferUsage::CopySrc).bits();
    uint64 t = (TextureUsage::RenderAttachment | TextureUsage::CopySrc).bits();
    uint64 u = (TextureUsage::TextureBinding | TextureUsage::StorageBinding | TextureUsage::CopyDst).bits();
    uint64 s = (ShaderStage::Vertex | ShaderStage::Fragment).bits();
    uint64 c = ShaderStage::Compute.bits();
    if (b != 0x9 || v != 0x1F6 || t != 0x11 || u != 0xE || s != 0x3 || c != 0x4) {
        return "buffer ${b} and ${v}, texture ${t} and ${u}, stages ${s} and ${c}";
    }
    return "";
}

// "" when `has` answers for every flag asked for, and only those.
fn string flagHas() {
    BufferUsage read = BufferUsage::MapRead | BufferUsage::CopyDst;
    if (!read.has(flags: BufferUsage::CopyDst)) { return "MapRead | CopyDst lacks CopyDst"; }
    if (!read.has(flags: BufferUsage::CopyDst | BufferUsage::MapRead)) { return "MapRead | CopyDst lacks both"; }
    if (read.has(flags: BufferUsage::Vertex)) { return "MapRead | CopyDst has Vertex"; }
    if (read.has(flags: BufferUsage::CopyDst | BufferUsage::Vertex)) { return "MapRead | CopyDst has CopyDst | Vertex"; }
    TextureUsage target = TextureUsage::RenderAttachment | TextureUsage::CopySrc;
    if (!target.has(flags: TextureUsage::RenderAttachment) || target.has(flags: TextureUsage::CopyDst)) {
        return "RenderAttachment | CopySrc answered wrongly";
    }
    ShaderStage seen = ShaderStage::Vertex | ShaderStage::Fragment;
    if (!seen.has(flags: ShaderStage::Fragment) || seen.has(flags: ShaderStage::Compute)
        || seen.has(flags: ShaderStage::Fragment | ShaderStage::Compute)) {
        return "Vertex | Fragment answered wrongly";
    }
    return "";
}

// "" when sets are equal by their flags alone.
fn string flagEquality() {
    if ((BufferUsage::Uniform | BufferUsage::CopyDst) != (BufferUsage::CopyDst | BufferUsage::Uniform)) {
        return "Uniform | CopyDst differs from CopyDst | Uniform";
    }
    if ((BufferUsage::Uniform | BufferUsage::CopyDst) == BufferUsage::Uniform) { return "Uniform | CopyDst equals Uniform"; }
    if ((TextureUsage::CopySrc | TextureUsage::CopySrc) != TextureUsage::CopySrc) { return "CopySrc twice is not CopySrc"; }
    if (ShaderStage::Vertex == ShaderStage::Fragment) { return "Vertex equals Fragment"; }
    return "";
}

// "" when capabilities made of these lists are refused.
unsafe fn string refused(DynamicArray<TextureFormat> formats, DynamicArray<PresentMode> presents,
                         DynamicArray<AlphaMode> alphas, TextureUsage usages) {
    Result<SurfaceCapabilities, GpuError> made = SurfaceCapabilities.make(formats: give formats, presentModes: give presents,
                                                                        alphaModes: give alphas, usages: usages);
    return match (made) {
        case Ok(value: c): "they were made";
        case Err(error: e): "";
    };
}

// What a configure answered, as a test compares it: "ok", "NoArea", "TooLarge <most>" or "NotOffered".
fn string refusal(const ref Result<Unit, ConfigureError> got) {
    string what = "ok";
    match (got) {
        case Ok(value: u): { }
        case Err(error: e): {
            match (e) {
                case NoArea: { what = "NoArea"; }
                case TooLarge(most: m): { what = "TooLarge ${m}"; }
                case NotOffered(words: said): { what = "NotOffered"; }
                case Closed: { what = "Closed"; }
                case NoWindow: { what = "NoWindow"; }
            };
        }
    };
    return what;
}

// A refusal's words, printed, and "" when `got` is `want` (a NotOffered must say what it refused).
fn string expectRefusal(const ref Result<Unit, ConfigureError> got, const ref string want) {
    string have = refusal(got: got);
    match (got) {
        case Ok(value: u): { }
        case Err(error: e): {
            string words = e.message();
            println(s: "info refused: ${words}");
            if (words.isEmpty()) { return "refused with no words"; }
        }
    };
    if (have == want) { return ""; }
    return "got ${have}, not ${want}";
}

// Adapters asked of the instance together and handed out one at a time. WebGPU gives an adapter one device (AGENTS.gpu.md
// item 10, decision 1), so each device a case asks for comes from an adapter of its own.
type resource AdapterPool {
    DynamicArray<AdapterRequest> asked = DynamicArray.empty();
    DynamicArray<Adapter> ready = DynamicArray.empty();
    string failure = "";
    int32 unavailable = 0;   // requests answered NoAdapter

    public unsafe ctor make(ref Instance instance, int32 count) {
        int32 i = 0;
        while (i < count) {
            this.asked.add(item: instance.requestAdapter(options: AdapterOptions.make(power: PowerPreference::HighPerformance)));
            i = i + 1;
        }
    }

    // Polls each request still pending: true once none is.
    public unsafe fn bool settled() {
        isize i = 0;
        while (i < this.asked.length()) {
            AdapterStatus s = this.asked[i].poll();
            match (give s) {
                case Pending: { i = i + 1; }
                case Ready(adapter: a): { AdapterRequest settledOne = this.asked.remove(index: i); this.ready.add(item: give a); }
                case Failed(error: e): {
                    AdapterRequest settledOne = this.asked.remove(index: i);
                    this.failure = e.message();
                    if (isNoAdapter(e: e)) { this.unavailable = this.unavailable + 1; }
                }
            };
        }
        return this.asked.length() == 0;
    }

    public const fn isize count() { return this.ready.length(); }
    // Every request answered that there is no adapter here.
    public const fn bool noneHere() { return this.ready.length() == 0 && this.unavailable > 0; }
    public const fn string failedWith() { return copy this.failure; }
    public unsafe fn Optional<Adapter> take() { return this.ready.pop(); }
}

fn bool isConsumed(const ref GpuError e) { return match (e) { case Consumed: true; case _: false; }; }
fn bool isNoAdapter(const ref GpuError e) { return match (e) { case NoAdapter(words: said): true; case _: false; }; }

// Whether the program was given `flag`.
unsafe fn bool hasFlag(string flag) {
    Args a = args();
    int32 i = 0;
    while (i < a.count()) {
        Optional<string> one = a.get(at: i);
        bool found = match (one) { case Some(value: s): s == flag; case None: false; };
        if (found) { return true; }
        i = i + 1;
    }
    return false;
}

// `--adapter-optional`: a browser or system that gives WebGPU no adapter skips the cases that need one, saying so,
// rather than failing them. Only a leg known to have none passes it (headless Firefox 160 here, AGENTS.gpu.md item 11),
// so a missing adapter anywhere else still fails.
unsafe fn bool adapterOptional() { return hasFlag(flag: "--adapter-optional"); }

// `--no-immediates`: a browser known to lack immediates (Firefox 160, whose `GPUSupportedLimits` has no
// `maxImmediateSize`, so the package answers 0; GPU-14) is held to exactly that 0, where every other browser is held to
// WebGPU's 64. Only Firefox's leg passes it, and the day Firefox reports immediates, the 0 fails and the flag goes.
unsafe fn bool noImmediates() { return hasFlag(flag: "--no-immediates"); }

// `--no-shader-warnings`: a browser whose WGSL compiler reports no warnings (Firefox 160, whose WebGPU is wgpu's and so
// naga's, as natively) is held to giving none, where Dawn is held to giving one (GPU-4, part 1). Only Firefox's leg
// passes it.
unsafe fn bool noShaderWarnings() { return hasFlag(flag: "--no-shader-warnings"); }

// `--huge-buffer-out-of-memory`: a browser that reports a buffer of 2^53 - 256 bytes, the size the package clamps a
// larger one to, as out of memory, where WebGPU makes it a validation error (Firefox 160, measured on 2026-11-13; a
// buffer of 2^28 + 1 bytes is a validation error there too), is held to that, where every other leg is held to WebGPU's
// validation error. Only Firefox's leg passes it. Either way it is an error, not the end of the program (decision 9).
unsafe fn bool hugeBufferOutOfMemory() { return hasFlag(flag: "--huge-buffer-out-of-memory"); }

type resource Check implements App {
    Optional<Instance> instance = Optional::None;
    Optional<AdapterPool> pool = Optional::None;      // the adapters, one for each device below
    Optional<Adapter> adapter = Optional::None;
    Optional<Adapter> refusedAdapter = Optional::None;  // the adapter `beyond` was asked of, asked again once refused
    Optional<DeviceRequest> request = Optional::None;     // WebGPU's defaults: the device the clear runs on
    Optional<DeviceRequest> raised = Optional::None;      // one limit raised to the adapter's
    Optional<DeviceRequest> beyond = Optional::None;      // one limit past the adapter's
    Optional<DeviceRequest> lacking = Optional::None;     // a feature the adapter lacks
    Optional<DeviceRequest> every = Optional::None;       // every feature the adapter has
    Optional<DeviceRequest> again = Optional::None;       // a second device from the adapter that gave `request`'s
    Optional<DeviceRequest> viaCopy = Optional::None;     // the same, through a copy of that adapter
    Optional<DeviceRequest> afterRefusal = Optional::None; // a good request of the adapter that refused `beyond`
    Optional<DeviceRequest> pairFirst = Optional::None;   // two requests made at once of one adapter
    Optional<DeviceRequest> pairSecond = Optional::None;
    int32 pairGranted = 0;
    int32 pairConsumed = 0;
    int32 pairOther = 0;
    FeatureSet offered = FeatureSet.empty();
    uint32 raisedTo = 0;
    int32 open = 0;                                       // device requests not settled yet
    Optional<Device> device = Optional::None;
    Optional<Queue> queue = Optional::None;
    Optional<Buffer> readback = Optional::None;
    Optional<BufferRead> read = Optional::None;
    int32 stage = 0;     // 0 awaiting the adapters, 1 the devices, 2 the map, 3 the surface cases, 4 the error cases, 5 the shader cases, 6 the binding cases, 7 the pipeline cases, 8 done
    Optional<SurfaceRun> surfaces = Optional::None;
    Optional<ErrorRun> errorRun = Optional::None;
    Optional<ShaderRun> shaderRun = Optional::None;
    Optional<BindingRun> bindingRun = Optional::None;
    Optional<PipelineRun> pipelineRun = Optional::None;
    Instant began = monotonicNow();
    int32 runs = 0;
    int32 failures = 0;

    public unsafe ctor make() {
        this.formatCases();
        this.verdict(name: "a flag set's bits are webgpu.h's, its members joined", why: flagBits());
        this.verdict(name: "a flag set has every flag asked for, and no other", why: flagHas());
        this.verdict(name: "flag sets are equal when they hold the same flags, in any order", why: flagEquality());
        this.capabilityCases();
        this.verdict(name: "an acquire fails in one of seven ways, each with its words", why: acquireFailures());
        Result<Instance, GpuError> made = Instance.make();
        match (give made) {
            case Ok(value: inst): {
                this.pool = Optional::Some(value: AdapterPool.make(instance: inst, count: ADAPTERS));
                this.instance = Optional::Some(value: give inst);
            }
            case Err(error: e): {
                string why = e.message();
                this.verdict(name: "an instance", why: why);
                this.stage = 3;
            }
        };
    }

    public const fn int32 failed() { return this.failures; }

    public fn void verdict(const ref string name, const ref string why) {
        this.runs = this.runs + 1;
        if (why.isEmpty()) {
            println(s: "ok   ${name}");
        } else {
            this.failures = this.failures + 1;
            println(s: "FAIL ${name}: ${why}");
        }
    }

    // One frame of the loop: false once every check has run.
    public fn bool tick() { return this.step() != 0; }

    // The host's lifecycle: nothing here holds a surface, so there is nothing to drop on `SurfaceLost`.
    public fn void lifecycle(Lifecycle event) { }

    unsafe fn int32 step() {
        if (this.stage < 3 && this.began.elapsed().asMillis() > TIMEOUT_MS) {
            string lost = "no device yet";
            match (this.device) {
                case Some(value: d): { lost = lossSaid(loss: d.lost()); }
                case None: { }
            };
            this.verdict(name: "the GPU answers within 10 s", why: "timed out at stage ${this.stage} (the device: ${lost})");
            this.stage = 3;
        }
        int32 was = this.stage;
        if (this.stage == 0) { this.awaitAdapter(); }
        if (this.stage == 1) { this.awaitDevices(); }
        if (this.stage == 2) { this.awaitRead(); }
        if (this.stage == 3) { this.surfaceStep(); }
        if (this.stage == 4) { this.errorStep(); }
        if (this.stage == 5) { this.shaderStep(); }
        if (this.stage != was) {
            int64 heap = heapInUse();
            int32 now = this.stage;
            if (heap >= 0) { println(s: "info the heap in use, stage ${was} to ${now}: ${heap} bytes"); }
        }
        if (this.stage == 6) { this.bindingStep(); }
        if (this.stage == 7) { this.pipelineStep(); }
        if (this.stage == 8) { return this.finish(); }
        return 1;
    }

    // The surface cases' step this tick, run apart from this check so they can report to it.
    unsafe fn void surfaceStep() {
        Optional<SurfaceRun> taken = replace(place: this.surfaces, with: Optional::None);
        SurfaceRun pending = match (give taken) { case Some(value: r): give r; case None: SurfaceRun.make(); };
        bool done = pending.step(t: this);
        this.surfaces = Optional::Some(value: give pending);
        if (done) { this.surfaces = Optional::None; this.stage = 4; }
    }

    // The error cases on the web's timing, a step this tick.
    unsafe fn void errorStep() {
        Optional<ErrorRun> taken = replace(place: this.errorRun, with: Optional::None);
        ErrorRun pending = match (give taken) { case Some(value: r): give r; case None: ErrorRun.make(); };
        bool done = pending.step(t: this);
        this.errorRun = Optional::Some(value: give pending);
        if (done) { this.errorRun = Optional::None; this.stage = 5; }
    }

    // The shader-module cases (tests/src/shaders.kama), a step this tick, their verdicts reported here.
    unsafe fn void shaderStep() {
        Optional<ShaderRun> taken = replace(place: this.shaderRun, with: Optional::None);
        ShaderRun pending = match (give taken) { case Some(value: r): give r; case None: ShaderRun.make(adapterOptional: adapterOptional(), noShaderWarnings: noShaderWarnings()); };
        bool done = pending.step();
        isize i = 0;
        while (i < pending.verdicts().count()) {
            string name = pending.verdicts().nameAt(at: i);
            string why = pending.verdicts().whyAt(at: i);
            this.verdict(name: name, why: why);
            i = i + 1;
        }
        pending.verdicts().clear();
        this.shaderRun = Optional::Some(value: give pending);
        if (done) { this.shaderRun = Optional::None; this.stage = 6; }
    }

    // The cases of GPU-4's second part (tests/src/bindings.kama), a step this tick, their verdicts reported here.
    unsafe fn void bindingStep() {
        Optional<BindingRun> taken = replace(place: this.bindingRun, with: Optional::None);
        BindingRun pending = match (give taken) { case Some(value: r): give r; case None: BindingRun.make(adapterOptional: adapterOptional()); };
        bool done = pending.step();
        isize i = 0;
        while (i < pending.verdicts().count()) {
            string name = pending.verdicts().nameAt(at: i);
            string why = pending.verdicts().whyAt(at: i);
            this.verdict(name: name, why: why);
            i = i + 1;
        }
        pending.verdicts().clear();
        this.bindingRun = Optional::Some(value: give pending);
        if (done) { this.bindingRun = Optional::None; this.stage = 7; }
    }

    // The cases of GPU-4's third part (tests/src/pipelines.kama), a step this tick, their verdicts reported here. With no
    // adapter here (`--adapter-optional`) the check comes straight here, for the cases that need none.
    unsafe fn void pipelineStep() {
        Optional<PipelineRun> taken = replace(place: this.pipelineRun, with: Optional::None);
        PipelineRun pending = match (give taken) { case Some(value: r): give r; case None: PipelineRun.make(adapterOptional: adapterOptional()); };
        bool done = pending.step();
        isize i = 0;
        while (i < pending.verdicts().count()) {
            string name = pending.verdicts().nameAt(at: i);
            string why = pending.verdicts().whyAt(at: i);
            this.verdict(name: name, why: why);
            i = i + 1;
        }
        pending.verdicts().clear();
        this.pipelineRun = Optional::Some(value: give pending);
        if (done) { this.pipelineRun = Optional::None; this.stage = 8; }
    }

    unsafe fn void awaitAdapter() {
        Optional<AdapterPool> taken = replace(place: this.pool, with: Optional::None);
        match (give taken) {
            case None: { this.verdict(name: "adapters, asked of the instance", why: "there was no request"); this.stage = 3; }
            case Some(value: p): {
                bool done = p.settled();
                if (!done) { this.pool = Optional::Some(value: give p); return; }
                isize n = p.count();
                if (n < cast<isize>(ADAPTERS)) {
                    string words = p.failedWith();
                    if (p.noneHere() && adapterOptional()) {
                        // Every case after this one needs an adapter, the surface cases and the error cases too, but the
                        // pipeline cases' first, which the pipeline run makes before it asks for one.
                        this.verdict(name: "with no adapter here, WebGPU says why (NoAdapter's words)",
                                     why: words.isEmpty() ? "no words" : "");
                        println(s: "skip every case that needs a WebGPU adapter: there is none here (--adapter-optional): ${words}");
                        this.stage = 7;
                        return;
                    }
                    this.verdict(name: "adapters, asked of the instance", why: "${n} of ${ADAPTERS} given: ${words}");
                    this.stage = 3;
                    return;
                }
                this.verdict(name: "adapters, asked of the instance", why: "");
                this.askAdapters(pool: p);
                this.stage = 1;
            }
        };
    }

    // What an adapter answers, then a device asked of each adapter, at once.
    unsafe fn void askAdapters(ref AdapterPool pool) {
        Adapter primary = match (pool.take()) { case Some(value: a): give a; case None: { return; } };
        Adapter raising = match (pool.take()) { case Some(value: a): give a; case None: { return; } };
        Adapter past = match (pool.take()) { case Some(value: a): give a; case None: { return; } };
        Adapter whole = match (pool.take()) { case Some(value: a): give a; case None: { return; } };
        Adapter lacks = match (pool.take()) { case Some(value: a): give a; case None: { return; } };
        Adapter both = match (pool.take()) { case Some(value: a): give a; case None: { return; } };
        this.pairFirst = Optional::Some(value: both.requestDevice(options: readOptions()));
        this.pairSecond = Optional::Some(value: both.requestDevice(options: readOptions()));
        this.open = this.open + 2;
        AdapterInfo info = primary.info();
        Backend backend = info.backend();
        bool named = match (backend) { case Undefined: false; case Null: false; case _: true; };
        string description = info.description();
        println(s: "info the adapter: ${description}");
        this.verdict(name: "the adapter names its backend", why: named ? "" : "its backend is Undefined or Null");
        Limits limits = primary.limits();
        Limits defaults = Limits.defaults();
        string below = meets(have: limits, want: defaults, lacked: noImmediates());
        this.verdict(name: "the adapter's limits meet WebGPU's defaults", why: below);

        this.request = Optional::Some(value: primary.requestDevice(options: readOptions()));
        this.open = this.open + 1;

        uint32 top = limits.maxTextureDimension2D;
        if (top > defaults.maxTextureDimension2D) {
            DeviceOptions up = readOptions();
            up.limits.maxTextureDimension2D = top;
            this.raisedTo = top;
            this.raised = Optional::Some(value: raising.requestDevice(options: up));
            this.open = this.open + 1;
        } else {
            println(s: "skip a raised limit: the adapter's maxTextureDimension2D is WebGPU's default, ${top}");
        }

        DeviceOptions pastLimit = readOptions();
        pastLimit.limits.maxTextureDimension2D = top + 1;
        this.beyond = Optional::Some(value: past.requestDevice(options: pastLimit));
        this.open = this.open + 1;
        this.refusedAdapter = Optional::Some(value: give past);

        FeatureSet has = primary.features();
        this.verdict(name: "the adapter answers its features", why: answered(has: has));
        DeviceOptions all = readOptions();
        all.features = has;
        this.offered = has;
        this.every = Optional::Some(value: whole.requestDevice(options: all));
        this.open = this.open + 1;
        Optional<Feature> missing = lackedBy(has: has);
        match (missing) {
            case Some(value: f): {
                DeviceOptions wants = readOptions();
                wants.features = wants.features.with(feature: f);
                this.lacking = Optional::Some(value: lacks.requestDevice(options: wants));
                this.open = this.open + 1;
            }
            case None: { println(s: "skip a feature the adapter lacks: it has every candidate"); }
        };
        Optional<Instance> held = match (this.instance) { case Some(value: i): Optional::Some(value: copy i); case None: Optional::None; };
        match (give held) {
            case Some(value: inst): { errorCases(t: this, instance: inst); }
            case None: { }
        };
        this.adapter = Optional::Some(value: give primary);
    }

    unsafe fn void awaitDevices() {
        if (this.request.isSome()) {
            DeviceStatus s = pollOne(slot: this.request);
            match (give s) {
                case Pending: { }
                case Ready(device: d, queue: q): {
                    this.open = this.open - 1;
                    this.verdict(name: "a device and its queue, from the adapter", why: "");
                    match (this.adapter) {
                        case Some(value: a): {
                            this.again = Optional::Some(value: a.requestDevice(options: readOptions()));
                            Adapter twin = copy a;
                            this.viaCopy = Optional::Some(value: twin.requestDevice(options: readOptions()));
                            this.open = this.open + 2;
                        }
                        case None: { }
                    };
                    Limits got = d.limits();
                    Limits defaults = Limits.defaults();
                    string off = equal(have: got, want: defaults, lacked: noImmediates());
                    this.verdict(name: "a device asked for the defaults has WebGPU's default limits, not the adapter's", why: off);
                    this.render(device: d, queue: q);
                    this.device = Optional::Some(value: give d);
                    this.queue = Optional::Some(value: give q);
                }
                case Failed(error: e): {
                    this.open = this.open - 1;
                    string why = e.message();
                    this.verdict(name: "a device and its queue, from the adapter", why: why);
                    this.stage = 3;
                    return;
                }
            };
        }
        if (this.raised.isSome()) {
            DeviceStatus s = pollOne(slot: this.raised);
            match (give s) {
                case Pending: { }
                case Ready(device: d, queue: q): {
                    this.open = this.open - 1;
                    Limits got = d.limits();
                    uint32 to = got.maxTextureDimension2D;
                    uint32 want = this.raisedTo;
                    this.verdict(name: "a limit raised to the adapter's is granted",
                                 why: to == want ? "" : "maxTextureDimension2D ${to}, not ${want}");
                }
                case Failed(error: e): {
                    this.open = this.open - 1;
                    string why = e.message();
                    this.verdict(name: "a limit raised to the adapter's is granted", why: "refused: " + why);
                }
            };
        }
        if (this.beyond.isSome()) {
            DeviceStatus s = pollOne(slot: this.beyond);
            match (give s) {
                case Pending: { }
                case Ready(device: d, queue: q): {
                    this.open = this.open - 1;
                    this.verdict(name: "a limit past the adapter's is refused, in the implementation's words", why: "a device was given");
                }
                case Failed(error: e): {
                    this.open = this.open - 1;
                    string why = e.message();
                    println(s: "info refused: ${why}");
                    this.verdict(name: "a limit past the adapter's is refused, in the implementation's words",
                                 why: why.isEmpty() ? "refused with no words" : "");
                    match (this.refusedAdapter) {
                        case Some(value: a): {
                            this.afterRefusal = Optional::Some(value: a.requestDevice(options: readOptions()));
                            this.open = this.open + 1;
                        }
                        case None: { }
                    };
                }
            };
        }
        if (this.lacking.isSome()) {
            DeviceStatus s = pollOne(slot: this.lacking);
            match (give s) {
                case Pending: { }
                case Ready(device: d, queue: q): {
                    this.open = this.open - 1;
                    this.verdict(name: "a feature the adapter lacks is refused, in the implementation's words", why: "a device was given");
                }
                case Failed(error: e): {
                    this.open = this.open - 1;
                    string why = e.message();
                    println(s: "info refused: ${why}");
                    this.verdict(name: "a feature the adapter lacks is refused, in the implementation's words",
                                 why: why.isEmpty() ? "refused with no words" : "");
                }
            };
        }
        if (this.every.isSome()) {
            DeviceStatus s = pollOne(slot: this.every);
            match (give s) {
                case Pending: { }
                case Ready(device: d, queue: q): {
                    this.open = this.open - 1;
                    FeatureSet given = d.features();
                    string gap = missingFrom(given: given, offered: this.offered);
                    this.verdict(name: "a device asked for every feature the adapter has is given them all", why: gap);
                }
                case Failed(error: e): {
                    this.open = this.open - 1;
                    string why = e.message();
                    this.verdict(name: "a device asked for every feature the adapter has is given them all", why: "refused: " + why);
                }
            };
        }
        if (this.again.isSome()) {
            DeviceStatus s = pollOne(slot: this.again);
            this.consumedCase(s: give s, name: "a second device from an adapter that gave one is refused as Consumed");
        }
        if (this.viaCopy.isSome()) {
            DeviceStatus s = pollOne(slot: this.viaCopy);
            this.consumedCase(s: give s, name: "a copy of an adapter that gave a device is consumed too");
        }
        if (this.afterRefusal.isSome()) {
            DeviceStatus s = pollOne(slot: this.afterRefusal);
            match (give s) {
                case Pending: { }
                case Ready(device: d, queue: q): {
                    this.open = this.open - 1;
                    this.verdict(name: "a request refused for a limit leaves its adapter unconsumed: a good one is granted", why: "");
                }
                case Failed(error: e): {
                    this.open = this.open - 1;
                    string why = e.message();
                    this.verdict(name: "a request refused for a limit leaves its adapter unconsumed: a good one is granted",
                                 why: "refused: " + why);
                }
            };
        }
        if (this.pairFirst.isSome()) {
            DeviceStatus s = pollOne(slot: this.pairFirst);
            this.pairSettles(s: give s);
        }
        if (this.pairSecond.isSome()) {
            DeviceStatus s = pollOne(slot: this.pairSecond);
            this.pairSettles(s: give s);
        }
        if (this.open == 0 && this.stage == 1) { this.stage = 2; }
    }

    // One of two requests made at once of one adapter: the first answered gets the device, and the other is refused as
    // Consumed, whether the package refuses it (natively, where the first is granted inside its call) or the browser does.
    unsafe fn void pairSettles(DeviceStatus s) {
        bool settled = true;
        match (give s) {
            case Pending: { settled = false; }
            case Ready(device: d, queue: q): { this.pairGranted = this.pairGranted + 1; }
            case Failed(error: e): {
                if (isConsumed(e: e)) { this.pairConsumed = this.pairConsumed + 1; }
                else { this.pairOther = this.pairOther + 1; string why = e.message(); println(s: "info the pair: ${why}"); }
            }
        };
        if (!settled) { return; }
        this.open = this.open - 1;
        if (this.pairGranted + this.pairConsumed + this.pairOther < 2) { return; }
        int32 g = this.pairGranted;
        int32 c = this.pairConsumed;
        int32 o = this.pairOther;
        this.verdict(name: "two requests made at once of one adapter: one device, and the other refused as Consumed",
                     why: g == 1 && c == 1 ? "" : "${g} granted, ${c} refused as Consumed, ${o} refused otherwise");
    }

    // A request of a consumed adapter: refused as Consumed, at once and without asking WebGPU, on every leg.
    unsafe fn void consumedCase(DeviceStatus s, const ref string name) {
        match (give s) {
            case Pending: { this.open = this.open - 1; this.verdict(name: name, why: "still pending, where it is refused at once"); }
            case Ready(device: d, queue: q): { this.open = this.open - 1; this.verdict(name: name, why: "a device was given"); }
            case Failed(error: e): {
                this.open = this.open - 1;
                string why = e.message();
                this.verdict(name: name, why: isConsumed(e: e) ? "" : "refused otherwise: " + why);
            }
        };
    }

    // Clear a texture, copy it to a buffer, and ask for the buffer's bytes.
    unsafe fn void render(ref Device device, ref Queue queue) {
        Texture target = device.createTexture(descriptor: TextureDescriptor.make(width: SIDE, height: SIDE, format: TextureFormat::RGBA8Unorm,
                                              usage: TextureUsage::RenderAttachment | TextureUsage::CopySrc));
        TextureView view = target.createView();
        uint64 bytes = cast<uint64>(ROW) * cast<uint64>(SIDE);
        Buffer copy = device.createBuffer(descriptor: BufferDescriptor.make(size: bytes,
                                                                            usage: BufferUsage::MapRead | BufferUsage::CopyDst));
        CommandEncoder encoder = device.createCommandEncoder();
        RenderPass pass = encoder.beginRenderPass(target: view, clear: Color.of(r: RED, g: GREEN, b: BLUE, a: 1.0));
        give pass.end();
        encoder.copyTextureToBuffer(texture: target, buffer: copy, width: SIDE, height: SIDE, bytesPerRow: ROW);
        CommandBuffer commands = give encoder.finish();
        queue.submit(commands: give commands);
        this.read = Optional::Some(value: copy.mapRead(offset: 0, size: bytes));
        this.readback = Optional::Some(value: give copy);
    }

    unsafe fn void awaitRead() {
        match (this.device) {
            case Some(value: d): { d.poll(wait: true); }
            case None: { }
        };
        ReadStatus status = ReadStatus::Pending;
        match (this.read) {
            case Some(value: r): { status = r.poll(); }
            case None: { status = ReadStatus::Failed(error: GpuError::Taken); }
        };
        match (give status) {
            case Pending: { }
            case Ready: { this.checkPixels(); this.stage = 3; }
            case Failed(error: e): {
                string why = e.message();
                this.verdict(name: "the readback maps", why: why);
                this.stage = 3;
            }
        };
    }

    unsafe fn void checkPixels() {
        DynamicArray<uint8> px = DynamicArray.empty();
        match (this.read) {
            case Some(value: r): { px = r.bytes(); }
            case None: { }
        };
        isize want = cast<isize>(ROW) * cast<isize>(SIDE);
        isize got = px.length();
        if (got != want) {
            this.verdict(name: "the readback's bytes", why: "${got} bytes, not ${want}");
            return;
        }
        int32 r = cast<int32>(RED * 255.0 + 0.5);
        int32 g = cast<int32>(GREEN * 255.0 + 0.5);
        int32 b = cast<int32>(BLUE * 255.0 + 0.5);
        isize bad = 0;
        isize i = 0;
        while (i < want) {
            if (!near(got: px[i], want: r) || !near(got: px[i + 1], want: g) || !near(got: px[i + 2], want: b)
                || !near(got: px[i + 3], want: 255)) {
                bad = bad + 1;
            }
            i = i + 4;
        }
        if (bad == 0) {
            this.verdict(name: "every texel reads back as the clear colour", why: "");
        } else {
            uint8 r0 = px[0];
            uint8 g0 = px[1];
            uint8 b0 = px[2];
            uint8 a0 = px[3];
            this.verdict(name: "every texel reads back as the clear colour",
                         why: "${bad} texels differ; the first is ${r0} ${g0} ${b0} ${a0}, not ${r} ${g} ${b} 255");
        }
    }

    // TextureFormat: every format webgpu.h names, each by its own number both ways, with its sRGB and linear forms.
    unsafe fn void formatCases() {
        int32 named = 0;
        string wrong = "";
        int32 n = 0;
        while (n < 1024) {
            Optional<TextureFormat> f = TextureFormat::fromValue(value: n);
            match (f) {
                case Some(value: x): {
                    named = named + 1;
                    int32 back = x.value();
                    if (back != n && wrong.isEmpty()) { string nm = x.name(); wrong = "${n} names ${nm}, whose number is ${back}"; }
                }
                case None: { }
            };
            n = n + 1;
        }
        if (wrong.isEmpty() && named != 101) { wrong = "${named} numbers named, not 101"; }
        this.verdict(name: "TextureFormat names webgpu.h's 101 formats, each by its own number", why: wrong);
        Optional<TextureFormat> undefined = TextureFormat::fromValue(value: 0);
        Optional<TextureFormat> nv12 = TextureFormat::fromValue(value: 0x00030007);
        this.verdict(name: "a number webgpu.h names no format for is none: Undefined, and wgpu-native's NV12",
                     why: undefined.isSome() || nv12.isSome() ? "it named one" : "");
        this.verdict(name: "RGBA8Unorm and RGBA8UnormSrgb are each other's sRGB and linear forms",
                     why: twins(linear: TextureFormat::RGBA8Unorm, srgb: TextureFormat::RGBA8UnormSrgb));
        this.verdict(name: "BGRA8Unorm and BGRA8UnormSrgb are each other's sRGB and linear forms",
                     why: twins(linear: TextureFormat::BGRA8Unorm, srgb: TextureFormat::BGRA8UnormSrgb));
        this.verdict(name: "a compressed pair has its forms too: BC7RGBAUnorm and ASTC10x8Unorm",
                     why: twins(linear: TextureFormat::BC7RGBAUnorm, srgb: TextureFormat::BC7RGBAUnormSrgb)
                          + twins(linear: TextureFormat::ASTC10x8Unorm, srgb: TextureFormat::ASTC10x8UnormSrgb));
        this.verdict(name: "RGBA16Float and RGB10A2Unorm have no sRGB form",
                     why: loner(f: TextureFormat::RGBA16Float) + loner(f: TextureFormat::RGB10A2Unorm));
        string a = TextureFormat::BGRA8UnormSrgb.name();
        string b = TextureFormat::Depth24PlusStencil8.name();
        this.verdict(name: "a format's name is webgpu.h's",
                     why: a == "BGRA8UnormSrgb" && b == "Depth24PlusStencil8" ? "" : "${a}, ${b}");
        this.verdict(name: "requiredFeature follows WebGPU's table: 14 BC formats, 10 ETC2 and EAC, 28 ASTC, Depth32FloatStencil8 and the six 16-bit norms need their feature, the other 42 none",
                     why: requiredFeatures());
    }

    // What `preferred()` makes of a surface's answer, and the answers `of` refuses as breaking webgpu.h's promises.
    unsafe fn void capabilityCases() {
        // The web's (emdawnwebgpu's): the browser's preferred canvas format first, none sRGB; Fifo; Opaque, Premultiplied.
        DynamicArray<TextureFormat> wf = formats1(a: TextureFormat::BGRA8Unorm);
        wf.add(item: TextureFormat::RGBA8Unorm);
        wf.add(item: TextureFormat::RGBA16Float);
        DynamicArray<AlphaMode> wa = alphas1(a: AlphaMode::Opaque);
        wa.add(item: AlphaMode::Premultiplied);
        TextureUsage canvas = TextureUsage::RenderAttachment | TextureUsage::TextureBinding | TextureUsage::CopySrc
                              | TextureUsage::CopyDst;
        Result<SurfaceCapabilities, GpuError> web = SurfaceCapabilities.make(formats: give wf,
                                                                           presentModes: presents1(a: PresentMode::Fifo),
                                                                           alphaModes: give wa, usages: canvas);
        match (give web) {
            case Ok(value: caps): {
                SurfaceConfig c = caps.preferred();
                this.verdict(name: "on the web's answer, preferred() draws BGRA8Unorm through its sRGB view, Fifo, Opaque",
                             why: expectConfig(got: c, format: TextureFormat::BGRA8Unorm, view: TextureFormat::BGRA8UnormSrgb,
                                               present: PresentMode::Fifo, alpha: AlphaMode::Opaque));
                string order = formatList(fs: caps.formats());
                this.verdict(name: "a surface's formats keep its order",
                             why: order == "BGRA8Unorm, RGBA8Unorm, RGBA16Float" ? "" : order);
            }
            case Err(error: e): { string why = e.message(); this.verdict(name: "the web's answer makes capabilities", why: why); }
        };

        // This machine's (wgpu-native over Vulkan, measured 2026-11-10): sRGB first, Immediate before Fifo, Opaque only.
        DynamicArray<TextureFormat> nf = formats1(a: TextureFormat::RGBA8UnormSrgb);
        nf.add(item: TextureFormat::BGRA8UnormSrgb);
        nf.add(item: TextureFormat::RGBA8Unorm);
        nf.add(item: TextureFormat::BGRA8Unorm);
        nf.add(item: TextureFormat::RGB10A2Unorm);
        DynamicArray<PresentMode> np = presents1(a: PresentMode::Immediate);
        np.add(item: PresentMode::Fifo);
        np.add(item: PresentMode::FifoRelaxed);
        Result<SurfaceCapabilities, GpuError> native = SurfaceCapabilities.make(formats: give nf, presentModes: give np,
            alphaModes: alphas1(a: AlphaMode::Opaque),
            usages: TextureUsage::RenderAttachment | TextureUsage::TextureBinding | TextureUsage::CopySrc);
        match (give native) {
            case Ok(value: caps): {
                SurfaceConfig c = caps.preferred();
                this.verdict(name: "on a native answer, preferred() draws RGBA8UnormSrgb through itself, and Fifo though Immediate is first",
                             why: expectConfig(got: c, format: TextureFormat::RGBA8UnormSrgb, view: TextureFormat::RGBA8UnormSrgb,
                                               present: PresentMode::Fifo, alpha: AlphaMode::Opaque));
            }
            case Err(error: e): { string why = e.message(); this.verdict(name: "a native answer makes capabilities", why: why); }
        };

        // A format with no sRGB form first, and an alpha mode other than Opaque first.
        DynamicArray<TextureFormat> hf = formats1(a: TextureFormat::RGBA16Float);
        hf.add(item: TextureFormat::BGRA8Unorm);
        DynamicArray<AlphaMode> ha = alphas1(a: AlphaMode::Premultiplied);
        ha.add(item: AlphaMode::Opaque);
        Result<SurfaceCapabilities, GpuError> hdr = SurfaceCapabilities.make(formats: give hf,
                                                                           presentModes: presents1(a: PresentMode::Fifo),
                                                                           alphaModes: give ha,
                                                                           usages: TextureUsage::RenderAttachment);
        match (give hdr) {
            case Ok(value: caps): {
                SurfaceConfig c = caps.preferred();
                this.verdict(name: "preferred() draws a format with no sRGB form through itself, and takes the first alpha mode",
                             why: expectConfig(got: c, format: TextureFormat::RGBA16Float, view: TextureFormat::RGBA16Float,
                                               present: PresentMode::Fifo, alpha: AlphaMode::Premultiplied));
            }
            case Err(error: e): { string why = e.message(); this.verdict(name: "an HDR answer makes capabilities", why: why); }
        };

        DynamicArray<TextureFormat> none = DynamicArray.empty();
        this.verdict(name: "capabilities with no format are refused",
                     why: refused(formats: give none, presents: presents1(a: PresentMode::Fifo),
                                  alphas: alphas1(a: AlphaMode::Opaque), usages: TextureUsage::RenderAttachment));
        this.verdict(name: "capabilities without Fifo are refused",
                     why: refused(formats: formats1(a: TextureFormat::BGRA8Unorm), presents: presents1(a: PresentMode::Mailbox),
                                  alphas: alphas1(a: AlphaMode::Opaque), usages: TextureUsage::RenderAttachment));
        DynamicArray<AlphaMode> noAlpha = DynamicArray.empty();
        this.verdict(name: "capabilities with no alpha mode are refused",
                     why: refused(formats: formats1(a: TextureFormat::BGRA8Unorm), presents: presents1(a: PresentMode::Fifo),
                                  alphas: give noAlpha, usages: TextureUsage::RenderAttachment));
        this.verdict(name: "capabilities without RenderAttachment are refused",
                     why: refused(formats: formats1(a: TextureFormat::BGRA8Unorm), presents: presents1(a: PresentMode::Fifo),
                                  alphas: alphas1(a: AlphaMode::Opaque), usages: TextureUsage::TextureBinding));
    }

    // Every handle released by its destructor, then the verdict on uncaptured errors and the totals.
    unsafe fn int32 finish() {
        this.surfaces = Optional::None;
        this.errorRun = Optional::None;
        match (this.device) {
            case Some(value: d): {
                DeviceErrors errs = d.takeErrors();
                this.verdict(name: "no uncaptured WebGPU error on the clear's device", why: errorsSaid(errs: errs));
            }
            case None: { }
        };
        this.read = Optional::None;
        this.readback = Optional::None;
        this.queue = Optional::None;
        this.device = Optional::None;
        this.request = Optional::None;
        this.raised = Optional::None;
        this.beyond = Optional::None;
        this.lacking = Optional::None;
        this.every = Optional::None;
        this.adapter = Optional::None;
        this.again = Optional::None;
        this.viaCopy = Optional::None;
        this.afterRefusal = Optional::None;
        this.pairFirst = Optional::None;
        this.pairSecond = Optional::None;
        this.refusedAdapter = Optional::None;
        this.pool = Optional::None;
        this.instance = Optional::None;
        int64 alive = statesAlive();
        this.verdict(name: "every device's state is freed with its last handle",
                     why: alive == 0 ? "" : "${alive} still alive after every handle was dropped");
        println(s: "gpu tests: ${this.runs} cases, ${this.failures} failed");
        exitStatus = this.failures > 0 ? 1 : 0;
        endOnTheWeb(failed: this.failures > 0);
        return 0;
    }
}

// ---- a surface on a window: a system window natively, the page's canvas on the web (GPU-3) ---------------------------

comptime uint32 PATCH = 64;   // the corner of a frame read back, PATCH × PATCH texels

// The surface cases, a step a tick, since on the web the adapter, the device and each readback are answered between
// ticks; natively each is answered when it is polled. The windows open with `openIn`: natively system windows, opened
// unfocused, the selector unused; on the web the page's canvases (tests/web/shell.html): #canvas, #second for the
// windows that close, #wide wider than a texture may be, and #flat with no area.
type resource SurfaceRun {
    int32 stage = 0;
    Instant began = monotonicNow();
    Optional<Window> window = Optional::None;
    Optional<Instance> instance = Optional::None;
    Optional<Surface> surface = Optional::None;
    Optional<Surface> early = Optional::None;   // copied before any configure: it must still draw in the configured view format
    Optional<AdapterRequest> adapterRequest = Optional::None;
    Optional<Adapter> adapter = Optional::None;
    Optional<SurfaceCapabilities> caps = Optional::None;
    Optional<DeviceRequest> deviceRequest = Optional::None;
    Optional<Device> device = Optional::None;
    Optional<Queue> queue = Optional::None;
    Optional<GreyRead> grey = Optional::None;
    Optional<SurfaceConfig> linear = Optional::None;   // the configure the second readback is drawn through

    public ctor make() { }

    // One tick's step: true once every surface case has run.
    public unsafe fn bool step(ref Check t) {
        if (this.stage > 0 && this.stage < 9 && this.began.elapsed().asMillis() > TIMEOUT_MS) {
            int32 at = this.stage;
            t.verdict(name: "the surface cases end within 10 s", why: "timed out at stage ${at}");
            return true;
        }
        if (this.stage == 0) { this.open(t: t); }
        else if (this.stage == 1) { this.awaitAdapter(t: t); }
        else if (this.stage == 2) { this.awaitDevice(t: t); }
        else if (this.stage == 3) { this.awaitGrey(t: t, want: 188); }
        else if (this.stage == 4) { this.awaitGrey(t: t, want: 128); }
        else if (this.stage == 5) { this.lastWords(t: t); }
        return this.stage >= 9;
    }

    unsafe fn void open(ref Check t) {
        if (noDisplay()) { println(s: "skip the surface cases: KAMA_WINDOW_NO_DISPLAY is set"); this.stage = 9; return; }
        Result<Window, WindowError> opened = Window.openIn(canvas: "#canvas", title: "@kama/gpu tests", width: 320,
                                                           height: 200, options: quietly());
        Window win = match (give opened) {
            case Ok(value: x): give x;
            case Err(error: e): { string why = e.message(); t.verdict(name: "a window for the surface cases", why: why); this.stage = 9; return; }
        };
        Result<Instance, GpuError> made = Instance.make();
        Instance inst = match (give made) {
            case Ok(value: i): give i;
            case Err(error: e): { string why = e.message(); t.verdict(name: "an instance for the surface cases", why: why); this.stage = 9; return; }
        };
        Result<Surface, GpuError> onWindow = Surface.make(instance: inst, window: win);
        Surface s = match (give onWindow) {
            case Ok(value: x): give x;
            case Err(error: e): { string why = e.message(); t.verdict(name: "a surface on the window", why: why); this.stage = 9; return; }
        };
        this.early = Optional::Some(value: copy s);
        this.adapterRequest = Optional::Some(value: inst.requestAdapter(options: AdapterOptions.withSurface(surface: s,
                                                                                    power: PowerPreference::HighPerformance)));
        this.surface = Optional::Some(value: give s);
        this.instance = Optional::Some(value: give inst);
        this.window = Optional::Some(value: give win);
        this.stage = 1;
    }

    unsafe fn void awaitAdapter(ref Check t) {
        AdapterStatus status = AdapterStatus::Failed(error: GpuError::Taken);
        match (this.adapterRequest) { case Some(value: r): { status = r.poll(); } case None: { } };
        bool settled = match (status) { case Pending: false; case _: true; };
        if (settled) { this.adapterRequest = Optional::None; }
        match (give status) {
            case Pending: { }
            case Failed(error: e): { string why = e.message(); t.verdict(name: "an adapter for the surface", why: why); this.stage = 9; }
            case Ready(adapter: a): {
                Surface s = match (this.surface) { case Some(value: x): copy x; case None: { this.stage = 9; return; } };
                Result<SurfaceCapabilities, GpuError> asked = s.capabilities(adapter: a);
                SurfaceCapabilities c = match (give asked) {
                    case Ok(value: x): give x;
                    case Err(error: e): { string why = e.message(); t.verdict(name: "a surface answers its capabilities", why: why); this.stage = 9; return; }
                };
                string formats = formatList(fs: c.formats());
                string presents = presentList(ps: c.presentModes());
                string alphas = alphaList(modes: c.alphaModes());
                uint64 usages = c.usages().bits();
                println(s: "info the surface offers ${formats}; ${presents}; ${alphas}; usages ${usages}");
                t.verdict(name: "a surface answers its capabilities", why: "");
                // wgpu-native ends the process on this acquire (measured 3 of 3, 2026-11-10), and a browser throws.
                t.verdict(name: "an acquire before any configure is refused as NotConfigured, not aborted",
                          why: refusedAs(surface: s, want: "NotConfigured"));
                this.deviceRequest = Optional::Some(value: a.requestDevice(options: readOptions()));
                this.caps = Optional::Some(value: give c);
                this.adapter = Optional::Some(value: give a);
                this.stage = 2;
            }
        };
    }

    unsafe fn void awaitDevice(ref Check t) {
        DeviceStatus status = DeviceStatus::Failed(error: GpuError::Taken);
        match (this.deviceRequest) { case Some(value: r): { status = r.poll(); } case None: { } };
        bool settled = match (status) { case Pending: false; case _: true; };
        if (settled) { this.deviceRequest = Optional::None; }
        match (give status) {
            case Pending: { }
            case Failed(error: e): { string why = e.message(); t.verdict(name: "a device for the surface", why: why); this.stage = 9; }
            case Ready(device: d, queue: q): {
                this.device = Optional::Some(value: give d);
                this.queue = Optional::Some(value: give q);
                this.runConfigured(t: t);
            }
        };
    }

    // Every case that answers at once, then the first readback started.
    unsafe fn void runConfigured(ref Check t) {
        Optional<Window> wTaken = replace(place: this.window, with: Optional::None);
        Window win = match (give wTaken) { case Some(value: x): give x; case None: { this.stage = 9; return; } };
        Surface s = match (this.surface) { case Some(value: x): copy x; case None: { this.stage = 9; return; } };
        Surface e = match (this.early) { case Some(value: x): copy x; case None: { this.stage = 9; return; } };
        Instance inst = match (this.instance) { case Some(value: x): copy x; case None: { this.stage = 9; return; } };
        Adapter a = match (this.adapter) { case Some(value: x): copy x; case None: { this.stage = 9; return; } };
        Device d = match (this.device) { case Some(value: x): copy x; case None: { this.stage = 9; return; } };
        Queue q = match (this.queue) { case Some(value: x): copy x; case None: { this.stage = 9; return; } };
        Optional<SurfaceCapabilities> held = replace(place: this.caps, with: Optional::None);
        SurfaceCapabilities c = match (give held) { case Some(value: x): give x; case None: { this.stage = 9; return; } };
        configureCases(t: t, surface: s, early: e, caps: c, device: d, queue: q);
        areaCases(t: t, window: win, surface: s, instance: inst, device: d, caps: c);
        closedCases(t: t, instance: inst, adapter: a, device: d, caps: c);
        this.window = Optional::Some(value: give win);

        Optional<TextureFormat> lw = linearWithTwin(offered: c.formats());
        bool copies = c.usages().has(flags: TextureUsage::CopySrc);
        SurfaceConfig srgb = c.preferred();
        this.caps = Optional::Some(value: give c);
        match (lw) {
            case None: { println(s: "skip a frame read back: the surface offers no linear format with an sRGB form"); this.stage = 5; return; }
            case Some(value: f): {
                if (!copies) { println(s: "skip a frame read back: the surface does not offer CopySrc"); this.stage = 5; return; }
                srgb.format = f;
                srgb.viewFormat = match (f.srgb()) { case Some(value: v): v; case None: f; };
                srgb.usage = TextureUsage::RenderAttachment | TextureUsage::CopySrc;
                Result<Unit, ConfigureError> s1 = s.configure(device: d, config: srgb);
                t.verdict(name: "a linear format through its sRGB view is taken", why: expectRefusal(got: s1, want: "ok"));
                SurfaceConfig plain = srgb;
                plain.viewFormat = f;
                this.linear = Optional::Some(value: plain);
                this.startGrey(t: t, through: e, name: "a frame drawn through the sRGB view, by a copy made before the configure");
                this.stage = 3;
            }
        };
    }

    unsafe fn void startGrey(ref Check t, ref Surface through, const ref string name) {
        Device d = match (this.device) { case Some(value: x): copy x; case None: { return; } };
        Queue q = match (this.queue) { case Some(value: x): copy x; case None: { return; } };
        Result<GreyRead, GpuError> started = startGreyRead(surface: through, device: d, queue: q);
        match (give started) {
            case Ok(value: g): { this.grey = Optional::Some(value: give g); }
            case Err(error: e): { string why = e.message(); t.verdict(name: name, why: why); }
        };
    }

    unsafe fn void awaitGrey(ref Check t, int32 want) {
        string name = want == 188
            ? "a frame drawn through the sRGB view, by a copy made before the configure, reads 0.5 grey as 188"
            : "a frame drawn through the linear view reads 0.5 grey as 128";
        if (this.grey.isNone()) { this.afterGrey(t: t, want: want); return; }
        Device d = match (this.device) { case Some(value: x): copy x; case None: { this.stage = 9; return; } };
        Optional<Result<int32, GpuError>> got = Optional::None;
        match (this.grey) { case Some(value: g): { got = g.poll(device: d); } case None: { } };
        match (got) {
            case None: { }
            case Some(value: r): {
                this.grey = Optional::None;
                t.verdict(name: name, why: greyIs(got: r, want: want));
                this.afterGrey(t: t, want: want);
            }
        };
    }

    unsafe fn void afterGrey(ref Check t, int32 want) {
        if (want != 188) { this.stage = 5; return; }
        Surface s = match (this.surface) { case Some(value: x): copy x; case None: { this.stage = 9; return; } };
        Device d = match (this.device) { case Some(value: x): copy x; case None: { this.stage = 9; return; } };
        Optional<SurfaceConfig> plain = replace(place: this.linear, with: Optional::None);
        match (plain) {
            case None: { this.stage = 5; }
            case Some(value: c): {
                Result<Unit, ConfigureError> s2 = s.configure(device: d, config: c);
                t.verdict(name: "a linear format through itself is taken", why: expectRefusal(got: s2, want: "ok"));
                this.startGrey(t: t, through: s, name: "a frame drawn through the linear view reads 0.5 grey as 128");
                this.stage = 4;
            }
        };
    }

    // On the web an error reaches the channel a tick after the queue is next used, which the readbacks did.
    unsafe fn void lastWords(ref Check t) {
        match (this.device) {
            case Some(value: d): {
                DeviceErrors errs = d.takeErrors();
                t.verdict(name: "no uncaptured WebGPU error on the surface's device", why: errorsSaid(errs: errs));
            }
            case None: { }
        };
        this.stage = 9;
    }
}

@compileFor(ARCH_WASM32)
fn bool noDisplay() { return false; }
@compileFor(!ARCH_WASM32)
fn bool noDisplay() {
    string off = envOr(name: "KAMA_WINDOW_NO_DISPLAY", dflt: "");
    return !off.isEmpty();
}

// A frame cleared to 0.5 grey through its view, its top-left PATCH × PATCH texels on their way to the CPU.
type resource GreyRead {
    Optional<Buffer> buffer = Optional::None;
    Optional<BufferRead> read = Optional::None;

    public unsafe ctor make(Buffer buffer, BufferRead read) {
        this.buffer = Optional::Some(value: give buffer);
        this.read = Optional::Some(value: give read);
    }

    // None while the bytes are on their way; then the grey every texel reads, or why not. Natively it waits on the
    // device; on the web the browser maps the buffer between ticks.
    public unsafe fn Optional<Result<int32, GpuError>> poll(const ref Device device) {
        device.poll(wait: true);
        ReadStatus status = ReadStatus::Pending;
        match (this.read) {
            case Some(value: r): { status = r.poll(); }
            case None: { return Optional::Some(value: Result::Err(error: GpuError::Taken)); }
        };
        match (give status) {
            case Pending: { return Optional::None; }
            case Failed(error: e): { return Optional::Some(value: Result::Err(error: give e)); }
            case Ready: { }
        };
        DynamicArray<uint8> px = match (this.read) { case Some(value: r): r.bytes(); case None: DynamicArray.empty(); };
        if (px.length() < 4) { return Optional::Some(value: Result::Err(error: GpuError::Refused(words: "no texels read"))); }
        int32 grey = cast<int32>(px[0]);
        isize i = 0;
        while (i + 3 < px.length()) {
            if (!near(got: px[i], want: grey) || !near(got: px[i + 1], want: grey) || !near(got: px[i + 2], want: grey)
                || !near(got: px[i + 3], want: 255)) {
                uint8 r = px[i];
                uint8 g = px[i + 1];
                uint8 b = px[i + 2];
                uint8 a = px[i + 3];
                return Optional::Some(value: Result::Err(error: GpuError::Refused(words: "a texel read ${r} ${g} ${b} ${a}, the first ${grey}")));
            }
            i = i + 4;
        }
        return Optional::Some(value: Result::Ok(value: grey));
    }
}

// Acquire a frame, clear it to 0.5 grey through `frame.view()`, copy its top-left PATCH × PATCH texels out, and present
// it, the copy's map started.
unsafe fn Result<GreyRead, GpuError> startGreyRead(ref Surface surface, ref Device device, ref Queue queue) {
    Result<SurfaceTexture, SurfaceError> acquired = surface.acquire();
    SurfaceTexture frame = match (give acquired) {
        case Ok(value: f): give f;
        case Err(error: e): { string why = e.message(); return Result::Err(error: GpuError::Refused(words: "no frame: ${why}")); }
    };
    TextureView view = frame.view();
    Texture texture = frame.texture();
    uint64 bytes = cast<uint64>(ROW) * cast<uint64>(PATCH);
    Buffer buffer = device.createBuffer(descriptor: BufferDescriptor.make(size: bytes,
                                                                        usage: BufferUsage::MapRead | BufferUsage::CopyDst));
    CommandEncoder encoder = device.createCommandEncoder();
    RenderPass pass = encoder.beginRenderPass(target: view, clear: Color.of(r: 0.5, g: 0.5, b: 0.5, a: 1.0));
    give pass.end();
    encoder.copyTextureToBuffer(texture: texture, buffer: buffer, width: PATCH, height: PATCH, bytesPerRow: ROW);
    CommandBuffer commands = give encoder.finish();
    queue.submit(commands: give commands);
    BufferRead read = buffer.mapRead(offset: 0, size: bytes);
    give frame.present();
    return Result::Ok(value: GreyRead.make(buffer: give buffer, read: give read));
}

fn string greyIs(const ref Result<int32, GpuError> got, int32 want) {
    string why = "";
    match (got) {
        case Ok(value: v): {
            if (v < want - 1 || v > want + 1) { why = "read ${v}"; }
        }
        case Err(error: e): { why = e.message(); }
    };
    return why;
}

// ---- a surface holds its window (GPU-2) ------------------------------------------------------------------------------

// A surface on a window of its own, the window dropped on the way out.
unsafe fn Result<Surface, GpuError> surfaceOutlivingWindow(const ref Instance instance) {
    Result<Window, WindowError> opened = Window.openIn(canvas: "#second", title: "@kama/gpu closed window", width: 160,
                                                       height: 100, options: quietly());
    Window window = match (give opened) {
        case Ok(value: opens): give opens;
        case Err(error: e): { string why = e.message(); return Result::Err(error: GpuError::Refused(words: give why)); }
    };
    return Surface.make(instance: instance, window: window);
}

// Adapter options made with such a surface, the surface dropped on the way out too.
unsafe fn Optional<AdapterOptions> optionsOutlivingWindow(const ref Instance instance) {
    Result<Surface, GpuError> made = surfaceOutlivingWindow(instance: instance);
    Optional<AdapterOptions> held = Optional::None;
    match (give made) {
        case Ok(value: s): { held = Optional::Some(value: AdapterOptions.withSurface(surface: s, power: PowerPreference::HighPerformance)); }
        case Err(error: e): { string why = e.message(); println(s: "info no surface for the options: ${why}"); }
    };
    return give held;
}

// A frame acquired from a configured surface on a window of its own, the surface and the window dropped on the way out.
unsafe fn Optional<SurfaceTexture> frameOutlivingWindow(const ref Instance instance, ref Device device, const ref SurfaceConfig config) {
    Result<Window, WindowError> opened = Window.openIn(canvas: "#second", title: "@kama/gpu held frame", width: 160,
                                                       height: 100, options: quietly());
    Window window = match (give opened) {
        case Ok(value: opens): give opens;
        case Err(error: e): { string why = e.message(); println(s: "info no window for the held frame: ${why}"); return Optional::None; }
    };
    Result<Surface, GpuError> made = Surface.make(instance: instance, window: window);
    Surface surface = match (give made) {
        case Ok(value: s): give s;
        case Err(error: e): { string why = e.message(); println(s: "info no surface for the held frame: ${why}"); return Optional::None; }
    };
    Result<Unit, ConfigureError> done = surface.configure(device: device, config: config);
    match (done) {
        case Ok(value: u): { }
        case Err(error: e): { string why = e.message(); println(s: "info the held frame's surface refused: ${why}"); return Optional::None; }
    };
    Result<SurfaceTexture, SurfaceError> got = surface.acquire();
    Optional<SurfaceTexture> frame = Optional::None;
    match (give got) {
        case Ok(value: f): { frame = Optional::Some(value: give f); }
        case Err(error: e): { string why = e.message(); println(s: "info no frame to hold: ${why}"); }
    };
    return give frame;
}

// "" when the window records alive are `want`.
unsafe fn string recordsAre(int32 want) {
    int32 got = windowRecords();
    if (got == want) { return ""; }
    return "${got} window records alive, not ${want}";
}

// What an acquire answered, as a test compares it: "a frame", or the error's name.
fn string acquireName(const ref Result<SurfaceTexture, SurfaceError> got) {
    string what = "a frame";
    match (got) {
        case Ok(value: f): { }
        case Err(error: e): {
            match (e) {
                case Occluded: { what = "Occluded"; }
                case Outdated: { what = "Outdated"; }
                case Lost: { what = "Lost"; }
                case Timeout: { what = "Timeout"; }
                case Failed: { what = "Failed"; }
                case Closed: { what = "Closed"; }
                case NotConfigured: { what = "NotConfigured"; }
            };
        }
    };
    return what;
}

// "" when an acquire on `surface` is refused as `want`, without a frame.
unsafe fn string refusedAs(ref Surface surface, string want) {
    Result<SurfaceTexture, SurfaceError> got = surface.acquire();
    string name = acquireName(got: got);
    if (name == want) { return ""; }
    return "got ${name}";
}

// "" when `surface` gives a frame, cleared and presented; otherwise why not.
unsafe fn string drawnOnce(ref Surface surface, ref Device device, ref Queue queue) {
    Result<SurfaceTexture, SurfaceError> acquired = surface.acquire();
    SurfaceTexture frame = match (give acquired) {
        case Ok(value: f): give f;
        case Err(error: e): { string why = e.message(); return "no frame: ${why}"; }
    };
    TextureView view = frame.view();
    CommandEncoder encoder = device.createCommandEncoder();
    RenderPass pass = encoder.beginRenderPass(target: view, clear: Color.of(r: 0.0, g: 0.0, b: 0.0, a: 1.0));
    give pass.end();
    CommandBuffer commands = give encoder.finish();
    queue.submit(commands: give commands);
    give frame.present();
    return "";
}

// A surface, adapter options made with one, and a frame each hold their window's record after the window is dropped,
// so its system window stays valid under them: natively a configure on a destroyed one aborts wgpu-native (measured
// 2026-11-10). Once the window is closed, nothing reaches it again.
unsafe fn void closedCases(ref Check t, const ref Instance instance, const ref Adapter adapter, ref Device device,
                           const ref SurfaceCapabilities caps) {
    int32 before = windowRecords();
    Result<Surface, GpuError> made = surfaceOutlivingWindow(instance: instance);
    match (give made) {
        case Err(error: e): { string why = e.message(); t.verdict(name: "a surface on a window that then closes", why: why); return; }
        case Ok(value: surface): {
            t.verdict(name: "a surface holds its window's record after the window is dropped", why: recordsAre(want: before + 1));
            SurfaceConfig config = caps.preferred();
            Result<Unit, ConfigureError> r = surface.configure(device: device, config: config);
            t.verdict(name: "a surface on a closed window refuses to configure, as Closed",
                      why: expectRefusal(got: r, want: "Closed"));
            Result<SurfaceTexture, SurfaceError> a = surface.acquire();
            string got = acquireName(got: a);
            if (got == "Closed") { t.verdict(name: "a surface on a closed window refuses to acquire, as Closed", why: ""); }
            else { t.verdict(name: "a surface on a closed window refuses to acquire, as Closed", why: "got ${got}"); }
            Result<SurfaceCapabilities, GpuError> c = surface.capabilities(adapter: adapter);
            match (c) {
                case Ok(value: k): { t.verdict(name: "a surface on a closed window refuses its capabilities", why: "it answered them"); }
                case Err(error: e): { t.verdict(name: "a surface on a closed window refuses its capabilities", why: ""); }
            };
        }
    };
    t.verdict(name: "the surface's drop frees the closed window's record", why: recordsAre(want: before));

    Optional<AdapterOptions> options = optionsOutlivingWindow(instance: instance);
    match (give options) {
        case None: { t.verdict(name: "adapter options with a surface on a window that then closes", why: "none"); }
        case Some(value: o): {
            t.verdict(name: "adapter options made with a surface hold its window's record", why: recordsAre(want: before + 1));
        }
    };
    t.verdict(name: "the options' drop frees the record", why: recordsAre(want: before));

    SurfaceConfig preferred = caps.preferred();
    Optional<SurfaceTexture> frame = frameOutlivingWindow(instance: instance, device: device, config: preferred);
    match (give frame) {
        case None: { t.verdict(name: "a frame from a window that then closes", why: "no frame"); }
        case Some(value: f): {
            t.verdict(name: "a frame holds its window's record after its surface and window are dropped",
                      why: recordsAre(want: before + 1));
            give f.present();   // the window is closed: the frame is dropped, never presented
        }
    };
    t.verdict(name: "the frame's drop frees the record", why: recordsAre(want: before));
}

// A window with no area, refused as NoArea: natively the window minimised without taking the focus, then restored; on
// the web a canvas the page does not display. A window past the device's maxTextureDimension2D, refused as TooLarge: on
// the web a canvas 6000 CSS pixels wide at a scale of 1.5; natively no system window here is that wide.
@compileFor(!ARCH_WASM32)
unsafe fn void areaCases(ref Check t, ref Window window, ref Surface surface, const ref Instance instance, ref Device device,
                         const ref SurfaceCapabilities caps) {
    SurfaceConfig preferred = caps.preferred();
    NativeWindow n = window.nativeHandle();
    if (minimise(hwnd: n.window(), minimised: 1) < 0) {
        println(s: "skip a window with no area: minimising one is asked of Win32 here");
    } else {
        window.pump();
        Result<Unit, ConfigureError> r = surface.configure(device: device, config: preferred);
        t.verdict(name: "a minimised window, with no area, is refused as NoArea, not aborted", why: expectRefusal(got: r, want: "NoArea"));
        minimise(hwnd: n.window(), minimised: 0);
        window.pump();
        Result<Unit, ConfigureError> back = surface.configure(device: device, config: preferred);
        t.verdict(name: "restored, it is configured again", why: expectRefusal(got: back, want: "ok"));
    }
    println(s: "skip a window past maxTextureDimension2D: no system window here is wider than 8192 pixels");
}

@compileFor(ARCH_WASM32)
unsafe fn void areaCases(ref Check t, ref Window window, ref Surface surface, const ref Instance instance, ref Device device,
                         const ref SurfaceCapabilities caps) {
    SurfaceConfig preferred = caps.preferred();
    WindowOptions byPage = quietly();
    byPage.sizedByPage = true;
    Result<Window, WindowError> flat = Window.openIn(canvas: "#flat", title: "flat", width: 320, height: 200, options: byPage);
    match (give flat) {
        case Err(error: e): { string why = e.message(); t.verdict(name: "a canvas with no area is refused as NoArea", why: "no window: " + why); }
        case Ok(value: flatWindow): {
            Result<Surface, GpuError> made = Surface.make(instance: instance, window: flatWindow);
            match (give made) {
                case Err(error: e): { string why = e.message(); t.verdict(name: "a canvas with no area is refused as NoArea", why: "no surface: " + why); }
                case Ok(value: s): {
                    Result<Unit, ConfigureError> r = s.configure(device: device, config: preferred);
                    t.verdict(name: "a canvas with no area is refused as NoArea", why: expectRefusal(got: r, want: "NoArea"));
                }
            };
        }
    };
    Limits limits = device.limits();
    uint32 most = limits.maxTextureDimension2D;
    // One CSS pixel past the most, so past it in pixels at any device scale of 1 or more.
    int32 past = cast<int32>(most) + 1;
    Result<Window, WindowError> wide = Window.openIn(canvas: "#wide", title: "wide", width: past, height: 10, options: quietly());
    match (give wide) {
        case Err(error: e): { string why = e.message(); t.verdict(name: "a canvas wider than maxTextureDimension2D is refused as TooLarge, naming the most", why: "no window: " + why); }
        case Ok(value: wideWindow): {
            Size px = wideWindow.framebufferSize();
            int32 pw = px.width;
            int32 ph = px.height;
            println(s: "info the wide canvas is ${pw}×${ph} pixels");
            Result<Surface, GpuError> made = Surface.make(instance: instance, window: wideWindow);
            match (give made) {
                case Err(error: e): { string why = e.message(); t.verdict(name: "a canvas wider than maxTextureDimension2D is refused as TooLarge, naming the most", why: "no surface: " + why); }
                case Ok(value: s): {
                    Result<Unit, ConfigureError> r = s.configure(device: device, config: preferred);
                    t.verdict(name: "a canvas wider than maxTextureDimension2D is refused as TooLarge, naming the most",
                              why: expectRefusal(got: r, want: "TooLarge ${most}"));
                }
            };
        }
    };
    // #twod holds the page's 2D context, so the browser gives it no WebGPU context, as a browser without WebGPU gives
    // none to any canvas: the surface is refused, saying so, where emdawnwebgpu's own check would end the program.
    Result<Window, WindowError> twod = Window.openIn(canvas: "#twod", title: "twod", width: 64, height: 64, options: quietly());
    match (give twod) {
        case Err(error: e): { string why = e.message(); t.verdict(name: "a canvas the browser gives no WebGPU context is refused, not aborted", why: "no window: " + why); }
        case Ok(value: twodWindow): {
            Result<Surface, GpuError> made = Surface.make(instance: instance, window: twodWindow);
            string got = match (give made) {
                case Ok(value: s): "a surface";
                case Err(error: e): e.message();
            };
            string want = "the browser gives this canvas no WebGPU context";
            t.verdict(name: "a canvas the browser gives no WebGPU context is refused, not aborted",
                      why: got == want ? "" : "got `" + got + "`, not `" + want + "`");
        }
    };
}

// A present mode, an alpha mode, and so on, the surface does not offer, or None when it offers them all.
fn Optional<PresentMode> presentNotIn(const ref DynamicArray<PresentMode> offered) {
    DynamicArray<PresentMode> all = presents1(a: PresentMode::Mailbox);
    all.add(item: PresentMode::Immediate);
    all.add(item: PresentMode::FifoRelaxed);
    isize i = 0;
    while (i < all.length()) {
        bool there = false;
        isize j = 0;
        while (j < offered.length()) { if (offered[j] == all[i]) { there = true; } j = j + 1; }
        if (!there) { return Optional::Some(value: all[i]); }
        i = i + 1;
    }
    return Optional::None;
}

fn Optional<AlphaMode> alphaNotIn(const ref DynamicArray<AlphaMode> offered) {
    DynamicArray<AlphaMode> all = alphas1(a: AlphaMode::Premultiplied);
    all.add(item: AlphaMode::Unpremultiplied);
    all.add(item: AlphaMode::Inherit);
    all.add(item: AlphaMode::Opaque);
    isize i = 0;
    while (i < all.length()) {
        bool there = false;
        isize j = 0;
        while (j < offered.length()) { if (offered[j] == all[i]) { there = true; } j = j + 1; }
        if (!there) { return Optional::Some(value: all[i]); }
        i = i + 1;
    }
    return Optional::None;
}

// The first format the surface offers that is linear and has an sRGB form, or None.
fn Optional<TextureFormat> linearWithTwin(const ref DynamicArray<TextureFormat> offered) {
    isize i = 0;
    while (i < offered.length()) {
        TextureFormat f = offered[i];
        Optional<TextureFormat> s = f.srgb();
        if (!f.isSrgb() && s.isSome()) { return Optional::Some(value: f); }
        i = i + 1;
    }
    return Optional::None;
}

// Each configure the package must refuse rather than let wgpu-native abort the process (each one measured aborting it,
// 2026-11-10) or a browser throw, then every choice the surface offers, the preferred config, and frames from it.
unsafe fn void configureCases(ref Check t, ref Surface surface, ref Surface early, const ref SurfaceCapabilities caps,
                              ref Device device, ref Queue queue) {
    SurfaceConfig preferred = caps.preferred();
    Optional<PresentMode> pm = presentNotIn(offered: caps.presentModes());
    match (pm) {
        case Some(value: m): {
            SurfaceConfig c = caps.preferred();
            c.present = m;
            Result<Unit, ConfigureError> r = surface.configure(device: device, config: c);
            t.verdict(name: "a present mode the surface does not offer is refused as NotOffered", why: expectRefusal(got: r, want: "NotOffered"));
        }
        case None: { println(s: "skip a present mode not offered: the surface offers every one"); }
    };
    Optional<AlphaMode> am = alphaNotIn(offered: caps.alphaModes());
    match (am) {
        case Some(value: m): {
            SurfaceConfig c = caps.preferred();
            c.alpha = m;
            Result<Unit, ConfigureError> r = surface.configure(device: device, config: c);
            t.verdict(name: "an alpha mode the surface does not offer is refused as NotOffered", why: expectRefusal(got: r, want: "NotOffered"));
        }
        case None: { println(s: "skip an alpha mode not offered: the surface offers every one"); }
    };
    SurfaceConfig depth = caps.preferred();
    depth.format = TextureFormat::Depth32Float;
    depth.viewFormat = TextureFormat::Depth32Float;
    Result<Unit, ConfigureError> df = surface.configure(device: device, config: depth);
    t.verdict(name: "a format the surface does not offer is refused as NotOffered", why: expectRefusal(got: df, want: "NotOffered"));
    SurfaceConfig other = caps.preferred();
    other.viewFormat = TextureFormat::RGBA16Float;
    Result<Unit, ConfigureError> vf = surface.configure(device: device, config: other);
    t.verdict(name: "a view format that changes more than sRGB-ness is refused as NotOffered",
              why: expectRefusal(got: vf, want: "NotOffered"));
    // A configure with no usage cannot be written: there is no empty TextureUsage (tests/xfail/usage_mixed).
    if (!caps.usages().has(flags: TextureUsage::StorageBinding)) {
        SurfaceConfig storage = caps.preferred();
        storage.usage = TextureUsage::RenderAttachment | TextureUsage::StorageBinding;
        Result<Unit, ConfigureError> su = surface.configure(device: device, config: storage);
        t.verdict(name: "a usage the surface does not offer is refused as NotOffered", why: expectRefusal(got: su, want: "NotOffered"));
    } else {
        println(s: "skip a usage not offered: the surface offers StorageBinding");
    }
    // Every configure so far was refused before WebGPU saw it, so the surface has never been configured.
    t.verdict(name: "a surface whose every configure was refused is still refused as NotConfigured",
              why: refusedAs(surface: surface, want: "NotConfigured"));

    // Each choice the surface offers is taken: what the package read agrees with what WebGPU checks, which natively
    // would abort the process on a choice the surface does not offer.
    string bad = "";
    isize i = 0;
    while (i < caps.formats().length() && bad.isEmpty()) {
        SurfaceConfig c = caps.preferred();
        c.format = caps.formats()[i];
        c.viewFormat = c.format;
        Result<Unit, ConfigureError> r = surface.configure(device: device, config: c);
        string got = refusal(got: r);
        if (got != "ok") { string n = c.format.name(); bad = "format ${n}: ${got}"; }
        i = i + 1;
    }
    i = 0;
    while (i < caps.presentModes().length() && bad.isEmpty()) {
        SurfaceConfig c = caps.preferred();
        c.present = caps.presentModes()[i];
        Result<Unit, ConfigureError> r = surface.configure(device: device, config: c);
        string got = refusal(got: r);
        if (got != "ok") { string n = c.present.name(); bad = "present mode ${n}: ${got}"; }
        i = i + 1;
    }
    i = 0;
    while (i < caps.alphaModes().length() && bad.isEmpty()) {
        SurfaceConfig c = caps.preferred();
        c.alpha = caps.alphaModes()[i];
        Result<Unit, ConfigureError> r = surface.configure(device: device, config: c);
        string got = refusal(got: r);
        if (got != "ok") { string n = c.alpha.name(); bad = "alpha mode ${n}: ${got}"; }
        i = i + 1;
    }
    if (bad.isEmpty()) {
        SurfaceConfig c = caps.preferred();
        c.usage = caps.usages();
        Result<Unit, ConfigureError> r = surface.configure(device: device, config: c);
        string got = refusal(got: r);
        if (got != "ok") { bad = "every usage it offers at once: ${got}"; }
    }
    t.verdict(name: "every format, present mode, alpha mode and usage the surface offers is taken", why: bad);

    Result<Unit, ConfigureError> taken = surface.configure(device: device, config: preferred);
    t.verdict(name: "the preferred config is taken, at the window's size", why: expectRefusal(got: taken, want: "ok"));
    t.verdict(name: "a configured surface gives a frame", why: drawnOnce(surface: surface, device: device, queue: queue));
    t.verdict(name: "a copy made before the configure gives a frame after it",
              why: drawnOnce(surface: early, device: device, queue: queue));
    addSurfaceRef(surface: surface.raw());
    Surface adopted = Surface.adopt(raw: surface.raw());
    t.verdict(name: "an adopted surface is taken as configured by its maker",
              why: drawnOnce(surface: adopted, device: device, queue: queue));
    Result<Unit, ConfigureError> unsized = adopted.configure(device: device, config: preferred);
    t.verdict(name: "an adopted surface, with no window to size it, is refused as NoWindow: its maker configures it",
              why: expectRefusal(got: unsized, want: "NoWindow"));
}

// ---- a device's errors on the web's timing, on both legs (GPU-3) -----------------------------------------------------

comptime int32 SETTLE_TICKS = 30;   // the most a case waits for what it expects; on the web it arrives a tick after a flush
comptime int32 QUIET_TICKS = 5;     // how long a case waits before it says nothing more arrived

// Whether a drain found anything.
fn bool arrived(const ref Optional<DeviceErrors> got) {
    return match (got) { case Some(value: errs): !errs.isEmpty(); case None: false; };
}

// What a command buffer whose finish failed leaves in the channel once submitted: natively the finish's error alone,
// since the package never submits it (AGENTS.gpu.md item 2, decision 3); on the web the browser's refusal of the submit
// as well ("[Invalid CommandBuffer] is invalid due to a previous error", measured 2026-11-11).
@compileFor(ARCH_WASM32)
fn isize spoiledReports() { return 2; }
@compileFor(!ARCH_WASM32)
fn isize spoiledReports() { return 1; }

// A device's errors, its scopes and its state, each case written for the web's timing and run on both legs. On the web an
// error reaches the device's channel only once its queue is next used, by the next tick (measured 2026-11-11: never while
// nothing is queued), and a pop is answered a tick later; natively each is in by the time it is polled. So a case acts,
// uses the queues (`flush`), and checks a tick or more later. The native cases above hold wgpu-native's own timing: in
// the channel when the call returns.
type resource ErrorRun {
    int32 stage = 0;
    int32 waited = 0;
    Instant began = monotonicNow();
    Optional<Instance> instance = Optional::None;
    Optional<AdapterPool> pool = Optional::None;
    Optional<DeviceRequest> requestA = Optional::None;
    Optional<DeviceRequest> requestB = Optional::None;
    Optional<Device> deviceA = Optional::None;
    Optional<Device> deviceB = Optional::None;
    Optional<Queue> queueA = Optional::None;
    Optional<Queue> queueB = Optional::None;
    Optional<ScopePop> popping = Optional::None;
    uint64 provoked = 0;   // the errors provoked so far, each distinct (`pastLargest`)

    public ctor make() { }

    // The next distinct error's number, and `count` more after it taken.
    unsafe fn uint64 nextErrors(uint64 count) {
        uint64 k = this.provoked + 1;
        this.provoked = this.provoked + count;
        return k;
    }

    // One tick's step: true once every case has run.
    public unsafe fn bool step(ref Check t) {
        if (this.stage < 99 && this.began.elapsed().asMillis() > TIMEOUT_MS) {
            int32 at = this.stage;
            t.verdict(name: "the error cases on the web's timing end within 10 s", why: "timed out at stage ${at}");
            return true;
        }
        this.waited = this.waited + 1;
        if (this.stage == 0) { this.open(t: t); }
        else if (this.stage == 1) { this.awaitAdapters(t: t); }
        else if (this.stage == 2) { this.awaitDevices(t: t); }
        else if (this.stage == 10) { this.provokeOne(); }
        else if (this.stage == 11) { this.checkOne(t: t); }
        else if (this.stage == 20) { this.scopeCatches(t: t); }
        else if (this.stage == 21) { this.awaitCaught(t: t); }
        else if (this.stage == 22) { this.caughtStaysOut(t: t); }
        else if (this.stage == 30) { this.scopePasses(t: t); }
        else if (this.stage == 31) { this.awaitPassed(t: t); }
        else if (this.stage == 32) { this.passedReaches(t: t); }
        else if (this.stage == 40) { this.scopeDropped(); }
        else if (this.stage == 41) { this.droppedReaches(t: t); }
        else if (this.stage == 50) { this.flood(); }
        else if (this.stage == 51) { this.fullRing(t: t); }
        else if (this.stage == 60) { this.spoil(); }
        else if (this.stage == 61) { this.spoiled(t: t); }
        else if (this.stage == 70) { this.provokeHuge(); }
        else if (this.stage == 71) { this.hugeRefused(t: t); }
        return this.stage >= 99;
    }

    unsafe fn void next(int32 to) { this.stage = to; this.waited = 0; }

    unsafe fn void open(ref Check t) {
        Result<Instance, GpuError> made = Instance.make();
        match (give made) {
            case Ok(value: inst): {
                this.pool = Optional::Some(value: AdapterPool.make(instance: inst, count: 2));
                this.instance = Optional::Some(value: give inst);
                this.next(to: 1);
            }
            case Err(error: e): { string why = e.message(); t.verdict(name: "an instance for the error cases", why: why); this.next(to: 99); }
        };
    }

    unsafe fn void awaitAdapters(ref Check t) {
        Optional<AdapterPool> taken = replace(place: this.pool, with: Optional::None);
        AdapterPool p = match (give taken) { case Some(value: x): give x; case None: { this.next(to: 99); return; } };
        bool done = p.settled();
        if (!done) { this.pool = Optional::Some(value: give p); return; }
        string failure = p.failedWith();
        Optional<Adapter> one = p.take();
        Optional<Adapter> two = p.take();
        match (give one) {
            case None: {
                Optional<Adapter> unused = give two;
                t.verdict(name: "two adapters for the error cases", why: "none: " + failure);
                this.next(to: 99);
            }
            case Some(value: a): {
                match (give two) {
                    case None: { t.verdict(name: "two adapters for the error cases", why: "one: " + failure); this.next(to: 99); }
                    case Some(value: b): {
                        this.requestA = Optional::Some(value: a.requestDevice(options: readOptions()));
                        this.requestB = Optional::Some(value: b.requestDevice(options: readOptions()));
                        this.next(to: 2);
                    }
                };
            }
        };
    }

    unsafe fn void awaitDevices(ref Check t) {
        if (this.requestA.isSome()) {
            DeviceStatus s = pollOne(slot: this.requestA);
            match (give s) {
                case Pending: { }
                case Ready(device: d, queue: q): { this.deviceA = Optional::Some(value: give d); this.queueA = Optional::Some(value: give q); }
                case Failed(error: e): { string why = e.message(); t.verdict(name: "a device for the error cases", why: why); this.next(to: 99); return; }
            };
        }
        if (this.requestB.isSome()) {
            DeviceStatus s = pollOne(slot: this.requestB);
            match (give s) {
                case Pending: { }
                case Ready(device: d, queue: q): { this.deviceB = Optional::Some(value: give d); this.queueB = Optional::Some(value: give q); }
                case Failed(error: e): { string why = e.message(); t.verdict(name: "a second device for the error cases", why: why); this.next(to: 99); return; }
            };
        }
        if (this.deviceA.isSome() && this.deviceB.isSome()) { this.next(to: 10); }
    }

    // An empty command buffer submitted on each device's queue: on the web, what lets a pending error through.
    unsafe fn void flush() {
        match (this.deviceA) {
            case Some(value: d): {
                match (this.queueA) {
                    case Some(value: q): { CommandEncoder enc = d.createCommandEncoder(); CommandBuffer cb = give enc.finish(); q.submit(commands: give cb); }
                    case None: { }
                };
            }
            case None: { }
        };
        match (this.deviceB) {
            case Some(value: d): {
                match (this.queueB) {
                    case Some(value: q): { CommandEncoder enc = d.createCommandEncoder(); CommandBuffer cb = give enc.finish(); q.submit(commands: give cb); }
                    case None: { }
                };
            }
            case None: { }
        };
    }

    // What device A's channel holds now, drained; None when there is no device.
    unsafe fn Optional<DeviceErrors> drainA() {
        Optional<DeviceErrors> got = Optional::None;
        match (this.deviceA) {
            case Some(value: d): { DeviceErrors errs = d.takeErrors(); got = Optional::Some(value: give errs); }
            case None: { }
        };
        return give got;
    }

    // An error on one device: its channel, once its queue is used, and not the other's.
    unsafe fn void provokeOne() {
        uint64 k = this.nextErrors(count: 1);
        match (this.deviceA) { case Some(value: d): { Buffer bad = pastLargest(device: d, by: k); } case None: { } };
        this.flush();
        this.next(to: 11);
    }

    unsafe fn void checkOne(ref Check t) {
        Optional<DeviceErrors> got = this.drainA();
        int32 ticks = this.waited;
        if (!arrived(got: got)) {
            if (ticks < SETTLE_TICKS) { return; }
            t.verdict(name: "an error reaches its own device's channel once the device's queue is used",
                      why: "nothing within ${ticks} ticks");
            this.next(to: 20);
            return;
        }
        match (got) {
            case None: { }
            case Some(value: errs): {
                string one = holds(errs: errs, want: 1, kind: GpuErrorKind::Validation);
                if (one.isEmpty()) {
                    string words = errs.reports()[0].message();
                    println(s: "info the error, ${ticks} tick(s) after the flush: ${words}");
                }
                t.verdict(name: "an error reaches its own device's channel once the device's queue is used", why: one);
                t.verdict(name: "a buffer's label names it in its error's words", why: namedIn(errs: errs, label: "past the largest"));
                match (this.deviceB) {
                    case Some(value: b): {
                        DeviceErrors other = b.takeErrors();
                        t.verdict(name: "and not another device's", why: other.isEmpty() ? "" : "the other's holds " + errorsSaid(errs: other));
                    }
                    case None: { }
                };
            }
        };
        this.next(to: 20);
    }

    // A scope catches the error made in it, its pop answered a tick later on the web; a pop out of order is refused.
    unsafe fn void scopeCatches(ref Check t) {
        uint64 k = this.nextErrors(count: 1);
        match (this.deviceA) {
            case Some(value: d): {
                ErrorScope outer = d.pushErrorScope(filter: ErrorFilter::Validation);
                ErrorScope inner = d.pushErrorScope(filter: ErrorFilter::Validation);
                Result<ScopePop, GpuError> early = give outer.pop();
                bool outOfOrder = match (early) { case Err(error: e): match (e) { case OutOfOrder: true; case _: false; }; case Ok(value: p): false; };
                t.verdict(name: "a pop out of order is refused as OutOfOrder, on every leg", why: outOfOrder ? "" : "it was not refused as OutOfOrder");
                Result<ScopePop, GpuError> late = give inner.pop();
                ErrorScope s = d.pushErrorScope(filter: ErrorFilter::Validation);
                Buffer bad = pastLargest(device: d, by: k);
                Result<ScopePop, GpuError> popped = give s.pop();
                match (give popped) {
                    case Ok(value: p): { this.popping = Optional::Some(value: give p); }
                    case Err(error: e): { string why = e.message(); t.verdict(name: "a scope catches the error made in it", why: "its pop was refused: " + why); }
                };
            }
            case None: { }
        };
        this.flush();
        this.next(to: 21);
    }

    unsafe fn void awaitCaught(ref Check t) {
        if (this.popping.isNone()) { this.next(to: 30); return; }
        PopStatus s = PopStatus::Pending;
        match (this.popping) { case Some(value: p): { s = p.poll(); } case None: { } };
        int32 ticks = this.waited;
        match (give s) {
            case Pending: {
                if (ticks < SETTLE_TICKS) { return; }
                t.verdict(name: "a scope catches the error made in it", why: "its pop was not answered within ${ticks} ticks");
            }
            case Ready(caught: c): {
                string why = match (c) {
                    case Some(value: r): r.kind() == GpuErrorKind::Validation ? "" : "it caught another kind";
                    case None: "it caught nothing";
                };
                println(s: "info the pop answered ${ticks} tick(s) after it was made");
                t.verdict(name: "a scope catches the error made in it", why: why);
            }
            case Failed(error: e): { string why = e.message(); t.verdict(name: "a scope catches the error made in it", why: "its pop failed: " + why); }
        };
        this.popping = Optional::None;
        this.flush();
        this.next(to: 22);
    }

    unsafe fn void caughtStaysOut(ref Check t) {
        if (this.waited < QUIET_TICKS) { return; }
        Optional<DeviceErrors> got = this.drainA();
        string why = "";
        match (got) {
            case Some(value: errs): { if (!errs.isEmpty()) { why = "the channel holds " + errorsSaid(errs: errs); } }
            case None: { }
        };
        t.verdict(name: "what a scope caught does not reach the channel", why: why);
        this.next(to: 30);
    }

    // A scope with another filter catches nothing, and the error goes on to the channel.
    unsafe fn void scopePasses(ref Check t) {
        uint64 k = this.nextErrors(count: 1);
        match (this.deviceA) {
            case Some(value: d): {
                ErrorScope s = d.pushErrorScope(filter: ErrorFilter::OutOfMemory);
                Buffer bad = pastLargest(device: d, by: k);
                Result<ScopePop, GpuError> popped = give s.pop();
                match (give popped) {
                    case Ok(value: p): { this.popping = Optional::Some(value: give p); }
                    case Err(error: e): { string why = e.message(); t.verdict(name: "a scope with another filter catches nothing", why: "its pop was refused: " + why); }
                };
            }
            case None: { }
        };
        this.flush();
        this.next(to: 31);
    }

    unsafe fn void awaitPassed(ref Check t) {
        if (this.popping.isNone()) { this.next(to: 32); return; }
        PopStatus s = PopStatus::Pending;
        match (this.popping) { case Some(value: p): { s = p.poll(); } case None: { } };
        int32 ticks = this.waited;
        match (give s) {
            case Pending: {
                if (ticks < SETTLE_TICKS) { return; }
                t.verdict(name: "a scope with another filter catches nothing", why: "its pop was not answered within ${ticks} ticks");
            }
            case Ready(caught: c): {
                string why = match (c) { case Some(value: r): "it caught: " + r.message(); case None: ""; };
                t.verdict(name: "a scope with another filter catches nothing", why: why);
            }
            case Failed(error: e): { string why = e.message(); t.verdict(name: "a scope with another filter catches nothing", why: "its pop failed: " + why); }
        };
        this.popping = Optional::None;
        this.flush();
        this.next(to: 32);
    }

    unsafe fn void passedReaches(ref Check t) {
        Optional<DeviceErrors> got = this.drainA();
        int32 ticks = this.waited;
        if (!arrived(got: got)) {
            if (ticks < SETTLE_TICKS) { return; }
            t.verdict(name: "and the error goes on to the channel", why: "nothing within ${ticks} ticks");
            this.next(to: 40);
            return;
        }
        match (got) {
            case None: { }
            case Some(value: errs): {
                t.verdict(name: "and the error goes on to the channel", why: holds(errs: errs, want: 1, kind: GpuErrorKind::Validation));
            }
        };
        this.next(to: 40);
    }

    // A scope dropped unpopped pops itself, and what it caught reaches the channel.
    unsafe fn void scopeDropped() {
        uint64 k = this.nextErrors(count: 1);
        match (this.deviceA) {
            case Some(value: d): { dropScopeOver(device: d, by: k); }
            case None: { }
        };
        this.flush();
        this.next(to: 41);
    }

    unsafe fn void droppedReaches(ref Check t) {
        Optional<DeviceErrors> got = this.drainA();
        int32 ticks = this.waited;
        if (!arrived(got: got)) {
            if (ticks < SETTLE_TICKS) { if (ticks % 2 == 0) { this.flush(); } return; }
            t.verdict(name: "a scope dropped unpopped pops itself, and what it caught reaches the channel", why: "nothing within ${ticks} ticks");
            this.next(to: 50);
            return;
        }
        match (got) {
            case None: { }
            case Some(value: errs): {
                t.verdict(name: "a scope dropped unpopped pops itself, and what it caught reaches the channel",
                          why: holds(errs: errs, want: 1, kind: GpuErrorKind::Validation));
            }
        };
        this.next(to: 50);
    }

    // A full channel keeps the oldest 64 and counts the rest.
    unsafe fn void flood() {
        uint64 from = this.nextErrors(count: 70);
        match (this.deviceA) {
            case Some(value: d): {
                uint64 k = 0;
                while (k < 70) { Buffer bad = pastLargest(device: d, by: from + k); k = k + 1; }
            }
            case None: { }
        };
        this.flush();
        this.next(to: 51);
    }

    unsafe fn void fullRing(ref Check t) {
        if (this.waited < QUIET_TICKS) { return; }
        Optional<DeviceErrors> got = this.drainA();
        string why = "nothing reached the channel";
        match (got) {
            case None: { }
            case Some(value: errs): {
                if (errs.isEmpty()) { return; }
                isize kept = errs.reports().length();
                int64 lost = errs.dropped();
                why = kept == 64 && lost == 6 ? "" : "${kept} kept and ${lost} dropped, not 64 and 6";
            }
        };
        t.verdict(name: "70 errors at once: the channel keeps the oldest 64 and counts the other 6", why: why);
        this.next(to: 60);
    }

    // A command buffer whose finish failed runs nothing: natively it is never submitted, and a browser refuses its submit.
    unsafe fn void spoil() {
        match (this.deviceB) {
            case Some(value: d): {
                match (this.queueB) {
                    case Some(value: q): {
                        CommandEncoder enc = badCopy(device: d);
                        CommandBuffer cb = give enc.finish();
                        q.submit(commands: give cb);
                    }
                    case None: { }
                };
            }
            case None: { }
        };
        this.flush();
        this.next(to: 61);
    }

    unsafe fn void spoiled(ref Check t) {
        if (this.waited < QUIET_TICKS) { return; }
        string why = "no second device";
        match (this.deviceB) {
            case Some(value: d): {
                DeviceErrors errs = d.takeErrors();
                isize n = errs.reports().length();
                isize want = spoiledReports();
                why = n == want ? "" : "${n} reports, not ${want}: " + errorsSaid(errs: errs);
                if (why.isEmpty() && n > 0) {
                    string words = errs.reports()[n - 1].message();
                    println(s: "info the last of them: ${words}");
                }
            }
            case None: { }
        };
        t.verdict(name: "a command buffer whose finish failed runs nothing: its error is in the channel, and on the web the browser's refusal of its submit",
                  why: why);
        this.next(to: 70);
    }

    // A buffer of 2^60 bytes, which the browser's JavaScript API throws on: a validation error once the package clamps it.
    unsafe fn void provokeHuge() {
        match (this.deviceA) { case Some(value: d): { Buffer huge = hugeBuffer(device: d); } case None: { } };
        this.flush();
        this.next(to: 71);
    }

    unsafe fn void hugeRefused(ref Check t) {
        Optional<DeviceErrors> got = this.drainA();
        int32 ticks = this.waited;
        if (!arrived(got: got)) {
            if (ticks < SETTLE_TICKS) { return; }
            t.verdict(name: "a buffer of 2^60 bytes is a validation error, not the end of the program", why: "nothing within ${ticks} ticks");
            this.next(to: 99);
            return;
        }
        GpuErrorKind expected = hugeBufferOutOfMemory() ? GpuErrorKind::OutOfMemory : GpuErrorKind::Validation;
        string why = match (got) { case Some(value: errs): holds(errs: errs, want: 1, kind: expected); case None: "none"; };
        t.verdict(name: "a buffer of 2^60 bytes is a validation error, not the end of the program", why: why);
        this.next(to: 99);
    }
}

// ---- a device's errors (GPU-1): natively, where an error is in the channel when the call that caused it returns --------

fn string kindName(GpuErrorKind k) {
    return match (k) {
        case Validation: "Validation";
        case OutOfMemory: "OutOfMemory";
        case Internal: "Internal";
        case Unknown: "Unknown";
    };
}

// A drain, for a verdict on a device that must have none: "" when it is empty.
fn string errorsSaid(const ref DeviceErrors errs) {
    if (errs.isEmpty()) { return ""; }
    isize n = errs.reports().length();
    int64 dropped = errs.dropped();
    if (n == 0) { return "${dropped} dropped"; }
    string earliest = errs.reports()[0].message();
    return "${n} reported and ${dropped} dropped, the first: ${earliest}";
}

// A drain, for a verdict: "" when it holds exactly `want` reports, each of `kind`, and dropped none.
fn string holds(const ref DeviceErrors errs, isize want, GpuErrorKind kind) {
    isize n = errs.reports().length();
    int64 dropped = errs.dropped();
    if (n != want) { return "${n} reported, not ${want}"; }
    if (dropped != 0) { return "${dropped} dropped"; }
    isize i = 0;
    while (i < n) {
        GpuErrorKind got = errs.reports()[i].kind();
        if (got != kind) {
            string name = kindName(k: got);
            return "report ${i} is ${name}";
        }
        string words = errs.reports()[i].message();
        if (words.isEmpty()) { return "report ${i} has no words"; }
        i = i + 1;
    }
    return "";
}

fn string lossSaid(const ref Optional<DeviceLoss> loss) {
    return match (loss) {
        case Some(value: l): l.message();
        case None: "not lost";
    };
}

// A validation error in words of its own: a buffer `by` bytes past the device's largest, whose size each implementation
// names. Firefox 160 reports a device's uncaptured error once for each message, dropping a repeat (GPU-14, measured
// 2026-11-12), so the cases on the web's timing make each error they wait for distinct.
unsafe fn Buffer pastLargest(ref Device device, uint64 by) {
    Limits l = device.limits();
    BufferDescriptor d = BufferDescriptor.make(size: l.maxBufferSize + by, usage: BufferUsage::CopyDst);
    d.label(text: "past the largest");
    return device.createBuffer(descriptor: give d);
}

// MapRead may be combined only with CopyDst: a validation error.
unsafe fn Buffer badBuffer(ref Device device) {
    BufferDescriptor d = BufferDescriptor.make(size: 16, usage: BufferUsage::MapRead | BufferUsage::Storage);
    d.label(text: "badly used");
    return device.createBuffer(descriptor: give d);
}

// A buffer of 2^60 bytes, past what WebGPU's JavaScript API takes (2^53 - 1, which a browser throws on): a validation
// error on both legs, never the end of the program (AGENTS.gpu.md item 12, decision 9).
unsafe fn Buffer hugeBuffer(ref Device device) {
    return device.createBuffer(descriptor: BufferDescriptor.make(size: 1152921504606846976, usage: BufferUsage::CopyDst));
}

// "" when `errs` holds one error whose words name `label`.
fn string namedIn(const ref DeviceErrors errs, const ref string label) {
    if (errs.reports().length() != 1) { return errorsSaid(errs: errs); }
    string words = errs.reports()[0].message();
    if (!words.contains(substring: label)) { return "its words do not name `${label}`: ${words}"; }
    return "";
}

// A texture with no width: a validation error in other words.
unsafe fn Texture badTexture(ref Device device) {
    return device.createTexture(descriptor: TextureDescriptor.make(width: 0, height: 4, format: TextureFormat::RGBA8Unorm, usage: TextureUsage::TextureBinding));
}

// An encoder holding a copy out of a texture made without CopySrc: an error its finish reports.
unsafe fn CommandEncoder badCopy(ref Device device) {
    Texture source = device.createTexture(descriptor: TextureDescriptor.make(width: 4, height: 4, format: TextureFormat::RGBA8Unorm,
                                          usage: TextureUsage::TextureBinding));
    Buffer target = device.createBuffer(descriptor: BufferDescriptor.make(size: cast<uint64>(ROW) * 4,
                                                                        usage: BufferUsage::CopyDst));
    CommandEncoder encoder = device.createCommandEncoder();
    encoder.copyTextureToBuffer(texture: source, buffer: target, width: 4, height: 4, bytesPerRow: ROW);
    return give encoder;
}

@compileFor(ARCH_WASM32)
unsafe fn void errorCases(ref Check t, ref Instance instance) {
    println(s: "skip the native error cases: they hold wgpu-native's timing, in the channel when the call returns; the web's run on its own timing (ErrorRun)");
}

// A device asked of an adapter of its own; natively both are answered as soon as they are polled.
@compileFor(!ARCH_WASM32)
unsafe fn Optional<Device> deviceNow(ref Check t, ref Instance instance, const ref string purpose) {
    Optional<Adapter> fresh = adapterNow(t: t, instance: instance, purpose: purpose);
    Adapter adapter = match (give fresh) { case Some(value: a): give a; case None: { return Optional::None; } };
    DeviceRequest request = adapter.requestDevice(options: readOptions());
    int32 polls = 0;
    while (polls < 1000) {
        DeviceStatus s = request.poll();
        match (give s) {
            case Pending: { }
            case Ready(device: d, queue: q): { return Optional::Some(value: give d); }
            case Failed(error: e): { string why = e.message(); t.verdict(name: purpose, why: why); return Optional::None; }
        };
        polls = polls + 1;
    }
    t.verdict(name: purpose, why: "the request never settled");
    return Optional::None;
}

// An adapter of the instance; natively it is answered as soon as it is polled.
@compileFor(!ARCH_WASM32)
unsafe fn Optional<Adapter> adapterNow(ref Check t, ref Instance instance, const ref string purpose) {
    AdapterRequest asked = instance.requestAdapter(options: AdapterOptions.make(power: PowerPreference::HighPerformance));
    int32 polls = 0;
    while (polls < 1000) {
        AdapterStatus s = asked.poll();
        match (give s) {
            case Pending: { }
            case Ready(adapter: a): { return Optional::Some(value: give a); }
            case Failed(error: e): { string why = e.message(); t.verdict(name: purpose, why: "no adapter: " + why); return Optional::None; }
        };
        polls = polls + 1;
    }
    t.verdict(name: purpose, why: "the adapter request never settled");
    return Optional::None;
}

@compileFor(!ARCH_WASM32)
unsafe fn void errorCases(ref Check t, ref Instance instance) {
    Optional<Device> asked = deviceNow(t: t, instance: instance, purpose: "a device for the error cases");
    Device a = match (give asked) {
        case Some(value: d): give d;
        case None: { return; }
    };
    Optional<Device> askedAgain = deviceNow(t: t, instance: instance, purpose: "a second device for the error cases");
    Device b = match (give askedAgain) {
        case Some(value: d): give d;
        case None: { return; }
    };

    Buffer bad = badBuffer(device: a);
    DeviceErrors got = a.takeErrors();
    string one = holds(errs: got, want: 1, kind: GpuErrorKind::Validation);
    if (one.isEmpty()) {
        // wgpu-native's words begin with the call and end with the usages asked for: kept whole, not cut
        string words = got.reports()[0].message();
        if (!words.contains(substring: "MAP") || !words.contains(substring: "STORAGE)")) { one = "in other words: ${words}"; }
    }
    t.verdict(name: "an uncaptured error is in its device's channel when the call returns, whole, in WebGPU's words", why: one);
    t.verdict(name: "a buffer's label names it in its error's words", why: namedIn(errs: got, label: "badly used"));
    t.verdict(name: "a device's channel is watched", why: got.watched() ? "" : "watched() is false");
    DeviceErrors again = a.takeErrors();
    t.verdict(name: "a drain empties the channel", why: errorsSaid(errs: again));
    Buffer huge = hugeBuffer(device: a);
    DeviceErrors past = a.takeErrors();
    t.verdict(name: "a buffer of 2^60 bytes is a validation error, not the end of the program",
              why: holds(errs: past, want: 1, kind: GpuErrorKind::Validation));

    Buffer onB = badBuffer(device: b);
    DeviceErrors onA = a.takeErrors();
    DeviceErrors fromB = b.takeErrors();
    string apart = holds(errs: fromB, want: 1, kind: GpuErrorKind::Validation);
    if (!onA.isEmpty()) { apart = "the other device's error reached this one"; }
    t.verdict(name: "two devices' errors are kept apart", why: apart);

    Device copied = copy a;
    Buffer viaOriginal = badBuffer(device: a);
    DeviceErrors shared = copied.takeErrors();
    DeviceErrors afterShared = a.takeErrors();
    string share = holds(errs: shared, want: 1, kind: GpuErrorKind::Validation);
    if (share.isEmpty() && !afterShared.isEmpty()) { share = "the original's channel still held it"; }
    t.verdict(name: "a device's copies share one channel: an error made through one is drained through another", why: share);

    Optional<DeviceLoss> loss = a.lost();
    t.verdict(name: "a live device is not lost", why: loss.isSome() ? "lost(): " + lossSaid(loss: loss) : "");

    // A full channel: 64 errors in one set of words, then 36 in another. The oldest are kept, the rest counted.
    Texture flat = badTexture(device: b);
    DeviceErrors flatErrors = b.takeErrors();
    string later = "";
    if (flatErrors.reports().length() == 1) { later = flatErrors.reports()[0].message(); }
    int32 i = 0;
    while (i < 64) { Buffer x = badBuffer(device: a); i = i + 1; }
    i = 0;
    while (i < 36) { Texture y = badTexture(device: a); i = i + 1; }
    DeviceErrors full = a.takeErrors();
    isize kept = full.reports().length();
    int64 dropped = full.dropped();
    string ring = "";
    if (later.isEmpty()) { ring = "a texture with no width gave no single error to tell the later ones by"; }
    else if (kept != 64) { ring = "${kept} kept, not 64"; }
    else if (dropped != 36) { ring = "${dropped} dropped, not 36"; }
    else {
        isize k = 0;
        while (k < kept) {
            string words = full.reports()[k].message();
            if (words == later) { ring = "a later report was kept, at ${k}"; }
            k = k + 1;
        }
    }
    t.verdict(name: "a full channel keeps the oldest 64 reports and counts the rest", why: ring);
    DeviceErrors emptied = a.takeErrors();
    t.verdict(name: "a drain starts the count of what was dropped again", why: errorsSaid(errs: emptied));

    // An adopted device keeps its maker's callback: its errors reach the package's channel of the device it came from.
    Optional<Adapter> another = adapterNow(t: t, instance: instance, purpose: "an adapter for the adopted device");
    Adapter adapter = match (give another) { case Some(value: x): give x; case None: { return; } };
    addDeviceRef(device: a.raw());
    Device adopted = Device.adopt(raw: a.raw(), adapter: adapter);
    Buffer viaAdopted = badBuffer(device: adopted);
    DeviceErrors unseen = adopted.takeErrors();
    DeviceErrors maker = a.takeErrors();
    string adopt = "";
    if (unseen.watched()) { adopt = "watched() is true"; }
    else if (!unseen.isEmpty()) { adopt = "the adopted device's channel holds an error"; }
    else { adopt = holds(errs: maker, want: 1, kind: GpuErrorKind::Validation); }
    t.verdict(name: "an adopted device says its errors are not watched, and they reach its maker", why: adopt);

    scopeCases(t: t, instance: instance);
    spoiledCases(t: t, instance: instance);
    outlivesCase(t: t, instance: instance);
}

// A command buffer whose finish reported an error is never submitted natively, where wgpu-native would end the process
// (tests/facts, `abort-submit`); a browser refuses the same submit after reporting it.
@compileFor(!ARCH_WASM32)
unsafe fn void spoiledCases(ref Check t, ref Instance instance) {
    Optional<Adapter> fresh = adapterNow(t: t, instance: instance, purpose: "a device for the finish cases");
    Adapter adapter = match (give fresh) { case Some(value: a): give a; case None: { return; } };
    DeviceRequest request = adapter.requestDevice(options: readOptions());
    int32 polls = 0;
    while (polls < 1000) {
        DeviceStatus s = request.poll();
        match (give s) {
            case Pending: { }
            case Ready(device: d, queue: q): { spoiledWith(t: t, device: d, queue: q); return; }
            case Failed(error: e): { string why = e.message(); t.verdict(name: "a device for the finish cases", why: why); return; }
        };
        polls = polls + 1;
    }
    t.verdict(name: "a device for the finish cases", why: "the request never settled");
}

@compileFor(!ARCH_WASM32)
unsafe fn void spoiledWith(ref Check t, ref Device device, ref Queue queue) {
    CommandEncoder encoder = badCopy(device: device);
    CommandBuffer commands = give encoder.finish();
    queue.submit(commands: give commands);
    DeviceErrors errs = device.takeErrors();
    t.verdict(name: "a command buffer whose finish reported an error is not submitted, and the error is in the channel",
              why: holds(errs: errs, want: 1, kind: GpuErrorKind::Validation));

    string words = "";
    ErrorScope around = device.pushErrorScope(filter: ErrorFilter::Validation);
    CommandEncoder again = badCopy(device: device);
    CommandBuffer more = give again.finish();
    queue.submit(commands: give more);
    Result<ScopePop, GpuError> popped = give around.pop();
    string inScope = caughtBy(popped: give popped, kind: Optional::Some(value: GpuErrorKind::Validation), words: words);
    DeviceErrors after = device.takeErrors();
    if (inScope.isEmpty() && !after.isEmpty()) { inScope = "the channel got it too"; }
    t.verdict(name: "inside a scope too: the scope catches the finish's error, and the buffer is not submitted", why: inScope);
}

// A scope popped, natively answered at once: "" when it caught an error of `kind`, its words left in `words`, or, with
// `kind` None, when it caught nothing.
@compileFor(!ARCH_WASM32)
unsafe fn string caughtBy(Result<ScopePop, GpuError> popped, Optional<GpuErrorKind> kind, ref string words) {
    string why = "";
    match (give popped) {
        case Ok(value: answer): {
            PopStatus status = answer.poll();
            match (give status) {
                case Pending: { why = "still pending, where natively a pop is answered at once"; }
                case Failed(error: e): { string said = e.message(); why = "the pop failed: ${said}"; }
                case Ready(caught: c): {
                    match (give c) {
                        case Some(value: report): {
                            words = report.message();
                            GpuErrorKind got = report.kind();
                            match (kind) {
                                case Some(value: k): {
                                    if (got != k) { string name = kindName(k: got); why = "it caught a ${name} error"; }
                                }
                                case None: { why = "it caught an error: " + report.message(); }
                            };
                        }
                        case None: { if (kind.isSome()) { why = "it caught nothing"; } }
                    };
                }
            };
        }
        case Err(error: e): { string said = e.message(); why = "the pop was refused: ${said}"; }
    };
    return why;
}

// A scope pushed, an error made in it, and the scope dropped unpopped.
unsafe fn void dropScope(ref Device device) {
    ErrorScope open = device.pushErrorScope(filter: ErrorFilter::Validation);
    Buffer bad = badBuffer(device: device);
}

// The same, with a distinct error (`pastLargest`), for the cases on the web's timing.
unsafe fn void dropScopeOver(ref Device device, uint64 by) {
    ErrorScope open = device.pushErrorScope(filter: ErrorFilter::Validation);
    Buffer bad = pastLargest(device: device, by: by);
}

// Error scopes, which the seam keeps natively: WebGPU's rules, and none of wgpu-native's aborting paths reachable.
@compileFor(!ARCH_WASM32)
unsafe fn void scopeCases(ref Check t, ref Instance instance) {
    Optional<Device> asked = deviceNow(t: t, instance: instance, purpose: "a device for the scope cases");
    Device d = match (give asked) {
        case Some(value: x): give x;
        case None: { return; }
    };
    string words = "";

    ErrorScope s1 = d.pushErrorScope(filter: ErrorFilter::Validation);
    Buffer b1 = badBuffer(device: d);
    Result<ScopePop, GpuError> p1 = give s1.pop();
    string one = caughtBy(popped: give p1, kind: Optional::Some(value: GpuErrorKind::Validation), words: words);
    DeviceErrors after1 = d.takeErrors();
    if (one.isEmpty() && !after1.isEmpty()) { one = "the channel got it too"; }
    t.verdict(name: "a scope catches an error made while it is open, and the channel does not", why: one);

    ErrorScope outer2 = d.pushErrorScope(filter: ErrorFilter::Validation);
    ErrorScope inner2 = d.pushErrorScope(filter: ErrorFilter::OutOfMemory);
    Buffer b2 = badBuffer(device: d);
    Result<ScopePop, GpuError> pi2 = give inner2.pop();
    string innerWhy = caughtBy(popped: give pi2, kind: Optional::None, words: words);
    Result<ScopePop, GpuError> po2 = give outer2.pop();
    string two = caughtBy(popped: give po2, kind: Optional::Some(value: GpuErrorKind::Validation), words: words);
    if (!innerWhy.isEmpty()) { two = "the OutOfMemory scope: " + innerWhy; }
    t.verdict(name: "an error a scope's filter does not match passes to the scope beneath it", why: two);

    ErrorScope s3 = d.pushErrorScope(filter: ErrorFilter::OutOfMemory);
    Buffer b3 = badBuffer(device: d);
    Result<ScopePop, GpuError> p3 = give s3.pop();
    string three = caughtBy(popped: give p3, kind: Optional::None, words: words);
    DeviceErrors after3 = d.takeErrors();
    if (three.isEmpty()) { three = holds(errs: after3, want: 1, kind: GpuErrorKind::Validation); }
    t.verdict(name: "past every scope, an error reaches the channel", why: three);

    Texture flat = badTexture(device: d);
    DeviceErrors flatErrors = d.takeErrors();
    string later = "";
    if (flatErrors.reports().length() == 1) { later = flatErrors.reports()[0].message(); }
    ErrorScope s4 = d.pushErrorScope(filter: ErrorFilter::Validation);
    Buffer b4 = badBuffer(device: d);
    Texture t4 = badTexture(device: d);
    Result<ScopePop, GpuError> p4 = give s4.pop();
    string kept = "";
    string four = caughtBy(popped: give p4, kind: Optional::Some(value: GpuErrorKind::Validation), words: kept);
    DeviceErrors after4 = d.takeErrors();
    if (four.isEmpty() && later.isEmpty()) { four = "a texture with no width gave no single error to tell the later one by"; }
    else if (four.isEmpty() && kept == later) { four = "it kept the later error"; }
    else if (four.isEmpty() && !after4.isEmpty()) { four = "the later error reached the channel"; }
    t.verdict(name: "a scope keeps the first error it catches and swallows the rest", why: four);

    ErrorScope s5 = d.pushErrorScope(filter: ErrorFilter::Validation);
    Result<ScopePop, GpuError> p5 = give s5.pop();
    t.verdict(name: "a scope that caught nothing answers None", why: caughtBy(popped: give p5, kind: Optional::None, words: words));

    ErrorScope s6 = d.pushErrorScope(filter: ErrorFilter::Internal);
    Buffer b6 = badBuffer(device: d);
    Result<ScopePop, GpuError> p6 = give s6.pop();
    string six = caughtBy(popped: give p6, kind: Optional::None, words: words);
    DeviceErrors after6 = d.takeErrors();
    if (six.isEmpty()) { six = holds(errs: after6, want: 1, kind: GpuErrorKind::Validation); }
    t.verdict(name: "an Internal scope is taken natively, where wgpu-native's own would end the process", why: six);

    ErrorScope outer7 = d.pushErrorScope(filter: ErrorFilter::Validation);
    ErrorScope inner7 = d.pushErrorScope(filter: ErrorFilter::Validation);
    Result<ScopePop, GpuError> po7 = give outer7.pop();
    bool outOfOrder = match (po7) {
        case Err(error: e): match (e) { case OutOfOrder: true; case _: false; };
        case Ok(value: p): false;
    };
    Buffer b7 = badBuffer(device: d);
    Result<ScopePop, GpuError> pi7 = give inner7.pop();
    string seven = caughtBy(popped: give pi7, kind: Optional::Some(value: GpuErrorKind::Validation), words: words);
    Buffer b7b = badBuffer(device: d);
    DeviceErrors after7 = d.takeErrors();
    if (!outOfOrder) { seven = "the pop out of order was not refused with OutOfOrder"; }
    else if (seven.isEmpty()) { seven = holds(errs: after7, want: 1, kind: GpuErrorKind::Validation); }
    t.verdict(name: "a pop out of order is refused, and the stack does not jam", why: seven);

    ErrorScope outer8 = d.pushErrorScope(filter: ErrorFilter::Validation);
    Buffer b8 = badBuffer(device: d);
    ErrorScope inner8 = d.pushErrorScope(filter: ErrorFilter::OutOfMemory);
    Result<ScopePop, GpuError> po8 = give outer8.pop();
    DeviceErrors held8 = d.takeErrors();
    Result<ScopePop, GpuError> pi8 = give inner8.pop();
    DeviceErrors after8 = d.takeErrors();
    string eight = holds(errs: after8, want: 1, kind: GpuErrorKind::Validation);
    if (!held8.isEmpty()) { eight = "it reached the channel before the scope above it was popped"; }
    t.verdict(name: "what an orphaned scope caught reaches the channel once the scopes above it are popped", why: eight);

    dropScope(device: d);
    DeviceErrors after9 = d.takeErrors();
    Buffer b9 = badBuffer(device: d);
    DeviceErrors again9 = d.takeErrors();
    string nine = holds(errs: after9, want: 1, kind: GpuErrorKind::Validation);
    if (nine.isEmpty()) {
        string next = holds(errs: again9, want: 1, kind: GpuErrorKind::Validation);
        if (!next.isEmpty()) { nine = "the next error: " + next; }
    }
    t.verdict(name: "a scope dropped unpopped pops itself, and what it caught reaches the channel", why: nine);
}

// A device's state outlives the device while a handle made from it lives: wgpu-native reports the handle's errors to the
// device's callback after the device's last release (tests/facts, `afterrelease`).
@compileFor(!ARCH_WASM32)
unsafe fn void outlivesCase(ref Check t, ref Instance instance) {
    Optional<Device> made = deviceNow(t: t, instance: instance, purpose: "a device to drop before its encoder");
    int64 before = statesAlive();
    Optional<CommandEncoder> kept = Optional::None;
    match (give made) {
        case Some(value: d): { kept = Optional::Some(value: badCopy(device: d)); }
        case None: { return; }
    };
    int64 between = statesAlive();
    t.verdict(name: "a device's state outlives the device while a handle made from it lives",
              why: between == before ? "" : "${before} alive before the device was dropped, ${between} after");
    match (give kept) {
        case Some(value: encoder): { CommandBuffer commands = give encoder.finish(); }
        case None: { }
    };
    int64 after = statesAlive();
    t.verdict(name: "an error after the device is dropped is taken safely, and the state freed with the last handle",
              why: after == before - 1 ? "" : "${before} alive before, ${after} after the last handle");
}

// The status `main` returns natively, set by `finish`: the loop owns the app and drops it when `run` returns.
static int32 exitStatus = 1;

// On the web `run` never returns, so the program ends here; natively `run` returns and `main` gives the status.
@compileFor(ARCH_WASM32)
fn void endOnTheWeb(bool failed) { if (failed) { quit(code: 1); } else { quit(code: 0); } }
@compileFor(!ARCH_WASM32)
fn void endOnTheWeb(bool failed) { }

unsafe fn void runChecks() {
    Owned<App> app = new Check.make();
    run(app: give app);
}

fn uint8 main() {
    runChecks();
    return cast<uint8>(exitStatus);
}

// A format's required feature as a number: 0 none, 1 TextureCompressionBC, 2 TextureCompressionETC2,
// 3 TextureCompressionASTC, 4 Depth32FloatStencil8, 5 TextureFormatsTier1, 6 any other.
fn int32 neededIndex(Optional<Feature> f) {
    return match (f) {
        case Some(value: x): neededKind(x: x);
        case None: 0;
    };
}

fn int32 neededKind(Feature x) {
    return match (x) {
        case TextureCompressionBC: 1;
        case TextureCompressionETC2: 2;
        case TextureCompressionASTC: 3;
        case Depth32FloatStencil8: 4;
        case TextureFormatsTier1: 5;
        case _: 6;
    };
}

// "" when every format's required feature is WebGPU's: the count of each, and the formats beside a rule's edge.
fn string requiredFeatures() {
    InlineArray<int32>#(7) counts = [0; 7];
    int32 n = 0;
    while (n < 1024) {
        Optional<TextureFormat> f = TextureFormat::fromValue(value: n);
        match (f) {
            case Some(value: x): {
                isize k = cast<isize>(neededIndex(f: x.requiredFeature()));
                counts[k] = counts[k] + 1;
            }
            case None: { }
        };
        n = n + 1;
    }
    int32 none = counts[0];
    int32 bc = counts[1];
    int32 etc = counts[2];
    int32 astc = counts[3];
    int32 d32 = counts[4];
    int32 tier1 = counts[5];
    int32 other = counts[6];
    string got = "none ${none}, BC ${bc}, ETC2 ${etc}, ASTC ${astc}, Depth32FloatStencil8 ${d32}, TextureFormatsTier1 ${tier1}, other ${other}";
    if (none != 42 || bc != 14 || etc != 10 || astc != 28 || d32 != 1 || tier1 != 6 || other != 0) { return got; }
    int32 depth16 = neededIndex(f: TextureFormat::Depth16Unorm.requiredFeature());
    int32 r16float = neededIndex(f: TextureFormat::R16Float.requiredFeature());
    int32 rgba16unorm = neededIndex(f: TextureFormat::RGBA16Unorm.requiredFeature());
    int32 eac = neededIndex(f: TextureFormat::EACRG11Snorm.requiredFeature());
    int32 depth32 = neededIndex(f: TextureFormat::Depth32Float.requiredFeature());
    if (depth16 != 0 || r16float != 0 || rgba16unorm != 5 || eac != 2 || depth32 != 0) {
        return "Depth16Unorm ${depth16}, R16Float ${r16float}, RGBA16Unorm ${rgba16unorm}, EACRG11Snorm ${eac}, Depth32Float ${depth32}";
    }
    return "";
}
