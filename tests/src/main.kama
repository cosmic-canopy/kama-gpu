// @kama/gpu's tests, one program (AGENTS.package.md): a device brought up, a 64×64 texture cleared to a known colour,
// copied to a buffer, mapped and read back, with every handle released by its destructor and no uncaptured error.
//
// It is a state machine stepped by std::app::run, because on the web the device and the map are answered by the
// browser's event loop, between ticks. Natively the ticks run back to back, faster than the GPU clears and copies
// (measured: 600 non-blocking polls pass before a 64×64 clear's map completes), so it waits on the device there with
// `poll(wait: true)`, which the web leg ignores; the timeout is the clock's, not a tick count.
// A failing case prints its name, and the exit status is the number of failures (at most 1 here).

import {
    core::println,
    std::app::run, std::app::TickFn, std::app::quit,
    std::collections::DynamicArray,
    std::memory::Owned, std::memory::replace,
    std::time::Instant, std::time::monotonicNow,
    gpu::Instance, gpu::Device, gpu::Queue, gpu::DeviceRequest, gpu::DeviceStatus, gpu::GpuError,
    gpu::PowerPreference, gpu::Buffer, gpu::BufferUsage, gpu::BufferRead, gpu::ReadStatus, gpu::Texture,
    gpu::TextureFormat, gpu::TextureUsage, gpu::TextureView, gpu::CommandEncoder, gpu::RenderPass,
    gpu::CommandBuffer, gpu::Color, gpu::uncapturedErrors, gpu::lastErrorMessage, gpu::lostDevices,
};

comptime uint32 SIDE = 64;
comptime uint32 ROW = 256;      // 64 texels × 4 bytes: already the 256 a copy's rows are aligned to
comptime int64 TIMEOUT_MS = 10000;

// The clear colour, and the bytes an RGBA8Unorm texel holds for it (0.25, 0.5, 0.75 of 255, rounded either way).
comptime float64 RED = 0.25;
comptime float64 GREEN = 0.5;
comptime float64 BLUE = 0.75;

fn bool near(uint8 got, int32 want) {
    int32 g = cast<int32>(got);
    return g >= want - 1 && g <= want + 1;
}

type resource Check {
    Optional<Instance> instance = Optional::None;
    Optional<DeviceRequest> request = Optional::None;
    Optional<Device> device = Optional::None;
    Optional<Queue> queue = Optional::None;
    Optional<Buffer> readback = Optional::None;
    Optional<BufferRead> read = Optional::None;
    int32 stage = 0;     // 0 awaiting the device, 1 awaiting the map, 2 done
    Instant began = monotonicNow();
    int32 runs = 0;
    int32 failures = 0;

    public unsafe ctor make() {
        Result<Instance, GpuError> made = Instance.create();
        match (give made) {
            case Ok(value: inst): {
                this.request = Optional::Some(value: inst.requestDevice(power: PowerPreference::HighPerformance));
                this.instance = Optional::Some(value: give inst);
            }
            case Err(error: e): {
                string why = e.message();
                this.verdict(name: "an instance", why: why);
                this.stage = 2;
            }
        };
    }

    public const fn int32 failed() { return this.failures; }

    fn void verdict(const ref string name, const ref string why) {
        this.runs = this.runs + 1;
        if (why.isEmpty()) {
            println(s: "ok   ${name}");
        } else {
            this.failures = this.failures + 1;
            println(s: "FAIL ${name}: ${why}");
        }
    }

    public unsafe fn int32 tick() {
        if (this.stage < 2 && this.began.elapsed().asMillis() > TIMEOUT_MS) {
            int64 lost = lostDevices();
            string last = lastErrorMessage();
            this.verdict(name: "the GPU answers within 10 s",
                         why: "timed out at stage ${this.stage} (devices lost: ${lost}; last message: ${last})");
            this.stage = 2;
        }
        if (this.stage == 0) { this.awaitDevice(); }
        if (this.stage == 1) { this.awaitRead(); }
        if (this.stage == 2) { return this.finish(); }
        return 1;
    }

    unsafe fn void awaitDevice() {
        Optional<DeviceRequest> taken = replace(place: this.request, with: Optional::None);
        match (give taken) {
            case None: { this.verdict(name: "a device request", why: "there was none"); this.stage = 2; }
            case Some(value: r): {
                DeviceStatus status = r.poll();
                this.request = Optional::Some(value: give r);   // kept while pending, dropped once settled
                match (give status) {
                    case Pending: { }
                    case Ready(device: d, queue: q): {
                        this.request = Optional::None;
                        this.verdict(name: "a device and its queue", why: "");
                        this.render(device: d, queue: q);
                        this.device = Optional::Some(value: give d);
                        this.queue = Optional::Some(value: give q);
                        this.stage = 1;
                    }
                    case Failed(error: e): {
                        this.request = Optional::None;
                        string why = e.message();
                        this.verdict(name: "a device and its queue", why: why);
                        this.stage = 2;
                    }
                };
            }
        };
    }

    // Clear a texture, copy it to a buffer, and ask for the buffer's bytes.
    unsafe fn void render(ref Device device, ref Queue queue) {
        Texture target = device.createTexture(width: SIDE, height: SIDE, format: TextureFormat::RGBA8Unorm,
                                              usage: TextureUsage::RenderAttachment | TextureUsage::CopySrc);
        TextureView view = target.createView();
        uint64 bytes = cast<uint64>(ROW) * cast<uint64>(SIDE);
        Buffer copy = device.createBuffer(size: bytes, usage: BufferUsage::MapRead | BufferUsage::CopyDst);
        CommandEncoder encoder = device.createCommandEncoder();
        RenderPass pass = encoder.beginRenderPass(target: view, clear: Color.rgba(r: RED, g: GREEN, b: BLUE, a: 1.0));
        give pass.end();
        encoder.copyTextureToBuffer(texture: target, buffer: copy, width: SIDE, height: SIDE, bytesPerRow: ROW);
        CommandBuffer commands = give encoder.finish();
        queue.submit(commands: give commands);
        this.read = Optional::Some(value: copy.mapRead(offset: 0, size: bytes));
        this.readback = Optional::Some(value: give copy);
    }

    unsafe fn void awaitRead() {
        match (this.device) {
            case Some(value: d): { d.poll(wait: true); }
            case None: { }
        };
        ReadStatus status = ReadStatus::Pending;
        match (this.read) {
            case Some(value: r): { status = r.poll(); }
            case None: { status = ReadStatus::Failed(error: GpuError::Taken); }
        };
        match (give status) {
            case Pending: { }
            case Ready: { this.checkPixels(); this.stage = 2; }
            case Failed(error: e): {
                string why = e.message();
                this.verdict(name: "the readback maps", why: why);
                this.stage = 2;
            }
        };
    }

    unsafe fn void checkPixels() {
        DynamicArray<uint8> px = DynamicArray.empty();
        match (this.read) {
            case Some(value: r): { px = r.bytes(); }
            case None: { }
        };
        isize want = cast<isize>(ROW) * cast<isize>(SIDE);
        isize got = px.length();
        if (got != want) {
            this.verdict(name: "the readback's bytes", why: "${got} bytes, not ${want}");
            return;
        }
        int32 r = cast<int32>(RED * 255.0 + 0.5);
        int32 g = cast<int32>(GREEN * 255.0 + 0.5);
        int32 b = cast<int32>(BLUE * 255.0 + 0.5);
        isize bad = 0;
        isize i = 0;
        while (i < want) {
            if (!near(got: px[i], want: r) || !near(got: px[i + 1], want: g) || !near(got: px[i + 2], want: b)
                || !near(got: px[i + 3], want: 255)) {
                bad = bad + 1;
            }
            i = i + 4;
        }
        if (bad == 0) {
            this.verdict(name: "every texel reads back as the clear colour", why: "");
        } else {
            uint8 r0 = px[0];
            uint8 g0 = px[1];
            uint8 b0 = px[2];
            uint8 a0 = px[3];
            this.verdict(name: "every texel reads back as the clear colour",
                         why: "${bad} texels differ; the first is ${r0} ${g0} ${b0} ${a0}, not ${r} ${g} ${b} 255");
        }
    }

    // Every handle released by its destructor, then the verdict on uncaptured errors and the totals.
    unsafe fn int32 finish() {
        this.read = Optional::None;
        this.readback = Optional::None;
        this.queue = Optional::None;
        this.device = Optional::None;
        this.request = Optional::None;
        this.instance = Optional::None;
        int64 errors = uncapturedErrors();
        if (errors == 0) {
            this.verdict(name: "no uncaptured WebGPU error", why: "");
        } else {
            string last = lastErrorMessage();
            this.verdict(name: "no uncaptured WebGPU error", why: "${errors}, the last: ${last}");
        }
        println(s: "gpu tests: ${this.runs} cases, ${this.failures} failed");
        endOnTheWeb(failed: this.failures > 0);
        return 0;
    }
}

// On the web `run` never returns, so the program ends here; natively `run` returns and `main` gives the status.
@compileFor(ARCH_WASM32)
unsafe fn void endOnTheWeb(bool failed) { if (failed) { quit(code: 1); } else { quit(code: 0); } }
@compileFor(!ARCH_WASM32)
unsafe fn void endOnTheWeb(bool failed) { }

unsafe fn int32 tick(UnsafePtr state) {
    UnsafePtr<Check> check = cast<UnsafePtr<Check>>(state);
    return tickOnce(check: check[0]);
}

unsafe fn int32 tickOnce(ref Check check) { return check.tick(); }

unsafe fn uint8 appMain() {
    Owned<Check> boxed = new Check.make();
    UnsafePtr<Check> check = boxed.release();   // the run loop owns it from here
    TickFn t = tick;
    run(tick: t, state: cast<UnsafePtr>(check));
    if (check[0].failed() > 0) { return 1; }
    return 0;
}

fn uint8 main() { return appMain(); }
