// @kama/gpu's tests, one program (AGENTS.package.md): an adapter asked for, answering its info, its limits and its
// features; devices requested from it with WebGPU's defaults, a raised limit, a limit beyond it and a feature it lacks;
// then a 64×64 texture cleared to a known colour, copied to a buffer, mapped and read back, with every handle released by
// its destructor and no uncaptured error.
//
// Before any of that, on every leg and with no GPU: `TextureFormat` both ways with its sRGB and linear forms, and what
// `preferred()` makes of a surface's answer (the web's, this machine's), handed in through `SurfaceCapabilities.of`.
// After it, natively and with a display: a surface on a real window, its capabilities, each configure the package must
// refuse rather than let wgpu-native abort the process, and a grey frame read back through an sRGB view and a linear one.
//
// It is a state machine, an `App` that std::app::run ticks, because on the web the adapter, the devices and the map are
// answered by the browser's event loop, between ticks. Natively the ticks run back to back, faster than the GPU clears
// and copies (measured: 600 non-blocking polls pass before a 64×64 clear's map completes), so it waits on the device
// there with `poll(wait: true)`, which the web leg ignores; the timeout is the clock's, not a tick count.
// A failing case prints its name, and the exit status is 1 when any failed.

import {
    core::println,
    core::env::envOr,
    std::app::App, std::app::Lifecycle, std::app::run, std::app::quit,
    std::collections::DynamicArray,
    std::memory::Owned, std::memory::replace,
    std::time::Instant, std::time::monotonicNow,
    gpu::Instance, gpu::Adapter, gpu::AdapterOptions, gpu::AdapterRequest, gpu::AdapterStatus, gpu::AdapterInfo,
    gpu::Backend, gpu::Limits, gpu::Feature, gpu::FeatureSet, gpu::DeviceOptions,
    gpu::Device, gpu::Queue, gpu::DeviceRequest, gpu::DeviceStatus, gpu::GpuError,
    gpu::PowerPreference, gpu::Buffer, gpu::BufferUsage, gpu::BufferRead, gpu::ReadStatus, gpu::Texture,
    gpu::TextureFormat, gpu::TextureUsage, gpu::TextureView, gpu::CommandEncoder, gpu::RenderPass,
    gpu::CommandBuffer, gpu::Color,
    gpu::DeviceErrors, gpu::GpuErrorReport, gpu::GpuErrorKind, gpu::DeviceLoss, gpu::LossReason,
    gpu::ErrorFilter, gpu::ErrorScope, gpu::ScopePop, gpu::PopStatus,
    gpu::Surface, gpu::SurfaceTexture, gpu::SurfaceError, gpu::SurfaceCapabilities, gpu::SurfaceConfig,
    gpu::PresentMode, gpu::AlphaMode, gpu::ConfigureError,
    window::Window, window::WindowError, window::Size,
    addDeviceRef, statesAlive,
};

comptime uint32 SIDE = 64;
comptime uint32 ROW = 256;      // 64 texels × 4 bytes: already the 256 a copy's rows are aligned to
comptime int64 TIMEOUT_MS = 10000;

// The clear colour, and the bytes an RGBA8Unorm texel holds for it (0.25, 0.5, 0.75 of 255, rounded either way).
comptime float64 RED = 0.25;
comptime float64 GREEN = 0.5;
comptime float64 BLUE = 0.75;

fn bool near(uint8 got, int32 want) {
    int32 g = cast<int32>(got);
    return g >= want - 1 && g <= want + 1;
}

// ---- limits, compared field by field ---------------------------------------------------------------------------------

// "" when `have` is at least `want` (a maximum), else the field and both numbers.
fn string atLeast(const ref string name, uint64 have, uint64 want) {
    if (have >= want) { return ""; }
    return "${name}: ${have}, below ${want}";
}

// "" when `have` is at most `want` (a minimum alignment, where less is better).
fn string atMost(const ref string name, uint64 have, uint64 want) {
    if (have <= want) { return ""; }
    return "${name}: ${have}, above ${want}";
}

fn string same(const ref string name, uint64 have, uint64 want) {
    if (have == want) { return ""; }
    return "${name}: ${have}, not ${want}";
}

fn string first(const ref DynamicArray<string> faults) {
    foreach (const ref string f in faults.iterConst()) { if (!f.isEmpty()) { return copy f; } }
    return "";
}

fn uint64 w(uint32 v) { return cast<uint64>(v); }

// wgpu-native (v29.0.1.1) does not report `maxBindGroupsPlusVertexBuffers`: an adapter and a device both answer 0 for
// it (measured 2026-11-10). The package answers what the implementation says, so natively that one 0 is accepted, and
// on the web, where the browser reports it, it is held like the rest.
@compileFor(ARCH_WASM32)
fn bool unreported(uint32 v) { return false; }
@compileFor(!ARCH_WASM32)
fn bool unreported(uint32 v) { return v == 0; }

// The first limit of `have` that does not meet `want`, or "": each maximum at least as high, each alignment as low.
fn string meets(const ref Limits have, const ref Limits want) {
    DynamicArray<string> f = DynamicArray.empty();
    f.add(item: atLeast(name: "maxTextureDimension1D", have: w(v: have.maxTextureDimension1D), want: w(v: want.maxTextureDimension1D)));
    f.add(item: atLeast(name: "maxTextureDimension2D", have: w(v: have.maxTextureDimension2D), want: w(v: want.maxTextureDimension2D)));
    f.add(item: atLeast(name: "maxTextureDimension3D", have: w(v: have.maxTextureDimension3D), want: w(v: want.maxTextureDimension3D)));
    f.add(item: atLeast(name: "maxTextureArrayLayers", have: w(v: have.maxTextureArrayLayers), want: w(v: want.maxTextureArrayLayers)));
    f.add(item: atLeast(name: "maxBindGroups", have: w(v: have.maxBindGroups), want: w(v: want.maxBindGroups)));
    f.add(item: unreported(v: have.maxBindGroupsPlusVertexBuffers) ? ""
                : atLeast(name: "maxBindGroupsPlusVertexBuffers", have: w(v: have.maxBindGroupsPlusVertexBuffers), want: w(v: want.maxBindGroupsPlusVertexBuffers)));
    f.add(item: atLeast(name: "maxBindingsPerBindGroup", have: w(v: have.maxBindingsPerBindGroup), want: w(v: want.maxBindingsPerBindGroup)));
    f.add(item: atLeast(name: "maxDynamicUniformBuffersPerPipelineLayout", have: w(v: have.maxDynamicUniformBuffersPerPipelineLayout), want: w(v: want.maxDynamicUniformBuffersPerPipelineLayout)));
    f.add(item: atLeast(name: "maxDynamicStorageBuffersPerPipelineLayout", have: w(v: have.maxDynamicStorageBuffersPerPipelineLayout), want: w(v: want.maxDynamicStorageBuffersPerPipelineLayout)));
    f.add(item: atLeast(name: "maxSampledTexturesPerShaderStage", have: w(v: have.maxSampledTexturesPerShaderStage), want: w(v: want.maxSampledTexturesPerShaderStage)));
    f.add(item: atLeast(name: "maxSamplersPerShaderStage", have: w(v: have.maxSamplersPerShaderStage), want: w(v: want.maxSamplersPerShaderStage)));
    f.add(item: atLeast(name: "maxStorageBuffersPerShaderStage", have: w(v: have.maxStorageBuffersPerShaderStage), want: w(v: want.maxStorageBuffersPerShaderStage)));
    f.add(item: atLeast(name: "maxStorageTexturesPerShaderStage", have: w(v: have.maxStorageTexturesPerShaderStage), want: w(v: want.maxStorageTexturesPerShaderStage)));
    f.add(item: atLeast(name: "maxUniformBuffersPerShaderStage", have: w(v: have.maxUniformBuffersPerShaderStage), want: w(v: want.maxUniformBuffersPerShaderStage)));
    f.add(item: atLeast(name: "maxUniformBufferBindingSize", have: have.maxUniformBufferBindingSize, want: want.maxUniformBufferBindingSize));
    f.add(item: atLeast(name: "maxStorageBufferBindingSize", have: have.maxStorageBufferBindingSize, want: want.maxStorageBufferBindingSize));
    f.add(item: atMost(name: "minUniformBufferOffsetAlignment", have: w(v: have.minUniformBufferOffsetAlignment), want: w(v: want.minUniformBufferOffsetAlignment)));
    f.add(item: atMost(name: "minStorageBufferOffsetAlignment", have: w(v: have.minStorageBufferOffsetAlignment), want: w(v: want.minStorageBufferOffsetAlignment)));
    f.add(item: atLeast(name: "maxVertexBuffers", have: w(v: have.maxVertexBuffers), want: w(v: want.maxVertexBuffers)));
    f.add(item: atLeast(name: "maxBufferSize", have: have.maxBufferSize, want: want.maxBufferSize));
    f.add(item: atLeast(name: "maxVertexAttributes", have: w(v: have.maxVertexAttributes), want: w(v: want.maxVertexAttributes)));
    f.add(item: atLeast(name: "maxVertexBufferArrayStride", have: w(v: have.maxVertexBufferArrayStride), want: w(v: want.maxVertexBufferArrayStride)));
    f.add(item: atLeast(name: "maxInterStageShaderVariables", have: w(v: have.maxInterStageShaderVariables), want: w(v: want.maxInterStageShaderVariables)));
    f.add(item: atLeast(name: "maxColorAttachments", have: w(v: have.maxColorAttachments), want: w(v: want.maxColorAttachments)));
    f.add(item: atLeast(name: "maxColorAttachmentBytesPerSample", have: w(v: have.maxColorAttachmentBytesPerSample), want: w(v: want.maxColorAttachmentBytesPerSample)));
    f.add(item: atLeast(name: "maxComputeWorkgroupStorageSize", have: w(v: have.maxComputeWorkgroupStorageSize), want: w(v: want.maxComputeWorkgroupStorageSize)));
    f.add(item: atLeast(name: "maxComputeInvocationsPerWorkgroup", have: w(v: have.maxComputeInvocationsPerWorkgroup), want: w(v: want.maxComputeInvocationsPerWorkgroup)));
    f.add(item: atLeast(name: "maxComputeWorkgroupSizeX", have: w(v: have.maxComputeWorkgroupSizeX), want: w(v: want.maxComputeWorkgroupSizeX)));
    f.add(item: atLeast(name: "maxComputeWorkgroupSizeY", have: w(v: have.maxComputeWorkgroupSizeY), want: w(v: want.maxComputeWorkgroupSizeY)));
    f.add(item: atLeast(name: "maxComputeWorkgroupSizeZ", have: w(v: have.maxComputeWorkgroupSizeZ), want: w(v: want.maxComputeWorkgroupSizeZ)));
    f.add(item: atLeast(name: "maxComputeWorkgroupsPerDimension", have: w(v: have.maxComputeWorkgroupsPerDimension), want: w(v: want.maxComputeWorkgroupsPerDimension)));
    f.add(item: atLeast(name: "maxImmediateSize", have: w(v: have.maxImmediateSize), want: w(v: want.maxImmediateSize)));
    return first(faults: f);
}

// The first limit of `have` that is not `want`'s, or "".
fn string equal(const ref Limits have, const ref Limits want) {
    DynamicArray<string> f = DynamicArray.empty();
    f.add(item: same(name: "maxTextureDimension1D", have: w(v: have.maxTextureDimension1D), want: w(v: want.maxTextureDimension1D)));
    f.add(item: same(name: "maxTextureDimension2D", have: w(v: have.maxTextureDimension2D), want: w(v: want.maxTextureDimension2D)));
    f.add(item: same(name: "maxTextureDimension3D", have: w(v: have.maxTextureDimension3D), want: w(v: want.maxTextureDimension3D)));
    f.add(item: same(name: "maxTextureArrayLayers", have: w(v: have.maxTextureArrayLayers), want: w(v: want.maxTextureArrayLayers)));
    f.add(item: same(name: "maxBindGroups", have: w(v: have.maxBindGroups), want: w(v: want.maxBindGroups)));
    f.add(item: unreported(v: have.maxBindGroupsPlusVertexBuffers) ? ""
                : same(name: "maxBindGroupsPlusVertexBuffers", have: w(v: have.maxBindGroupsPlusVertexBuffers), want: w(v: want.maxBindGroupsPlusVertexBuffers)));
    f.add(item: same(name: "maxBindingsPerBindGroup", have: w(v: have.maxBindingsPerBindGroup), want: w(v: want.maxBindingsPerBindGroup)));
    f.add(item: same(name: "maxDynamicUniformBuffersPerPipelineLayout", have: w(v: have.maxDynamicUniformBuffersPerPipelineLayout), want: w(v: want.maxDynamicUniformBuffersPerPipelineLayout)));
    f.add(item: same(name: "maxDynamicStorageBuffersPerPipelineLayout", have: w(v: have.maxDynamicStorageBuffersPerPipelineLayout), want: w(v: want.maxDynamicStorageBuffersPerPipelineLayout)));
    f.add(item: same(name: "maxSampledTexturesPerShaderStage", have: w(v: have.maxSampledTexturesPerShaderStage), want: w(v: want.maxSampledTexturesPerShaderStage)));
    f.add(item: same(name: "maxSamplersPerShaderStage", have: w(v: have.maxSamplersPerShaderStage), want: w(v: want.maxSamplersPerShaderStage)));
    f.add(item: same(name: "maxStorageBuffersPerShaderStage", have: w(v: have.maxStorageBuffersPerShaderStage), want: w(v: want.maxStorageBuffersPerShaderStage)));
    f.add(item: same(name: "maxStorageTexturesPerShaderStage", have: w(v: have.maxStorageTexturesPerShaderStage), want: w(v: want.maxStorageTexturesPerShaderStage)));
    f.add(item: same(name: "maxUniformBuffersPerShaderStage", have: w(v: have.maxUniformBuffersPerShaderStage), want: w(v: want.maxUniformBuffersPerShaderStage)));
    f.add(item: same(name: "maxUniformBufferBindingSize", have: have.maxUniformBufferBindingSize, want: want.maxUniformBufferBindingSize));
    f.add(item: same(name: "maxStorageBufferBindingSize", have: have.maxStorageBufferBindingSize, want: want.maxStorageBufferBindingSize));
    f.add(item: same(name: "minUniformBufferOffsetAlignment", have: w(v: have.minUniformBufferOffsetAlignment), want: w(v: want.minUniformBufferOffsetAlignment)));
    f.add(item: same(name: "minStorageBufferOffsetAlignment", have: w(v: have.minStorageBufferOffsetAlignment), want: w(v: want.minStorageBufferOffsetAlignment)));
    f.add(item: same(name: "maxVertexBuffers", have: w(v: have.maxVertexBuffers), want: w(v: want.maxVertexBuffers)));
    f.add(item: same(name: "maxBufferSize", have: have.maxBufferSize, want: want.maxBufferSize));
    f.add(item: same(name: "maxVertexAttributes", have: w(v: have.maxVertexAttributes), want: w(v: want.maxVertexAttributes)));
    f.add(item: same(name: "maxVertexBufferArrayStride", have: w(v: have.maxVertexBufferArrayStride), want: w(v: want.maxVertexBufferArrayStride)));
    f.add(item: same(name: "maxInterStageShaderVariables", have: w(v: have.maxInterStageShaderVariables), want: w(v: want.maxInterStageShaderVariables)));
    f.add(item: same(name: "maxColorAttachments", have: w(v: have.maxColorAttachments), want: w(v: want.maxColorAttachments)));
    f.add(item: same(name: "maxColorAttachmentBytesPerSample", have: w(v: have.maxColorAttachmentBytesPerSample), want: w(v: want.maxColorAttachmentBytesPerSample)));
    f.add(item: same(name: "maxComputeWorkgroupStorageSize", have: w(v: have.maxComputeWorkgroupStorageSize), want: w(v: want.maxComputeWorkgroupStorageSize)));
    f.add(item: same(name: "maxComputeInvocationsPerWorkgroup", have: w(v: have.maxComputeInvocationsPerWorkgroup), want: w(v: want.maxComputeInvocationsPerWorkgroup)));
    f.add(item: same(name: "maxComputeWorkgroupSizeX", have: w(v: have.maxComputeWorkgroupSizeX), want: w(v: want.maxComputeWorkgroupSizeX)));
    f.add(item: same(name: "maxComputeWorkgroupSizeY", have: w(v: have.maxComputeWorkgroupSizeY), want: w(v: want.maxComputeWorkgroupSizeY)));
    f.add(item: same(name: "maxComputeWorkgroupSizeZ", have: w(v: have.maxComputeWorkgroupSizeZ), want: w(v: want.maxComputeWorkgroupSizeZ)));
    f.add(item: same(name: "maxComputeWorkgroupsPerDimension", have: w(v: have.maxComputeWorkgroupsPerDimension), want: w(v: want.maxComputeWorkgroupsPerDimension)));
    f.add(item: same(name: "maxImmediateSize", have: w(v: have.maxImmediateSize), want: w(v: want.maxImmediateSize)));
    return first(faults: f);
}

// A feature desktop adapters commonly lack, the first of these this adapter lacks; None when it has them all.
fn Optional<Feature> lackedBy(const ref FeatureSet has) {
    DynamicArray<Feature> candidates = DynamicArray.empty();
    candidates.add(item: Feature::TextureCompressionASTC);
    candidates.add(item: Feature::TextureCompressionASTCSliced3D);
    candidates.add(item: Feature::TextureCompressionETC2);
    candidates.add(item: Feature::TextureComponentSwizzle);
    candidates.add(item: Feature::PrimitiveIndex);
    candidates.add(item: Feature::ClipDistances);
    foreach (Feature f in candidates.iterator()) { if (!has.has(feature: f)) { return Optional::Some(value: f); } }
    return Optional::None;
}

// WebGPU says every adapter has `core-features-and-limits`, and the browser lists it. wgpu-native (v29.0.1.1) does not
// (measured 2026-11-10: 14 of webgpu.h's features, that one not among them), so natively an adapter must answer at
// least one feature, and on the web that one.
@compileFor(ARCH_WASM32)
fn string answered(const ref FeatureSet has) {
    return has.has(feature: Feature::CoreFeaturesAndLimits) ? "" : "it does not list CoreFeaturesAndLimits";
}
@compileFor(!ARCH_WASM32)
fn string answered(const ref FeatureSet has) {
    FeatureSet none = FeatureSet.empty();
    string gap = missingFrom(given: none, offered: has);
    return gap.isEmpty() ? "it lists none of webgpu.h's features" : "";
}

// The first feature `offered` has that `given` lacks, or "".
fn string missingFrom(const ref FeatureSet given, const ref FeatureSet offered) {
    DynamicArray<Feature> all = DynamicArray.empty();
    all.add(item: Feature::CoreFeaturesAndLimits);
    all.add(item: Feature::DepthClipControl);
    all.add(item: Feature::Depth32FloatStencil8);
    all.add(item: Feature::TextureCompressionBC);
    all.add(item: Feature::TextureCompressionBCSliced3D);
    all.add(item: Feature::TextureCompressionETC2);
    all.add(item: Feature::TextureCompressionASTC);
    all.add(item: Feature::TextureCompressionASTCSliced3D);
    all.add(item: Feature::TimestampQuery);
    all.add(item: Feature::IndirectFirstInstance);
    all.add(item: Feature::ShaderF16);
    all.add(item: Feature::RG11B10UfloatRenderable);
    all.add(item: Feature::BGRA8UnormStorage);
    all.add(item: Feature::Float32Filterable);
    all.add(item: Feature::Float32Blendable);
    all.add(item: Feature::ClipDistances);
    all.add(item: Feature::DualSourceBlending);
    all.add(item: Feature::Subgroups);
    all.add(item: Feature::TextureFormatsTier1);
    all.add(item: Feature::TextureFormatsTier2);
    all.add(item: Feature::PrimitiveIndex);
    all.add(item: Feature::TextureComponentSwizzle);
    isize n = 0;
    foreach (Feature f in all.iterator()) {
        if (offered.has(feature: f)) {
            n = n + 1;
            if (!given.has(feature: f)) { return "feature ${n} of those offered was not given"; }
        }
    }
    println(s: "info the adapter offers ${n} of webgpu.h's features");
    return "";
}

// One request polled: Pending keeps it in `slot`; a settled one leaves `slot` empty and is handed back.
unsafe fn DeviceStatus pollOne(ref Optional<DeviceRequest> slot) {
    Optional<DeviceRequest> taken = replace(place: slot, with: Optional::None);
    match (give taken) {
        case None: { return DeviceStatus::Failed(error: GpuError::Taken); }
        case Some(value: r): {
            DeviceStatus s = r.poll();
            slot = Optional::Some(value: give r);
            bool pending = match (s) { case Pending: true; case _: false; };
            if (!pending) { slot = Optional::None; }
            return give s;
        }
    };
}

// ---- texture formats, and what a surface answers (every leg, no GPU) --------------------------------------------------

fn bool sameFormat(Optional<TextureFormat> got, TextureFormat want) {
    return match (got) { case Some(value: f): f == want; case None: false; };
}

// "" when `linear` and `srgb` are each other's forms, and each its own.
fn string twins(TextureFormat linear, TextureFormat srgb) {
    string ln = linear.name();
    string sn = srgb.name();
    if (linear.isSrgb()) { return "${ln} says it is sRGB"; }
    if (!srgb.isSrgb()) { return "${sn} says it is not sRGB"; }
    if (!sameFormat(got: linear.srgb(), want: srgb)) { return "${ln}'s sRGB form is not ${sn}"; }
    if (!sameFormat(got: srgb.srgb(), want: srgb)) { return "${sn} is not its own sRGB form"; }
    if (srgb.linear() != linear) { return "${sn}'s linear form is not ${ln}"; }
    if (linear.linear() != linear) { return "${ln} is not its own linear form"; }
    return "";
}

// "" when `f` has no sRGB form and is its own linear form.
fn string loner(TextureFormat f) {
    string n = f.name();
    if (f.isSrgb()) { return "${n} says it is sRGB"; }
    Optional<TextureFormat> s = f.srgb();
    if (s.isSome()) { return "${n} has an sRGB form"; }
    if (f.linear() != f) { return "${n} is not its own linear form"; }
    return "";
}

fn string formatList(const ref DynamicArray<TextureFormat> fs) {
    string acc = "";
    isize i = 0;
    while (i < fs.length()) {
        string n = fs[i].name();
        if (acc.isEmpty()) { acc = copy n; } else { acc = "${acc}, ${n}"; }
        i = i + 1;
    }
    return acc;
}

fn string presentList(const ref DynamicArray<PresentMode> ps) {
    string acc = "";
    isize i = 0;
    while (i < ps.length()) {
        string n = ps[i].name();
        if (acc.isEmpty()) { acc = copy n; } else { acc = "${acc}, ${n}"; }
        i = i + 1;
    }
    return acc;
}

fn string alphaList(const ref DynamicArray<AlphaMode> modes) {
    string acc = "";
    isize i = 0;
    while (i < modes.length()) {
        string n = modes[i].name();
        if (acc.isEmpty()) { acc = copy n; } else { acc = "${acc}, ${n}"; }
        i = i + 1;
    }
    return acc;
}

fn string described(const ref SurfaceConfig c) {
    string f = c.format.name();
    string v = c.viewFormat.name();
    string p = c.present.name();
    string a = c.alpha.name();
    uint64 u = c.usage;
    return "${f} through ${v}, ${p}, ${a}, usage ${u}";
}

// "" when `got` is the config described, with RenderAttachment its usage.
fn string expectConfig(const ref SurfaceConfig got, TextureFormat format, TextureFormat view, PresentMode present,
                       AlphaMode alpha) {
    if (got.format == format && got.viewFormat == view && got.present == present && got.alpha == alpha
        && got.usage == TextureUsage::RenderAttachment) {
        return "";
    }
    string d = described(c: got);
    return "got ${d}";
}

fn DynamicArray<TextureFormat> formats1(TextureFormat a) {
    DynamicArray<TextureFormat> l = DynamicArray.empty();
    l.add(item: a);
    return l;
}

fn DynamicArray<PresentMode> presents1(PresentMode a) {
    DynamicArray<PresentMode> l = DynamicArray.empty();
    l.add(item: a);
    return l;
}

fn DynamicArray<AlphaMode> alphas1(AlphaMode a) {
    DynamicArray<AlphaMode> l = DynamicArray.empty();
    l.add(item: a);
    return l;
}

// "" when every way an acquire can fail has its words. The match is exhaustive, so a variant added, or one left over
// that neither leg's webgpu.h reports (OutOfMemory, item 7), fails the build.
fn string acquireFailures() {
    DynamicArray<SurfaceError> all = DynamicArray.empty();
    all.add(item: SurfaceError::Occluded);
    all.add(item: SurfaceError::Outdated);
    all.add(item: SurfaceError::Lost);
    all.add(item: SurfaceError::Timeout);
    all.add(item: SurfaceError::Failed);
    isize i = 0;
    while (i < all.length()) {
        string kind = match (all[i]) {
            case Occluded: "Occluded";
            case Outdated: "Outdated";
            case Lost: "Lost";
            case Timeout: "Timeout";
            case Failed: "Failed";
        };
        string words = all[i].message();
        if (words.isEmpty()) { return "${kind} has no words"; }
        i = i + 1;
    }
    return "";
}

// "" when capabilities made of these lists are refused.
unsafe fn string refused(DynamicArray<TextureFormat> formats, DynamicArray<PresentMode> presents,
                         DynamicArray<AlphaMode> alphas, uint64 usages) {
    Result<SurfaceCapabilities, GpuError> made = SurfaceCapabilities.make(formats: give formats, presentModes: give presents,
                                                                        alphaModes: give alphas, usages: usages);
    return match (made) {
        case Ok(value: c): "they were made";
        case Err(error: e): "";
    };
}

// What a configure answered, as a test compares it: "ok", "NoArea", "TooLarge <most>" or "NotOffered".
fn string refusal(const ref Result<Unit, ConfigureError> got) {
    string what = "ok";
    match (got) {
        case Ok(value: u): { }
        case Err(error: e): {
            match (e) {
                case NoArea: { what = "NoArea"; }
                case TooLarge(most: m): { what = "TooLarge ${m}"; }
                case NotOffered(words: said): { what = "NotOffered"; }
            };
        }
    };
    return what;
}

// A refusal's words, printed, and "" when `got` is `want` (a NotOffered must say what it refused).
fn string expectRefusal(const ref Result<Unit, ConfigureError> got, const ref string want) {
    string have = refusal(got: got);
    match (got) {
        case Ok(value: u): { }
        case Err(error: e): {
            string words = e.message();
            println(s: "info refused: ${words}");
            if (words.isEmpty()) { return "refused with no words"; }
        }
    };
    if (have == want) { return ""; }
    return "got ${have}, not ${want}";
}

type resource Check implements App {
    Optional<Instance> instance = Optional::None;
    Optional<AdapterRequest> adapterRequest = Optional::None;
    Optional<Adapter> adapter = Optional::None;
    Optional<DeviceRequest> request = Optional::None;     // WebGPU's defaults: the device the clear runs on
    Optional<DeviceRequest> raised = Optional::None;      // one limit raised to the adapter's
    Optional<DeviceRequest> beyond = Optional::None;      // one limit past the adapter's
    Optional<DeviceRequest> lacking = Optional::None;     // a feature the adapter lacks
    Optional<DeviceRequest> every = Optional::None;       // every feature the adapter has
    FeatureSet offered = FeatureSet.empty();
    uint32 raisedTo = 0;
    int32 open = 0;                                       // device requests not settled yet
    Optional<Device> device = Optional::None;
    Optional<Queue> queue = Optional::None;
    Optional<Buffer> readback = Optional::None;
    Optional<BufferRead> read = Optional::None;
    int32 stage = 0;     // 0 awaiting the adapter, 1 the devices, 2 the map, 3 done
    Instant began = monotonicNow();
    int32 runs = 0;
    int32 failures = 0;

    public unsafe ctor make() {
        this.formatCases();
        this.capabilityCases();
        this.verdict(name: "an acquire fails in one of five ways, each with its words", why: acquireFailures());
        Result<Instance, GpuError> made = Instance.make();
        match (give made) {
            case Ok(value: inst): {
                this.adapterRequest = Optional::Some(value: inst.requestAdapter(options: AdapterOptions.make(power: PowerPreference::HighPerformance)));
                this.instance = Optional::Some(value: give inst);
            }
            case Err(error: e): {
                string why = e.message();
                this.verdict(name: "an instance", why: why);
                this.stage = 3;
            }
        };
    }

    public const fn int32 failed() { return this.failures; }

    public fn void verdict(const ref string name, const ref string why) {
        this.runs = this.runs + 1;
        if (why.isEmpty()) {
            println(s: "ok   ${name}");
        } else {
            this.failures = this.failures + 1;
            println(s: "FAIL ${name}: ${why}");
        }
    }

    // One frame of the loop: false once every check has run.
    public fn bool tick() { return this.step() != 0; }

    // The host's lifecycle: nothing here holds a surface, so there is nothing to drop on `SurfaceLost`.
    public fn void lifecycle(Lifecycle event) { }

    unsafe fn int32 step() {
        if (this.stage < 3 && this.began.elapsed().asMillis() > TIMEOUT_MS) {
            string lost = "no device yet";
            match (this.device) {
                case Some(value: d): { lost = lossSaid(loss: d.lost()); }
                case None: { }
            };
            this.verdict(name: "the GPU answers within 10 s", why: "timed out at stage ${this.stage} (the device: ${lost})");
            this.stage = 3;
        }
        if (this.stage == 0) { this.awaitAdapter(); }
        if (this.stage == 1) { this.awaitDevices(); }
        if (this.stage == 2) { this.awaitRead(); }
        if (this.stage == 3) { return this.finish(); }
        return 1;
    }

    unsafe fn void awaitAdapter() {
        Optional<AdapterRequest> taken = replace(place: this.adapterRequest, with: Optional::None);
        match (give taken) {
            case None: { this.verdict(name: "an adapter request", why: "there was none"); this.stage = 3; }
            case Some(value: r): {
                AdapterStatus status = r.poll();
                this.adapterRequest = Optional::Some(value: give r);
                match (give status) {
                    case Pending: { }
                    case Ready(adapter: a): {
                        this.adapterRequest = Optional::None;
                        this.verdict(name: "an adapter, asked of the instance", why: "");
                        this.askAdapter(adapter: a);
                        this.adapter = Optional::Some(value: give a);
                        this.stage = 1;
                    }
                    case Failed(error: e): {
                        this.adapterRequest = Optional::None;
                        string why = e.message();
                        this.verdict(name: "an adapter, asked of the instance", why: why);
                        this.stage = 3;
                    }
                };
            }
        };
    }

    // What the adapter answers, then four devices asked of it at once.
    unsafe fn void askAdapter(ref Adapter adapter) {
        AdapterInfo info = adapter.info();
        Backend backend = info.backend();
        bool named = match (backend) { case Undefined: false; case Null: false; case _: true; };
        string description = info.description();
        println(s: "info the adapter: ${description}");
        this.verdict(name: "the adapter names its backend", why: named ? "" : "its backend is Undefined or Null");
        Limits limits = adapter.limits();
        Limits defaults = Limits.defaults();
        string below = meets(have: limits, want: defaults);
        this.verdict(name: "the adapter's limits meet WebGPU's defaults", why: below);

        this.request = Optional::Some(value: adapter.requestDevice(options: DeviceOptions.defaults()));
        this.open = 1;

        uint32 top = limits.maxTextureDimension2D;
        if (top > defaults.maxTextureDimension2D) {
            DeviceOptions up = DeviceOptions.defaults();
            up.limits.maxTextureDimension2D = top;
            this.raisedTo = top;
            this.raised = Optional::Some(value: adapter.requestDevice(options: up));
            this.open = this.open + 1;
        } else {
            println(s: "skip a raised limit: the adapter's maxTextureDimension2D is WebGPU's default, ${top}");
        }

        DeviceOptions past = DeviceOptions.defaults();
        past.limits.maxTextureDimension2D = top + 1;
        this.beyond = Optional::Some(value: adapter.requestDevice(options: past));
        this.open = this.open + 1;

        FeatureSet has = adapter.features();
        this.verdict(name: "the adapter answers its features", why: answered(has: has));
        DeviceOptions all = DeviceOptions.defaults();
        all.features = has;
        this.offered = has;
        this.every = Optional::Some(value: adapter.requestDevice(options: all));
        this.open = this.open + 1;
        Optional<Feature> missing = lackedBy(has: has);
        match (missing) {
            case Some(value: f): {
                DeviceOptions wants = DeviceOptions.defaults();
                wants.features = wants.features.with(feature: f);
                this.lacking = Optional::Some(value: adapter.requestDevice(options: wants));
                this.open = this.open + 1;
            }
            case None: { println(s: "skip a feature the adapter lacks: it has every candidate"); }
        };
        errorCases(t: this, adapter: adapter);
    }

    unsafe fn void awaitDevices() {
        if (this.request.isSome()) {
            DeviceStatus s = pollOne(slot: this.request);
            match (give s) {
                case Pending: { }
                case Ready(device: d, queue: q): {
                    this.open = this.open - 1;
                    this.verdict(name: "a device and its queue, from the adapter", why: "");
                    Limits got = d.limits();
                    Limits defaults = Limits.defaults();
                    string off = equal(have: got, want: defaults);
                    this.verdict(name: "a device asked for the defaults has WebGPU's default limits, not the adapter's", why: off);
                    this.render(device: d, queue: q);
                    this.device = Optional::Some(value: give d);
                    this.queue = Optional::Some(value: give q);
                }
                case Failed(error: e): {
                    this.open = this.open - 1;
                    string why = e.message();
                    this.verdict(name: "a device and its queue, from the adapter", why: why);
                    this.stage = 3;
                    return;
                }
            };
        }
        if (this.raised.isSome()) {
            DeviceStatus s = pollOne(slot: this.raised);
            match (give s) {
                case Pending: { }
                case Ready(device: d, queue: q): {
                    this.open = this.open - 1;
                    Limits got = d.limits();
                    uint32 to = got.maxTextureDimension2D;
                    uint32 want = this.raisedTo;
                    this.verdict(name: "a limit raised to the adapter's is granted",
                                 why: to == want ? "" : "maxTextureDimension2D ${to}, not ${want}");
                }
                case Failed(error: e): {
                    this.open = this.open - 1;
                    string why = e.message();
                    this.verdict(name: "a limit raised to the adapter's is granted", why: "refused: " + why);
                }
            };
        }
        if (this.beyond.isSome()) {
            DeviceStatus s = pollOne(slot: this.beyond);
            match (give s) {
                case Pending: { }
                case Ready(device: d, queue: q): {
                    this.open = this.open - 1;
                    this.verdict(name: "a limit past the adapter's is refused, in the implementation's words", why: "a device was given");
                }
                case Failed(error: e): {
                    this.open = this.open - 1;
                    string why = e.message();
                    println(s: "info refused: ${why}");
                    this.verdict(name: "a limit past the adapter's is refused, in the implementation's words",
                                 why: why.isEmpty() ? "refused with no words" : "");
                }
            };
        }
        if (this.lacking.isSome()) {
            DeviceStatus s = pollOne(slot: this.lacking);
            match (give s) {
                case Pending: { }
                case Ready(device: d, queue: q): {
                    this.open = this.open - 1;
                    this.verdict(name: "a feature the adapter lacks is refused, in the implementation's words", why: "a device was given");
                }
                case Failed(error: e): {
                    this.open = this.open - 1;
                    string why = e.message();
                    println(s: "info refused: ${why}");
                    this.verdict(name: "a feature the adapter lacks is refused, in the implementation's words",
                                 why: why.isEmpty() ? "refused with no words" : "");
                }
            };
        }
        if (this.every.isSome()) {
            DeviceStatus s = pollOne(slot: this.every);
            match (give s) {
                case Pending: { }
                case Ready(device: d, queue: q): {
                    this.open = this.open - 1;
                    FeatureSet given = d.features();
                    string gap = missingFrom(given: given, offered: this.offered);
                    this.verdict(name: "a device asked for every feature the adapter has is given them all", why: gap);
                }
                case Failed(error: e): {
                    this.open = this.open - 1;
                    string why = e.message();
                    this.verdict(name: "a device asked for every feature the adapter has is given them all", why: "refused: " + why);
                }
            };
        }
        if (this.open == 0 && this.stage == 1) { this.stage = 2; }
    }

    // Clear a texture, copy it to a buffer, and ask for the buffer's bytes.
    unsafe fn void render(ref Device device, ref Queue queue) {
        Texture target = device.createTexture(width: SIDE, height: SIDE, format: TextureFormat::RGBA8Unorm,
                                              usage: TextureUsage::RenderAttachment | TextureUsage::CopySrc);
        TextureView view = target.createView();
        uint64 bytes = cast<uint64>(ROW) * cast<uint64>(SIDE);
        Buffer copy = device.createBuffer(size: bytes, usage: BufferUsage::MapRead | BufferUsage::CopyDst);
        CommandEncoder encoder = device.createCommandEncoder();
        RenderPass pass = encoder.beginRenderPass(target: view, clear: Color.of(r: RED, g: GREEN, b: BLUE, a: 1.0));
        give pass.end();
        encoder.copyTextureToBuffer(texture: target, buffer: copy, width: SIDE, height: SIDE, bytesPerRow: ROW);
        CommandBuffer commands = give encoder.finish();
        queue.submit(commands: give commands);
        this.read = Optional::Some(value: copy.mapRead(offset: 0, size: bytes));
        this.readback = Optional::Some(value: give copy);
    }

    unsafe fn void awaitRead() {
        match (this.device) {
            case Some(value: d): { d.poll(wait: true); }
            case None: { }
        };
        ReadStatus status = ReadStatus::Pending;
        match (this.read) {
            case Some(value: r): { status = r.poll(); }
            case None: { status = ReadStatus::Failed(error: GpuError::Taken); }
        };
        match (give status) {
            case Pending: { }
            case Ready: { this.checkPixels(); this.stage = 3; }
            case Failed(error: e): {
                string why = e.message();
                this.verdict(name: "the readback maps", why: why);
                this.stage = 3;
            }
        };
    }

    unsafe fn void checkPixels() {
        DynamicArray<uint8> px = DynamicArray.empty();
        match (this.read) {
            case Some(value: r): { px = r.bytes(); }
            case None: { }
        };
        isize want = cast<isize>(ROW) * cast<isize>(SIDE);
        isize got = px.length();
        if (got != want) {
            this.verdict(name: "the readback's bytes", why: "${got} bytes, not ${want}");
            return;
        }
        int32 r = cast<int32>(RED * 255.0 + 0.5);
        int32 g = cast<int32>(GREEN * 255.0 + 0.5);
        int32 b = cast<int32>(BLUE * 255.0 + 0.5);
        isize bad = 0;
        isize i = 0;
        while (i < want) {
            if (!near(got: px[i], want: r) || !near(got: px[i + 1], want: g) || !near(got: px[i + 2], want: b)
                || !near(got: px[i + 3], want: 255)) {
                bad = bad + 1;
            }
            i = i + 4;
        }
        if (bad == 0) {
            this.verdict(name: "every texel reads back as the clear colour", why: "");
        } else {
            uint8 r0 = px[0];
            uint8 g0 = px[1];
            uint8 b0 = px[2];
            uint8 a0 = px[3];
            this.verdict(name: "every texel reads back as the clear colour",
                         why: "${bad} texels differ; the first is ${r0} ${g0} ${b0} ${a0}, not ${r} ${g} ${b} 255");
        }
    }

    // TextureFormat: every format webgpu.h names, each by its own number both ways, with its sRGB and linear forms.
    unsafe fn void formatCases() {
        int32 named = 0;
        string wrong = "";
        int32 n = 0;
        while (n < 1024) {
            Optional<TextureFormat> f = TextureFormat::fromValue(value: n);
            match (f) {
                case Some(value: x): {
                    named = named + 1;
                    int32 back = x.value();
                    if (back != n && wrong.isEmpty()) { string nm = x.name(); wrong = "${n} names ${nm}, whose number is ${back}"; }
                }
                case None: { }
            };
            n = n + 1;
        }
        if (wrong.isEmpty() && named != 101) { wrong = "${named} numbers named, not 101"; }
        this.verdict(name: "TextureFormat names webgpu.h's 101 formats, each by its own number", why: wrong);
        Optional<TextureFormat> undefined = TextureFormat::fromValue(value: 0);
        Optional<TextureFormat> nv12 = TextureFormat::fromValue(value: 0x00030007);
        this.verdict(name: "a number webgpu.h names no format for is none: Undefined, and wgpu-native's NV12",
                     why: undefined.isSome() || nv12.isSome() ? "it named one" : "");
        this.verdict(name: "RGBA8Unorm and RGBA8UnormSrgb are each other's sRGB and linear forms",
                     why: twins(linear: TextureFormat::RGBA8Unorm, srgb: TextureFormat::RGBA8UnormSrgb));
        this.verdict(name: "BGRA8Unorm and BGRA8UnormSrgb are each other's sRGB and linear forms",
                     why: twins(linear: TextureFormat::BGRA8Unorm, srgb: TextureFormat::BGRA8UnormSrgb));
        this.verdict(name: "a compressed pair has its forms too: BC7RGBAUnorm and ASTC10x8Unorm",
                     why: twins(linear: TextureFormat::BC7RGBAUnorm, srgb: TextureFormat::BC7RGBAUnormSrgb)
                          + twins(linear: TextureFormat::ASTC10x8Unorm, srgb: TextureFormat::ASTC10x8UnormSrgb));
        this.verdict(name: "RGBA16Float and RGB10A2Unorm have no sRGB form",
                     why: loner(f: TextureFormat::RGBA16Float) + loner(f: TextureFormat::RGB10A2Unorm));
        string a = TextureFormat::BGRA8UnormSrgb.name();
        string b = TextureFormat::Depth24PlusStencil8.name();
        this.verdict(name: "a format's name is webgpu.h's",
                     why: a == "BGRA8UnormSrgb" && b == "Depth24PlusStencil8" ? "" : "${a}, ${b}");
    }

    // What `preferred()` makes of a surface's answer, and the answers `of` refuses as breaking webgpu.h's promises.
    unsafe fn void capabilityCases() {
        // The web's (emdawnwebgpu's): the browser's preferred canvas format first, none sRGB; Fifo; Opaque, Premultiplied.
        DynamicArray<TextureFormat> wf = formats1(a: TextureFormat::BGRA8Unorm);
        wf.add(item: TextureFormat::RGBA8Unorm);
        wf.add(item: TextureFormat::RGBA16Float);
        DynamicArray<AlphaMode> wa = alphas1(a: AlphaMode::Opaque);
        wa.add(item: AlphaMode::Premultiplied);
        uint64 canvas = TextureUsage::RenderAttachment | TextureUsage::TextureBinding | TextureUsage::CopySrc
                        | TextureUsage::CopyDst;
        Result<SurfaceCapabilities, GpuError> web = SurfaceCapabilities.make(formats: give wf,
                                                                           presentModes: presents1(a: PresentMode::Fifo),
                                                                           alphaModes: give wa, usages: canvas);
        match (give web) {
            case Ok(value: caps): {
                SurfaceConfig c = caps.preferred();
                this.verdict(name: "on the web's answer, preferred() draws BGRA8Unorm through its sRGB view, Fifo, Opaque",
                             why: expectConfig(got: c, format: TextureFormat::BGRA8Unorm, view: TextureFormat::BGRA8UnormSrgb,
                                               present: PresentMode::Fifo, alpha: AlphaMode::Opaque));
                string order = formatList(fs: caps.formats());
                this.verdict(name: "a surface's formats keep its order",
                             why: order == "BGRA8Unorm, RGBA8Unorm, RGBA16Float" ? "" : order);
            }
            case Err(error: e): { string why = e.message(); this.verdict(name: "the web's answer makes capabilities", why: why); }
        };

        // This machine's (wgpu-native over Vulkan, measured 2026-11-10): sRGB first, Immediate before Fifo, Opaque only.
        DynamicArray<TextureFormat> nf = formats1(a: TextureFormat::RGBA8UnormSrgb);
        nf.add(item: TextureFormat::BGRA8UnormSrgb);
        nf.add(item: TextureFormat::RGBA8Unorm);
        nf.add(item: TextureFormat::BGRA8Unorm);
        nf.add(item: TextureFormat::RGB10A2Unorm);
        DynamicArray<PresentMode> np = presents1(a: PresentMode::Immediate);
        np.add(item: PresentMode::Fifo);
        np.add(item: PresentMode::FifoRelaxed);
        Result<SurfaceCapabilities, GpuError> native = SurfaceCapabilities.make(formats: give nf, presentModes: give np,
            alphaModes: alphas1(a: AlphaMode::Opaque),
            usages: TextureUsage::RenderAttachment | TextureUsage::TextureBinding | TextureUsage::CopySrc);
        match (give native) {
            case Ok(value: caps): {
                SurfaceConfig c = caps.preferred();
                this.verdict(name: "on a native answer, preferred() draws RGBA8UnormSrgb through itself, and Fifo though Immediate is first",
                             why: expectConfig(got: c, format: TextureFormat::RGBA8UnormSrgb, view: TextureFormat::RGBA8UnormSrgb,
                                               present: PresentMode::Fifo, alpha: AlphaMode::Opaque));
            }
            case Err(error: e): { string why = e.message(); this.verdict(name: "a native answer makes capabilities", why: why); }
        };

        // A format with no sRGB form first, and an alpha mode other than Opaque first.
        DynamicArray<TextureFormat> hf = formats1(a: TextureFormat::RGBA16Float);
        hf.add(item: TextureFormat::BGRA8Unorm);
        DynamicArray<AlphaMode> ha = alphas1(a: AlphaMode::Premultiplied);
        ha.add(item: AlphaMode::Opaque);
        Result<SurfaceCapabilities, GpuError> hdr = SurfaceCapabilities.make(formats: give hf,
                                                                           presentModes: presents1(a: PresentMode::Fifo),
                                                                           alphaModes: give ha,
                                                                           usages: TextureUsage::RenderAttachment);
        match (give hdr) {
            case Ok(value: caps): {
                SurfaceConfig c = caps.preferred();
                this.verdict(name: "preferred() draws a format with no sRGB form through itself, and takes the first alpha mode",
                             why: expectConfig(got: c, format: TextureFormat::RGBA16Float, view: TextureFormat::RGBA16Float,
                                               present: PresentMode::Fifo, alpha: AlphaMode::Premultiplied));
            }
            case Err(error: e): { string why = e.message(); this.verdict(name: "an HDR answer makes capabilities", why: why); }
        };

        DynamicArray<TextureFormat> none = DynamicArray.empty();
        this.verdict(name: "capabilities with no format are refused",
                     why: refused(formats: give none, presents: presents1(a: PresentMode::Fifo),
                                  alphas: alphas1(a: AlphaMode::Opaque), usages: TextureUsage::RenderAttachment));
        this.verdict(name: "capabilities without Fifo are refused",
                     why: refused(formats: formats1(a: TextureFormat::BGRA8Unorm), presents: presents1(a: PresentMode::Mailbox),
                                  alphas: alphas1(a: AlphaMode::Opaque), usages: TextureUsage::RenderAttachment));
        DynamicArray<AlphaMode> noAlpha = DynamicArray.empty();
        this.verdict(name: "capabilities with no alpha mode are refused",
                     why: refused(formats: formats1(a: TextureFormat::BGRA8Unorm), presents: presents1(a: PresentMode::Fifo),
                                  alphas: give noAlpha, usages: TextureUsage::RenderAttachment));
        this.verdict(name: "capabilities without RenderAttachment are refused",
                     why: refused(formats: formats1(a: TextureFormat::BGRA8Unorm), presents: presents1(a: PresentMode::Fifo),
                                  alphas: alphas1(a: AlphaMode::Opaque), usages: TextureUsage::TextureBinding));
    }

    // Every handle released by its destructor, then the verdict on uncaptured errors and the totals.
    unsafe fn int32 finish() {
        surfaceCases(t: this);
        match (this.device) {
            case Some(value: d): {
                DeviceErrors errs = d.takeErrors();
                this.verdict(name: "no uncaptured WebGPU error on the clear's device", why: errorsSaid(errs: errs));
            }
            case None: { }
        };
        this.read = Optional::None;
        this.readback = Optional::None;
        this.queue = Optional::None;
        this.device = Optional::None;
        this.request = Optional::None;
        this.raised = Optional::None;
        this.beyond = Optional::None;
        this.lacking = Optional::None;
        this.every = Optional::None;
        this.adapter = Optional::None;
        this.adapterRequest = Optional::None;
        this.instance = Optional::None;
        int64 alive = statesAlive();
        this.verdict(name: "every device's state is freed with its last handle",
                     why: alive == 0 ? "" : "${alive} still alive after every handle was dropped");
        println(s: "gpu tests: ${this.runs} cases, ${this.failures} failed");
        exitStatus = this.failures > 0 ? 1 : 0;
        endOnTheWeb(failed: this.failures > 0);
        return 0;
    }
}

// ---- a surface on a real window (natively: the web's canvas surface comes with @kama/window's web half) ---------------

comptime uint32 PATCH = 64;   // the corner of a frame read back, PATCH × PATCH texels

@compileFor(ARCH_WASM32)
unsafe fn void surfaceCases(ref Check t) {
    println(s: "skip the surface cases: a canvas surface comes with @kama/window's web half");
}

@compileFor(!ARCH_WASM32)
unsafe fn void surfaceCases(ref Check t) {
    string off = envOr(name: "KAMA_WINDOW_NO_DISPLAY", dflt: "");
    if (!off.isEmpty()) { println(s: "skip the surface cases: KAMA_WINDOW_NO_DISPLAY is set"); return; }
    // Declared in the order they must outlive each other: the window, then what presents to it.
    Result<Window, WindowError> opened = Window.open(title: "@kama/gpu tests", width: 320, height: 200);
    Window window = match (give opened) {
        case Ok(value: opens): give opens;
        case Err(error: e): { string why = e.message(); t.verdict(name: "a window for the surface cases", why: why); return; }
    };
    Result<Instance, GpuError> made = Instance.make();
    Instance instance = match (give made) {
        case Ok(value: i): give i;
        case Err(error: e): { string why = e.message(); t.verdict(name: "an instance for the surface cases", why: why); return; }
    };
    Result<Surface, GpuError> onWindow = Surface.make(instance: instance, window: window);
    Surface surface = match (give onWindow) {
        case Ok(value: s): give s;
        case Err(error: e): { string why = e.message(); t.verdict(name: "a surface on the window", why: why); return; }
    };
    Surface early = copy surface;   // copied before any configure: it must still draw in the configured view format
    Result<Adapter, GpuError> found = adapterFor(instance: instance, surface: surface);
    Adapter adapter = match (give found) {
        case Ok(value: a): give a;
        case Err(error: e): { string why = e.message(); t.verdict(name: "an adapter for the surface", why: why); return; }
    };
    Result<SurfaceCapabilities, GpuError> asked = surface.capabilities(adapter: adapter);
    SurfaceCapabilities caps = match (give asked) {
        case Ok(value: c): give c;
        case Err(error: e): { string why = e.message(); t.verdict(name: "a surface answers its capabilities", why: why); return; }
    };
    string formats = formatList(fs: caps.formats());
    string presents = presentList(ps: caps.presentModes());
    string alphas = alphaList(modes: caps.alphaModes());
    uint64 usages = caps.usages();
    println(s: "info the surface offers ${formats}; ${presents}; ${alphas}; usages ${usages}");
    t.verdict(name: "a surface answers its capabilities", why: "");
    DeviceRequest request = adapter.requestDevice(options: DeviceOptions.defaults());
    int32 polls = 0;
    while (polls < 1000) {
        DeviceStatus s = request.poll();
        match (give s) {
            case Pending: { }
            case Ready(device: d, queue: q): {
                Size px = window.framebufferSize();
                configureCases(t: t, surface: surface, early: early, caps: caps, device: d, queue: q,
                               width: cast<uint32>(px.width), height: cast<uint32>(px.height));
                DeviceErrors errs = d.takeErrors();
                t.verdict(name: "no uncaptured WebGPU error on the surface's device", why: errorsSaid(errs: errs));
                return;
            }
            case Failed(error: e): { string why = e.message(); t.verdict(name: "a device for the surface", why: why); return; }
        };
        polls = polls + 1;
    }
    t.verdict(name: "a device for the surface", why: "the request never settled");
}

// An adapter that can present to `surface`; natively the request is answered as soon as it is polled.
@compileFor(!ARCH_WASM32)
unsafe fn Result<Adapter, GpuError> adapterFor(ref Instance instance, const ref Surface surface) {
    AdapterRequest asked = instance.requestAdapter(options: AdapterOptions.withSurface(surface: surface,
                                                                                       power: PowerPreference::HighPerformance));
    int32 polls = 0;
    while (polls < 1000) {
        AdapterStatus a = asked.poll();
        match (give a) {
            case Pending: { }
            case Ready(adapter: adapter): { return Result::Ok(value: give adapter); }
            case Failed(error: e): { return Result::Err(error: give e); }
        };
        polls = polls + 1;
    }
    return Result::Err(error: GpuError::Refused(words: "the adapter request never settled"));
}

// A present mode, an alpha mode, and so on, the surface does not offer, or None when it offers them all.
@compileFor(!ARCH_WASM32)
fn Optional<PresentMode> presentNotIn(const ref DynamicArray<PresentMode> offered) {
    DynamicArray<PresentMode> all = presents1(a: PresentMode::Mailbox);
    all.add(item: PresentMode::Immediate);
    all.add(item: PresentMode::FifoRelaxed);
    isize i = 0;
    while (i < all.length()) {
        bool there = false;
        isize j = 0;
        while (j < offered.length()) { if (offered[j] == all[i]) { there = true; } j = j + 1; }
        if (!there) { return Optional::Some(value: all[i]); }
        i = i + 1;
    }
    return Optional::None;
}

@compileFor(!ARCH_WASM32)
fn Optional<AlphaMode> alphaNotIn(const ref DynamicArray<AlphaMode> offered) {
    DynamicArray<AlphaMode> all = alphas1(a: AlphaMode::Premultiplied);
    all.add(item: AlphaMode::Unpremultiplied);
    all.add(item: AlphaMode::Inherit);
    all.add(item: AlphaMode::Opaque);
    isize i = 0;
    while (i < all.length()) {
        bool there = false;
        isize j = 0;
        while (j < offered.length()) { if (offered[j] == all[i]) { there = true; } j = j + 1; }
        if (!there) { return Optional::Some(value: all[i]); }
        i = i + 1;
    }
    return Optional::None;
}

// The first format the surface offers that is linear and has an sRGB form, or None.
@compileFor(!ARCH_WASM32)
fn Optional<TextureFormat> linearWithTwin(const ref DynamicArray<TextureFormat> offered) {
    isize i = 0;
    while (i < offered.length()) {
        TextureFormat f = offered[i];
        Optional<TextureFormat> s = f.srgb();
        if (!f.isSrgb() && s.isSome()) { return Optional::Some(value: f); }
        i = i + 1;
    }
    return Optional::None;
}

// Each configure the package must refuse rather than let wgpu-native abort the process (each one measured aborting it,
// 2026-11-10), then the preferred config, then a grey frame read back through an sRGB view and through a linear one.
@compileFor(!ARCH_WASM32)
unsafe fn void configureCases(ref Check t, ref Surface surface, ref Surface early, const ref SurfaceCapabilities caps,
                              ref Device device, ref Queue queue, uint32 width, uint32 height) {
    SurfaceConfig preferred = caps.preferred();
    Result<Unit, ConfigureError> noWidth = surface.configure(device: device, config: preferred, width: 0, height: height);
    t.verdict(name: "a configure with no width is refused as NoArea, not aborted", why: expectRefusal(got: noWidth, want: "NoArea"));
    Result<Unit, ConfigureError> noHeight = surface.configure(device: device, config: preferred, width: width, height: 0);
    t.verdict(name: "a configure with no height is refused as NoArea", why: expectRefusal(got: noHeight, want: "NoArea"));

    Limits limits = device.limits();
    uint32 most = limits.maxTextureDimension2D;
    Result<Unit, ConfigureError> wide = surface.configure(device: device, config: preferred, width: most + 1, height: height);
    t.verdict(name: "a configure past the device's maxTextureDimension2D is refused as TooLarge, naming the most",
              why: expectRefusal(got: wide, want: "TooLarge ${most}"));
    Result<Unit, ConfigureError> tall = surface.configure(device: device, config: preferred, width: width, height: most + 1);
    t.verdict(name: "a configure past it in height is refused as TooLarge", why: expectRefusal(got: tall, want: "TooLarge ${most}"));

    Optional<PresentMode> pm = presentNotIn(offered: caps.presentModes());
    match (pm) {
        case Some(value: m): {
            SurfaceConfig c = caps.preferred();
            c.present = m;
            Result<Unit, ConfigureError> r = surface.configure(device: device, config: c, width: width, height: height);
            t.verdict(name: "a present mode the surface does not offer is refused as NotOffered", why: expectRefusal(got: r, want: "NotOffered"));
        }
        case None: { println(s: "skip a present mode not offered: the surface offers every one"); }
    };
    Optional<AlphaMode> am = alphaNotIn(offered: caps.alphaModes());
    match (am) {
        case Some(value: m): {
            SurfaceConfig c = caps.preferred();
            c.alpha = m;
            Result<Unit, ConfigureError> r = surface.configure(device: device, config: c, width: width, height: height);
            t.verdict(name: "an alpha mode the surface does not offer is refused as NotOffered", why: expectRefusal(got: r, want: "NotOffered"));
        }
        case None: { println(s: "skip an alpha mode not offered: the surface offers every one"); }
    };
    SurfaceConfig depth = caps.preferred();
    depth.format = TextureFormat::Depth32Float;
    depth.viewFormat = TextureFormat::Depth32Float;
    Result<Unit, ConfigureError> df = surface.configure(device: device, config: depth, width: width, height: height);
    t.verdict(name: "a format the surface does not offer is refused as NotOffered", why: expectRefusal(got: df, want: "NotOffered"));
    SurfaceConfig other = caps.preferred();
    other.viewFormat = TextureFormat::RGBA16Float;
    Result<Unit, ConfigureError> vf = surface.configure(device: device, config: other, width: width, height: height);
    t.verdict(name: "a view format that changes more than sRGB-ness is refused as NotOffered",
              why: expectRefusal(got: vf, want: "NotOffered"));
    SurfaceConfig unused = caps.preferred();
    unused.usage = 0;
    Result<Unit, ConfigureError> nu = surface.configure(device: device, config: unused, width: width, height: height);
    t.verdict(name: "a configure with no usage is refused as NotOffered", why: expectRefusal(got: nu, want: "NotOffered"));
    if ((caps.usages() & TextureUsage::StorageBinding) == 0) {
        SurfaceConfig storage = caps.preferred();
        storage.usage = TextureUsage::RenderAttachment | TextureUsage::StorageBinding;
        Result<Unit, ConfigureError> su = surface.configure(device: device, config: storage, width: width, height: height);
        t.verdict(name: "a usage the surface does not offer is refused as NotOffered", why: expectRefusal(got: su, want: "NotOffered"));
    } else {
        println(s: "skip a usage not offered: the surface offers StorageBinding");
    }

    // Each choice the surface offers is taken: what the package read agrees with what wgpu-native checks, which would
    // abort the process on a choice the surface does not offer.
    string bad = "";
    isize i = 0;
    while (i < caps.formats().length() && bad.isEmpty()) {
        SurfaceConfig c = caps.preferred();
        c.format = caps.formats()[i];
        c.viewFormat = c.format;
        Result<Unit, ConfigureError> r = surface.configure(device: device, config: c, width: width, height: height);
        string got = refusal(got: r);
        if (got != "ok") { string n = c.format.name(); bad = "format ${n}: ${got}"; }
        i = i + 1;
    }
    i = 0;
    while (i < caps.presentModes().length() && bad.isEmpty()) {
        SurfaceConfig c = caps.preferred();
        c.present = caps.presentModes()[i];
        Result<Unit, ConfigureError> r = surface.configure(device: device, config: c, width: width, height: height);
        string got = refusal(got: r);
        if (got != "ok") { string n = c.present.name(); bad = "present mode ${n}: ${got}"; }
        i = i + 1;
    }
    i = 0;
    while (i < caps.alphaModes().length() && bad.isEmpty()) {
        SurfaceConfig c = caps.preferred();
        c.alpha = caps.alphaModes()[i];
        Result<Unit, ConfigureError> r = surface.configure(device: device, config: c, width: width, height: height);
        string got = refusal(got: r);
        if (got != "ok") { string n = c.alpha.name(); bad = "alpha mode ${n}: ${got}"; }
        i = i + 1;
    }
    if (bad.isEmpty()) {
        SurfaceConfig c = caps.preferred();
        c.usage = caps.usages();
        Result<Unit, ConfigureError> r = surface.configure(device: device, config: c, width: width, height: height);
        string got = refusal(got: r);
        if (got != "ok") { bad = "every usage it offers at once: ${got}"; }
    }
    t.verdict(name: "every format, present mode, alpha mode and usage the surface offers is taken", why: bad);

    Result<Unit, ConfigureError> taken = surface.configure(device: device, config: preferred, width: width, height: height);
    t.verdict(name: "the preferred config is taken", why: expectRefusal(got: taken, want: "ok"));

    Optional<TextureFormat> lw = linearWithTwin(offered: caps.formats());
    bool copies = (caps.usages() & TextureUsage::CopySrc) != 0;
    match (lw) {
        case Some(value: f): {
            if (!copies) { println(s: "skip a frame read back: the surface does not offer CopySrc"); return; }
            SurfaceConfig srgb = caps.preferred();
            srgb.format = f;
            srgb.viewFormat = match (f.srgb()) { case Some(value: v): v; case None: f; };
            srgb.usage = TextureUsage::RenderAttachment | TextureUsage::CopySrc;
            Result<Unit, ConfigureError> s1 = surface.configure(device: device, config: srgb, width: width, height: height);
            t.verdict(name: "a linear format through its sRGB view is taken", why: expectRefusal(got: s1, want: "ok"));
            Result<int32, GpuError> encoded = drawGrey(surface: early, device: device, queue: queue);
            t.verdict(name: "a frame drawn through the sRGB view, by a copy made before the configure, reads 0.5 grey as 188",
                      why: greyIs(got: encoded, want: 188));
            SurfaceConfig linear = srgb;
            linear.viewFormat = f;
            Result<Unit, ConfigureError> s2 = surface.configure(device: device, config: linear, width: width, height: height);
            t.verdict(name: "a linear format through itself is taken", why: expectRefusal(got: s2, want: "ok"));
            Result<int32, GpuError> plain = drawGrey(surface: surface, device: device, queue: queue);
            t.verdict(name: "a frame drawn through the linear view reads 0.5 grey as 128", why: greyIs(got: plain, want: 128));
        }
        case None: { println(s: "skip a frame read back: the surface offers no linear format with an sRGB form"); }
    };
}

@compileFor(!ARCH_WASM32)
fn string greyIs(const ref Result<int32, GpuError> got, int32 want) {
    string why = "";
    match (got) {
        case Ok(value: v): {
            if (v < want - 1 || v > want + 1) { why = "read ${v}"; }
        }
        case Err(error: e): { why = e.message(); }
    };
    return why;
}

// Acquire a frame, clear it to 0.5 grey through `frame.view()`, copy its top-left PATCH × PATCH texels out, present it,
// and answer the grey they read: every texel the same grey, and opaque.
@compileFor(!ARCH_WASM32)
unsafe fn Result<int32, GpuError> drawGrey(ref Surface surface, ref Device device, ref Queue queue) {
    Result<SurfaceTexture, SurfaceError> acquired = surface.acquire();
    SurfaceTexture frame = match (give acquired) {
        case Ok(value: f): give f;
        case Err(error: e): { string why = e.message(); return Result::Err(error: GpuError::Refused(words: "no frame: ${why}")); }
    };
    TextureView view = frame.view();
    Texture texture = frame.texture();
    uint64 bytes = cast<uint64>(ROW) * cast<uint64>(PATCH);
    Buffer buffer = device.createBuffer(size: bytes, usage: BufferUsage::MapRead | BufferUsage::CopyDst);
    CommandEncoder encoder = device.createCommandEncoder();
    RenderPass pass = encoder.beginRenderPass(target: view, clear: Color.of(r: 0.5, g: 0.5, b: 0.5, a: 1.0));
    give pass.end();
    encoder.copyTextureToBuffer(texture: texture, buffer: buffer, width: PATCH, height: PATCH, bytesPerRow: ROW);
    CommandBuffer commands = give encoder.finish();
    queue.submit(commands: give commands);
    BufferRead read = buffer.mapRead(offset: 0, size: bytes);
    int32 polls = 0;
    bool ready = false;
    while (polls < 100 && !ready) {
        device.poll(wait: true);
        ReadStatus status = read.poll();
        match (give status) {
            case Pending: { }
            case Ready: { ready = true; }
            case Failed(error: e): { give frame.present(); return Result::Err(error: give e); }
        };
        polls = polls + 1;
    }
    give frame.present();
    if (!ready) { return Result::Err(error: GpuError::Refused(words: "the readback never mapped")); }
    DynamicArray<uint8> px = read.bytes();
    int32 grey = cast<int32>(px[0]);
    isize i = 0;
    while (i < px.length()) {
        if (!near(got: px[i], want: grey) || !near(got: px[i + 1], want: grey) || !near(got: px[i + 2], want: grey)
            || !near(got: px[i + 3], want: 255)) {
            uint8 r = px[i];
            uint8 g = px[i + 1];
            uint8 b = px[i + 2];
            uint8 a = px[i + 3];
            return Result::Err(error: GpuError::Refused(words: "a texel read ${r} ${g} ${b} ${a}, the first ${grey}"));
        }
        i = i + 4;
    }
    return Result::Ok(value: grey);
}

// ---- a device's errors (GPU-1): natively, where an error is in the channel when the call that caused it returns --------

fn string kindName(GpuErrorKind k) {
    return match (k) {
        case Validation: "Validation";
        case OutOfMemory: "OutOfMemory";
        case Internal: "Internal";
        case Unknown: "Unknown";
    };
}

// A drain, for a verdict on a device that must have none: "" when it is empty.
fn string errorsSaid(const ref DeviceErrors errs) {
    if (errs.isEmpty()) { return ""; }
    isize n = errs.reports().length();
    int64 dropped = errs.dropped();
    if (n == 0) { return "${dropped} dropped"; }
    string earliest = errs.reports()[0].message();
    return "${n} reported and ${dropped} dropped, the first: ${earliest}";
}

// A drain, for a verdict: "" when it holds exactly `want` reports, each of `kind`, and dropped none.
fn string holds(const ref DeviceErrors errs, isize want, GpuErrorKind kind) {
    isize n = errs.reports().length();
    int64 dropped = errs.dropped();
    if (n != want) { return "${n} reported, not ${want}"; }
    if (dropped != 0) { return "${dropped} dropped"; }
    isize i = 0;
    while (i < n) {
        GpuErrorKind got = errs.reports()[i].kind();
        if (got != kind) {
            string name = kindName(k: got);
            return "report ${i} is ${name}";
        }
        string words = errs.reports()[i].message();
        if (words.isEmpty()) { return "report ${i} has no words"; }
        i = i + 1;
    }
    return "";
}

fn string lossSaid(const ref Optional<DeviceLoss> loss) {
    return match (loss) {
        case Some(value: l): l.message();
        case None: "not lost";
    };
}

// MapRead may be combined only with CopyDst: a validation error.
unsafe fn Buffer badBuffer(ref Device device) {
    return device.createBuffer(size: 16, usage: BufferUsage::MapRead | BufferUsage::Storage);
}

// A texture with no width: a validation error in other words.
unsafe fn Texture badTexture(ref Device device) {
    return device.createTexture(width: 0, height: 4, format: TextureFormat::RGBA8Unorm, usage: TextureUsage::TextureBinding);
}

// An encoder holding a copy out of a texture made without CopySrc: an error its finish reports.
unsafe fn CommandEncoder badCopy(ref Device device) {
    Texture source = device.createTexture(width: 4, height: 4, format: TextureFormat::RGBA8Unorm,
                                          usage: TextureUsage::TextureBinding);
    Buffer target = device.createBuffer(size: cast<uint64>(ROW) * 4, usage: BufferUsage::CopyDst);
    CommandEncoder encoder = device.createCommandEncoder();
    encoder.copyTextureToBuffer(texture: source, buffer: target, width: 4, height: 4, bytesPerRow: ROW);
    return give encoder;
}

@compileFor(ARCH_WASM32)
unsafe fn void errorCases(ref Check t, ref Adapter adapter) {
    println(s: "skip the error cases: the web reports an error a task later, and its leg runs in a browser with GPU-3");
}

// A device asked of `adapter`; natively it is answered as soon as it is polled.
@compileFor(!ARCH_WASM32)
unsafe fn Optional<Device> deviceNow(ref Check t, ref Adapter adapter, const ref string purpose) {
    DeviceRequest request = adapter.requestDevice(options: DeviceOptions.defaults());
    int32 polls = 0;
    while (polls < 1000) {
        DeviceStatus s = request.poll();
        match (give s) {
            case Pending: { }
            case Ready(device: d, queue: q): { return Optional::Some(value: give d); }
            case Failed(error: e): { string why = e.message(); t.verdict(name: purpose, why: why); return Optional::None; }
        };
        polls = polls + 1;
    }
    t.verdict(name: purpose, why: "the request never settled");
    return Optional::None;
}

@compileFor(!ARCH_WASM32)
unsafe fn void errorCases(ref Check t, ref Adapter adapter) {
    Optional<Device> asked = deviceNow(t: t, adapter: adapter, purpose: "a device for the error cases");
    Device a = match (give asked) {
        case Some(value: d): give d;
        case None: { return; }
    };
    Optional<Device> askedAgain = deviceNow(t: t, adapter: adapter, purpose: "a second device for the error cases");
    Device b = match (give askedAgain) {
        case Some(value: d): give d;
        case None: { return; }
    };

    Buffer bad = badBuffer(device: a);
    DeviceErrors got = a.takeErrors();
    string one = holds(errs: got, want: 1, kind: GpuErrorKind::Validation);
    if (one.isEmpty()) {
        // wgpu-native's words begin with the call and end with the usages asked for: kept whole, not cut
        string words = got.reports()[0].message();
        if (!words.contains(substring: "MAP") || !words.contains(substring: "STORAGE)")) { one = "in other words: ${words}"; }
    }
    t.verdict(name: "an uncaptured error is in its device's channel when the call returns, whole, in WebGPU's words", why: one);
    t.verdict(name: "a device's channel is watched", why: got.watched() ? "" : "watched() is false");
    DeviceErrors again = a.takeErrors();
    t.verdict(name: "a drain empties the channel", why: errorsSaid(errs: again));

    Buffer onB = badBuffer(device: b);
    DeviceErrors onA = a.takeErrors();
    DeviceErrors fromB = b.takeErrors();
    string apart = holds(errs: fromB, want: 1, kind: GpuErrorKind::Validation);
    if (!onA.isEmpty()) { apart = "the other device's error reached this one"; }
    t.verdict(name: "two devices' errors are kept apart", why: apart);

    Device copied = copy a;
    Buffer viaOriginal = badBuffer(device: a);
    DeviceErrors shared = copied.takeErrors();
    DeviceErrors afterShared = a.takeErrors();
    string share = holds(errs: shared, want: 1, kind: GpuErrorKind::Validation);
    if (share.isEmpty() && !afterShared.isEmpty()) { share = "the original's channel still held it"; }
    t.verdict(name: "a device's copies share one channel: an error made through one is drained through another", why: share);

    Optional<DeviceLoss> loss = a.lost();
    t.verdict(name: "a live device is not lost", why: loss.isSome() ? "lost(): " + lossSaid(loss: loss) : "");

    // A full channel: 64 errors in one set of words, then 36 in another. The oldest are kept, the rest counted.
    Texture flat = badTexture(device: b);
    DeviceErrors flatErrors = b.takeErrors();
    string later = "";
    if (flatErrors.reports().length() == 1) { later = flatErrors.reports()[0].message(); }
    int32 i = 0;
    while (i < 64) { Buffer x = badBuffer(device: a); i = i + 1; }
    i = 0;
    while (i < 36) { Texture y = badTexture(device: a); i = i + 1; }
    DeviceErrors full = a.takeErrors();
    isize kept = full.reports().length();
    int64 dropped = full.dropped();
    string ring = "";
    if (later.isEmpty()) { ring = "a texture with no width gave no single error to tell the later ones by"; }
    else if (kept != 64) { ring = "${kept} kept, not 64"; }
    else if (dropped != 36) { ring = "${dropped} dropped, not 36"; }
    else {
        isize k = 0;
        while (k < kept) {
            string words = full.reports()[k].message();
            if (words == later) { ring = "a later report was kept, at ${k}"; }
            k = k + 1;
        }
    }
    t.verdict(name: "a full channel keeps the oldest 64 reports and counts the rest", why: ring);
    DeviceErrors emptied = a.takeErrors();
    t.verdict(name: "a drain starts the count of what was dropped again", why: errorsSaid(errs: emptied));

    // An adopted device keeps its maker's callback: its errors reach the package's channel of the device it came from.
    addDeviceRef(device: a.raw());
    Device adopted = Device.adopt(raw: a.raw(), adapter: adapter);
    Buffer viaAdopted = badBuffer(device: adopted);
    DeviceErrors unseen = adopted.takeErrors();
    DeviceErrors maker = a.takeErrors();
    string adopt = "";
    if (unseen.watched()) { adopt = "watched() is true"; }
    else if (!unseen.isEmpty()) { adopt = "the adopted device's channel holds an error"; }
    else { adopt = holds(errs: maker, want: 1, kind: GpuErrorKind::Validation); }
    t.verdict(name: "an adopted device says its errors are not watched, and they reach its maker", why: adopt);

    scopeCases(t: t, adapter: adapter);
    spoiledCases(t: t, adapter: adapter);
    outlivesCase(t: t, adapter: adapter);
}

// A command buffer whose finish reported an error is never submitted natively, where wgpu-native would end the process
// (tests/facts, `abort-submit`); a browser refuses the same submit after reporting it.
@compileFor(!ARCH_WASM32)
unsafe fn void spoiledCases(ref Check t, ref Adapter adapter) {
    DeviceRequest request = adapter.requestDevice(options: DeviceOptions.defaults());
    int32 polls = 0;
    while (polls < 1000) {
        DeviceStatus s = request.poll();
        match (give s) {
            case Pending: { }
            case Ready(device: d, queue: q): { spoiledWith(t: t, device: d, queue: q); return; }
            case Failed(error: e): { string why = e.message(); t.verdict(name: "a device for the finish cases", why: why); return; }
        };
        polls = polls + 1;
    }
    t.verdict(name: "a device for the finish cases", why: "the request never settled");
}

@compileFor(!ARCH_WASM32)
unsafe fn void spoiledWith(ref Check t, ref Device device, ref Queue queue) {
    CommandEncoder encoder = badCopy(device: device);
    CommandBuffer commands = give encoder.finish();
    queue.submit(commands: give commands);
    DeviceErrors errs = device.takeErrors();
    t.verdict(name: "a command buffer whose finish reported an error is not submitted, and the error is in the channel",
              why: holds(errs: errs, want: 1, kind: GpuErrorKind::Validation));

    string words = "";
    ErrorScope around = device.pushErrorScope(filter: ErrorFilter::Validation);
    CommandEncoder again = badCopy(device: device);
    CommandBuffer more = give again.finish();
    queue.submit(commands: give more);
    Result<ScopePop, GpuError> popped = give around.pop();
    string inScope = caughtBy(popped: give popped, kind: Optional::Some(value: GpuErrorKind::Validation), words: words);
    DeviceErrors after = device.takeErrors();
    if (inScope.isEmpty() && !after.isEmpty()) { inScope = "the channel got it too"; }
    t.verdict(name: "inside a scope too: the scope catches the finish's error, and the buffer is not submitted", why: inScope);
}

// A scope popped, natively answered at once: "" when it caught an error of `kind`, its words left in `words`, or, with
// `kind` None, when it caught nothing.
@compileFor(!ARCH_WASM32)
unsafe fn string caughtBy(Result<ScopePop, GpuError> popped, Optional<GpuErrorKind> kind, ref string words) {
    string why = "";
    match (give popped) {
        case Ok(value: answer): {
            PopStatus status = answer.poll();
            match (give status) {
                case Pending: { why = "still pending, where natively a pop is answered at once"; }
                case Failed(error: e): { string said = e.message(); why = "the pop failed: ${said}"; }
                case Ready(caught: c): {
                    match (give c) {
                        case Some(value: report): {
                            words = report.message();
                            GpuErrorKind got = report.kind();
                            match (kind) {
                                case Some(value: k): {
                                    if (got != k) { string name = kindName(k: got); why = "it caught a ${name} error"; }
                                }
                                case None: { why = "it caught an error: " + report.message(); }
                            };
                        }
                        case None: { if (kind.isSome()) { why = "it caught nothing"; } }
                    };
                }
            };
        }
        case Err(error: e): { string said = e.message(); why = "the pop was refused: ${said}"; }
    };
    return why;
}

// A scope pushed, an error made in it, and the scope dropped unpopped.
@compileFor(!ARCH_WASM32)
unsafe fn void dropScope(ref Device device) {
    ErrorScope open = device.pushErrorScope(filter: ErrorFilter::Validation);
    Buffer bad = badBuffer(device: device);
}

// Error scopes, which the seam keeps natively: WebGPU's rules, and none of wgpu-native's aborting paths reachable.
@compileFor(!ARCH_WASM32)
unsafe fn void scopeCases(ref Check t, ref Adapter adapter) {
    Optional<Device> asked = deviceNow(t: t, adapter: adapter, purpose: "a device for the scope cases");
    Device d = match (give asked) {
        case Some(value: x): give x;
        case None: { return; }
    };
    string words = "";

    ErrorScope s1 = d.pushErrorScope(filter: ErrorFilter::Validation);
    Buffer b1 = badBuffer(device: d);
    Result<ScopePop, GpuError> p1 = give s1.pop();
    string one = caughtBy(popped: give p1, kind: Optional::Some(value: GpuErrorKind::Validation), words: words);
    DeviceErrors after1 = d.takeErrors();
    if (one.isEmpty() && !after1.isEmpty()) { one = "the channel got it too"; }
    t.verdict(name: "a scope catches an error made while it is open, and the channel does not", why: one);

    ErrorScope outer2 = d.pushErrorScope(filter: ErrorFilter::Validation);
    ErrorScope inner2 = d.pushErrorScope(filter: ErrorFilter::OutOfMemory);
    Buffer b2 = badBuffer(device: d);
    Result<ScopePop, GpuError> pi2 = give inner2.pop();
    string innerWhy = caughtBy(popped: give pi2, kind: Optional::None, words: words);
    Result<ScopePop, GpuError> po2 = give outer2.pop();
    string two = caughtBy(popped: give po2, kind: Optional::Some(value: GpuErrorKind::Validation), words: words);
    if (!innerWhy.isEmpty()) { two = "the OutOfMemory scope: " + innerWhy; }
    t.verdict(name: "an error a scope's filter does not match passes to the scope beneath it", why: two);

    ErrorScope s3 = d.pushErrorScope(filter: ErrorFilter::OutOfMemory);
    Buffer b3 = badBuffer(device: d);
    Result<ScopePop, GpuError> p3 = give s3.pop();
    string three = caughtBy(popped: give p3, kind: Optional::None, words: words);
    DeviceErrors after3 = d.takeErrors();
    if (three.isEmpty()) { three = holds(errs: after3, want: 1, kind: GpuErrorKind::Validation); }
    t.verdict(name: "past every scope, an error reaches the channel", why: three);

    Texture flat = badTexture(device: d);
    DeviceErrors flatErrors = d.takeErrors();
    string later = "";
    if (flatErrors.reports().length() == 1) { later = flatErrors.reports()[0].message(); }
    ErrorScope s4 = d.pushErrorScope(filter: ErrorFilter::Validation);
    Buffer b4 = badBuffer(device: d);
    Texture t4 = badTexture(device: d);
    Result<ScopePop, GpuError> p4 = give s4.pop();
    string kept = "";
    string four = caughtBy(popped: give p4, kind: Optional::Some(value: GpuErrorKind::Validation), words: kept);
    DeviceErrors after4 = d.takeErrors();
    if (four.isEmpty() && later.isEmpty()) { four = "a texture with no width gave no single error to tell the later one by"; }
    else if (four.isEmpty() && kept == later) { four = "it kept the later error"; }
    else if (four.isEmpty() && !after4.isEmpty()) { four = "the later error reached the channel"; }
    t.verdict(name: "a scope keeps the first error it catches and swallows the rest", why: four);

    ErrorScope s5 = d.pushErrorScope(filter: ErrorFilter::Validation);
    Result<ScopePop, GpuError> p5 = give s5.pop();
    t.verdict(name: "a scope that caught nothing answers None", why: caughtBy(popped: give p5, kind: Optional::None, words: words));

    ErrorScope s6 = d.pushErrorScope(filter: ErrorFilter::Internal);
    Buffer b6 = badBuffer(device: d);
    Result<ScopePop, GpuError> p6 = give s6.pop();
    string six = caughtBy(popped: give p6, kind: Optional::None, words: words);
    DeviceErrors after6 = d.takeErrors();
    if (six.isEmpty()) { six = holds(errs: after6, want: 1, kind: GpuErrorKind::Validation); }
    t.verdict(name: "an Internal scope is taken natively, where wgpu-native's own would end the process", why: six);

    ErrorScope outer7 = d.pushErrorScope(filter: ErrorFilter::Validation);
    ErrorScope inner7 = d.pushErrorScope(filter: ErrorFilter::Validation);
    Result<ScopePop, GpuError> po7 = give outer7.pop();
    bool outOfOrder = match (po7) {
        case Err(error: e): match (e) { case OutOfOrder: true; case _: false; };
        case Ok(value: p): false;
    };
    Buffer b7 = badBuffer(device: d);
    Result<ScopePop, GpuError> pi7 = give inner7.pop();
    string seven = caughtBy(popped: give pi7, kind: Optional::Some(value: GpuErrorKind::Validation), words: words);
    Buffer b7b = badBuffer(device: d);
    DeviceErrors after7 = d.takeErrors();
    if (!outOfOrder) { seven = "the pop out of order was not refused with OutOfOrder"; }
    else if (seven.isEmpty()) { seven = holds(errs: after7, want: 1, kind: GpuErrorKind::Validation); }
    t.verdict(name: "a pop out of order is refused, and the stack does not jam", why: seven);

    ErrorScope outer8 = d.pushErrorScope(filter: ErrorFilter::Validation);
    Buffer b8 = badBuffer(device: d);
    ErrorScope inner8 = d.pushErrorScope(filter: ErrorFilter::OutOfMemory);
    Result<ScopePop, GpuError> po8 = give outer8.pop();
    DeviceErrors held8 = d.takeErrors();
    Result<ScopePop, GpuError> pi8 = give inner8.pop();
    DeviceErrors after8 = d.takeErrors();
    string eight = holds(errs: after8, want: 1, kind: GpuErrorKind::Validation);
    if (!held8.isEmpty()) { eight = "it reached the channel before the scope above it was popped"; }
    t.verdict(name: "what an orphaned scope caught reaches the channel once the scopes above it are popped", why: eight);

    dropScope(device: d);
    DeviceErrors after9 = d.takeErrors();
    Buffer b9 = badBuffer(device: d);
    DeviceErrors again9 = d.takeErrors();
    string nine = holds(errs: after9, want: 1, kind: GpuErrorKind::Validation);
    if (nine.isEmpty()) {
        string next = holds(errs: again9, want: 1, kind: GpuErrorKind::Validation);
        if (!next.isEmpty()) { nine = "the next error: " + next; }
    }
    t.verdict(name: "a scope dropped unpopped pops itself, and what it caught reaches the channel", why: nine);
}

// A device's state outlives the device while a handle made from it lives: wgpu-native reports the handle's errors to the
// device's callback after the device's last release (tests/facts, `afterrelease`).
@compileFor(!ARCH_WASM32)
unsafe fn void outlivesCase(ref Check t, ref Adapter adapter) {
    Optional<Device> made = deviceNow(t: t, adapter: adapter, purpose: "a device to drop before its encoder");
    int64 before = statesAlive();
    Optional<CommandEncoder> kept = Optional::None;
    match (give made) {
        case Some(value: d): { kept = Optional::Some(value: badCopy(device: d)); }
        case None: { return; }
    };
    int64 between = statesAlive();
    t.verdict(name: "a device's state outlives the device while a handle made from it lives",
              why: between == before ? "" : "${before} alive before the device was dropped, ${between} after");
    match (give kept) {
        case Some(value: encoder): { CommandBuffer commands = give encoder.finish(); }
        case None: { }
    };
    int64 after = statesAlive();
    t.verdict(name: "an error after the device is dropped is taken safely, and the state freed with the last handle",
              why: after == before - 1 ? "" : "${before} alive before, ${after} after the last handle");
}

// The status `main` returns natively, set by `finish`: the loop owns the app and drops it when `run` returns.
static int32 exitStatus = 1;

// On the web `run` never returns, so the program ends here; natively `run` returns and `main` gives the status.
@compileFor(ARCH_WASM32)
fn void endOnTheWeb(bool failed) { if (failed) { quit(code: 1); } else { quit(code: 0); } }
@compileFor(!ARCH_WASM32)
fn void endOnTheWeb(bool failed) { }

unsafe fn void runChecks() {
    Owned<App> app = new Check.make();
    run(app: give app);
}

fn uint8 main() {
    runChecks();
    return cast<uint8>(exitStatus);
}
