// clear: a window cleared to a slowly changing colour every frame, on @kama/gpu and @kama/window. Escape or the close
// button quits; a resize reconfigures the surface. `clear --frames N` presents N frames and exits, for a check that
// needs no hand on the keyboard. It prints how many frames it presented and whether WebGPU reported an error, and its
// exit status is 1 when it did.
//
// Native only for now: on the web the loop must be the browser's (std::app::run) and the window a canvas, which come
// with @kama/window's web half.

import {
    core::println,
    core::env::args, core::env::Args,
    std::fmt::parse, std::fmt::ParseError,
    gpu::Instance, gpu::Adapter, gpu::AdapterOptions, gpu::AdapterRequest, gpu::AdapterStatus, gpu::DeviceOptions,
    gpu::Device, gpu::Queue, gpu::DeviceRequest, gpu::DeviceStatus, gpu::GpuError, gpu::PowerPreference,
    gpu::Surface, gpu::SurfaceTexture, gpu::SurfaceError, gpu::TextureFormat, gpu::TextureView, gpu::CommandEncoder,
    gpu::RenderPass, gpu::CommandBuffer, gpu::Color, gpu::uncapturedErrors, gpu::lastErrorMessage,
    window::Window, window::WindowError, window::Event, window::Key, window::Size,
};

comptime TextureFormat FORMAT = TextureFormat::BGRA8Unorm;

// `--frames N`, or 0 for no limit.
unsafe fn int32 frameLimit() {
    Args a = args();
    Optional<string> flag = a.get(at: 0);
    Optional<string> value = a.get(at: 1);
    bool asked = match (flag) { case Some(value: f): f == "--frames"; case None: false; };
    if (!asked) { return 0; }
    return match (give value) {
        case Some(value: v): {
            Result<int32, ParseError> n = parse::<int32>(s: v);
            match (n) { case Ok(value: k): { return k; } case Err(error: e): { return 0; } };
        }
        case None: 0;
    };
}

// An adapter that can present to `surface`, then a device from it with WebGPU's defaults; natively each request is
// answered as soon as it is polled.
unsafe fn Result<DeviceStatus, GpuError> device(ref Instance instance, const ref Surface surface) {
    AdapterRequest asked = instance.requestAdapter(options: AdapterOptions.forSurface(surface: surface,
                                                                                       power: PowerPreference::HighPerformance));
    int32 polls = 0;
    while (polls < 1000) {
        AdapterStatus a = asked.poll();
        match (give a) {
            case Pending: { }
            case Ready(adapter: adapter): { return deviceFrom(adapter: adapter); }
            case Failed(error: e): { return Result::Err(error: give e); }
        };
        polls = polls + 1;
    }
    return Result::Err(error: GpuError::Refused(words: "the adapter request never settled"));
}

unsafe fn Result<DeviceStatus, GpuError> deviceFrom(ref Adapter adapter) {
    DeviceRequest request = adapter.requestDevice(options: DeviceOptions.defaults());
    int32 polls = 0;
    while (polls < 1000) {
        DeviceStatus s = request.poll();
        match (s) {
            case Pending: { }
            case Ready(device: d, queue: q): { return Result::Ok(value: give s); }
            case Failed(error: e): { return Result::Ok(value: give s); }
        };
        polls = polls + 1;
    }
    return Result::Err(error: GpuError::Refused(words: "the device request never settled"));
}

unsafe fn uint8 run() {
    int32 limit = frameLimit();
    Result<Window, WindowError> opened = Window.open(title: "@kama/gpu clear", width: 640, height: 400);
    Window window = match (give opened) {
        case Ok(value: w): give w;
        case Err(error: e): { string why = e.message(); println(s: "clear: no window: ${why}"); return 1; }
    };
    Result<Instance, GpuError> made = Instance.create();
    Instance instance = match (give made) {
        case Ok(value: i): give i;
        case Err(error: e): { string why = e.message(); println(s: "clear: ${why}"); return 1; }
    };
    Result<Surface, GpuError> onWindow = Surface.create(instance: instance, window: window);
    Surface surface = match (give onWindow) {
        case Ok(value: s): give s;
        case Err(error: e): { string why = e.message(); println(s: "clear: ${why}"); return 1; }
    };
    Result<DeviceStatus, GpuError> asked = device(instance: instance, surface: surface);
    DeviceStatus status = match (give asked) {
        case Ok(value: s): give s;
        case Err(error: e): { string why = e.message(); println(s: "clear: ${why}"); return 1; }
    };
    match (give status) {
        case Pending: { println(s: "clear: no device"); return 1; }
        case Failed(error: e): { string why = e.message(); println(s: "clear: no device: ${why}"); return 1; }
        case Ready(device: dev, queue: queue): {
            Size px = window.framebufferSize();
            surface.configure(device: dev, width: cast<uint32>(px.width), height: cast<uint32>(px.height), format: FORMAT);
            int32 frames = 0;
            int32 skipped = 0;
            bool running = true;
            while (running) {
                window.pump();
                bool reconfigure = false;
                bool polling = true;
                while (polling) {
                    Optional<Event> next = window.pollEvent();
                    match (next) {
                        case None: { polling = false; }
                        case Some(value: e): {
                            match (e) {
                                case CloseRequested: { running = false; }
                                case KeyDown(key: k, mods: m, repeat: r): { if (k == Key::Escape) { running = false; } }
                                case Resize(width: w, height: h): { reconfigure = true; }
                                case _: { }
                            };
                        }
                    };
                }
                if (reconfigure) {
                    Size now = window.framebufferSize();
                    if (now.width > 0 && now.height > 0) {
                        surface.configure(device: dev, width: cast<uint32>(now.width), height: cast<uint32>(now.height),
                                          format: FORMAT);
                    }
                }
                Result<SurfaceTexture, SurfaceError> acquired = surface.acquire();
                match (give acquired) {
                    case Ok(value: frame): {
                        TextureView view = frame.view();
                        float64 t = cast<float64>(frames % 240) / 240.0;
                        CommandEncoder encoder = dev.createCommandEncoder();
                        RenderPass pass = encoder.beginRenderPass(target: view, clear: Color.rgba(r: t, g: 0.3, b: 1.0 - t, a: 1.0));
                        give pass.end();
                        CommandBuffer commands = give encoder.finish();
                        queue.submit(commands: give commands);
                        give frame.present();
                        frames = frames + 1;
                    }
                    case Err(error: e): {
                        skipped = skipped + 1;
                        match (e) {
                            case Outdated: { reconfigure = true; }
                            case Lost: { reconfigure = true; }
                            case Failed: { println(s: "clear: the surface failed"); running = false; }
                            case _: { }
                        };
                        if (reconfigure) {
                            Size now = window.framebufferSize();
                            if (now.width > 0 && now.height > 0) {
                                surface.configure(device: dev, width: cast<uint32>(now.width),
                                                  height: cast<uint32>(now.height), format: FORMAT);
                            }
                        }
                    }
                };
                if (limit > 0 && frames >= limit) { running = false; }
            }
            int64 errors = uncapturedErrors();
            println(s: "clear: ${frames} frames presented, ${skipped} acquires skipped, ${errors} WebGPU errors");
            if (errors > 0) {
                string last = lastErrorMessage();
                println(s: "clear: the last: ${last}");
                return 1;
            }
            return 0;
        }
    };
}

fn uint8 main() { return run(); }
