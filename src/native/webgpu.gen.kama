type value WGPUBufferUsage {
    public comptime uint64 None = 0x0000000000000000;
    public comptime uint64 MapRead = 0x0000000000000001;
    public comptime uint64 MapWrite = 0x0000000000000002;
    public comptime uint64 CopySrc = 0x0000000000000004;
    public comptime uint64 CopyDst = 0x0000000000000008;
    public comptime uint64 Index = 0x0000000000000010;
    public comptime uint64 Vertex = 0x0000000000000020;
    public comptime uint64 Uniform = 0x0000000000000040;
    public comptime uint64 Storage = 0x0000000000000080;
    public comptime uint64 Indirect = 0x0000000000000100;
    public comptime uint64 QueryResolve = 0x0000000000000200;
}

type value WGPUColorWriteMask {
    public comptime uint64 None = 0x0000000000000000;
    public comptime uint64 Red = 0x0000000000000001;
    public comptime uint64 Green = 0x0000000000000002;
    public comptime uint64 Blue = 0x0000000000000004;
    public comptime uint64 Alpha = 0x0000000000000008;
    public comptime uint64 All = 0x000000000000000F;
}

type value WGPUMapMode {
    public comptime uint64 None = 0x0000000000000000;
    public comptime uint64 Read = 0x0000000000000001;
    public comptime uint64 Write = 0x0000000000000002;
}

type value WGPUShaderStage {
    public comptime uint64 None = 0x0000000000000000;
    public comptime uint64 Vertex = 0x0000000000000001;
    public comptime uint64 Fragment = 0x0000000000000002;
    public comptime uint64 Compute = 0x0000000000000004;
}

type value WGPUTextureUsage {
    public comptime uint64 None = 0x0000000000000000;
    public comptime uint64 CopySrc = 0x0000000000000001;
    public comptime uint64 CopyDst = 0x0000000000000002;
    public comptime uint64 TextureBinding = 0x0000000000000004;
    public comptime uint64 StorageBinding = 0x0000000000000008;
    public comptime uint64 RenderAttachment = 0x0000000000000010;
    public comptime uint64 TransientAttachment = 0x0000000000000020;
}

type value WGPUInstanceBackend {   // wgpu-native's header only
    public comptime uint64 All = 0x00000000;
    public comptime uint64 Vulkan = 1 << 0;
    public comptime uint64 GL = 1 << 1;
    public comptime uint64 Metal = 1 << 2;
    public comptime uint64 DX12 = 1 << 3;
    public comptime uint64 BrowserWebGPU = 1 << 5;
    public comptime uint64 Primary = (1 << 0) | (1 << 2) | (1 << 3) | (1 << 5);
    public comptime uint64 Secondary = (1 << 1);
    public comptime uint64 Force32 = 0x7FFFFFFF;
}

type value WGPUInstanceFlag {   // wgpu-native's header only
    public comptime uint64 Empty = 0x00000000;
    public comptime uint64 Debug = 1 << 0;
    public comptime uint64 Validation = 1 << 1;
    public comptime uint64 DiscardHalLabels = 1 << 2;
    public comptime uint64 AllowUnderlyingNoncompliantAdapter = 1 << 3;
    public comptime uint64 GPUBasedValidation = 1 << 4;
    public comptime uint64 ValidationIndirectCall = 1 << 5;
    public comptime uint64 AutomaticTimestampNormalization = 1 << 6;
    public comptime uint64 Default = 1 << 24;
    public comptime uint64 Debugging = 1 << 25;
    public comptime uint64 AdvancedDebugging = 1 << 26;
    public comptime uint64 WithEnv = 1 << 27;
    public comptime uint64 Force32 = 0x7FFFFFFF;
}

type value WGPUShaderRuntimeChecks {   // wgpu-native's header only
    public comptime uint64 None = 0x0000000000000000;
    public comptime uint64 BoundsChecks = 0x0000000000000001;
    public comptime uint64 ForceLoopBounding = 0x0000000000000002;
    public comptime uint64 RayQueryInitializationTracking = 0x0000000000000004;
    public comptime uint64 TaskShaderDispatchTracking = 0x0000000000000008;
    public comptime uint64 MeshShaderPrimitiveIndicesClamp = 0x0000000000000010;
}

