            case ASTC4x4UnormSrgb: TextureFormat::ASTC4x4Unorm;
            case ASTC5x4UnormSrgb: TextureFormat::ASTC5x4Unorm;
            case ASTC5x5UnormSrgb: TextureFormat::ASTC5x5Unorm;
