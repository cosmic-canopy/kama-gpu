            case ASTC8x6UnormSrgb: TextureFormat::ASTC8x6Unorm;
            case ASTC8x8UnormSrgb: TextureFormat::ASTC8x8Unorm;
            case ASTC10x5UnormSrgb: TextureFormat::ASTC10x5Unorm;
            case ASTC10x6UnormSrgb: TextureFormat::ASTC10x6Unorm;
            case ASTC10x8UnormSrgb: TextureFormat::ASTC10x8Unorm;
            case ASTC10x10UnormSrgb: TextureFormat::ASTC10x10Unorm;
            case ASTC12x10UnormSrgb: TextureFormat::ASTC12x10Unorm;
            case ASTC12x12UnormSrgb: TextureFormat::ASTC12x12Unorm;
            case _: this;
        };
    }

