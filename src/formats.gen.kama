    // Its linear form: the format its sRGB form reinterprets (`RGBA8UnormSrgb` -> `RGBA8Unorm`), else itself.
    public const fn TextureFormat linear() {
        return match (this) {
            case RGBA8UnormSrgb: TextureFormat::RGBA8Unorm;
            case BGRA8UnormSrgb: TextureFormat::BGRA8Unorm;
            case BC1RGBAUnormSrgb: TextureFormat::BC1RGBAUnorm;
