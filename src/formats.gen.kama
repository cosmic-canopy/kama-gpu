            case ETC2RGB8UnormSrgb: true;
            case ETC2RGB8A1UnormSrgb: true;
            case ETC2RGBA8UnormSrgb: true;
            case ASTC4x4UnormSrgb: true;
            case ASTC5x4UnormSrgb: true;
            case ASTC5x5UnormSrgb: true;
            case ASTC6x5UnormSrgb: true;
