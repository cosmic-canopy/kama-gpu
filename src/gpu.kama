comptime int32 MESSAGE_BYTES = 512;
comptime int32 SEAM_KIND_VALIDATION = 0;   // GPUSEAM_KIND_VALIDATION
// webgpu.h's WGPU_WHOLE_SIZE, a #define the bindings never see: a buffer binding to the end of its buffer.
comptime uint64 WHOLE_SIZE = 0xFFFFFFFFFFFFFFFF;
// webgpu.h's WGPU_DEPTH_SLICE_UNDEFINED, a #define the bindings never see; csrc/gpuseam.c asserts it is this.
comptime uint32 DEPTH_SLICE_UNDEFINED = 0xFFFFFFFF;
// webgpu.h's WGPU_LIMIT_U32_UNDEFINED and _U64_UNDEFINED: a limit a request leaves to WebGPU's default. Asserted likewise.
comptime uint32 LIMIT_U32_UNDEFINED = 0xFFFFFFFF;
comptime uint64 LIMIT_U64_UNDEFINED = 0xFFFFFFFFFFFFFFFF;
// The largest size or offset the package hands WebGPU: 2^53 - 256, a multiple of every alignment WebGPU has, which no
// device reaches. WebGPU's JavaScript API throws on a 64-bit number past 2^53 - 1, which ends a web program, and
// wgpu-native reads UINT64_MAX as "the whole size", so a larger one is clamped to this, and the device refuses it as it
// refuses any size past its limits (AGENTS.gpu.md item 12, decision 9).
comptime uint64 SIZE_LIMIT = 9007199254740736;

fn uint64 inRange(uint64 v) { return v > SIZE_LIMIT ? SIZE_LIMIT : v; }
// The most features a set holds or a query copies out: webgpu.h names 22, and an implementation may add its own.
comptime int32 FEATURES_MAX = 64;

// ---- errors ----------------------------------------------------------------------------------------------------------

type enum GpuError implements Error {
    NoInstance,             // WebGPU gave no instance
    NoAdapter(string words),// WebGPU has no adapter here for the request (webgpu.h's Unavailable): a browser or system
                            // without WebGPU, or none matching its options. In the implementation's words
    Refused(string words),  // the adapter, the device or a map was refused, in the implementation's words
    Taken,                  // what a request gave was handed over already
    OutOfOrder,             // an error scope was popped while one pushed after it on its thread was still open
    Consumed;               // the adapter had given a device already: WebGPU gives an adapter one, so request another

    public const fn string message() {
        return match (this) {
            case NoInstance: "WebGPU gave no instance";
            case NoAdapter(words: w): copy w;
            case Refused(words: w): copy w;
            case Taken: "what this request gave was already taken";
            case OutOfOrder: "an error scope was popped while one pushed after it on the same thread was still open";
            case Consumed: "the adapter has already given a device: WebGPU gives an adapter one, so request another adapter";
        };
    }
}

// The bytes a seam call copied out, as text.
unsafe fn string textOf(const ref InlineArray<uint8>#(512) buf, int32 length) {
    DynamicArray<uint8> bytes = DynamicArray.empty();
    isize i = 0;
    while (i < cast<isize>(length)) { bytes.add(item: buf[i]); i = i + 1; }
    Result<string, Utf8Error> r = decode(bytes: bytes.view());
    match (give r) {
        case Ok(value: s): { return give s; }
        case Err(error: e): { return "(not UTF-8)"; }
    };
}

// The `length` bytes the seam keeps at `p`, as text.
unsafe fn string textFrom(UnsafeConstPtr<uint8> p, int32 length) {
    if (p == null || length <= 0) { return ""; }
    DynamicArray<uint8> bytes = DynamicArray.empty();
    isize n = cast<isize>(length);
    bytes.reserve(n: n);
    isize i = 0;
    while (i < n) { bytes.add(item: p[i]); i = i + 1; }
    Result<string, Utf8Error> r = decode(bytes: bytes.view());
    match (give r) {
        case Ok(value: s): { return give s; }
        case Err(error: e): { return "(not UTF-8)"; }
    };
}

// ---- a device's errors and its loss (GPU-1; AGENTS.gpu.md item 2) --------------------------------------------------

// What kind of error WebGPU reported; Unknown is anything else.
type enum GpuErrorKind { Validation, OutOfMemory, Internal, Unknown }

fn GpuErrorKind kindFrom(int32 v) {
    if (v == 0) { return GpuErrorKind::Validation; }
    if (v == 1) { return GpuErrorKind::OutOfMemory; }
    if (v == 2) { return GpuErrorKind::Internal; }
    return GpuErrorKind::Unknown;
}

// One error WebGPU reported, in its own words, whole.
type resource GpuErrorReport {
    GpuErrorKind sort;
    string words;

    public ctor of(GpuErrorKind kind, string message) {
        this.sort = kind;
        this.words = give message;
    }
    public const fn GpuErrorKind kind() { return this.sort; }
    public const fn string message() { return copy this.words; }
}

// What `device.takeErrors()` drained: the device's uncaptured errors since the last drain, the oldest first. A full
// channel keeps the oldest 64, since the first error is usually the cause and the later ones its cascade, and counts the
// rest in `dropped()`.
type resource DeviceErrors {
    DynamicArray<GpuErrorReport> items;
    int64 overflow;
    bool wired;

    friend Device::takeErrors[make];

    ctor make(DynamicArray<GpuErrorReport> reports, int64 dropped, bool watched) {
        this.items = give reports;
        this.overflow = dropped;
        this.wired = watched;
    }
    public const fn const ref DynamicArray<GpuErrorReport> reports() { return this.items; }
    public const fn int64 dropped() { return this.overflow; }
    // False for a device adopted from elsewhere: it keeps the error callback its maker gave it (webgpu.h sets one only
    // when a device is made), so its errors reach that callback and never this channel.
    public const fn bool watched() { return this.wired; }
    public const fn bool isEmpty() { return this.items.length() == 0 && this.overflow == 0; }
}

// Why a device was lost: Destroyed when it was destroyed on purpose.
type enum LossReason { Unknown, Destroyed }

// How a device was lost, in the implementation's words.
type resource DeviceLoss {
    LossReason why;
    string words;

    public ctor of(LossReason reason, string message) {
        this.why = reason;
        this.words = give message;
    }
    public const fn LossReason reason() { return this.why; }
    public const fn string message() { return copy this.words; }
}

// Which errors an error scope catches.
type enum ErrorFilter { Validation, OutOfMemory, Internal }

fn int32 filterValue(ErrorFilter f) {
    return match (f) {
        case Validation: 0;
        case OutOfMemory: 1;
        case Internal: 2;
    };
}

// What a popped scope caught: the first error its filter matched, or None.
type enum PopStatus { Pending, Ready(Optional<GpuErrorReport> caught), Failed(GpuError error) }

// An error scope: the errors of the calls made on this thread while it is open, from `device.pushErrorScope(filter:)`
// to `pop()`. It catches the first error its filter matches and swallows the rest, as WebGPU's does; an error it does
// not match goes to the scope beneath it, and past the last to the device's channel. Scopes pop in the reverse of the
// order they were pushed. One dropped unpopped pops itself, and what it caught goes to the channel. Not `Sendable`: a
// scope belongs to the thread that pushed it. Natively the seam keeps the scopes; on the web they are the browser's.
type resource ErrorScope {
    UnsafePtr slot;

    friend Device::pushErrorScope[start];

    unsafe ctor start(UnsafePtr block, UnsafePtr device, ErrorFilter filter) {
        this.slot = scopePush(state: block, device: device, filter: filterValue(f: filter));
    }

    // Close the scope, and ask what it caught. Refused with OutOfOrder while a scope pushed after it on this thread is
    // still open: the scope is spent all the same, is popped once those are, and what it caught goes to the channel.
    public unsafe give fn Result<ScopePop, GpuError> pop() {
        UnsafePtr s = this.slot;
        this.slot = null;
        if (s != null && scopePop(pushed: s) != 0) { return Result::Err(error: GpuError::OutOfOrder); }
        return Result::Ok(value: ScopePop.start(slot: s));
    }

    unsafe ~ErrorScope() { scopeAbandon(pushed: this.slot); }
}

// What a popped scope caught: natively ready at once, on the web a task later.
type resource ScopePop {
    UnsafePtr slot;

    friend ErrorScope::pop[start];

    unsafe ctor start(UnsafePtr slot) { this.slot = slot; }

    public unsafe const fn PopStatus poll() {
        if (this.slot == null) { return PopStatus::Failed(error: GpuError::Refused(words: "out of memory for the scope")); }
        int32 s = scopePopPoll(pushed: this.slot);
        if (s == SEAM_PENDING) { return PopStatus::Pending; }
        string words = textFrom(p: scopeMessage(pushed: this.slot), length: scopeLength(pushed: this.slot));
        if (s == SEAM_FAILED) {
            if (words.isEmpty()) { words = "the scope's pop failed"; }
            return PopStatus::Failed(error: GpuError::Refused(words: give words));
        }
        if (scopeCaught(pushed: this.slot) == 0) { return PopStatus::Ready(caught: Optional::None); }
        GpuErrorReport report = GpuErrorReport.of(kind: kindFrom(v: scopeKind(pushed: this.slot)), message: give words);
        return PopStatus::Ready(caught: Optional::Some(value: give report));
    }

    unsafe ~ScopePop() { scopeDropPopped(pushed: this.slot); }
}

// A hold on a device's state block in the seam: its errors and its loss. Every handle made from a device keeps one,
// since wgpu-native reports a handle's error to its device's callback even after the device's last release
// (tests/facts, `afterrelease`), and the block is freed with the last hold. Empty for a handle adopted from elsewhere.
type resource StateHold implements Copyable<This>(bare: give) {
    UnsafePtr block;

    // A hold the seam counted already: a device request's, or a new block's.
    public unsafe ctor fromSeam(UnsafePtr block) { this.block = block; }
    // Another hold on `block`, which may be null.
    public unsafe ctor make(UnsafePtr block) {
        this.block = block;
        stateHold(state: block);
    }
    public unsafe ctor empty() { this.block = null; }
    public unsafe ctor copy(ref StateHold source) {
        this.block = source.block;
        stateHold(state: this.block);
    }
    public unsafe const fn UnsafePtr raw() { return this.block; }

    unsafe ~StateHold() { stateRelease(state: this.block); }
}

// ---- plain data ------------------------------------------------------------------------------------------------------

type enum PowerPreference { Default, LowPower, HighPerformance }

fn int32 powerValue(PowerPreference p) {
    return match (p) {
        case Default: WGPUPowerPreference::Undefined;
        case LowPower: WGPUPowerPreference::LowPower;
        case HighPerformance: WGPUPowerPreference::HighPerformance;
    };
}

// The API an adapter runs on: WebGPU in a browser, a native one elsewhere.
type enum Backend { Undefined, Null, WebGPU, D3D11, D3D12, Metal, Vulkan, OpenGL, OpenGLES }

fn Backend backendOf(int32 v) {
    if (v == WGPUBackendType::Null) { return Backend::Null; }
    if (v == WGPUBackendType::WebGPU) { return Backend::WebGPU; }
    if (v == WGPUBackendType::D3D11) { return Backend::D3D11; }
    if (v == WGPUBackendType::D3D12) { return Backend::D3D12; }
    if (v == WGPUBackendType::Metal) { return Backend::Metal; }
    if (v == WGPUBackendType::Vulkan) { return Backend::Vulkan; }
    if (v == WGPUBackendType::OpenGL) { return Backend::OpenGL; }
    if (v == WGPUBackendType::OpenGLES) { return Backend::OpenGLES; }
    return Backend::Undefined;
}

// What kind of processor an adapter is.
type enum AdapterKind { DiscreteGPU, IntegratedGPU, CPU, Unknown }

fn AdapterKind kindOf(int32 v) {
    if (v == WGPUAdapterType::DiscreteGPU) { return AdapterKind::DiscreteGPU; }
    if (v == WGPUAdapterType::IntegratedGPU) { return AdapterKind::IntegratedGPU; }
    if (v == WGPUAdapterType::CPU) { return AdapterKind::CPU; }
    return AdapterKind::Unknown;
}

// A feature a device can be asked for (WebGPU's `GPUFeatureName`). The set grows as webgpu.h's does.
type enum Feature {
    CoreFeaturesAndLimits, DepthClipControl, Depth32FloatStencil8, TextureCompressionBC, TextureCompressionBCSliced3D,
    TextureCompressionETC2, TextureCompressionASTC, TextureCompressionASTCSliced3D, TimestampQuery, IndirectFirstInstance,
    ShaderF16, RG11B10UfloatRenderable, BGRA8UnormStorage, Float32Filterable, Float32Blendable, ClipDistances,
    DualSourceBlending, Subgroups, TextureFormatsTier1, TextureFormatsTier2, PrimitiveIndex, TextureComponentSwizzle
}

fn int32 featureValue(Feature f) {
    return match (f) {
        case CoreFeaturesAndLimits: WGPUFeatureName::CoreFeaturesAndLimits;
        case DepthClipControl: WGPUFeatureName::DepthClipControl;
        case Depth32FloatStencil8: WGPUFeatureName::Depth32FloatStencil8;
        case TextureCompressionBC: WGPUFeatureName::TextureCompressionBC;
        case TextureCompressionBCSliced3D: WGPUFeatureName::TextureCompressionBCSliced3D;
        case TextureCompressionETC2: WGPUFeatureName::TextureCompressionETC2;
        case TextureCompressionASTC: WGPUFeatureName::TextureCompressionASTC;
        case TextureCompressionASTCSliced3D: WGPUFeatureName::TextureCompressionASTCSliced3D;
        case TimestampQuery: WGPUFeatureName::TimestampQuery;
        case IndirectFirstInstance: WGPUFeatureName::IndirectFirstInstance;
        case ShaderF16: WGPUFeatureName::ShaderF16;
        case RG11B10UfloatRenderable: WGPUFeatureName::RG11B10UfloatRenderable;
        case BGRA8UnormStorage: WGPUFeatureName::BGRA8UnormStorage;
        case Float32Filterable: WGPUFeatureName::Float32Filterable;
        case Float32Blendable: WGPUFeatureName::Float32Blendable;
        case ClipDistances: WGPUFeatureName::ClipDistances;
        case DualSourceBlending: WGPUFeatureName::DualSourceBlending;
        case Subgroups: WGPUFeatureName::Subgroups;
        case TextureFormatsTier1: WGPUFeatureName::TextureFormatsTier1;
        case TextureFormatsTier2: WGPUFeatureName::TextureFormatsTier2;
        case PrimitiveIndex: WGPUFeatureName::PrimitiveIndex;
        case TextureComponentSwizzle: WGPUFeatureName::TextureComponentSwizzle;
    };
}

// Every feature, in webgpu.h's order.
fn DynamicArray<Feature> everyFeature() {
    DynamicArray<Feature> all = DynamicArray.empty();
    all.add(item: Feature::CoreFeaturesAndLimits);
    all.add(item: Feature::DepthClipControl);
    all.add(item: Feature::Depth32FloatStencil8);
    all.add(item: Feature::TextureCompressionBC);
    all.add(item: Feature::TextureCompressionBCSliced3D);
    all.add(item: Feature::TextureCompressionETC2);
    all.add(item: Feature::TextureCompressionASTC);
    all.add(item: Feature::TextureCompressionASTCSliced3D);
    all.add(item: Feature::TimestampQuery);
    all.add(item: Feature::IndirectFirstInstance);
    all.add(item: Feature::ShaderF16);
    all.add(item: Feature::RG11B10UfloatRenderable);
    all.add(item: Feature::BGRA8UnormStorage);
    all.add(item: Feature::Float32Filterable);
    all.add(item: Feature::Float32Blendable);
    all.add(item: Feature::ClipDistances);
    all.add(item: Feature::DualSourceBlending);
    all.add(item: Feature::Subgroups);
    all.add(item: Feature::TextureFormatsTier1);
    all.add(item: Feature::TextureFormatsTier2);
    all.add(item: Feature::PrimitiveIndex);
    all.add(item: Feature::TextureComponentSwizzle);
    return all;
}

// The feature a WGPUFeatureName names, or None for one this package does not name (an implementation's own).
fn Optional<Feature> featureFrom(int32 v) {
    DynamicArray<Feature> all = everyFeature();
    foreach (Feature f in all.iterator()) { if (featureValue(f: f) == v) { return Optional::Some(value: f); } }
    return Optional::None;
}

// Features, as a set: `FeatureSet.empty().with(feature: Feature::TimestampQuery)`.
type value FeatureSet {
    uint64 bits = 0;   // bit n is the feature whose webgpu.h number is n + 1

    public ctor empty() { }

    // This set and `feature`.
    public const fn FeatureSet with(Feature feature) {
        FeatureSet more = FeatureSet.empty();
        more.bits = this.bits | (cast<uint64>(1) << (featureValue(f: feature) - 1));
        return more;
    }

    public const fn bool has(Feature feature) {
        return (this.bits & (cast<uint64>(1) << (featureValue(f: feature) - 1))) != 0;
    }
}

// Its name, as `Feature` spells it, for the package's own words.
fn string featureName(Feature f) {
    return match (f) {
        case CoreFeaturesAndLimits: "CoreFeaturesAndLimits";
        case DepthClipControl: "DepthClipControl";
        case Depth32FloatStencil8: "Depth32FloatStencil8";
        case TextureCompressionBC: "TextureCompressionBC";
        case TextureCompressionBCSliced3D: "TextureCompressionBCSliced3D";
        case TextureCompressionETC2: "TextureCompressionETC2";
        case TextureCompressionASTC: "TextureCompressionASTC";
        case TextureCompressionASTCSliced3D: "TextureCompressionASTCSliced3D";
        case TimestampQuery: "TimestampQuery";
        case IndirectFirstInstance: "IndirectFirstInstance";
        case ShaderF16: "ShaderF16";
        case RG11B10UfloatRenderable: "RG11B10UfloatRenderable";
        case BGRA8UnormStorage: "BGRA8UnormStorage";
        case Float32Filterable: "Float32Filterable";
        case Float32Blendable: "Float32Blendable";
        case ClipDistances: "ClipDistances";
        case DualSourceBlending: "DualSourceBlending";
        case Subgroups: "Subgroups";
        case TextureFormatsTier1: "TextureFormatsTier1";
        case TextureFormatsTier2: "TextureFormatsTier2";
        case PrimitiveIndex: "PrimitiveIndex";
        case TextureComponentSwizzle: "TextureComponentSwizzle";
    };
}

// Why `what` may not use `format` on a device with `given` features, or "".
fn string refusalOfFormat(TextureFormat format, FeatureSet given, const ref string what) {
    Optional<Feature> needed = format.requiredFeature();
    return match (needed) {
        case Some(value: f): given.has(feature: f) ? "" : "${what} uses the texture format " + format.name()
            + ", which needs the feature " + featureName(f: f) + "; the device was not given it, and WebGPU refuses it";
        case None: "";
    };
}

// The WGPUFeatureNames `count` of which a query copied into `names`, as a set; an implementation's own are left out.
fn FeatureSet featuresFrom(const ref InlineArray<int32>#(64) names, int32 count) {
    FeatureSet s = FeatureSet.empty();
    int32 i = 0;
    while (i < count && i < FEATURES_MAX) {
        Optional<Feature> f = featureFrom(v: names[cast<isize>(i)]);
        match (f) { case Some(value: x): { s = s.with(feature: x); } case None: { } };
        i = i + 1;
    }
    return s;
}

// The most a device may use, as WebGPU's `GPUSupportedLimits` names them: each `max` a ceiling, each `min` alignment a
// floor (lower is more). An adapter answers the most it can give; a device, what it was given.
type value Limits {
    public uint32 maxTextureDimension1D = 0;
    public uint32 maxTextureDimension2D = 0;
    public uint32 maxTextureDimension3D = 0;
    public uint32 maxTextureArrayLayers = 0;
    public uint32 maxBindGroups = 0;
    public uint32 maxBindGroupsPlusVertexBuffers = 0;
    public uint32 maxBindingsPerBindGroup = 0;
    public uint32 maxDynamicUniformBuffersPerPipelineLayout = 0;
    public uint32 maxDynamicStorageBuffersPerPipelineLayout = 0;
    public uint32 maxSampledTexturesPerShaderStage = 0;
    public uint32 maxSamplersPerShaderStage = 0;
    public uint32 maxStorageBuffersPerShaderStage = 0;
    public uint32 maxStorageTexturesPerShaderStage = 0;
    public uint32 maxUniformBuffersPerShaderStage = 0;
    public uint64 maxUniformBufferBindingSize = 0;
    public uint64 maxStorageBufferBindingSize = 0;
    public uint32 minUniformBufferOffsetAlignment = 0;
    public uint32 minStorageBufferOffsetAlignment = 0;
    public uint32 maxVertexBuffers = 0;
    public uint64 maxBufferSize = 0;
    public uint32 maxVertexAttributes = 0;
    public uint32 maxVertexBufferArrayStride = 0;
    public uint32 maxInterStageShaderVariables = 0;
    public uint32 maxColorAttachments = 0;
    public uint32 maxColorAttachmentBytesPerSample = 0;
    public uint32 maxComputeWorkgroupStorageSize = 0;
    public uint32 maxComputeInvocationsPerWorkgroup = 0;
    public uint32 maxComputeWorkgroupSizeX = 0;
    public uint32 maxComputeWorkgroupSizeY = 0;
    public uint32 maxComputeWorkgroupSizeZ = 0;
    public uint32 maxComputeWorkgroupsPerDimension = 0;
    public uint32 maxImmediateSize = 0;

    // WebGPU's defaults, which every adapter meets (the spec's limits table). The tests hold a device asked for them to
    // exactly these on each leg.
    public ctor defaults() {
        this.maxTextureDimension1D = 8192;
        this.maxTextureDimension2D = 8192;
        this.maxTextureDimension3D = 2048;
        this.maxTextureArrayLayers = 256;
        this.maxBindGroups = 4;
        this.maxBindGroupsPlusVertexBuffers = 24;
        this.maxBindingsPerBindGroup = 1000;
        this.maxDynamicUniformBuffersPerPipelineLayout = 8;
        this.maxDynamicStorageBuffersPerPipelineLayout = 4;
        this.maxSampledTexturesPerShaderStage = 16;
        this.maxSamplersPerShaderStage = 16;
        this.maxStorageBuffersPerShaderStage = 8;
        this.maxStorageTexturesPerShaderStage = 4;
        this.maxUniformBuffersPerShaderStage = 12;
        this.maxUniformBufferBindingSize = 65536;
        this.maxStorageBufferBindingSize = 134217728;
        this.minUniformBufferOffsetAlignment = 256;
        this.minStorageBufferOffsetAlignment = 256;
        this.maxVertexBuffers = 8;
        this.maxBufferSize = 268435456;
        this.maxVertexAttributes = 16;
        this.maxVertexBufferArrayStride = 2048;
        this.maxInterStageShaderVariables = 16;
        this.maxColorAttachments = 8;
        this.maxColorAttachmentBytesPerSample = 32;
        this.maxComputeWorkgroupStorageSize = 16384;
        this.maxComputeInvocationsPerWorkgroup = 256;
        this.maxComputeWorkgroupSizeX = 256;
        this.maxComputeWorkgroupSizeY = 256;
        this.maxComputeWorkgroupSizeZ = 64;
        this.maxComputeWorkgroupsPerDimension = 65535;
        this.maxImmediateSize = 64;   // "the size of a 4×4 matrix of f32 values"
    }
}

// What webgpu.h answered, as `Limits`.
fn Limits limitsOf(const ref WGPULimits n) {
    Limits l = Limits.defaults();
    l.maxTextureDimension1D = n.maxTextureDimension1D;
    l.maxTextureDimension2D = n.maxTextureDimension2D;
    l.maxTextureDimension3D = n.maxTextureDimension3D;
    l.maxTextureArrayLayers = n.maxTextureArrayLayers;
    l.maxBindGroups = n.maxBindGroups;
    l.maxBindGroupsPlusVertexBuffers = n.maxBindGroupsPlusVertexBuffers;
    l.maxBindingsPerBindGroup = n.maxBindingsPerBindGroup;
    l.maxDynamicUniformBuffersPerPipelineLayout = n.maxDynamicUniformBuffersPerPipelineLayout;
    l.maxDynamicStorageBuffersPerPipelineLayout = n.maxDynamicStorageBuffersPerPipelineLayout;
    l.maxSampledTexturesPerShaderStage = n.maxSampledTexturesPerShaderStage;
    l.maxSamplersPerShaderStage = n.maxSamplersPerShaderStage;
    l.maxStorageBuffersPerShaderStage = n.maxStorageBuffersPerShaderStage;
    l.maxStorageTexturesPerShaderStage = n.maxStorageTexturesPerShaderStage;
    l.maxUniformBuffersPerShaderStage = n.maxUniformBuffersPerShaderStage;
    l.maxUniformBufferBindingSize = n.maxUniformBufferBindingSize;
    l.maxStorageBufferBindingSize = n.maxStorageBufferBindingSize;
    l.minUniformBufferOffsetAlignment = n.minUniformBufferOffsetAlignment;
    l.minStorageBufferOffsetAlignment = n.minStorageBufferOffsetAlignment;
    l.maxVertexBuffers = n.maxVertexBuffers;
    l.maxBufferSize = n.maxBufferSize;
    l.maxVertexAttributes = n.maxVertexAttributes;
    l.maxVertexBufferArrayStride = n.maxVertexBufferArrayStride;
    l.maxInterStageShaderVariables = n.maxInterStageShaderVariables;
    l.maxColorAttachments = n.maxColorAttachments;
    l.maxColorAttachmentBytesPerSample = n.maxColorAttachmentBytesPerSample;
    l.maxComputeWorkgroupStorageSize = n.maxComputeWorkgroupStorageSize;
    l.maxComputeInvocationsPerWorkgroup = n.maxComputeInvocationsPerWorkgroup;
    l.maxComputeWorkgroupSizeX = n.maxComputeWorkgroupSizeX;
    l.maxComputeWorkgroupSizeY = n.maxComputeWorkgroupSizeY;
    l.maxComputeWorkgroupSizeZ = n.maxComputeWorkgroupSizeZ;
    l.maxComputeWorkgroupsPerDimension = n.maxComputeWorkgroupsPerDimension;
    l.maxImmediateSize = n.maxImmediateSize;
    return l;
}

fn uint32 asked32(uint32 want, uint32 standard) { return want == standard ? LIMIT_U32_UNDEFINED : want; }
fn uint64 asked64(uint64 want, uint64 standard) { return want == standard ? LIMIT_U64_UNDEFINED : want; }

// `want` as a request: each limit left at WebGPU's default is undefined, so the implementation's own default stands,
// and each one raised is asked for.
fn WGPULimits required(const ref Limits want) {
    Limits d = Limits.defaults();
    WGPULimits n = WGPULimits.zero();
    n.maxTextureDimension1D = asked32(want: want.maxTextureDimension1D, standard: d.maxTextureDimension1D);
    n.maxTextureDimension2D = asked32(want: want.maxTextureDimension2D, standard: d.maxTextureDimension2D);
    n.maxTextureDimension3D = asked32(want: want.maxTextureDimension3D, standard: d.maxTextureDimension3D);
    n.maxTextureArrayLayers = asked32(want: want.maxTextureArrayLayers, standard: d.maxTextureArrayLayers);
    n.maxBindGroups = asked32(want: want.maxBindGroups, standard: d.maxBindGroups);
    n.maxBindGroupsPlusVertexBuffers = asked32(want: want.maxBindGroupsPlusVertexBuffers, standard: d.maxBindGroupsPlusVertexBuffers);
    n.maxBindingsPerBindGroup = asked32(want: want.maxBindingsPerBindGroup, standard: d.maxBindingsPerBindGroup);
    n.maxDynamicUniformBuffersPerPipelineLayout = asked32(want: want.maxDynamicUniformBuffersPerPipelineLayout, standard: d.maxDynamicUniformBuffersPerPipelineLayout);
    n.maxDynamicStorageBuffersPerPipelineLayout = asked32(want: want.maxDynamicStorageBuffersPerPipelineLayout, standard: d.maxDynamicStorageBuffersPerPipelineLayout);
    n.maxSampledTexturesPerShaderStage = asked32(want: want.maxSampledTexturesPerShaderStage, standard: d.maxSampledTexturesPerShaderStage);
    n.maxSamplersPerShaderStage = asked32(want: want.maxSamplersPerShaderStage, standard: d.maxSamplersPerShaderStage);
    n.maxStorageBuffersPerShaderStage = asked32(want: want.maxStorageBuffersPerShaderStage, standard: d.maxStorageBuffersPerShaderStage);
    n.maxStorageTexturesPerShaderStage = asked32(want: want.maxStorageTexturesPerShaderStage, standard: d.maxStorageTexturesPerShaderStage);
    n.maxUniformBuffersPerShaderStage = asked32(want: want.maxUniformBuffersPerShaderStage, standard: d.maxUniformBuffersPerShaderStage);
    n.maxUniformBufferBindingSize = asked64(want: want.maxUniformBufferBindingSize, standard: d.maxUniformBufferBindingSize);
    n.maxStorageBufferBindingSize = asked64(want: want.maxStorageBufferBindingSize, standard: d.maxStorageBufferBindingSize);
    n.minUniformBufferOffsetAlignment = asked32(want: want.minUniformBufferOffsetAlignment, standard: d.minUniformBufferOffsetAlignment);
    n.minStorageBufferOffsetAlignment = asked32(want: want.minStorageBufferOffsetAlignment, standard: d.minStorageBufferOffsetAlignment);
    n.maxVertexBuffers = asked32(want: want.maxVertexBuffers, standard: d.maxVertexBuffers);
    n.maxBufferSize = asked64(want: want.maxBufferSize, standard: d.maxBufferSize);
    n.maxVertexAttributes = asked32(want: want.maxVertexAttributes, standard: d.maxVertexAttributes);
    n.maxVertexBufferArrayStride = asked32(want: want.maxVertexBufferArrayStride, standard: d.maxVertexBufferArrayStride);
    n.maxInterStageShaderVariables = asked32(want: want.maxInterStageShaderVariables, standard: d.maxInterStageShaderVariables);
    n.maxColorAttachments = asked32(want: want.maxColorAttachments, standard: d.maxColorAttachments);
    n.maxColorAttachmentBytesPerSample = asked32(want: want.maxColorAttachmentBytesPerSample, standard: d.maxColorAttachmentBytesPerSample);
    n.maxComputeWorkgroupStorageSize = asked32(want: want.maxComputeWorkgroupStorageSize, standard: d.maxComputeWorkgroupStorageSize);
    n.maxComputeInvocationsPerWorkgroup = asked32(want: want.maxComputeInvocationsPerWorkgroup, standard: d.maxComputeInvocationsPerWorkgroup);
    n.maxComputeWorkgroupSizeX = asked32(want: want.maxComputeWorkgroupSizeX, standard: d.maxComputeWorkgroupSizeX);
    n.maxComputeWorkgroupSizeY = asked32(want: want.maxComputeWorkgroupSizeY, standard: d.maxComputeWorkgroupSizeY);
    n.maxComputeWorkgroupSizeZ = asked32(want: want.maxComputeWorkgroupSizeZ, standard: d.maxComputeWorkgroupSizeZ);
    n.maxComputeWorkgroupsPerDimension = asked32(want: want.maxComputeWorkgroupsPerDimension, standard: d.maxComputeWorkgroupsPerDimension);
    n.maxImmediateSize = asked32(want: want.maxImmediateSize, standard: d.maxImmediateSize);
    return n;
}

// What a device is asked for (WebGPU's `GPUDeviceDescriptor`, its `requiredLimits` and `requiredFeatures`): WebGPU's
// default limits and no feature, unless a program raises a limit or adds a feature. A request its adapter cannot meet
// fails, in the implementation's words.
type value DeviceOptions {
    public Limits limits = Limits.defaults();
    public FeatureSet features = FeatureSet.empty();
    // Each error the device reports to its channel is also printed to stderr as it arrives (AGENTS.gpu.md item 12,
    // decision 3, item 2), so an error nobody reads is never silent. An error a scope catches, and a failed
    // asynchronous pipeline's, which its request carries, are not printed. A program that reads the channel itself
    // turns it off.
    public bool printErrors = true;
    // The isolates that compile this device's asynchronous pipelines natively (decision 2), started by its first
    // `createRenderPipelineAsync`: half the cores by default, at least 1. On the web the browser compiles them.
    public int32 compileWorkers = halfTheCores();

    public ctor defaults() { }
}

// WebGPU's flag sets (AGENTS.gpu.md item 12, decision 6). Each is a type of its own, as kama's flag sets are
// (`std::fs::Permissions`): its members are sets of one, joined with `|` (`BufferUsage::MapRead | BufferUsage::CopyDst`)
// and read with `has(flags:)`, so one set cannot stand where another is wanted, though webgpu.h gives them the same
// numbers (TextureUsage CopyDst, BufferUsage MapWrite and ShaderStage Fragment are each 2). There is no empty set:
// WebGPU refuses a buffer or a texture with no usage. `bits()` is webgpu.h's number, for a program that binds more of
// webgpu.h with its own externs.

// A buffer's usages (WebGPU's `GPUBufferUsageFlags`).
@generate(Equatable)
type value BufferUsage {
    uint64 mask;

    ctor fromBits(uint64 bits) { this.mask = bits; }

    public comptime BufferUsage MapRead = BufferUsage.fromBits(bits: WGPUBufferUsage::MapRead);
    public comptime BufferUsage MapWrite = BufferUsage.fromBits(bits: WGPUBufferUsage::MapWrite);
    public comptime BufferUsage CopySrc = BufferUsage.fromBits(bits: WGPUBufferUsage::CopySrc);
    public comptime BufferUsage CopyDst = BufferUsage.fromBits(bits: WGPUBufferUsage::CopyDst);
    public comptime BufferUsage Index = BufferUsage.fromBits(bits: WGPUBufferUsage::Index);
    public comptime BufferUsage Vertex = BufferUsage.fromBits(bits: WGPUBufferUsage::Vertex);
    public comptime BufferUsage Uniform = BufferUsage.fromBits(bits: WGPUBufferUsage::Uniform);
    public comptime BufferUsage Storage = BufferUsage.fromBits(bits: WGPUBufferUsage::Storage);
    public comptime BufferUsage Indirect = BufferUsage.fromBits(bits: WGPUBufferUsage::Indirect);

    // Every usage either side has.
    public BufferUsage operator|(BufferUsage rhs) { return BufferUsage.fromBits(bits: this.mask | rhs.mask); }
    // Does this set hold every usage of `flags`?
    public const fn bool has(BufferUsage flags) { return (this.mask & flags.mask) == flags.mask; }
    public const fn uint64 bits() { return this.mask; }
}

// A texture's usages (WebGPU's `GPUTextureUsageFlags`).
@generate(Equatable)
type value TextureUsage {
    uint64 mask;

    ctor fromBits(uint64 bits) { this.mask = bits; }
    friend capabilitiesOf[fromBits];

    public comptime TextureUsage CopySrc = TextureUsage.fromBits(bits: WGPUTextureUsage::CopySrc);
    public comptime TextureUsage CopyDst = TextureUsage.fromBits(bits: WGPUTextureUsage::CopyDst);
    public comptime TextureUsage TextureBinding = TextureUsage.fromBits(bits: WGPUTextureUsage::TextureBinding);
    public comptime TextureUsage StorageBinding = TextureUsage.fromBits(bits: WGPUTextureUsage::StorageBinding);
    public comptime TextureUsage RenderAttachment = TextureUsage.fromBits(bits: WGPUTextureUsage::RenderAttachment);

    // Every usage either side has.
    public TextureUsage operator|(TextureUsage rhs) { return TextureUsage.fromBits(bits: this.mask | rhs.mask); }
    // Does this set hold every usage of `flags`?
    public const fn bool has(TextureUsage flags) { return (this.mask & flags.mask) == flags.mask; }
    public const fn uint64 bits() { return this.mask; }
}

// The shader stages a binding is seen by (WebGPU's `GPUShaderStageFlags`).
@generate(Equatable)
type value ShaderStage {
    uint64 mask;

    ctor fromBits(uint64 bits) { this.mask = bits; }

    public comptime ShaderStage Vertex = ShaderStage.fromBits(bits: WGPUShaderStage::Vertex);
    public comptime ShaderStage Fragment = ShaderStage.fromBits(bits: WGPUShaderStage::Fragment);
    public comptime ShaderStage Compute = ShaderStage.fromBits(bits: WGPUShaderStage::Compute);

    // Every stage either side has.
    public ShaderStage operator|(ShaderStage rhs) { return ShaderStage.fromBits(bits: this.mask | rhs.mask); }
    // Does this set hold every stage of `flags`?
    public const fn bool has(ShaderStage flags) { return (this.mask & flags.mask) == flags.mask; }
    public const fn uint64 bits() { return this.mask; }
}

// The channels of a colour target a pipeline writes (WebGPU's `GPUColorWriteFlags`), joined with `|` (AGENTS.gpu.md
// item 12, decision 6). `None` writes no channel, which WebGPU takes, as it takes no empty usage; `All`, every channel,
// is WebGPU's default.
@generate(Equatable)
type value ColorWriteMask {
    uint64 mask;

    ctor fromBits(uint64 bits) { this.mask = bits; }

    public comptime ColorWriteMask None = ColorWriteMask.fromBits(bits: WGPUColorWriteMask::None);
    public comptime ColorWriteMask Red = ColorWriteMask.fromBits(bits: WGPUColorWriteMask::Red);
    public comptime ColorWriteMask Green = ColorWriteMask.fromBits(bits: WGPUColorWriteMask::Green);
    public comptime ColorWriteMask Blue = ColorWriteMask.fromBits(bits: WGPUColorWriteMask::Blue);
    public comptime ColorWriteMask Alpha = ColorWriteMask.fromBits(bits: WGPUColorWriteMask::Alpha);
    public comptime ColorWriteMask All = ColorWriteMask.fromBits(bits: WGPUColorWriteMask::All);

    // Every channel either side has.
    public ColorWriteMask operator|(ColorWriteMask rhs) { return ColorWriteMask.fromBits(bits: this.mask | rhs.mask); }
    // Does this set hold every channel of `flags`?
    public const fn bool has(ColorWriteMask flags) { return (this.mask & flags.mask) == flags.mask; }
    public const fn uint64 bits() { return this.mask; }
}

// A colour, each channel 0 to 1, made memberwise: `Color.of(r: 0.1, g: 0.2, b: 0.3, a: 1.0)`.
@generate(of)
type value Color {
    public float64 r;
    public float64 g;
    public float64 b;
    public float64 a;
}

// ---- the instance and the device -------------------------------------------------------------------------------------

type resource Instance implements Copyable<This>(bare: give) {
    UnsafePtr handle;

    public unsafe ctor Result<Instance, GpuError> make() {
        UnsafePtr h = createInstance(descriptor: null);
        if (h == null) { return Result::Err(error: GpuError::NoInstance); }
        return Result::Ok(value: Instance.adopt(raw: h));
    }
    public unsafe ctor adopt(UnsafePtr raw) { this.handle = raw; }
    public unsafe ctor copy(ref Instance source) { this.handle = source.handle; instanceAddRef(instance: this.handle); }
    public unsafe const fn UnsafePtr raw() { return this.handle; }

    // Ask for an adapter (WebGPU's first step); `poll()` the request until it settles.
    public unsafe fn AdapterRequest requestAdapter(const ref AdapterOptions options) {
        return AdapterRequest.start(instance: this.handle, compatible: options.surface, power: options.power);
    }

    unsafe ~Instance() { if (this.handle != null) { instanceRelease(instance: this.handle); } }
}

// What an adapter is asked for (WebGPU's `GPURequestAdapterOptions`): a power preference, and the surface it must
// present to when there is one, on which it holds a reference, and on its window.
type resource AdapterOptions {
    int32 power;
    UnsafePtr surface;   // null for an adapter that need present nowhere
    NativeWindow onWindow = NativeWindow.adopt(kind: NativeKind::None, display: null, window: null);

    friend Instance::requestAdapter[power, surface];

    public unsafe ctor make(PowerPreference power) { this.power = powerValue(p: power); this.surface = null; }
    public unsafe ctor withSurface(const ref Surface surface, PowerPreference power) {
        this.power = powerValue(p: power);
        this.surface = surface.raw();
        surfaceAddRef(surface: this.surface);
        this.onWindow = surface.heldWindow();
    }

    unsafe ~AdapterOptions() { if (this.surface != null) { surfaceRelease(surface: this.surface); } }
}

type enum AdapterStatus { Pending, Ready(Adapter adapter), Failed(GpuError error) }

// An adapter on its way. Dropping it while it is still pending is safe: the seam frees it when its callback fires.
type resource AdapterRequest {
    UnsafePtr slot;
    UnsafePtr instance;   // the instance it was asked of, alive while the slot is; the adapter keeps a reference

    friend Instance::requestAdapter[start];

    unsafe ctor start(UnsafePtr instance, UnsafePtr compatible, int32 power) {
        this.instance = instance;
        this.slot = requestAdapter(instance: instance, compatible: compatible, power: power);
    }

    // Pending until the adapter has answered; then Ready once, handing the adapter over, or Failed with the
    // implementation's words: NoAdapter when there is none here for the request, Refused otherwise. A poll after Ready
    // is Failed(Taken).
    public unsafe const fn AdapterStatus poll() {
        if (this.slot == null) { return AdapterStatus::Failed(error: GpuError::Refused(words: "out of memory for the request")); }
        int32 s = adapterRequestPoll(request: this.slot);
        if (s == SEAM_PENDING) { return AdapterStatus::Pending; }
        if (s == SEAM_FAILED || s == SEAM_UNAVAILABLE) {
            InlineArray<uint8>#(512) buf = [0; 512];
            int32 n = adapterRequestMessage(request: this.slot, dst: addr(of: buf[0]), capacity: MESSAGE_BYTES);
            string words = textOf(buf: buf, length: n);
            if (s == SEAM_UNAVAILABLE) { return AdapterStatus::Failed(error: GpuError::NoAdapter(words: give words)); }
            return AdapterStatus::Failed(error: GpuError::Refused(words: give words));
        }
        UnsafePtr adapter = adapterRequestTake(request: this.slot);
        if (adapter == null) { return AdapterStatus::Failed(error: GpuError::Taken); }
        return AdapterStatus::Ready(adapter: Adapter.fromRequest(raw: adapter, instance: this.instance));
    }

    unsafe ~AdapterRequest() { adapterRequestDrop(request: this.slot); }
}

// What an adapter is (WebGPU's `GPUAdapterInfo`). A browser may leave the names empty, so a program must not depend
// on them.
type resource AdapterInfo {
    string vendorName = "";
    string architectureName = "";
    string deviceName = "";
    string descriptionText = "";
    Backend api = Backend::Undefined;
    AdapterKind sort = AdapterKind::Unknown;
    uint32 vendorNumber = 0;
    uint32 deviceNumber = 0;

    friend Adapter::info[fromAdapter];

    unsafe ctor fromAdapter(UnsafePtr adapter) {
        InlineArray<uint8>#(512) buf = [0; 512];
        int32 n = adapterInfoText(adapter: adapter, which: 0, dst: addr(of: buf[0]), capacity: MESSAGE_BYTES);
        this.vendorName = textOf(buf: buf, length: n);
        n = adapterInfoText(adapter: adapter, which: 1, dst: addr(of: buf[0]), capacity: MESSAGE_BYTES);
        this.architectureName = textOf(buf: buf, length: n);
        n = adapterInfoText(adapter: adapter, which: 2, dst: addr(of: buf[0]), capacity: MESSAGE_BYTES);
        this.deviceName = textOf(buf: buf, length: n);
        n = adapterInfoText(adapter: adapter, which: 3, dst: addr(of: buf[0]), capacity: MESSAGE_BYTES);
        this.descriptionText = textOf(buf: buf, length: n);
        int32 backend = 0;
        int32 kind = 0;
        uint32 vendorId = 0;
        uint32 deviceId = 0;
        adapterInfoNumbers(adapter: adapter, backend: addr(of: backend), kind: addr(of: kind), vendorId: addr(of: vendorId),
                           deviceId: addr(of: deviceId));
        this.api = backendOf(v: backend);
        this.sort = kindOf(v: kind);
        this.vendorNumber = vendorId;
        this.deviceNumber = deviceId;
    }

    public const fn string vendor() { return copy this.vendorName; }
    public const fn string architecture() { return copy this.architectureName; }
    public const fn string device() { return copy this.deviceName; }
    public const fn string description() { return copy this.descriptionText; }
    public const fn Backend backend() { return this.api; }
    public const fn AdapterKind kind() { return this.sort; }
    public const fn uint32 vendorId() { return this.vendorNumber; }
    public const fn uint32 deviceId() { return this.deviceNumber; }
}

// WebGPU gives an adapter one device (AGENTS.gpu.md item 10, decision 1): once a request of any of its copies is granted,
// the adapter is consumed, and a later request fails with `GpuError::Consumed`, on every leg. A program that wants two
// devices requests two adapters.
type resource Adapter implements Copyable<This>(bare: give) {
    UnsafePtr handle;
    UnsafePtr instance;   // the instance it came from, whose events its requests process; null when adopted
    UnsafePtr mark;       // whether it has given a device, shared by its copies and the requests made of them

    friend AdapterRequest::poll[fromRequest];

    // An adapter made outside this package; it takes over one reference. Its maker vouches that it has given no device.
    public unsafe ctor adopt(UnsafePtr raw) { this.handle = raw; this.instance = null; this.mark = adapterMarkNew(); }
    unsafe ctor fromRequest(UnsafePtr raw, UnsafePtr instance) {
        this.handle = raw;
        this.instance = instance;
        if (instance != null) { instanceAddRef(instance: instance); }
        this.mark = adapterMarkNew();
    }
    public unsafe ctor copy(ref Adapter source) {
        this.handle = source.handle;
        this.instance = source.instance;
        this.mark = source.mark;
        adapterAddRef(adapter: this.handle);
        if (this.instance != null) { instanceAddRef(instance: this.instance); }
        adapterMarkHold(mark: this.mark);
    }
    public unsafe const fn UnsafePtr raw() { return this.handle; }

    // What it is: its names, its backend and its kind.
    public unsafe const fn AdapterInfo info() { return AdapterInfo.fromAdapter(adapter: this.handle); }

    // The most it can give a device.
    public unsafe const fn Limits limits() {
        WGPULimits n = WGPULimits.zero();
        int32 status = adapterGetLimits(adapter: this.handle, limits: cast<UnsafePtr>(addr(of: n)));
        return limitsOf(n: n);
    }

    // The features it can give a device.
    public unsafe const fn FeatureSet features() {
        InlineArray<int32>#(64) names = [0; 64];
        int32 n = adapterFeatureNames(adapter: this.handle, dst: addr(of: names[0]), capacity: FEATURES_MAX);
        return featuresFrom(names: names, count: n);
    }

    // Ask for a device with `options` (WebGPU's second step); `poll()` the request until it settles. Once the adapter
    // has given a device, the request fails with `Consumed` at once.
    public unsafe fn DeviceRequest requestDevice(const ref DeviceOptions options) {
        return DeviceRequest.start(instance: this.instance, adapter: this.handle, mark: this.mark, options: options);
    }

    unsafe ~Adapter() {
        if (this.handle != null) { adapterRelease(adapter: this.handle); }
        if (this.instance != null) { instanceRelease(instance: this.instance); }
        adapterMarkRelease(mark: this.mark);
    }
}

type enum DeviceStatus { Pending, Ready(Device device, Queue queue), Failed(GpuError error) }

// A device on its way. Dropping it while it is still pending is safe: the seam frees it when its callback fires.
type resource DeviceRequest {
    UnsafePtr slot;
    UnsafePtr adapter;   // the adapter it was asked of, on which it holds a reference, handed to the device it gives
    int32 workers = 1;   // DeviceOptions.compileWorkers, for the device it gives

    friend Adapter::requestDevice[start];

    unsafe ctor start(UnsafePtr instance, UnsafePtr adapter, UnsafePtr mark, const ref DeviceOptions options) {
        this.adapter = adapter;
        if (adapter != null) { adapterAddRef(adapter: adapter); }
        this.workers = options.compileWorkers;
        WGPULimits limits = required(want: options.limits);
        InlineArray<int32>#(64) names = [0; 64];
        int32 count = 0;
        DynamicArray<Feature> all = everyFeature();
        foreach (Feature f in all.iterator()) {
            if (options.features.has(feature: f)) { names[cast<isize>(count)] = featureValue(f: f); count = count + 1; }
        }
        this.slot = requestDeviceOf(instance: instance, adapter: adapter, mark: mark, limits: cast<UnsafePtr>(addr(of: limits)),
                                    features: addr(of: names[0]), featureCount: count,
                                    printErrors: options.printErrors ? 1 : 0);
    }

    // Pending until the device has answered; then Ready once, handing the device and its queue over, or Failed with
    // the implementation's words. A poll after Ready is Failed(Taken).
    public unsafe const fn DeviceStatus poll() {
        if (this.slot == null) { return DeviceStatus::Failed(error: GpuError::Refused(words: "out of memory for the request")); }
        int32 s = deviceRequestPoll(request: this.slot);
        if (s == SEAM_PENDING) { return DeviceStatus::Pending; }
        if (s == SEAM_FAILED) {
            if (deviceRequestConsumed(request: this.slot) != 0) { return DeviceStatus::Failed(error: GpuError::Consumed); }
            InlineArray<uint8>#(512) buf = [0; 512];
            int32 n = deviceRequestMessage(request: this.slot, dst: addr(of: buf[0]), capacity: MESSAGE_BYTES);
            string words = textOf(buf: buf, length: n);
            return DeviceStatus::Failed(error: GpuError::Refused(words: give words));
        }
        UnsafePtr device = deviceRequestTakeDevice(request: this.slot);
        if (device == null) { return DeviceStatus::Failed(error: GpuError::Taken); }
        UnsafePtr state = deviceRequestTakeState(request: this.slot);
        UnsafePtr queue = deviceGetQueue(device: device);
        stateKeepQueue(state: state, queue: queue);
        return DeviceStatus::Ready(device: Device.fromRequest(raw: device, adapter: this.adapter, block: state,
                                                              workers: this.workers),
                                   queue: Queue.fromDevice(raw: queue, block: state, device: device));
    }

    unsafe ~DeviceRequest() {
        deviceRequestDrop(request: this.slot);
        if (this.adapter != null) { adapterRelease(adapter: this.adapter); }
    }
}

// A device holds a reference on the adapter it came from: webgpu.h cannot answer it (neither leg has
// `wgpuDeviceGetAdapter`), and a surface it configures is checked against what the surface offers that adapter.
type resource Device implements Copyable<This>(bare: give) {
    UnsafePtr handle;
    UnsafePtr adapter;
    StateHold hold = StateHold.empty();   // its errors and its loss, shared with every handle made from it
    Shared<CompilePool> pool;             // natively, the isolates its asynchronous pipelines compile on

    friend DeviceRequest::poll[fromRequest];
    friend Surface::configure[adapterHandle, stateBlock];

    // A device made outside this package, with the adapter it was requested of; it takes over one reference. It keeps
    // the callbacks its maker gave it, since webgpu.h sets them only when a device is made, so its errors and its loss
    // reach those and never this package: `takeErrors()` says so (`watched()` is false), and `lost()` answers None.
    public unsafe ctor adopt(UnsafePtr raw, const ref Adapter adapter) {
        this.handle = raw;
        this.adapter = adapter.raw();
        if (this.adapter != null) { adapterAddRef(adapter: this.adapter); }
        this.hold = StateHold.fromSeam(block: stateUnwatched());
        Shared<CompilePool> p = new CompilePool.make(block: this.hold.raw(), size: halfTheCores());
        this.pool = give p;
    }
    unsafe ctor fromRequest(UnsafePtr raw, UnsafePtr adapter, UnsafePtr block, int32 workers) {
        this.handle = raw;
        this.adapter = adapter;
        if (adapter != null) { adapterAddRef(adapter: adapter); }
        this.hold = StateHold.fromSeam(block: block);
        Shared<CompilePool> p = new CompilePool.make(block: block, size: workers);
        this.pool = give p;
    }
    public unsafe ctor copy(ref Device source) {
        this.handle = source.handle;
        this.adapter = source.adapter;
        deviceAddRef(device: this.handle);
        if (this.adapter != null) { adapterAddRef(adapter: this.adapter); }
        this.hold = copy source.hold;
        this.pool = copy source.pool;
    }
    public unsafe const fn UnsafePtr raw() { return this.handle; }
    unsafe const fn UnsafePtr adapterHandle() { return this.adapter; }
    unsafe const fn UnsafePtr stateBlock() { return this.hold.raw(); }

    // The uncaptured errors reported since the last call, the oldest first, from the device's calls and from every
    // handle made from it, draining its channel; every copy of the device shares the one channel. Natively an error is
    // here when the call that caused it returns; on the web, a task later.
    public unsafe fn DeviceErrors takeErrors() {
        DynamicArray<GpuErrorReport> list = DynamicArray.empty();
        int64 dropped = 0;
        UnsafePtr drained = stateTakeErrors(state: this.hold.raw());
        if (drained != null) {
            int32 n = errorsCount(errors: drained);
            int32 i = 0;
            while (i < n) {
                string words = textFrom(p: errorsMessage(errors: drained, at: i), length: errorsLength(errors: drained, at: i));
                list.add(item: GpuErrorReport.of(kind: kindFrom(v: errorsKind(errors: drained, at: i)), message: give words));
                i = i + 1;
            }
            dropped = errorsDropped(errors: drained);
            errorsFree(errors: drained);
        }
        return DeviceErrors.make(reports: give list, dropped: dropped, watched: stateWatched(state: this.hold.raw()) != 0);
    }

    // Open an error scope on this thread: it catches the errors of the calls made while it is open (the device's own,
    // and every handle's made from it) that `filter` matches, until it is popped. An adopted device's errors reach its
    // maker's callback, so natively its scopes catch nothing.
    public unsafe fn ErrorScope pushErrorScope(ErrorFilter filter) {
        return ErrorScope.start(block: this.hold.raw(), device: this.handle, filter: filter);
    }

    // How the device was lost, once it is. Natively wgpu-native reports no loss, of a destroy or a release (tests/facts,
    // `noloss`), so this answers None there.
    public unsafe const fn Optional<DeviceLoss> lost() {
        UnsafePtr block = this.hold.raw();
        int32 l = stateLost(state: block);
        if (l == 0) { return Optional::None; }
        string words = textFrom(p: stateLostMessage(state: block), length: stateLostLength(state: block));
        LossReason why = LossReason::Unknown;
        if (l == LOSS_DESTROYED) { why = LossReason::Destroyed; }
        return Optional::Some(value: DeviceLoss.of(reason: why, message: give words));
    }

    // The limits it was given: WebGPU's defaults, unless its request raised them.
    public unsafe const fn Limits limits() {
        WGPULimits n = WGPULimits.zero();
        int32 status = deviceGetLimits(device: this.handle, limits: cast<UnsafePtr>(addr(of: n)));
        return limitsOf(n: n);
    }

    // The features it was given.
    public unsafe const fn FeatureSet features() {
        InlineArray<int32>#(64) names = [0; 64];
        int32 n = deviceFeatureNames(device: this.handle, dst: addr(of: names[0]), capacity: FEATURES_MAX);
        return featuresFrom(names: names, count: n);
    }

    // A buffer as `descriptor` describes it (WebGPU's `createBuffer`; AGENTS.gpu.md item 12, decision 7).
    public unsafe fn Buffer createBuffer(BufferDescriptor descriptor) {
        WGPUBufferDescriptor d = WGPUBufferDescriptor.zero();
        d.size = inRange(v: descriptor.size());
        d.usage = descriptor.usage().bits();
        d.label = labelOf(text: descriptor.labelText());
        return Buffer.fromDevice(raw: deviceCreateBuffer(device: this.handle, descriptor: cast<UnsafePtr>(addr(of: d))),
                                 block: this.hold.raw());
    }

    // A 2D texture, one mip level, one sample. A format whose feature the device was not given is refused in the
    // package's words, where a browser throws (decision 9).
    public unsafe fn Texture createTexture(uint32 width, uint32 height, TextureFormat format, TextureUsage usage) {
        WGPUTextureDescriptor d = WGPUTextureDescriptor.zero();
        d.usage = usage.bits();
        d.dimension = WGPUTextureDimension::N2D;
        d.size.width = width;
        d.size.height = height;
        d.size.depthOrArrayLayers = 1;
        d.format = format.value();
        d.mipLevelCount = 1;
        d.sampleCount = 1;
        string refused = this.formatRefusal(format: format, what: "a texture");
        if (refused.isEmpty()) {
            return Texture.fromDevice(raw: deviceCreateTexture(device: this.handle, descriptor: cast<UnsafePtr>(addr(of: d))),
                                      block: this.hold.raw());
        }
        // the handle handed back is invalid: an empty RGBA8Unorm texture, which WebGPU refuses, its error dropped
        this.refuse(words: refused);
        TextureFormat plain = TextureFormat::RGBA8Unorm;
        d.format = plain.value();
        d.size.width = 0;
        quietBegin(device: this.handle);
        UnsafePtr raw = deviceCreateTexture(device: this.handle, descriptor: cast<UnsafePtr>(addr(of: d)));
        quietEnd(device: this.handle);
        return Texture.fromDevice(raw: raw, block: this.hold.raw());
    }

    // A shader module from WGSL (WebGPU's `createShaderModule`). It is handed back at once, as WebGPU's is: an error in
    // the WGSL is reported as every error is, to the device's channel or a scope, and whatever is made from the module
    // is invalid too. `module.compilationInfo()` places each message in the WGSL (AGENTS.gpu.md item 12, decision 3).
    public unsafe fn ShaderModule createShaderModule(ShaderModuleDescriptor descriptor) {
        string code = copy descriptor.wgsl();
        string label = copy descriptor.labelText();
        UnsafePtr<uint8> seen = null;
        int32 seenLength = 0;
        UnsafePtr raw = createShaderModuleOf(device: this.handle, code: cast<UnsafeConstPtr<uint8>>(code.cstr()),
                                             codeLength: cast<int32>(code.length()),
                                             label: cast<UnsafeConstPtr<uint8>>(label.cstr()),
                                             labelLength: cast<int32>(label.length()),
                                             observed: addr(of: seen), observedLength: addr(of: seenLength));
        string observed = textFrom(p: seen, length: seenLength);
        freeBytes(bytes: seen);
        Shared<ShaderText> text = new ShaderText.make(source: give code, observed: give observed,
                                                      slot: askCompilation(module: raw));
        return ShaderModule.fromDevice(raw: raw, block: this.hold.raw(), text: give text);
    }

    // A sampler as `descriptor` describes it (WebGPU's `createSampler`; AGENTS.gpu.md item 12, decision 8). A LOD clamp
    // that is not a number, or infinite, is refused as a validation error in the package's words, where a browser would
    // throw and end the program, and the sampler handed back is invalid, as a refused one is (decision 9); a +inf
    // `lodMaxClamp` clamps nothing, and is taken as such.
    public unsafe fn Sampler createSampler(SamplerDescriptor descriptor) {
        WGPUSamplerDescriptor d = descriptor.raw();
        string refused = descriptor.refusal();
        if (refused.isEmpty()) {
            return Sampler.fromDevice(raw: deviceCreateSampler(device: this.handle, descriptor: cast<UnsafePtr>(addr(of: d))),
                                      block: this.hold.raw());
        }
        this.refuse(words: refused);
        d.lodMinClamp = -1.0;   // a sampler the device refuses: the handle is invalid, as the refused call's would be
        d.lodMaxClamp = 32.0;
        quietBegin(device: this.handle);
        UnsafePtr raw = deviceCreateSampler(device: this.handle, descriptor: cast<UnsafePtr>(addr(of: d)));
        quietEnd(device: this.handle);
        return Sampler.fromDevice(raw: raw, block: this.hold.raw());
    }

    // A render pipeline as `descriptor` describes it (WebGPU's `createRenderPipeline`; AGENTS.gpu.md item 12, decision
    // 2). It is handed back at once, its error reported as every error is, to the device's channel or a scope. What a
    // browser throws on or wgpu-native ends the process on is refused in the package's words, and the pipeline handed
    // back is invalid (decision 9).
    public unsafe fn RenderPipeline createRenderPipeline(RenderPipelineDescriptor descriptor) {
        string refused = this.pipelineRefusal(descriptor: descriptor);
        LoweredPipeline lowered = LoweredPipeline.fromDescription(descriptor: descriptor);
        if (refused.isEmpty()) {
            UnsafePtr raw = deviceCreateRenderPipeline(device: this.handle, descriptor: lowered.pointer());
            return RenderPipeline.fromDevice(raw: raw, block: this.hold.raw());
        }
        this.refuse(words: refused);
        quietBegin(device: this.handle);
        UnsafePtr substitute = deviceCreateRenderPipeline(device: this.handle, descriptor: lowered.substitutePointer());
        quietEnd(device: this.handle);
        return RenderPipeline.fromDevice(raw: substitute, block: this.hold.raw());
    }

    // A render pipeline made asynchronously (WebGPU's `createRenderPipelineAsync`; AGENTS.gpu.md item 12, decision 2),
    // polled to `Ready` or `Failed`. Its failure lands in the request alone, never in the device's channel, as the
    // browser's does, and carries each stage's compilation messages (decision 3, item 1). Natively it compiles on the
    // device's own isolates (`DeviceOptions.compileWorkers`), since wgpu-native's asynchronous call ends the process; a
    // pending request keeps them, and its device's state, alive. What the package refuses fails the request at once, in
    // its words (decision 9).
    public unsafe fn PipelineRequest createRenderPipelineAsync(RenderPipelineDescriptor descriptor) {
        string refused = this.pipelineRefusal(descriptor: descriptor);
        LoweredPipeline lowered = LoweredPipeline.fromDescription(descriptor: descriptor);
        UnsafePtr job = null;
        UnsafePtr slot = pipelineStart(device: this.handle, state: this.hold.raw(), descriptor: lowered.pointer(),
                                       refusal: cast<UnsafeConstPtr<uint8>>(refused.cstr()),
                                       refusalLength: cast<int32>(refused.length()), job: addr(of: job));
        if (job != null) { this.pool.derefMut().submit(job: CompileJob.make(job: job)); }
        Optional<CompilationRequest> fragmentStage = match (descriptor.fragmentState) {
            case Some(value: f): Optional::Some(value: f.shader.compilationInfo());
            case None: Optional::None;
        };
        return PipelineRequest.start(slot: slot, block: this.hold.raw(),
                                     vertexStage: descriptor.vertexState.shader.compilationInfo(),
                                     fragmentStage: give fragmentStage, pool: copy this.pool);
    }

    // Why the package refuses `descriptor` on this device, or "" (decision 9): a pipeline constant or a depth bias that
    // is not a finite number, a format or a blend factor whose feature the device lacks (a browser throws on each), and
    // a depth write to a format with no depth (wgpu-native ends the process on it). Then what wgpu-native takes and
    // WebGPU refuses (decision 10): more vertex buffer slots than the device's maxVertexBuffers, which wgpu-native leaves
    // uncounted when they carry no attribute, and alpha to coverage at one sample. The rest is WebGPU's validation.
    unsafe const fn string pipelineRefusal(const ref RenderPipelineDescriptor descriptor) {
        string what = "the render pipeline '" + descriptor.labelled + "'";
        string vertexConstants = constantRefusal(names: descriptor.vertexState.constantNames,
                                                 values: descriptor.vertexState.constantValues, what: what);
        if (!vertexConstants.isEmpty()) { return vertexConstants; }
        isize slots = descriptor.vertexState.bufferList.length();
        isize most = cast<isize>(this.limits().maxVertexBuffers);
        if (slots > most) {
            return "${what} has ${slots} vertex buffer slots, past the device's maxVertexBuffers of ${most} (a device asks for more in DeviceOptions.limits, up to its adapter's): WebGPU refuses it";
        }
        if (descriptor.multisampleState.alphaToCoverageEnabled && descriptor.multisampleState.count == 1) {
            return "${what} turns on alpha to coverage at a sample count of 1, where it needs multisampling (a fragment stage's discard keeps or drops a fragment exactly): WebGPU refuses it";
        }
        match (descriptor.depthState) {
            case Some(value: s): {
                float64 slope = cast<float64>(s.depthBiasSlopeScale);
                float64 clamp = cast<float64>(s.depthBiasClamp);
                if (!finiteNumber(x: slope) || !finiteNumber(x: clamp)) {
                    return "${what} has a depth bias that is not a finite number (depthBiasSlopeScale ${slope}, depthBiasClamp ${clamp}): WebGPU refuses it";
                }
                if (s.depthWriteEnabled && !hasDepth(format: s.format)) {
                    string f = s.format.name();
                    return "${what} writes depth to ${f}, a format with no depth: WebGPU refuses it";
                }
                string depthFormat = this.formatRefusal(format: s.format, what: what);
                if (!depthFormat.isEmpty()) { return depthFormat; }
            }
            case None: { }
        };
        match (descriptor.fragmentState) {
            case Some(value: f): {
                string fragmentConstants = constantRefusal(names: f.constantNames, values: f.constantValues, what: what);
                if (!fragmentConstants.isEmpty()) { return fragmentConstants; }
                bool dual = this.features().has(feature: Feature::DualSourceBlending);
                isize i = 0;
                while (i < f.targetList.length()) {
                    match (f.targetList[i]) {
                        case Some(value: target): {
                            string targetFormat = this.formatRefusal(format: target.format, what: what);
                            if (!targetFormat.isEmpty()) { return targetFormat; }
                            if (!dual && blendsDual(target: target)) {
                                return "${what} blends with a Src1 factor, which needs the feature DualSourceBlending; the device was not given it, and WebGPU refuses it";
                            }
                        }
                        case None: { }
                    };
                    i = i + 1;
                }
            }
            case None: { }
        };
        return "";
    }

    // Why `what` may not use `format` on this device, or "": a format whose feature the device was not given, which a
    // browser throws on (decision 9).
    unsafe const fn string formatRefusal(TextureFormat format, const ref string what) {
        return refusalOfFormat(format: format, given: this.features(), what: what);
    }

    // What a backend would end the program on, refused and reported as a validation error where WebGPU reports one
    // (AGENTS.gpu.md item 12, decision 9).
    unsafe fn void refuse(const ref string words) {
        refuseOn(device: this.handle, message: cast<UnsafeConstPtr<uint8>>(words.cstr()), length: cast<int32>(words.length()));
    }

    // A bind group layout as `descriptor` describes it (WebGPU's `createBindGroupLayout`; AGENTS.gpu.md item 12,
    // decision 1). A `minBindingSize` past 2^53 - 1 is clamped (decision 9).
    public unsafe fn BindGroupLayout createBindGroupLayout(BindGroupLayoutDescriptor descriptor) {
        DynamicArray<WGPUBindGroupLayoutEntry> entries = descriptor.raw();
        WGPUBindGroupLayoutDescriptor d = WGPUBindGroupLayoutDescriptor.zero();
        d.label = labelOf(text: descriptor.labelText());
        d.entryCount = cast<usize>(entries.length());
        d.entries = cast<UnsafePtr>(entries.dataPtrMut());
        string what = "the bind group layout '" + descriptor.labelText() + "'";
        isize i = 0;
        while (i < entries.length()) {
            Optional<TextureFormat> stored = TextureFormat::fromValue(value: entries[i].storageTexture.format);
            string refused = match (stored) {
                case Some(value: f): this.formatRefusal(format: f, what: what);
                case None: "";
            };
            if (!refused.isEmpty()) {
                // the handle handed back is invalid: the entry's format made RGBA8UnormSrgb, never a storage format
                this.refuse(words: refused);
                TextureFormat unstorable = TextureFormat::RGBA8UnormSrgb;
                entries[i].storageTexture.format = unstorable.value();
                quietBegin(device: this.handle);
                UnsafePtr substitute = deviceCreateBindGroupLayout(device: this.handle, descriptor: cast<UnsafePtr>(addr(of: d)));
                quietEnd(device: this.handle);
                return BindGroupLayout.fromDevice(raw: substitute, block: this.hold.raw());
            }
            i = i + 1;
        }
        UnsafePtr raw = deviceCreateBindGroupLayout(device: this.handle, descriptor: cast<UnsafePtr>(addr(of: d)));
        return BindGroupLayout.fromDevice(raw: raw, block: this.hold.raw());
    }

    // A pipeline layout of `descriptor`'s groups, in order (WebGPU's `createPipelineLayout`).
    public unsafe fn PipelineLayout createPipelineLayout(PipelineLayoutDescriptor descriptor) {
        DynamicArray<UnsafePtr> groups = descriptor.raw();
        WGPUPipelineLayoutDescriptor d = WGPUPipelineLayoutDescriptor.zero();
        d.label = labelOf(text: descriptor.labelText());
        d.bindGroupLayoutCount = cast<usize>(groups.length());
        d.bindGroupLayouts = cast<UnsafePtr>(groups.dataPtrMut());
        UnsafePtr raw = deviceCreatePipelineLayout(device: this.handle, descriptor: cast<UnsafePtr>(addr(of: d)));
        return PipelineLayout.fromDevice(raw: raw, block: this.hold.raw());
    }

    // A bind group as `descriptor` describes it (WebGPU's `createBindGroup`). A buffer binding's offset and size past
    // 2^53 - 1 are clamped, and an empty one (a size of 0) is refused in the package's words, since wgpu-native ends
    // the process on it; the group handed back is invalid, as a refused one is (decision 9).
    public unsafe fn BindGroup createBindGroup(BindGroupDescriptor descriptor) {
        DynamicArray<WGPUBindGroupEntry> entries = descriptor.raw();
        WGPUBindGroupDescriptor d = WGPUBindGroupDescriptor.zero();
        d.label = labelOf(text: descriptor.labelText());
        d.layout = descriptor.layoutHandle();
        d.entryCount = cast<usize>(entries.length());
        d.entries = cast<UnsafePtr>(entries.dataPtrMut());
        string refused = descriptor.refusal();
        if (refused.isEmpty()) {
            return BindGroup.fromDevice(raw: deviceCreateBindGroup(device: this.handle, descriptor: cast<UnsafePtr>(addr(of: d))),
                                        block: this.hold.raw());
        }
        this.refuse(words: refused);
        // a group the device refuses: each empty binding as one past the end of any buffer
        isize i = 0;
        while (i < entries.length()) {
            if (entries[i].buffer != null && entries[i].size == 0) { entries[i].size = SIZE_LIMIT; }
            i = i + 1;
        }
        quietBegin(device: this.handle);
        UnsafePtr raw = deviceCreateBindGroup(device: this.handle, descriptor: cast<UnsafePtr>(addr(of: d)));
        quietEnd(device: this.handle);
        return BindGroup.fromDevice(raw: raw, block: this.hold.raw());
    }

    public unsafe fn CommandEncoder createCommandEncoder() {
        return CommandEncoder.fromDevice(raw: deviceCreateCommandEncoder(device: this.handle, descriptor: null),
                                         block: this.hold.raw());
    }

    // Natively, finish what the device can and fire its callbacks; `wait` blocks until its queue is empty. On the web
    // the browser's event loop does this between frames, so it does nothing.
    public unsafe const fn void poll(bool wait) {
        int32 w = 0;
        if (wait) { w = 1; }
        pollDevice(device: this.handle, wait: w);
    }

    unsafe ~Device() {
        if (this.handle != null) { deviceRelease(device: this.handle); }
        if (this.adapter != null) { adapterRelease(adapter: this.adapter); }
    }
}

type resource Queue implements Copyable<This>(bare: give) {
    UnsafePtr handle;
    UnsafePtr device;                      // a reference on its device, which carries the package's refusals; null adopted
    StateHold hold = StateHold.empty();   // its device's state, which its errors reach

    friend DeviceRequest::poll[fromDevice];

    // One made elsewhere; it takes over one reference, and holds no device state. A call the package refuses on it is
    // dropped unreported, since it has no device to report through.
    public unsafe ctor adopt(UnsafePtr raw) { this.handle = raw; this.device = null; }
    unsafe ctor fromDevice(UnsafePtr raw, UnsafePtr block, UnsafePtr device) {
        this.handle = raw;
        this.device = device;
        deviceAddRef(device: device);
        this.hold = StateHold.make(block: block);
    }
    public unsafe ctor copy(ref Queue source) {
        this.handle = source.handle;
        queueAddRef(queue: this.handle);
        this.device = source.device;
        if (this.device != null) { deviceAddRef(device: this.device); }
        this.hold = copy source.hold;
    }
    public unsafe const fn UnsafePtr raw() { return this.handle; }

    // Hand `commands` to the GPU; the command buffer is spent. Natively a command buffer whose finish reported an error
    // is not submitted, since wgpu-native would end the process (tests/facts, `abort-submit`): its error is in the
    // device's channel or a scope already, and a browser refuses the same submit after reporting it.
    // `data` written into `buffer` at `offset` (WebGPU's `writeBuffer`; AGENTS.gpu.md item 12, decision 4): before any
    // later submit's work, and seen by any later map. A byte count not a multiple of 4 is refused in the package's words,
    // where a browser would throw, and writes nothing; an offset past 2^53 - 1 is clamped (decision 9).
    public unsafe fn void writeBuffer(const ref Buffer buffer, uint64 offset, ConstView<uint8> data) {
        isize n = data.length();
        if (n % 4 != 0) {
            if (this.device != null) {
                string words = "writeBuffer: ${n} bytes is not a multiple of 4, as WebGPU requires; nothing was written";
                refuseOn(device: this.device, message: cast<UnsafeConstPtr<uint8>>(words.cstr()), length: cast<int32>(words.length()));
            }
            return;
        }
        queueWriteBuffer(queue: this.handle, buffer: buffer.raw(), bufferOffset: inRange(v: offset),
                         data: cast<UnsafePtr>(data.dataPtr()), size: cast<usize>(n));
    }

    public unsafe fn void submit(CommandBuffer commands) {
        if (commands.spoiled()) { return; }
        UnsafePtr one = commands.raw();
        queueSubmit(queue: this.handle, commandCount: 1, commands: cast<UnsafePtr>(addr(of: one)));
    }

    unsafe ~Queue() {
        if (this.handle != null) { queueRelease(queue: this.handle); }
        if (this.device != null) { deviceRelease(device: this.device); }
    }
}

// ---- buffers ---------------------------------------------------------------------------------------------------------

// webgpu.h's view of a label: its bytes, borrowed from `text`, which must outlive the call it is handed to.
unsafe fn WGPUStringView labelOf(const ref string text) {
    WGPUStringView v = WGPUStringView.zero();
    v.data = cast<UnsafeConstPtr<cchar>>(text.cstr());
    v.length = cast<usize>(text.length());
    return v;
}

// WebGPU's `GPUBufferDescriptor` (AGENTS.gpu.md item 12, decision 7): the size and the usages, which WebGPU requires,
// and a label, which the implementation's words name the buffer by. `mappedAtCreation` joins it in GPU-8.
type resource BufferDescriptor {
    uint64 bytes;
    BufferUsage uses;
    string labelled = "";

    public ctor make(uint64 size, BufferUsage usage) {
        this.bytes = size;
        this.uses = usage;
    }
    public fn void label(string text) { this.labelled = give text; }
    public const fn uint64 size() { return this.bytes; }
    public const fn BufferUsage usage() { return this.uses; }
    public const fn const ref string labelText() { return this.labelled; }
}

type resource Buffer implements Copyable<This>(bare: give) {
    UnsafePtr handle;
    StateHold hold = StateHold.empty();   // its device's state, which its errors reach

    friend Device::createBuffer[fromDevice];

    // One made elsewhere; it takes over one reference, and holds no device state.
    public unsafe ctor adopt(UnsafePtr raw) { this.handle = raw; }
    unsafe ctor fromDevice(UnsafePtr raw, UnsafePtr block) {
        this.handle = raw;
        this.hold = StateHold.make(block: block);
    }
    public unsafe ctor copy(ref Buffer source) {
        this.handle = source.handle;
        bufferAddRef(buffer: this.handle);
        this.hold = copy source.hold;
    }
    public unsafe const fn UnsafePtr raw() { return this.handle; }
    public unsafe const fn uint64 size() { return bufferGetSize(buffer: this.handle); }

    // Map `size` bytes from `offset` for reading (a MapRead buffer); `poll()` the read until it is Ready.
    public unsafe fn BufferRead mapRead(uint64 offset, uint64 size) {
        return BufferRead.start(buffer: this.handle, block: this.hold.raw(), offset: offset, size: size);
    }

    unsafe ~Buffer() { if (this.handle != null) { bufferRelease(buffer: this.handle); } }
}

type enum ReadStatus { Pending, Ready, Failed(GpuError error) }

// A buffer's bytes on their way to the CPU. Dropping it unmaps the buffer, or, while the map is still pending, leaves
// the seam to free it when its callback fires.
type resource BufferRead {
    UnsafePtr slot;
    uint64 length;

    friend Buffer::mapRead[start];

    // Natively the device's queue is flushed first, so the map sees every write made before it (AGENTS.gpu.md item 12,
    // decision 9): wgpu-native keeps them until the next submit.
    unsafe ctor start(UnsafePtr buffer, UnsafePtr block, uint64 offset, uint64 size) {
        this.length = size;
        this.slot = mapAsync(buffer: buffer, state: block, mode: WGPUMapMode::Read, offset: cast<usize>(offset),
                             size: cast<usize>(size));
    }

    public unsafe const fn ReadStatus poll() {
        if (this.slot == null) { return ReadStatus::Failed(error: GpuError::Refused(words: "out of memory for the map")); }
        int32 s = mapPoll(map: this.slot);
        if (s == SEAM_PENDING) { return ReadStatus::Pending; }
        if (s == SEAM_FAILED) {
            InlineArray<uint8>#(512) buf = [0; 512];
            int32 n = mapMessage(map: this.slot, dst: addr(of: buf[0]), capacity: MESSAGE_BYTES);
            string words = textOf(buf: buf, length: n);
            return ReadStatus::Failed(error: GpuError::Refused(words: give words));
        }
        return ReadStatus::Ready;
    }

    // The mapped bytes, copied out; empty until Ready.
    public unsafe const fn DynamicArray<uint8> bytes() {
        DynamicArray<uint8> acc = DynamicArray.empty();
        if (this.slot == null) { return acc; }
        UnsafeConstPtr<uint8> p = mapBytes(map: this.slot);
        if (p == null) { return acc; }
        isize n = cast<isize>(this.length);
        acc.reserve(n: n);
        isize i = 0;
        while (i < n) { acc.add(item: p[i]); i = i + 1; }
        return acc;
    }

    unsafe ~BufferRead() { mapDrop(map: this.slot); }
}

// ---- textures --------------------------------------------------------------------------------------------------------

type resource Texture implements Copyable<This>(bare: give) {
    UnsafePtr handle;
    StateHold hold = StateHold.empty();   // its device's state, which its errors reach

    friend Device::createTexture[fromDevice];
    friend SurfaceTexture::texture[fromDevice];

    // One made elsewhere; it takes over one reference, and holds no device state.
    public unsafe ctor adopt(UnsafePtr raw) { this.handle = raw; }
    unsafe ctor fromDevice(UnsafePtr raw, UnsafePtr block) {
        this.handle = raw;
        this.hold = StateHold.make(block: block);
    }
    public unsafe ctor copy(ref Texture source) {
        this.handle = source.handle;
        textureAddRef(texture: this.handle);
        this.hold = copy source.hold;
    }
    public unsafe const fn UnsafePtr raw() { return this.handle; }

    // A view of the whole texture.
    public unsafe fn TextureView createView() {
        return TextureView.fromDevice(raw: textureCreateView(texture: this.handle, descriptor: null), block: this.hold.raw());
    }

    unsafe ~Texture() { if (this.handle != null) { textureRelease(texture: this.handle); } }
}

type resource TextureView implements Copyable<This>(bare: give) {
    UnsafePtr handle;
    StateHold hold = StateHold.empty();   // its device's state, which its errors reach

    friend Texture::createView[fromDevice];
    friend SurfaceTexture::view[fromDevice];

    // One made elsewhere; it takes over one reference, and holds no device state.
    public unsafe ctor adopt(UnsafePtr raw) { this.handle = raw; }
    unsafe ctor fromDevice(UnsafePtr raw, UnsafePtr block) {
        this.handle = raw;
        this.hold = StateHold.make(block: block);
    }
    public unsafe ctor copy(ref TextureView source) {
        this.handle = source.handle;
        textureViewAddRef(textureView: this.handle);
        this.hold = copy source.hold;
    }
    public unsafe const fn UnsafePtr raw() { return this.handle; }

    unsafe ~TextureView() { if (this.handle != null) { textureViewRelease(textureView: this.handle); } }
}

// ---- samplers (GPU-4; AGENTS.gpu.md item 12, decision 8) ------------------------------------------------------------

// How a coordinate past a texture's edge is read (WebGPU's `GPUAddressMode`).
type enum AddressMode { ClampToEdge, Repeat, MirrorRepeat }
// How texels are blended between their centres (WebGPU's `GPUFilterMode`), and between mip levels (`GPUMipmapFilterMode`).
type enum FilterMode { Nearest, Linear }
type enum MipmapFilterMode { Nearest, Linear }
// A comparison (WebGPU's `GPUCompareFunction`): a comparison sampler's, and a depth test's.
type enum CompareFunction { Never, Less, Equal, LessEqual, Greater, NotEqual, GreaterEqual, Always }

fn int32 addressValue(AddressMode m) {
    return match (m) {
        case ClampToEdge: WGPUAddressMode::ClampToEdge;
        case Repeat: WGPUAddressMode::Repeat;
        case MirrorRepeat: WGPUAddressMode::MirrorRepeat;
    };
}

fn int32 filterModeValue(FilterMode m) {
    return match (m) { case Nearest: WGPUFilterMode::Nearest; case Linear: WGPUFilterMode::Linear; };
}

fn int32 mipmapValue(MipmapFilterMode m) {
    return match (m) { case Nearest: WGPUMipmapFilterMode::Nearest; case Linear: WGPUMipmapFilterMode::Linear; };
}

fn int32 compareValue(CompareFunction c) {
    return match (c) {
        case Never: WGPUCompareFunction::Never;
        case Less: WGPUCompareFunction::Less;
        case Equal: WGPUCompareFunction::Equal;
        case LessEqual: WGPUCompareFunction::LessEqual;
        case Greater: WGPUCompareFunction::Greater;
        case NotEqual: WGPUCompareFunction::NotEqual;
        case GreaterEqual: WGPUCompareFunction::GreaterEqual;
        case Always: WGPUCompareFunction::Always;
    };
}

fn bool finite(float32 x) { return x == x && x <= float32Max() && x >= -float32Max(); }

// WebGPU's `GPUSamplerDescriptor` (AGENTS.gpu.md item 12, decision 8): every part has WebGPU's default (clamp to the
// edge, nearest, LOD clamps 0 to 32, no comparison, anisotropy 1), and is set in the groups WebGPU's validation relates.
type resource SamplerDescriptor {
    AddressMode modeU = AddressMode::ClampToEdge;
    AddressMode modeV = AddressMode::ClampToEdge;
    AddressMode modeW = AddressMode::ClampToEdge;
    FilterMode magnify = FilterMode::Nearest;
    FilterMode minify = FilterMode::Nearest;
    MipmapFilterMode betweenLevels = MipmapFilterMode::Nearest;
    float32 lodMin = 0.0;
    float32 lodMax = 32.0;
    Optional<CompareFunction> comparing = Optional::None;
    uint16 anisotropy = 1;
    string labelled = "";

    friend Device::createSampler[raw, refusal];

    public ctor make() { }
    // How a coordinate past each edge is read.
    public fn void addressModes(AddressMode u, AddressMode v, AddressMode w) {
        this.modeU = u;
        this.modeV = v;
        this.modeW = w;
    }
    // How texels are blended magnified, minified, and between mip levels. An anisotropy above 1 needs all three Linear.
    public fn void filters(FilterMode mag, FilterMode min, MipmapFilterMode mipmap) {
        this.magnify = mag;
        this.minify = min;
        this.betweenLevels = mipmap;
    }
    // The levels of detail sampled, `min` at most `max`, neither below 0.
    public fn void lodClamp(float32 min, float32 max) {
        this.lodMin = min;
        this.lodMax = max;
    }
    // A comparison sampler: each texel compared with a reference.
    public fn void compare(CompareFunction function) { this.comparing = Optional::Some(value: function); }
    // At most `count` samples across a slanted footprint, 1 to 16 as the implementation clamps it.
    public fn void maxAnisotropy(uint16 count) { this.anisotropy = count; }
    public fn void label(string text) { this.labelled = give text; }

    // webgpu.h's description, its label borrowed from this one, which must outlive the call it is handed to.
    unsafe const fn WGPUSamplerDescriptor raw() {
        WGPUSamplerDescriptor d = WGPUSamplerDescriptor.zero();
        d.label = labelOf(text: this.labelled);
        d.addressModeU = addressValue(m: this.modeU);
        d.addressModeV = addressValue(m: this.modeV);
        d.addressModeW = addressValue(m: this.modeW);
        d.magFilter = filterModeValue(m: this.magnify);
        d.minFilter = filterModeValue(m: this.minify);
        d.mipmapFilter = mipmapValue(m: this.betweenLevels);
        d.lodMinClamp = this.lodMin;
        // +inf clamps nothing: 1e30 is past any level of detail, and a browser throws on +inf
        d.lodMaxClamp = this.lodMax > float32Max() ? 1.0e30 : this.lodMax;
        int32 comparison = match (this.comparing) { case Some(value: c): compareValue(c: c); case None: WGPUCompareFunction::Undefined; };
        d.compare = comparison;
        d.maxAnisotropy = this.anisotropy;
        return d;
    }

    // Why the package refuses this description (a LOD clamp not a number, or infinite but a +inf max), or "".
    const fn string refusal() {
        float32 lo = this.lodMin;
        float32 hi = this.lodMax;
        bool maxOk = finite(x: hi) || hi > float32Max();
        if (finite(x: lo) && maxOk) { return ""; }
        string name = copy this.labelled;
        return "the sampler '${name}' has a LOD clamp that is not a finite number (lodMinClamp ${lo}, lodMaxClamp ${hi}): WebGPU refuses it";
    }
}

type resource Sampler implements Copyable<This>(bare: give) {
    UnsafePtr handle;
    StateHold hold = StateHold.empty();   // its device's state, which its errors reach

    friend Device::createSampler[fromDevice];

    // One made elsewhere; it takes over one reference, and holds no device state.
    public unsafe ctor adopt(UnsafePtr raw) { this.handle = raw; }
    unsafe ctor fromDevice(UnsafePtr raw, UnsafePtr block) {
        this.handle = raw;
        this.hold = StateHold.make(block: block);
    }
    public unsafe ctor copy(ref Sampler source) {
        this.handle = source.handle;
        samplerAddRef(sampler: this.handle);
        this.hold = copy source.hold;
    }
    public unsafe const fn UnsafePtr raw() { return this.handle; }

    unsafe ~Sampler() { if (this.handle != null) { samplerRelease(sampler: this.handle); } }
}

// ---- bind group layouts, pipeline layouts and bind groups (GPU-4; AGENTS.gpu.md item 12, decision 1) ----------------

// What a buffer binding is read as (WebGPU's `GPUBufferBindingType`).
type enum BufferBindingType { Uniform, Storage, ReadOnlyStorage }
// What a sampler binding takes (WebGPU's `GPUSamplerBindingType`).
type enum SamplerBindingType { Filtering, NonFiltering, Comparison }
// What a texture binding's texels are read as (WebGPU's `GPUTextureSampleType`).
type enum TextureSampleType { Float, UnfilterableFloat, Depth, Sint, Uint }
// The shape of a texture view a binding takes (WebGPU's `GPUTextureViewDimension`).
type enum TextureViewDimension { D1, D2, D2Array, Cube, CubeArray, D3 }
// What a storage texture binding may do (WebGPU's `GPUStorageTextureAccess`).
type enum StorageTextureAccess { WriteOnly, ReadOnly, ReadWrite }

fn int32 viewDimensionValue(TextureViewDimension v) {
    return match (v) {
        case D1: WGPUTextureViewDimension::N1D;
        case D2: WGPUTextureViewDimension::N2D;
        case D2Array: WGPUTextureViewDimension::N2DArray;
        case Cube: WGPUTextureViewDimension::Cube;
        case CubeArray: WGPUTextureViewDimension::CubeArray;
        case D3: WGPUTextureViewDimension::N3D;
    };
}

// WebGPU's `GPUBufferBindingLayout`: a uniform buffer unless `kind` says otherwise.
type value BufferBindingLayout {
    public BufferBindingType kind = BufferBindingType::Uniform;
    public bool hasDynamicOffset = false;
    public uint64 minBindingSize = 0;

    public ctor make() { }
}

// WebGPU's `GPUSamplerBindingLayout`: a filtering sampler unless `kind` says otherwise.
type value SamplerBindingLayout {
    public SamplerBindingType kind = SamplerBindingType::Filtering;

    public ctor make() { }
}

// WebGPU's `GPUTextureBindingLayout`: a 2D float texture, one sample, unless its fields say otherwise.
type value TextureBindingLayout {
    public TextureSampleType sampleType = TextureSampleType::Float;
    public TextureViewDimension viewDimension = TextureViewDimension::D2;
    public bool multisampled = false;

    public ctor make() { }
}

// WebGPU's `GPUStorageTextureBindingLayout`: its format, which WebGPU requires; written, 2D, unless its fields say
// otherwise.
type value StorageTextureBindingLayout {
    public TextureFormat format;
    public StorageTextureAccess access = StorageTextureAccess::WriteOnly;
    public TextureViewDimension viewDimension = TextureViewDimension::D2;

    public ctor make(TextureFormat format) { this.format = format; }
}

// What a layout's binding holds: WebGPU's "exactly one of" a buffer, a sampler, a texture or a storage texture.
type enum BindingLayout {
    Buffer(BufferBindingLayout layout),
    Sampler(SamplerBindingLayout layout),
    Texture(TextureBindingLayout layout),
    StorageTexture(StorageTextureBindingLayout layout),
}

// webgpu.h's entry for one binding: the kind the enum names, every other kind left BindingNotUsed (zero).
fn WGPUBindGroupLayoutEntry layoutEntryOf(uint32 binding, ShaderStage visibility, const ref BindingLayout layout) {
    WGPUBindGroupLayoutEntry e = WGPUBindGroupLayoutEntry.zero();
    e.binding = binding;
    e.visibility = visibility.bits();
    match (layout) {
        case Buffer(layout: b): {
            int32 bufferKind = match (b.kind) {
                case Uniform: WGPUBufferBindingType::Uniform;
                case Storage: WGPUBufferBindingType::Storage;
                case ReadOnlyStorage: WGPUBufferBindingType::ReadOnlyStorage;
            };
            e.buffer.type = bufferKind;
            e.buffer.hasDynamicOffset = b.hasDynamicOffset ? 1 : 0;
            e.buffer.minBindingSize = inRange(v: b.minBindingSize);
        }
        case Sampler(layout: s): {
            int32 samplerKind = match (s.kind) {
                case Filtering: WGPUSamplerBindingType::Filtering;
                case NonFiltering: WGPUSamplerBindingType::NonFiltering;
                case Comparison: WGPUSamplerBindingType::Comparison;
            };
            e.sampler.type = samplerKind;
        }
        case Texture(layout: x): {
            int32 sampled = match (x.sampleType) {
                case Float: WGPUTextureSampleType::Float;
                case UnfilterableFloat: WGPUTextureSampleType::UnfilterableFloat;
                case Depth: WGPUTextureSampleType::Depth;
                case Sint: WGPUTextureSampleType::Sint;
                case Uint: WGPUTextureSampleType::Uint;
            };
            e.texture.sampleType = sampled;
            e.texture.viewDimension = viewDimensionValue(v: x.viewDimension);
            e.texture.multisampled = x.multisampled ? 1 : 0;
        }
        case StorageTexture(layout: st): {
            int32 access = match (st.access) {
                case WriteOnly: WGPUStorageTextureAccess::WriteOnly;
                case ReadOnly: WGPUStorageTextureAccess::ReadOnly;
                case ReadWrite: WGPUStorageTextureAccess::ReadWrite;
            };
            e.storageTexture.access = access;
            e.storageTexture.format = st.format.value();
            e.storageTexture.viewDimension = viewDimensionValue(v: st.viewDimension);
        }
    };
    return e;
}

// WebGPU's `GPUBindGroupLayoutDescriptor`: its entries, each a binding number, the stages that see it and what it holds,
// and a label.
type resource BindGroupLayoutDescriptor {
    DynamicArray<WGPUBindGroupLayoutEntry> entryList;
    string labelled = "";

    friend Device::createBindGroupLayout[raw];

    public ctor make() { this.entryList = DynamicArray.empty(); }
    public fn void entry(uint32 binding, ShaderStage visibility, BindingLayout layout) {
        this.entryList.add(item: layoutEntryOf(binding: binding, visibility: visibility, layout: layout));
    }
    public fn void label(string text) { this.labelled = give text; }
    public const fn const ref string labelText() { return this.labelled; }

    unsafe const fn DynamicArray<WGPUBindGroupLayoutEntry> raw() { return copy this.entryList; }
}

type resource BindGroupLayout implements Copyable<This>(bare: give) {
    UnsafePtr handle;
    StateHold hold = StateHold.empty();   // its device's state, which its errors reach

    friend Device::createBindGroupLayout[fromDevice];
    friend RenderPipeline::getBindGroupLayout[fromDevice];

    // One made elsewhere; it takes over one reference, and holds no device state.
    public unsafe ctor adopt(UnsafePtr raw) { this.handle = raw; }
    unsafe ctor fromDevice(UnsafePtr raw, UnsafePtr block) {
        this.handle = raw;
        this.hold = StateHold.make(block: block);
    }
    public unsafe ctor copy(ref BindGroupLayout source) {
        this.handle = source.handle;
        bindGroupLayoutAddRef(bindGroupLayout: this.handle);
        this.hold = copy source.hold;
    }
    public unsafe const fn UnsafePtr raw() { return this.handle; }

    unsafe ~BindGroupLayout() { if (this.handle != null) { bindGroupLayoutRelease(bindGroupLayout: this.handle); } }
}

// WebGPU's `GPUPipelineLayoutDescriptor`: its bind group layouts, group 0 first, and a label.
type resource PipelineLayoutDescriptor {
    DynamicArray<BindGroupLayout> groups;
    string labelled = "";

    friend Device::createPipelineLayout[raw];

    public ctor make() { this.groups = DynamicArray.empty(); }
    // The next group's layout.
    public fn void group(BindGroupLayout layout) { this.groups.add(item: give layout); }
    public fn void label(string text) { this.labelled = give text; }
    public const fn const ref string labelText() { return this.labelled; }

    unsafe const fn DynamicArray<UnsafePtr> raw() {
        DynamicArray<UnsafePtr> handles = DynamicArray.empty();
        isize i = 0;
        while (i < this.groups.length()) { handles.add(item: this.groups[i].raw()); i = i + 1; }
        return handles;
    }
}

type resource PipelineLayout implements Copyable<This>(bare: give) {
    UnsafePtr handle;
    StateHold hold = StateHold.empty();   // its device's state, which its errors reach

    friend Device::createPipelineLayout[fromDevice];

    // One made elsewhere; it takes over one reference, and holds no device state.
    public unsafe ctor adopt(UnsafePtr raw) { this.handle = raw; }
    unsafe ctor fromDevice(UnsafePtr raw, UnsafePtr block) {
        this.handle = raw;
        this.hold = StateHold.make(block: block);
    }
    public unsafe ctor copy(ref PipelineLayout source) {
        this.handle = source.handle;
        pipelineLayoutAddRef(pipelineLayout: this.handle);
        this.hold = copy source.hold;
    }
    public unsafe const fn UnsafePtr raw() { return this.handle; }

    unsafe ~PipelineLayout() { if (this.handle != null) { pipelineLayoutRelease(pipelineLayout: this.handle); } }
}

// WebGPU's `GPUBufferBinding`: a buffer, and the range of it a binding sees.
type resource BufferBinding {
    Buffer target;
    uint64 start;
    uint64 bytes;   // WHOLE_SIZE: to the end of the buffer

    friend BindGroupDescriptor::raw[buffer, offset, size];
    friend BindGroupDescriptor::refusal[size];

    // The whole buffer.
    public ctor whole(Buffer buffer) {
        this.target = give buffer;
        this.start = 0;
        this.bytes = WHOLE_SIZE;
    }
    // `size` bytes from `offset`.
    public ctor range(Buffer buffer, uint64 offset, uint64 size) {
        this.target = give buffer;
        this.start = offset;
        this.bytes = size;
    }
    // From `offset` to the end of the buffer.
    public ctor rest(Buffer buffer, uint64 offset) {
        this.target = give buffer;
        this.start = offset;
        this.bytes = WHOLE_SIZE;
    }

    unsafe const fn UnsafePtr buffer() { return this.target.raw(); }
    const fn uint64 offset() { return inRange(v: this.start); }
    const fn uint64 size() { return this.bytes == WHOLE_SIZE ? WHOLE_SIZE : inRange(v: this.bytes); }
}

// What a bind group's binding holds: WebGPU's `GPUBindingResource`, exactly one of a buffer's range, a sampler or a
// texture view.
type enum BindingResource {
    Buffer(BufferBinding binding),
    Sampler(Sampler sampler),
    Texture(TextureView view),
}

// WebGPU's `GPUBindGroupDescriptor`: the layout it follows, which WebGPU requires, its entries, each a binding number
// and what it holds, and a label.
type resource BindGroupDescriptor {
    BindGroupLayout layout;
    DynamicArray<uint32> bindings;
    DynamicArray<BindingResource> resources;
    string labelled = "";

    friend Device::createBindGroup[raw, refusal, layoutHandle];

    public ctor make(BindGroupLayout layout) {
        this.layout = give layout;
        this.bindings = DynamicArray.empty();
        this.resources = DynamicArray.empty();
    }
    public fn void entry(uint32 binding, BindingResource resource) {
        this.bindings.add(item: binding);
        this.resources.add(item: give resource);
    }
    public fn void label(string text) { this.labelled = give text; }
    public const fn const ref string labelText() { return this.labelled; }

    unsafe const fn UnsafePtr layoutHandle() { return this.layout.raw(); }

    // webgpu.h's entries, their handles borrowed from this description, which must outlive the call it is handed to.
    unsafe const fn DynamicArray<WGPUBindGroupEntry> raw() {
        DynamicArray<WGPUBindGroupEntry> list = DynamicArray.empty();
        isize i = 0;
        while (i < this.resources.length()) {
            WGPUBindGroupEntry e = WGPUBindGroupEntry.zero();
            e.binding = this.bindings[i];
            match (this.resources[i]) {
                case Buffer(binding: b): {
                    e.buffer = b.buffer();
                    e.offset = b.offset();
                    e.size = b.size();
                }
                case Sampler(sampler: s): { e.sampler = s.raw(); }
                case Texture(view: v): { e.textureView = v.raw(); }
            };
            list.add(item: e);
            i = i + 1;
        }
        return list;
    }

    // Why the package refuses this description (an empty buffer binding, which wgpu-native ends the process on), or "".
    const fn string refusal() {
        isize i = 0;
        while (i < this.resources.length()) {
            uint32 n = this.bindings[i];
            bool empty = match (this.resources[i]) { case Buffer(binding: b): b.size() == 0; case _: false; };
            if (empty) {
                string name = copy this.labelled;
                return "the bind group '${name}' binds 0 bytes of a buffer at binding ${n}: WebGPU refuses an empty binding";
            }
            i = i + 1;
        }
        return "";
    }
}

type resource BindGroup implements Copyable<This>(bare: give) {
    UnsafePtr handle;
    StateHold hold = StateHold.empty();   // its device's state, which its errors reach

    friend Device::createBindGroup[fromDevice];

    // One made elsewhere; it takes over one reference, and holds no device state.
    public unsafe ctor adopt(UnsafePtr raw) { this.handle = raw; }
    unsafe ctor fromDevice(UnsafePtr raw, UnsafePtr block) {
        this.handle = raw;
        this.hold = StateHold.make(block: block);
    }
    public unsafe ctor copy(ref BindGroup source) {
        this.handle = source.handle;
        bindGroupAddRef(bindGroup: this.handle);
        this.hold = copy source.hold;
    }
    public unsafe const fn UnsafePtr raw() { return this.handle; }

    unsafe ~BindGroup() { if (this.handle != null) { bindGroupRelease(bindGroup: this.handle); } }
}

// ---- shader modules (GPU-4; AGENTS.gpu.md item 12) -------------------------------------------------------------------

// WebGPU's `GPUShaderModuleDescriptor`: the WGSL, which WebGPU requires, and a label, which the implementation's words
// name the module by.
type resource ShaderModuleDescriptor {
    string code;
    string labelled = "";

    public ctor make(string wgsl) { this.code = give wgsl; }
    public fn void label(string text) { this.labelled = give text; }
    public const fn const ref string wgsl() { return this.code; }
    public const fn const ref string labelText() { return this.labelled; }
}

// What a module's copies share beside its handle: its WGSL, against which a message's place is counted in UTF-8 bytes;
// natively the words of the error wgpu-native reported as it was made ("" for none), which wgpu-native cannot be asked
// for again; and on the web the one request for the browser's messages, made with the module. emdawnwebgpu frees a
// module's cached messages when it is asked a second time once the first has been answered, and hands the freed memory
// to the second answer (its `ReadyHook` wraps the cached pointer in an owner; measured 2026-11-12), so the package asks
// once and every `compilationInfo()` reads that answer.
type resource ShaderText {
    string source;
    string observed;
    UnsafePtr slot;   // the web's compilation request; null natively

    public unsafe ctor make(string source, string observed, UnsafePtr slot) {
        this.source = give source;
        this.observed = give observed;
        this.slot = slot;
    }
    public const fn const ref string wgsl() { return this.source; }
    public const fn const ref string seen() { return this.observed; }
    public unsafe const fn UnsafePtr asked() { return this.slot; }

    unsafe ~ShaderText() { compilationDrop(c: this.slot); }
}

type resource ShaderModule implements Copyable<This>(bare: give) {
    UnsafePtr handle;
    StateHold hold = StateHold.empty();   // its device's state, which its errors reach
    Shared<ShaderText> text;

    friend Device::createShaderModule[fromDevice];

    // One made elsewhere from `wgsl`: it takes over one reference, and holds no device state. Natively its compilation
    // info has no messages, since its maker heard its errors.
    public unsafe ctor adopt(UnsafePtr raw, string wgsl) {
        this.handle = raw;
        Shared<ShaderText> t = new ShaderText.make(source: give wgsl, observed: "", slot: askCompilation(module: raw));
        this.text = give t;
    }
    unsafe ctor fromDevice(UnsafePtr raw, UnsafePtr block, Shared<ShaderText> text) {
        this.handle = raw;
        this.hold = StateHold.make(block: block);
        this.text = give text;
    }
    public unsafe ctor copy(ref ShaderModule source) {
        this.handle = source.handle;
        shaderModuleAddRef(shaderModule: this.handle);
        this.hold = copy source.hold;
        this.text = copy source.text;
    }
    public unsafe const fn UnsafePtr raw() { return this.handle; }

    // The module's compilation messages (WebGPU's `getCompilationInfo`), polled: on the web the browser's, asked once
    // as the module was made and answered a tick or so later; natively the error wgpu-native reported as the module was
    // made, at once, since wgpu-native ends the process on `GetCompilationInfo` (tests/facts). Each is placed in UTF-8
    // bytes of the WGSL.
    public unsafe const fn CompilationRequest compilationInfo() { return CompilationRequest.make(text: copy this.text); }

    unsafe ~ShaderModule() { if (this.handle != null) { shaderModuleRelease(shaderModule: this.handle); } }
}

// A compilation message's kind (webgpu.h's `WGPUCompilationMessageType`).
type enum CompilationMessageKind { Error, Warning, Info }

fn CompilationMessageKind messageKindOf(int32 v) {
    if (v == WGPUCompilationMessageType::Warning) { return CompilationMessageKind::Warning; }
    if (v == WGPUCompilationMessageType::Info) { return CompilationMessageKind::Info; }
    return CompilationMessageKind::Error;
}

// One message (WebGPU's `GPUCompilationMessage`), placed in UTF-8 bytes of the module's WGSL, kama's unit for a string:
// `line()` and `column()` count from 1, `offset()` from 0, and `length()` is the span the message points at. A message
// with no place has all four 0.
type resource CompilationMessage {
    CompilationMessageKind messageKind;
    string words;
    isize lineAt;
    isize columnAt;
    isize offsetAt;
    isize spanLength;

    public ctor make(CompilationMessageKind kind, string message, isize line, isize column, isize offset, isize length) {
        this.messageKind = kind;
        this.words = give message;
        this.lineAt = line;
        this.columnAt = column;
        this.offsetAt = offset;
        this.spanLength = length;
    }
    public const fn CompilationMessageKind kind() { return this.messageKind; }
    public const fn string message() { return copy this.words; }
    public const fn isize line() { return this.lineAt; }
    public const fn isize column() { return this.columnAt; }
    public const fn isize offset() { return this.offsetAt; }
    public const fn isize length() { return this.spanLength; }
}

// A module's messages (WebGPU's `GPUCompilationInfo`), in the implementation's order.
type resource CompilationInfo {
    DynamicArray<CompilationMessage> list;

    public ctor make(DynamicArray<CompilationMessage> messages) { this.list = give messages; }
    public const fn const ref DynamicArray<CompilationMessage> messages() { return this.list; }
    // Whether any message is an error: the module is invalid.
    public const fn bool hasErrors() {
        foreach (const ref CompilationMessage m in this.list.iterConst()) {
            bool error = match (m.kind()) { case Error: true; case _: false; };
            if (error) { return true; }
        }
        return false;
    }
}

type enum CompilationStatus { Pending, Ready(CompilationInfo info), Failed(GpuError error) }

// A module's compilation messages on their way: every request of a module and its copies reads the one answer (above).
// A poll after Ready answers Ready again, with the same messages.
type resource CompilationRequest {
    Shared<ShaderText> text;

    friend ShaderModule::compilationInfo[make];

    unsafe ctor make(Shared<ShaderText> text) { this.text = give text; }

    public unsafe const fn CompilationStatus poll() {
        if (answeredAtCreation()) {
            return CompilationStatus::Ready(info: nativeInfo(source: this.text.wgsl(), observed: this.text.seen()));
        }
        UnsafePtr slot = this.text.asked();
        if (slot == null) {
            return CompilationStatus::Failed(error: GpuError::Refused(words: "out of memory for the request"));
        }
        int32 s = compilationPoll(c: slot);
        if (s == SEAM_PENDING) { return CompilationStatus::Pending; }
        if (s == SEAM_FAILED) {
            InlineArray<uint8>#(512) buf = [0; 512];
            int32 n = compilationMessage(c: slot, dst: addr(of: buf[0]), capacity: MESSAGE_BYTES);
            string words = textOf(buf: buf, length: n);
            return CompilationStatus::Failed(error: GpuError::Refused(words: give words));
        }
        return CompilationStatus::Ready(info: webInfo(slot: slot, source: this.text.wgsl()));
    }
}

// Natively the messages are answered from what creation kept; on the web the browser is asked.
@compileFor(ARCH_WASM32)
fn bool answeredAtCreation() { return false; }
@compileFor(!ARCH_WASM32)
fn bool answeredAtCreation() { return true; }

// The browser asked for a module's messages, once, as it is made. Natively the seam answers null without asking, since
// wgpu-native ends the process on `GetCompilationInfo` (tests/facts).
unsafe fn UnsafePtr askCompilation(UnsafePtr module) { return compilationRequest(module: module); }

// The browser's messages, each placed in UTF-8 bytes: emdawnwebgpu hands on the browser's UTF-16 offsets and lengths
// unconverted (its own TODO), so they are counted again against the WGSL.
unsafe fn CompilationInfo webInfo(UnsafePtr slot, const ref string source) {
    DynamicArray<CompilationMessage> list = DynamicArray.empty();
    int32 n = compilationCount(c: slot);
    int32 i = 0;
    while (i < n) {
        int32 type = 0;
        uint64 line = 0;
        uint64 linePos = 0;
        uint64 offset = 0;
        uint64 length = 0;
        compilationPlace(c: slot, at: i, type: addr(of: type), line: addr(of: line), linePos: addr(of: linePos),
                         offset: addr(of: offset), length: addr(of: length));
        string words = textFrom(p: compilationText(c: slot, at: i), length: compilationTextLength(c: slot, at: i));
        Place p = fromUtf16(source: source, line: line, offset: offset, length: length);
        list.add(item: CompilationMessage.make(kind: messageKindOf(v: type), message: oneLine(words: words), line: p.line,
                                               column: p.column, offset: p.offset, length: p.length));
        i = i + 1;
    }
    return CompilationInfo.make(messages: give list);
}

// Natively: the error wgpu-native reported as the module was made, as one message, or none.
fn CompilationInfo nativeInfo(const ref string source, const ref string observed) {
    DynamicArray<CompilationMessage> list = DynamicArray.empty();
    if (!observed.isEmpty()) {
        Place p = fromNaga(source: source, words: observed);
        list.add(item: CompilationMessage.make(kind: CompilationMessageKind::Error, message: oneLine(words: observed),
                                               line: p.line, column: p.column, offset: p.offset, length: p.length));
    }
    return CompilationInfo.make(messages: give list);
}

// A message's place in UTF-8 bytes of the WGSL; all 0 for none.
@generate(of)
type value Place { public isize line; public isize column; public isize offset; public isize length; }

fn Place nowhere() { return Place.of(line: 0, column: 0, offset: 0, length: 0); }

// The bytes a UTF-8 character takes, from its first byte (a stray continuation byte counts as one).
fn isize utf8Width(uint8 lead) {
    if (lead >= 0xF0) { return 4; }
    if (lead >= 0xE0) { return 3; }
    if (lead >= 0xC0) { return 2; }
    return 1;
}

// The byte offset in `source` reached by counting `units` UTF-16 code units from byte `from`: a character of four
// UTF-8 bytes is two units (a surrogate pair), any other is one. Never past the end.
fn isize afterUtf16(const ref string source, isize from, uint64 units) {
    isize i = from;
    isize n = source.length();
    uint64 counted = 0;
    while (i < n && counted < units) {
        isize width = utf8Width(lead: source[i]);
        counted = counted + (width == 4 ? 2 : 1);
        i = i + width;
    }
    return i < n ? i : n;
}

// The byte offset in `source` reached by counting `chars` characters from byte `from`. Never past the end.
fn isize afterChars(const ref string source, isize from, isize chars) {
    isize i = from;
    isize n = source.length();
    isize counted = 0;
    while (i < n && counted < chars) {
        i = i + utf8Width(lead: source[i]);
        counted = counted + 1;
    }
    return i < n ? i : n;
}

// The byte offset where the line holding byte `offset` begins.
fn isize beginningOfLine(const ref string source, isize offset) {
    isize i = offset;
    while (i > 0 && source[i - 1] != 10) { i = i - 1; }
    return i;
}

// The byte offset where line `line` (from 1) begins, or -1 when the source has fewer lines.
fn isize lineBegins(const ref string source, isize line) {
    if (line == 1) { return 0; }
    isize seen = 1;
    isize i = 0;
    isize n = source.length();
    while (i < n) {
        if (source[i] == 10) {
            seen = seen + 1;
            if (seen == line) { return i + 1; }
        }
        i = i + 1;
    }
    return -1;
}

// A browser's message placed in UTF-8 bytes. WebGPU gives its offset and length in UTF-16 code units, which
// emdawnwebgpu passes on as webgpu.h's UTF-8 fields unconverted; the column follows from the offset. A line of 0 is a
// message with no place.
fn Place fromUtf16(const ref string source, uint64 line, uint64 offset, uint64 length) {
    if (line == 0 || line > cast<uint64>(source.length()) + 1) { return nowhere(); }
    isize start = afterUtf16(source: source, from: 0, units: offset);
    isize end = afterUtf16(source: source, from: start, units: length);
    isize begins = beginningOfLine(source: source, offset: start);
    return Place.of(line: cast<isize>(line), column: start - begins + 1, offset: start, length: end - start);
}

// A number of decimal digits in `words` from byte `from`, and the byte after them.
@generate(of)
type value Digits { public isize value; public isize next; }

fn Digits digitsAt(const ref string words, isize from) {
    isize i = from;
    isize v = 0;
    isize n = words.length();
    while (i < n && words[i] >= 48 && words[i] <= 57 && v < 100000000) {
        v = v * 10 + cast<isize>(words[i] - 48);
        i = i + 1;
    }
    return Digits.of(value: v, next: i);
}

// How many characters naga's carets mark: on the first line after the place whose `│` has only spaces before it (the
// echoed source line has its number there) and whose first mark after it is `^`. 0 when none is found.
fn isize nagaCarets(const ref string words, isize from) {
    string bar = "\u{2502}";
    isize n = words.length();
    Optional<isize> nl = words.findFrom(substring: "\n", start: from);
    isize i = match (nl) { case Some(value: x): x + 1; case None: n; };
    while (i < n) {
        Optional<isize> lineEnd = words.findFrom(substring: "\n", start: i);
        isize end = match (lineEnd) { case Some(value: x): x; case None: n; };
        Optional<isize> b = words.findFrom(substring: bar, start: i);
        isize at = match (b) { case Some(value: x): x; case None: n; };
        if (at < end) {
            bool spaced = true;
            isize k = i;
            while (k < at) { if (words[k] != 32) { spaced = false; } k = k + 1; }
            k = at + bar.length();
            while (k < end && words[k] == 32) { k = k + 1; }
            if (spaced && k < end && words[k] == 94) {
                isize carets = 0;
                while (k < end && words[k] == 94) { carets = carets + 1; k = k + 1; }
                return carets;
            }
        }
        i = end + 1;
    }
    return 0;
}

// naga's error placed in UTF-8 bytes. Its words carry the place as `wgsl:<line>:<column>`, the column counted in
// characters (measured 2026-11-12: 27 after a two-byte é where the byte is the 28th, 19 after a four-byte emoji), and
// mark its span with carets under the echoed source line, one a character. No place in its words: no place.
fn Place fromNaga(const ref string source, const ref string words) {
    Optional<isize> found = words.find(substring: "wgsl:");
    isize at = match (found) { case Some(value: x): x + 5; case None: -1; };
    if (at < 0) { return nowhere(); }
    Digits line = digitsAt(words: words, from: at);
    if (line.value == 0 || line.next >= words.length() || words[line.next] != 58) { return nowhere(); }
    Digits column = digitsAt(words: words, from: line.next + 1);
    if (column.value == 0) { return nowhere(); }
    isize begins = lineBegins(source: source, line: line.value);
    if (begins < 0) { return nowhere(); }
    isize start = afterChars(source: source, from: begins, chars: column.value - 1);
    isize end = afterChars(source: source, from: start, chars: nagaCarets(words: words, from: column.next));
    return Place.of(line: line.value, column: start - begins + 1, offset: start, length: end - start);
}

// A message's words as one line, on every leg. naga's report, natively and in Firefox (whose WebGPU is wgpu's), runs over
// several lines: its `Shader …` line, which names the module and says what is wrong ("Shader 'lit' parsing error: no
// definition in scope for identifier: `nosuch`"), then the source line echoed and its carets, which the message's place
// already gives. That line is the message; with none, its first line that is not blank (Dawn's is one line already).
fn string oneLine(const ref string words) {
    isize i = 0;
    isize n = words.length();
    string firstLine = "";
    while (i < n) {
        Optional<isize> lineEnd = words.findFrom(substring: "\n", start: i);
        isize end = match (lineEnd) { case Some(value: x): x; case None: n; };
        string line = words.substring(start: i, end: end);
        string trimmed = line.trim();
        if (trimmed.startsWith(prefix: "Shader ")) { return give trimmed; }
        if (firstLine.isEmpty()) { firstLine = copy trimmed; }
        i = end + 1;
    }
    return give firstLine;
}

// ---- render pipelines (GPU-4 part 3; AGENTS.gpu.md item 12, decisions 1, 2 and 9) ------------------------------------

// How vertices make primitives (WebGPU's `GPUPrimitiveTopology`).
type enum PrimitiveTopology { PointList, LineList, LineStrip, TriangleList, TriangleStrip }
// The element of an index buffer (WebGPU's `GPUIndexFormat`).
type enum IndexFormat { Uint16, Uint32 }
// The winding that faces the viewer (WebGPU's `GPUFrontFace`): counter-clockwise or clockwise.
type enum FrontFace { CCW, CW }
// The faces left undrawn (WebGPU's `GPUCullMode`).
type enum CullMode { None, Front, Back }
// What a stencil test's outcome does to the stencil value (WebGPU's `GPUStencilOperation`).
type enum StencilOperation { Keep, Zero, Replace, Invert, IncrementClamp, DecrementClamp, IncrementWrap, DecrementWrap }
// How a blend joins the source and the destination (WebGPU's `GPUBlendOperation`).
type enum BlendOperation { Add, Subtract, ReverseSubtract, Min, Max }
// What a blend multiplies each side by (WebGPU's `GPUBlendFactor`). The four `Src1` factors need DualSourceBlending.
type enum BlendFactor {
    Zero, One, Src, OneMinusSrc, SrcAlpha, OneMinusSrcAlpha, Dst, OneMinusDst, DstAlpha, OneMinusDstAlpha,
    SrcAlphaSaturated, Constant, OneMinusConstant, Src1, OneMinusSrc1, Src1Alpha, OneMinusSrc1Alpha
}
// Whether a vertex buffer advances per vertex or per instance (WebGPU's `GPUVertexStepMode`).
type enum VertexStepMode { Vertex, Instance }

fn int32 topologyValue(PrimitiveTopology t) {
    return match (t) {
        case PointList: WGPUPrimitiveTopology::PointList;
        case LineList: WGPUPrimitiveTopology::LineList;
        case LineStrip: WGPUPrimitiveTopology::LineStrip;
        case TriangleList: WGPUPrimitiveTopology::TriangleList;
        case TriangleStrip: WGPUPrimitiveTopology::TriangleStrip;
    };
}

fn int32 indexFormatValue(IndexFormat f) {
    return match (f) { case Uint16: WGPUIndexFormat::Uint16; case Uint32: WGPUIndexFormat::Uint32; };
}

fn int32 frontFaceValue(FrontFace f) {
    return match (f) { case CCW: WGPUFrontFace::CCW; case CW: WGPUFrontFace::CW; };
}

fn int32 cullModeValue(CullMode c) {
    return match (c) { case None: WGPUCullMode::None; case Front: WGPUCullMode::Front; case Back: WGPUCullMode::Back; };
}

fn int32 stencilOperationValue(StencilOperation o) {
    return match (o) {
        case Keep: WGPUStencilOperation::Keep;
        case Zero: WGPUStencilOperation::Zero;
        case Replace: WGPUStencilOperation::Replace;
        case Invert: WGPUStencilOperation::Invert;
        case IncrementClamp: WGPUStencilOperation::IncrementClamp;
        case DecrementClamp: WGPUStencilOperation::DecrementClamp;
        case IncrementWrap: WGPUStencilOperation::IncrementWrap;
        case DecrementWrap: WGPUStencilOperation::DecrementWrap;
    };
}

fn int32 blendOperationValue(BlendOperation o) {
    return match (o) {
        case Add: WGPUBlendOperation::Add;
        case Subtract: WGPUBlendOperation::Subtract;
        case ReverseSubtract: WGPUBlendOperation::ReverseSubtract;
        case Min: WGPUBlendOperation::Min;
        case Max: WGPUBlendOperation::Max;
    };
}

fn int32 blendFactorValue(BlendFactor f) {
    return match (f) {
        case Zero: WGPUBlendFactor::Zero;
        case One: WGPUBlendFactor::One;
        case Src: WGPUBlendFactor::Src;
        case OneMinusSrc: WGPUBlendFactor::OneMinusSrc;
        case SrcAlpha: WGPUBlendFactor::SrcAlpha;
        case OneMinusSrcAlpha: WGPUBlendFactor::OneMinusSrcAlpha;
        case Dst: WGPUBlendFactor::Dst;
        case OneMinusDst: WGPUBlendFactor::OneMinusDst;
        case DstAlpha: WGPUBlendFactor::DstAlpha;
        case OneMinusDstAlpha: WGPUBlendFactor::OneMinusDstAlpha;
        case SrcAlphaSaturated: WGPUBlendFactor::SrcAlphaSaturated;
        case Constant: WGPUBlendFactor::Constant;
        case OneMinusConstant: WGPUBlendFactor::OneMinusConstant;
        case Src1: WGPUBlendFactor::Src1;
        case OneMinusSrc1: WGPUBlendFactor::OneMinusSrc1;
        case Src1Alpha: WGPUBlendFactor::Src1Alpha;
        case OneMinusSrc1Alpha: WGPUBlendFactor::OneMinusSrc1Alpha;
    };
}

fn int32 stepModeValue(VertexStepMode m) {
    return match (m) { case Vertex: WGPUVertexStepMode::Vertex; case Instance: WGPUVertexStepMode::Instance; };
}

// WebGPU's `GPUPrimitiveState`: how vertices make primitives and which faces are culled, at WebGPU's defaults (a
// triangle list, counter-clockwise front faces, nothing culled). A strip's index format is set only for a strip, and
// `unclippedDepth` needs DepthClipControl.
type value PrimitiveState {
    public PrimitiveTopology topology = PrimitiveTopology::TriangleList;
    public Optional<IndexFormat> stripIndexFormat = Optional::None;
    public FrontFace frontFace = FrontFace::CCW;
    public CullMode cullMode = CullMode::None;
    public bool unclippedDepth = false;

    public ctor make() { }
}

// WebGPU's `GPUMultisampleState`: the samples a pipeline draws, at WebGPU's defaults (one sample, every sample in the
// mask, no alpha to coverage). A mask of 0 draws nothing, silently, on both legs (measured).
type value MultisampleState {
    public uint32 count = 1;
    public uint32 mask = 0xFFFFFFFF;
    public bool alphaToCoverageEnabled = false;

    public ctor make() { }
}

// WebGPU's `GPUStencilFaceState`: one face's stencil test and what each outcome does, at WebGPU's defaults (always
// passing, keeping the value).
type value StencilFaceState {
    public CompareFunction compare = CompareFunction::Always;
    public StencilOperation failOp = StencilOperation::Keep;
    public StencilOperation depthFailOp = StencilOperation::Keep;
    public StencilOperation passOp = StencilOperation::Keep;

    public ctor make() { }
}

// WebGPU's `GPUDepthStencilState`: the depth and stencil target's format, the depth test, the stencil test and the
// depth bias. WebGPU requires the format, whether depth is written and the depth test, so `make` takes them; the rest
// start at WebGPU's defaults. A depth bias that is not a finite number, and a depth write to a format with no depth,
// are refused (decision 9): a browser throws on the first, and wgpu-native ends the process on the second.
type value DepthStencilState {
    public TextureFormat format;
    public bool depthWriteEnabled;
    public CompareFunction depthCompare;
    public StencilFaceState stencilFront = StencilFaceState.make();
    public StencilFaceState stencilBack = StencilFaceState.make();
    public uint32 stencilReadMask = 0xFFFFFFFF;
    public uint32 stencilWriteMask = 0xFFFFFFFF;
    public int32 depthBias = 0;
    public float32 depthBiasSlopeScale = 0.0;
    public float32 depthBiasClamp = 0.0;

    public ctor make(TextureFormat format, bool depthWriteEnabled, CompareFunction depthCompare) {
        this.format = format;
        this.depthWriteEnabled = depthWriteEnabled;
        this.depthCompare = depthCompare;
    }
}

// WebGPU's `GPUBlendComponent`: how one side of a blend (the colour or the alpha) joins source and destination, at
// WebGPU's defaults (the source times one, plus the destination times zero: the source as it is).
type value BlendComponent {
    public BlendOperation operation = BlendOperation::Add;
    public BlendFactor srcFactor = BlendFactor::One;
    public BlendFactor dstFactor = BlendFactor::Zero;

    public ctor make() { }
}

// WebGPU's `GPUBlendState`: the colour's blend and the alpha's, both of which WebGPU requires.
type value BlendState {
    public BlendComponent color;
    public BlendComponent alpha;

    public ctor make(BlendComponent color, BlendComponent alpha) {
        this.color = color;
        this.alpha = alpha;
    }
}

// WebGPU's `GPUColorTargetState`: a colour target's format, its blend (none by default: the source is written as it
// is), and the channels written (all by default). A format whose feature the device lacks is refused (decision 9).
type value ColorTargetState {
    public TextureFormat format;
    public Optional<BlendState> blend = Optional::None;
    public ColorWriteMask writeMask = ColorWriteMask::All;

    public ctor make(TextureFormat format) { this.format = format; }
}

// WebGPU's `GPUVertexBufferLayout`: one vertex buffer's stride in bytes, whether it advances per vertex (the default)
// or per instance, and its attributes. A stride or an offset past 2^53 - 1 is clamped (decision 9).
type resource VertexBufferLayout {
    uint64 stride;
    VertexStepMode steps = VertexStepMode::Vertex;
    DynamicArray<WGPUVertexAttribute> attributeList;

    friend LoweredPipeline::fromDescription[...];

    public ctor make(uint64 arrayStride) {
        this.stride = arrayStride;
        this.attributeList = DynamicArray.empty();
    }
    // Per vertex, the default, or per instance.
    public fn void stepMode(VertexStepMode mode) { this.steps = mode; }
    // An attribute: `format` at `offset` bytes into each element, read by the shader's `@location(shaderLocation)`.
    public fn void attribute(VertexFormat format, uint64 offset, uint32 shaderLocation) {
        WGPUVertexAttribute a = WGPUVertexAttribute.zero();
        a.format = format.value();
        a.offset = inRange(v: offset);
        a.shaderLocation = shaderLocation;
        this.attributeList.add(item: a);
    }
}

// WebGPU's `GPUVertexState`: the vertex stage's module and entry point, its pipeline constants, and the vertex buffers
// it reads, in slot order.
type resource VertexState {
    ShaderModule shader;
    string entry;
    DynamicArray<string> constantNames;
    DynamicArray<float64> constantValues;
    DynamicArray<VertexBufferLayout> bufferList;

    friend LoweredPipeline::fromDescription[...];
    friend Device::pipelineRefusal[...];
    friend Device::createRenderPipelineAsync[...];

    public ctor make(ShaderModule module, string entryPoint) {
        this.shader = give module;
        this.entry = give entryPoint;
        this.constantNames = DynamicArray.empty();
        this.constantValues = DynamicArray.empty();
        this.bufferList = DynamicArray.empty();
    }
    // The pipeline-overridable constant `name` (a WGSL `override`) set to `value`. A value that is not a finite number
    // is refused (decision 9).
    public fn void constant(string name, float64 value) {
        this.constantNames.add(item: give name);
        this.constantValues.add(item: value);
    }
    // The next vertex buffer slot's layout.
    public fn void buffer(VertexBufferLayout layout) { this.bufferList.add(item: give layout); }
}

// WebGPU's `GPUFragmentState`: the fragment stage's module and entry point, its pipeline constants, and its colour
// targets in attachment order, any of them left empty (WebGPU's `null` target).
type resource FragmentState {
    ShaderModule shader;
    string entry;
    DynamicArray<string> constantNames;
    DynamicArray<float64> constantValues;
    DynamicArray<Optional<ColorTargetState>> targetList;

    friend LoweredPipeline::fromDescription[...];
    friend Device::pipelineRefusal[...];
    friend Device::createRenderPipelineAsync[...];

    public ctor make(ShaderModule module, string entryPoint) {
        this.shader = give module;
        this.entry = give entryPoint;
        this.constantNames = DynamicArray.empty();
        this.constantValues = DynamicArray.empty();
        this.targetList = DynamicArray.empty();
    }
    // The pipeline-overridable constant `name` (a WGSL `override`) set to `value`, refused unless finite (decision 9).
    public fn void constant(string name, float64 value) {
        this.constantNames.add(item: give name);
        this.constantValues.add(item: value);
    }
    // The next colour attachment's target.
    public fn void target(ColorTargetState state) { this.targetList.add(item: Optional::Some(value: state)); }
    // The next colour attachment left empty: nothing is written there.
    public fn void emptyTarget() { this.targetList.add(item: Optional::None); }
}

// Whether a pipeline's bind group layouts are given (`Explicit`) or read from its shaders (`Auto`, WebGPU's "auto",
// whose layouts `pipeline.getBindGroupLayout(index:)` hands back).
type enum Layout { Auto, Explicit(PipelineLayout layout) }

// WebGPU's `GPURenderPipelineDescriptor` (AGENTS.gpu.md item 12, decision 1): its layout and its vertex stage, which
// WebGPU requires; how primitives are made, its depth and stencil (none by default), its samples, and its fragment
// stage (none by default, as a depth-only pass has); and a label. The value parts are changed in place:
// `d.primitiveMut().cullMode = CullMode::Back;`.
type resource RenderPipelineDescriptor {
    Layout layoutChoice;
    VertexState vertexState;
    PrimitiveState primitiveState = PrimitiveState.make();
    Optional<DepthStencilState> depthState = Optional::None;
    MultisampleState multisampleState = MultisampleState.make();
    Optional<FragmentState> fragmentState = Optional::None;
    string labelled = "";

    friend LoweredPipeline::fromDescription[...];
    friend Device::pipelineRefusal[...];
    friend Device::createRenderPipelineAsync[...];

    public ctor make(Layout layout, VertexState vertex) {
        this.layoutChoice = give layout;
        this.vertexState = give vertex;
    }
    // The fragment stage: its module, entry point, constants and colour targets.
    public fn void fragment(FragmentState state) { this.fragmentState = Optional::Some(value: give state); }
    // The depth and stencil test, and the format of the target it reads.
    public fn void depthStencil(DepthStencilState state) { this.depthState = Optional::Some(value: state); }
    public fn void label(string text) { this.labelled = give text; }
    public const fn const ref string labelText() { return this.labelled; }
    // How vertices make primitives, changed in place.
    public fn ref PrimitiveState primitiveMut() { return this.primitiveState; }
    // The samples drawn, changed in place.
    public fn ref MultisampleState multisampleMut() { return this.multisampleState; }
}

// Whether `format` has a depth aspect, which a depth write needs.
fn bool hasDepth(TextureFormat format) {
    return match (format) {
        case Depth16Unorm: true;
        case Depth24Plus: true;
        case Depth24PlusStencil8: true;
        case Depth32Float: true;
        case Depth32FloatStencil8: true;
        case _: false;
    };
}

// Whether `x` is a finite number: x - x is 0 for one, and NaN for NaN or an infinity.
fn bool finiteNumber(float64 x) {
    float64 gap = x - x;
    return gap == 0.0;
}

fn bool dualSource(BlendFactor f) {
    return match (f) {
        case Src1: true;
        case OneMinusSrc1: true;
        case Src1Alpha: true;
        case OneMinusSrc1Alpha: true;
        case _: false;
    };
}

// Whether `target` blends with one of the four `Src1` factors, which need DualSourceBlending.
fn bool blendsDual(ColorTargetState target) {
    return match (target.blend) {
        case Some(value: b): dualSource(f: b.color.srcFactor) || dualSource(f: b.color.dstFactor)
            || dualSource(f: b.alpha.srcFactor) || dualSource(f: b.alpha.dstFactor);
        case None: false;
    };
}

// Why `what` may not set these constants, or "": one that is not a finite number, which a browser throws on.
fn string constantRefusal(const ref DynamicArray<string> names, const ref DynamicArray<float64> values, const ref string what) {
    isize i = 0;
    while (i < values.length()) {
        float64 v = values[i];
        if (!finiteNumber(x: v)) {
            string n = copy names[i];
            return "${what} sets the pipeline constant '${n}' to ${v}, which is not a finite number: WebGPU refuses it";
        }
        i = i + 1;
    }
    return "";
}

fn WGPUStencilFaceState stencilFaceOf(StencilFaceState f) {
    WGPUStencilFaceState s = WGPUStencilFaceState.zero();
    s.compare = compareValue(c: f.compare);
    s.failOp = stencilOperationValue(o: f.failOp);
    s.depthFailOp = stencilOperationValue(o: f.depthFailOp);
    s.passOp = stencilOperationValue(o: f.passOp);
    return s;
}

fn WGPUDepthStencilState depthStencilOf(DepthStencilState state) {
    WGPUDepthStencilState d = WGPUDepthStencilState.zero();
    d.format = state.format.value();
    d.depthWriteEnabled = state.depthWriteEnabled ? WGPUOptionalBool::True : WGPUOptionalBool::False;
    d.depthCompare = compareValue(c: state.depthCompare);
    d.stencilFront = stencilFaceOf(f: state.stencilFront);
    d.stencilBack = stencilFaceOf(f: state.stencilBack);
    d.stencilReadMask = state.stencilReadMask;
    d.stencilWriteMask = state.stencilWriteMask;
    d.depthBias = state.depthBias;
    d.depthBiasSlopeScale = state.depthBiasSlopeScale;
    d.depthBiasClamp = state.depthBiasClamp;
    return d;
}

fn WGPUBlendComponent blendComponentOf(BlendComponent c) {
    WGPUBlendComponent b = WGPUBlendComponent.zero();
    b.operation = blendOperationValue(o: c.operation);
    b.srcFactor = blendFactorValue(f: c.srcFactor);
    b.dstFactor = blendFactorValue(f: c.dstFactor);
    return b;
}

fn WGPUConstantEntry constantOf(const ref string name, float64 value) {
    WGPUConstantEntry c = WGPUConstantEntry.zero();
    c.key = labelOf(text: name);
    c.value = value;
    return c;
}

// webgpu.h's description of a render pipeline, lowered from a `RenderPipelineDescriptor`. It holds every array its
// pointers reach, and borrows its strings from the description, so both must outlive the call it is handed to.
type resource LoweredPipeline {
    DynamicArray<DynamicArray<WGPUVertexAttribute>> attributeLists;
    DynamicArray<WGPUVertexBufferLayout> buffers;
    DynamicArray<WGPUConstantEntry> vertexConstants;
    DynamicArray<WGPUConstantEntry> fragmentConstants;
    DynamicArray<WGPUBlendState> blends;
    DynamicArray<WGPUColorTargetState> targets;
    DynamicArray<WGPUDepthStencilState> depth;     // none or one
    DynamicArray<WGPUFragmentState> fragment;      // none or one
    WGPURenderPipelineDescriptor described;

    friend Device::createRenderPipeline[pointer, substitutePointer];
    friend Device::createRenderPipelineAsync[pointer];

    public unsafe ctor fromDescription(const ref RenderPipelineDescriptor descriptor) {
        this.attributeLists = DynamicArray.empty();
        this.buffers = DynamicArray.empty();
        this.vertexConstants = DynamicArray.empty();
        this.fragmentConstants = DynamicArray.empty();
        this.blends = DynamicArray.empty();
        this.targets = DynamicArray.empty();
        this.depth = DynamicArray.empty();
        this.fragment = DynamicArray.empty();
        this.described = WGPURenderPipelineDescriptor.zero();
        this.described.label = labelOf(text: descriptor.labelled);
        match (descriptor.layoutChoice) {
            case Auto: { }
            case Explicit(layout: l): { this.described.layout = l.raw(); }
        };

        // the vertex stage: every array filled before a pointer into it is taken
        isize i = 0;
        while (i < descriptor.vertexState.bufferList.length()) {
            this.attributeLists.add(item: copy descriptor.vertexState.bufferList[i].attributeList);
            WGPUVertexBufferLayout l = WGPUVertexBufferLayout.zero();
            l.stepMode = stepModeValue(m: descriptor.vertexState.bufferList[i].steps);
            l.arrayStride = inRange(v: descriptor.vertexState.bufferList[i].stride);
            l.attributeCount = cast<usize>(descriptor.vertexState.bufferList[i].attributeList.length());
            this.buffers.add(item: l);
            i = i + 1;
        }
        i = 0;
        while (i < this.buffers.length()) {
            this.buffers[i].attributes = cast<UnsafePtr>(this.attributeLists[i].dataPtrMut());
            i = i + 1;
        }
        i = 0;
        while (i < descriptor.vertexState.constantNames.length()) {
            this.vertexConstants.add(item: constantOf(name: descriptor.vertexState.constantNames[i],
                                                      value: descriptor.vertexState.constantValues[i]));
            i = i + 1;
        }
        this.described.vertex.module = descriptor.vertexState.shader.raw();
        this.described.vertex.entryPoint = labelOf(text: descriptor.vertexState.entry);
        this.described.vertex.constantCount = cast<usize>(this.vertexConstants.length());
        this.described.vertex.constants = cast<UnsafePtr>(this.vertexConstants.dataPtrMut());
        this.described.vertex.bufferCount = cast<usize>(this.buffers.length());
        this.described.vertex.buffers = cast<UnsafePtr>(this.buffers.dataPtrMut());

        // how primitives are made, and the samples
        PrimitiveState shape = descriptor.primitiveState;
        this.described.primitive.topology = topologyValue(t: shape.topology);
        int32 strip = match (shape.stripIndexFormat) {
            case Some(value: f): indexFormatValue(f: f);
            case None: WGPUIndexFormat::Undefined;
        };
        this.described.primitive.stripIndexFormat = strip;
        this.described.primitive.frontFace = frontFaceValue(f: shape.frontFace);
        this.described.primitive.cullMode = cullModeValue(c: shape.cullMode);
        this.described.primitive.unclippedDepth = shape.unclippedDepth ? 1 : 0;
        MultisampleState samples = descriptor.multisampleState;
        this.described.multisample.count = samples.count;
        this.described.multisample.mask = samples.mask;
        this.described.multisample.alphaToCoverageEnabled = samples.alphaToCoverageEnabled ? 1 : 0;

        // depth and stencil
        match (descriptor.depthState) {
            case Some(value: s): { this.depth.add(item: depthStencilOf(state: s)); }
            case None: { }
        };
        if (this.depth.length() > 0) { this.described.depthStencil = cast<UnsafePtr>(this.depth.dataPtrMut()); }

        // the fragment stage: its targets, and their blends, filled before a pointer into either is taken
        match (descriptor.fragmentState) {
            case Some(value: f): {
                DynamicArray<isize> blendAt = DynamicArray.empty();
                isize k = 0;
                while (k < f.targetList.length()) {
                    WGPUColorTargetState c = WGPUColorTargetState.zero();
                    isize at = -1;
                    match (f.targetList[k]) {
                        case Some(value: target): {
                            c.format = target.format.value();
                            c.writeMask = target.writeMask.bits();
                            match (target.blend) {
                                case Some(value: b): {
                                    WGPUBlendState blended = WGPUBlendState.zero();
                                    blended.color = blendComponentOf(c: b.color);
                                    blended.alpha = blendComponentOf(c: b.alpha);
                                    at = this.blends.length();
                                    this.blends.add(item: blended);
                                }
                                case None: { }
                            };
                        }
                        case None: { }
                    };
                    this.targets.add(item: c);
                    blendAt.add(item: at);
                    k = k + 1;
                }
                k = 0;
                while (k < this.targets.length()) {
                    if (blendAt[k] >= 0) { this.targets[k].blend = cast<UnsafePtr>(addr(of: this.blends[blendAt[k]])); }
                    k = k + 1;
                }
                k = 0;
                while (k < f.constantNames.length()) {
                    this.fragmentConstants.add(item: constantOf(name: f.constantNames[k], value: f.constantValues[k]));
                    k = k + 1;
                }
                WGPUFragmentState fs = WGPUFragmentState.zero();
                fs.module = f.shader.raw();
                fs.entryPoint = labelOf(text: f.entry);
                fs.constantCount = cast<usize>(this.fragmentConstants.length());
                fs.constants = cast<UnsafePtr>(this.fragmentConstants.dataPtrMut());
                fs.targetCount = cast<usize>(this.targets.length());
                fs.targets = cast<UnsafePtr>(this.targets.dataPtrMut());
                this.fragment.add(item: fs);
            }
            case None: { }
        };
        if (this.fragment.length() > 0) { this.described.fragment = cast<UnsafePtr>(this.fragment.dataPtrMut()); }
    }

    // The description, for the call.
    unsafe fn UnsafePtr pointer() { return cast<UnsafePtr>(addr(of: this.described)); }

    // The same pipeline with no fragment stage, no depth, no vertex buffers and no constants, which WebGPU refuses on
    // both legs since it has no target: what a refused description is replaced by, so the pipeline handed back is
    // invalid (decision 9).
    unsafe fn UnsafePtr substitutePointer() {
        this.described.fragment = null;
        this.described.depthStencil = null;
        this.described.vertex.bufferCount = 0;
        this.described.vertex.constantCount = 0;
        return cast<UnsafePtr>(addr(of: this.described));
    }
}

type resource RenderPipeline implements Copyable<This>(bare: give) {
    UnsafePtr handle;
    StateHold hold = StateHold.empty();   // its device's state, which its errors reach

    friend Device::createRenderPipeline[fromDevice];
    friend PipelineRequest::poll[fromDevice];

    // One made elsewhere; it takes over one reference, and holds no device state.
    public unsafe ctor adopt(UnsafePtr raw) { this.handle = raw; }
    unsafe ctor fromDevice(UnsafePtr raw, UnsafePtr block) {
        this.handle = raw;
        this.hold = StateHold.make(block: block);
    }
    public unsafe ctor copy(ref RenderPipeline source) {
        this.handle = source.handle;
        renderPipelineAddRef(renderPipeline: this.handle);
        this.hold = copy source.hold;
    }
    public unsafe const fn UnsafePtr raw() { return this.handle; }

    // The layout of bind group `index` (WebGPU's `getBindGroupLayout`), read from the shaders of a pipeline made with
    // `Layout::Auto`. An index past the device's maxBindGroups is a validation error.
    public unsafe fn BindGroupLayout getBindGroupLayout(uint32 index) {
        UnsafePtr raw = renderPipelineGetBindGroupLayout(renderPipeline: this.handle, groupIndex: index);
        return BindGroupLayout.fromDevice(raw: raw, block: this.hold.raw());
    }

    unsafe ~RenderPipeline() { if (this.handle != null) { renderPipelineRelease(renderPipeline: this.handle); } }
}

// ---- render pipelines made asynchronously (GPU-4 part 3, step 4; AGENTS.gpu.md item 12, decisions 2 and 3) ----------

// The jobs a compile pool's channel holds; any more wait in the device's overflow, which a worker takes from before it
// waits on the channel again, so asking never waits and nothing is compiled on the device's thread.
comptime int32 COMPILE_CHANNEL = 256;

// Half the cores, at least one: `DeviceOptions.compileWorkers`' default.
fn int32 halfTheCores() {
    int32 n = cpuCount() / 2;
    return n < 1 ? 1 : n;
}

// One native compile, sent to a pool's isolate: the seam's job, a deep copy of a pipeline's description holding a
// reference on each handle it names. Run, it is freed; dropped unrun, its request fails.
type resource CompileJob implements Sendable {
    UnsafePtr job;

    public unsafe ctor make(UnsafePtr job) { this.job = job; }
    public unsafe const fn UnsafePtr raw() { return this.job; }
    public unsafe fn void run() {
        UnsafePtr j = this.job;
        this.job = null;
        pipelineJobRun(job: j);
    }
    // The job, given up: the device's overflow keeps it.
    public unsafe fn UnsafePtr release() {
        UnsafePtr j = this.job;
        this.job = null;
        return j;
    }

    unsafe ~CompileJob() { if (this.job != null) { pipelineJobCancel(job: this.job); } }
}

// Natively, while the tests hold the pool (tests/src/hooks.kama), a worker waits before it compiles.
unsafe fn void waitWhilePaused() {
    while (compilePaused() != 0) { sleep(d: Duration.fromMillis(ms: 1)); }
}

// The jobs waiting in the device's overflow, each run in turn.
unsafe fn void runOverflow(UnsafePtr state) {
    UnsafePtr j = compileOverflowTake(state: state);
    while (j != null) {
        waitWhilePaused();
        pipelineJobRun(job: j);
        j = compileOverflowTake(state: state);
    }
}

// A pool's isolate: the device's overflow first, then the next job from the channel, until the channel closes.
@compileFor(!ARCH_WASM32)
unsafe fn void compileLoop(Receiver<CompileJob> jobs, UnsafePtr state) {
    compileWorkerStarted();
    bool open = true;
    while (open) {
        runOverflow(state: state);
        Optional<CompileJob> next = jobs.recv();
        match (give next) {
            case Some(value: j): {
                compileReceived(state: state);
                waitWhilePaused();
                j.run();
            }
            case None: { open = false; }
        };
    }
    runOverflow(state: state);
    compileWorkerEnded();
}

// A device's compile pool, natively (decision 2): `compileWorkers` isolates, started by its first asynchronous request,
// fed through a channel and the device's overflow. Every copy of the device holds it, and so does every pending request,
// so a request is answered after the device's last copy is gone, as WebGPU's promise keeps its device. Its last holder's
// drop closes the channel and joins the isolates once they have run what is queued.
@compileFor(!ARCH_WASM32)
type resource CompilePool {
    StateHold hold;                                       // the device's state: its overflow, and its jobs' scopes
    DynamicArray<Isolate> workers;                        // declared before the sender: fields drop in reverse, so
    Optional<Sender<CompileJob>> jobs = Optional::None;   // the channel closes before the isolates are joined
    int32 size;

    public unsafe ctor make(UnsafePtr block, int32 size) {
        this.hold = StateHold.make(block: block);
        this.workers = DynamicArray.empty();
        this.size = size < 1 ? 1 : size;
    }

    // `job` to a worker, the workers started by the first; a full channel leaves it in the device's overflow.
    public unsafe fn void submit(CompileJob job) {
        if (this.jobs.isNone()) { this.start(); }
        if (compileEnqueue(state: this.hold.raw(), job: job.raw(), capacity: COMPILE_CHANNEL) == 0) {
            UnsafePtr kept = job.release();
            return;
        }
        match (this.jobs) {
            case Some(value: s): {
                Result<Unit, Undelivered<CompileJob>> sent = s.send(item: give job);
            }
            case None: { CompileJob unsent = give job; }
        };
    }

    unsafe fn void start() {
        Channel<CompileJob> ch = Channel.bounded(capacity: cast<usize>(COMPILE_CHANNEL));
        UnsafePtr block = this.hold.raw();
        int32 i = 0;
        while (i < this.size) {
            Receiver<CompileJob> r = ch.receiver();
            Isolate h = spawn compileLoop(jobs: give r, state: block);
            this.workers.add(item: give h);
            i = i + 1;
        }
        this.jobs = Optional::Some(value: ch.sender());
    }
}

// On the web the browser compiles a pipeline asynchronously itself, and no isolate is started, so the web build stays
// single-threaded.
@compileFor(ARCH_WASM32)
type resource CompilePool {
    int32 size;

    public unsafe ctor make(UnsafePtr block, int32 size) { this.size = size; }
    public unsafe fn void submit(CompileJob job) { }
}

// Why an asynchronous pipeline failed (WebGPU's `GPUPipelineErrorReason`).
type enum PipelineErrorReason { Validation, Internal }

// What a failed asynchronous pipeline's request answers (AGENTS.gpu.md item 12, decision 3, item 1): WebGPU's reason,
// its words, and each stage module's compilation messages, placed in UTF-8 bytes of its WGSL, so a program sees where
// its shader went wrong without asking again.
type resource PipelineError implements Error {
    PipelineErrorReason why;
    string words;
    CompilationInfo vertexInfo;
    CompilationInfo fragmentInfo;

    friend PipelineRequest::poll[make];

    unsafe ctor make(PipelineErrorReason why, string words, CompilationInfo vertexInfo, CompilationInfo fragmentInfo) {
        this.why = why;
        this.words = give words;
        this.vertexInfo = give vertexInfo;
        this.fragmentInfo = give fragmentInfo;
    }
    public const fn string message() { return copy this.words; }
    public const fn PipelineErrorReason reason() { return this.why; }
    // The vertex stage module's messages.
    public const fn const ref CompilationInfo vertexMessages() { return this.vertexInfo; }
    // The fragment stage module's messages: none for a pipeline with no fragment stage.
    public const fn const ref CompilationInfo fragmentMessages() { return this.fragmentInfo; }
}

type enum PipelineStatus { Pending, Ready(RenderPipeline pipeline), Failed(PipelineError error) }

// A render pipeline asked for asynchronously (`device.createRenderPipelineAsync`), polled until it settles.
type resource PipelineRequest {
    UnsafePtr slot;
    StateHold hold;                                // its device's state, for the pipeline it hands out
    CompilationRequest vertexStage;
    Optional<CompilationRequest> fragmentStage;
    Shared<CompilePool> pool;                      // natively, the isolates compiling it, held while it is pending

    friend Device::createRenderPipelineAsync[start];

    unsafe ctor start(UnsafePtr slot, UnsafePtr block, CompilationRequest vertexStage,
                      Optional<CompilationRequest> fragmentStage, Shared<CompilePool> pool) {
        this.slot = slot;
        this.hold = StateHold.make(block: block);
        this.vertexStage = give vertexStage;
        this.fragmentStage = give fragmentStage;
        this.pool = give pool;
    }

    // Pending until the pipeline is made; then Ready with it, each poll a new reference, or Failed with WebGPU's reason,
    // its words and each stage's messages. On the web a failure answers once the stages' messages are in.
    public unsafe const fn PipelineStatus poll() {
        int32 s = pipelinePoll(slot: this.slot);
        if (s == SEAM_PENDING) { return PipelineStatus::Pending; }
        if (s == SEAM_READY) {
            return PipelineStatus::Ready(pipeline: RenderPipeline.fromDevice(raw: pipelineHandle(slot: this.slot),
                                                                         block: this.hold.raw()));
        }
        CompilationStatus v = this.vertexStage.poll();
        bool vertexPending = match (v) { case Pending: true; case _: false; };
        Optional<CompilationStatus> f = match (this.fragmentStage) {
            case Some(value: r): Optional::Some(value: r.poll());
            case None: Optional::None;
        };
        bool fragmentPending = match (f) {
            case Some(value: fs): match (fs) { case Pending: true; case _: false; };
            case None: false;
        };
        if (vertexPending || fragmentPending) { return PipelineStatus::Pending; }
        PipelineErrorReason why = pipelineErrorKind(slot: this.slot) == SEAM_KIND_VALIDATION
            ? PipelineErrorReason::Validation : PipelineErrorReason::Internal;
        string words = this.slot == null ? "out of memory for the request"
            : textFrom(p: pipelineErrorMessage(slot: this.slot), length: pipelineErrorLength(slot: this.slot));
        CompilationInfo vertexInfo = infoOf(status: give v);
        CompilationInfo fragmentInfo = match (give f) {
            case Some(value: fs): infoOf(status: give fs);
            case None: CompilationInfo.make(messages: DynamicArray.empty());
        };
        return PipelineStatus::Failed(error: PipelineError.make(why: why, words: give words, vertexInfo: give vertexInfo,
                                                                fragmentInfo: give fragmentInfo));
    }

    unsafe ~PipelineRequest() { pipelineDrop(slot: this.slot); }
}

// A stage's messages, once its module answered; none when it could not answer.
fn CompilationInfo infoOf(CompilationStatus status) {
    return match (give status) {
        case Ready(info: i): give i;
        case _: CompilationInfo.make(messages: DynamicArray.empty());
    };
}

// ---- recording -------------------------------------------------------------------------------------------------------

type resource CommandEncoder implements Copyable<This>(bare: give) {
    UnsafePtr handle;
    StateHold hold = StateHold.empty();   // its device's state, which its errors reach

    friend Device::createCommandEncoder[fromDevice];

    // One made elsewhere; it takes over one reference, and holds no device state.
    public unsafe ctor adopt(UnsafePtr raw) { this.handle = raw; }
    unsafe ctor fromDevice(UnsafePtr raw, UnsafePtr block) {
        this.handle = raw;
        this.hold = StateHold.make(block: block);
    }
    public unsafe ctor copy(ref CommandEncoder source) {
        this.handle = source.handle;
        commandEncoderAddRef(commandEncoder: this.handle);
        this.hold = copy source.hold;
    }
    public unsafe const fn UnsafePtr raw() { return this.handle; }

    // A render pass into one color target, cleared to `clear` and stored. `end()` it before `finish()`.
    public unsafe fn RenderPass beginRenderPass(const ref TextureView target, Color clear) {
        WGPURenderPassColorAttachment att = WGPURenderPassColorAttachment.zero();
        att.view = target.raw();
        att.depthSlice = DEPTH_SLICE_UNDEFINED;
        att.loadOp = WGPULoadOp::Clear;
        att.storeOp = WGPUStoreOp::Store;
        att.clearValue.r = clear.r;
        att.clearValue.g = clear.g;
        att.clearValue.b = clear.b;
        att.clearValue.a = clear.a;
        WGPURenderPassDescriptor d = WGPURenderPassDescriptor.zero();
        d.colorAttachmentCount = 1;
        d.colorAttachments = cast<UnsafePtr>(addr(of: att));
        return RenderPass.fromDevice(raw: commandEncoderBeginRenderPass(commandEncoder: this.handle,
                                                                        descriptor: cast<UnsafePtr>(addr(of: d))),
                                     block: this.hold.raw());
    }

    // Copy a `width` × `height` region of `texture`'s first level into `buffer`, `bytesPerRow` apart (a multiple of 256).
    public unsafe fn void copyTextureToBuffer(const ref Texture texture, const ref Buffer buffer, uint32 width,
                                              uint32 height, uint32 bytesPerRow) {
        WGPUTexelCopyTextureInfo src = WGPUTexelCopyTextureInfo.zero();
        src.texture = texture.raw();
        src.aspect = WGPUTextureAspect::All;
        WGPUTexelCopyBufferInfo dst = WGPUTexelCopyBufferInfo.zero();
        dst.buffer = buffer.raw();
        dst.layout.bytesPerRow = bytesPerRow;
        dst.layout.rowsPerImage = height;
        WGPUExtent3D ext = WGPUExtent3D.zero();
        ext.width = width;
        ext.height = height;
        ext.depthOrArrayLayers = 1;
        commandEncoderCopyTextureToBuffer(commandEncoder: this.handle, source: cast<UnsafePtr>(addr(of: src)),
                                          destination: cast<UnsafePtr>(addr(of: dst)),
                                          copySize: cast<UnsafePtr>(addr(of: ext)));
    }

    // The recorded commands; the encoder is spent. An error the recording made is reported here, to the device's
    // channel or the innermost scope that catches it, and natively such a command buffer is then never submitted.
    public unsafe give fn CommandBuffer finish() {
        int32 failed = 0;
        UnsafePtr commands = encoderFinish(encoder: this.handle, state: this.hold.raw(), failed: addr(of: failed));
        return CommandBuffer.fromDevice(raw: commands, block: this.hold.raw(), spoiled: failed != 0);
    }

    unsafe ~CommandEncoder() { if (this.handle != null) { commandEncoderRelease(commandEncoder: this.handle); } }
}

type resource RenderPass implements Copyable<This>(bare: give) {
    UnsafePtr handle;
    StateHold hold = StateHold.empty();   // its device's state, which its errors reach

    friend CommandEncoder::beginRenderPass[fromDevice];

    // One made elsewhere; it takes over one reference, and holds no device state.
    public unsafe ctor adopt(UnsafePtr raw) { this.handle = raw; }
    unsafe ctor fromDevice(UnsafePtr raw, UnsafePtr block) {
        this.handle = raw;
        this.hold = StateHold.make(block: block);
    }
    public unsafe ctor copy(ref RenderPass source) {
        this.handle = source.handle;
        renderPassEncoderAddRef(renderPassEncoder: this.handle);
        this.hold = copy source.hold;
    }
    public unsafe const fn UnsafePtr raw() { return this.handle; }

    // Draw with `pipeline` from here on (WebGPU's `setPipeline`).
    public unsafe fn void setPipeline(const ref RenderPipeline pipeline) {
        renderPassEncoderSetPipeline(renderPassEncoder: this.handle, pipeline: pipeline.raw());
    }

    // Draw `vertexCount` vertices of each of `instanceCount` instances, from `firstVertex` and `firstInstance` (WebGPU's
    // `draw`).
    public unsafe fn void draw(uint32 vertexCount, uint32 instanceCount, uint32 firstVertex, uint32 firstInstance) {
        renderPassEncoderDraw(renderPassEncoder: this.handle, vertexCount: vertexCount, instanceCount: instanceCount,
                              firstVertex: firstVertex, firstInstance: firstInstance);
    }

    // The pass is over; it is spent.
    public unsafe give fn void end() { renderPassEncoderEnd(renderPassEncoder: this.handle); }

    unsafe ~RenderPass() { if (this.handle != null) { renderPassEncoderRelease(renderPassEncoder: this.handle); } }
}

type resource CommandBuffer implements Copyable<This>(bare: give) {
    UnsafePtr handle;
    StateHold hold = StateHold.empty();   // its device's state, which its errors reach
    bool marked = false;                  // natively, its finish reported an error: never submitted

    friend CommandEncoder::finish[fromDevice];
    friend Queue::submit[spoiled];

    // One made elsewhere; it takes over one reference, and holds no device state.
    public unsafe ctor adopt(UnsafePtr raw) { this.handle = raw; }
    unsafe ctor fromDevice(UnsafePtr raw, UnsafePtr block, bool spoiled) {
        this.handle = raw;
        this.hold = StateHold.make(block: block);
        this.marked = spoiled;
    }
    const fn bool spoiled() { return this.marked; }
    public unsafe ctor copy(ref CommandBuffer source) {
        this.handle = source.handle;
        commandBufferAddRef(commandBuffer: this.handle);
        this.hold = copy source.hold;
        this.marked = source.marked;
    }
    public unsafe const fn UnsafePtr raw() { return this.handle; }

    unsafe ~CommandBuffer() { if (this.handle != null) { commandBufferRelease(commandBuffer: this.handle); } }
}

// ---- presenting to a window ------------------------------------------------------------------------------------------

// Why an acquire gave no texture. Occluded: the window is hidden or minimised; natively the acquire slept 32 ms first,
// so a loop that skips the frame does not spin. Outdated or Lost: configure again (at the window's new size). Timeout:
// try the next frame. Failed: anything else webgpu.h reports. Closed: the window's `Window` was dropped, so the surface
// never reaches it again: drop the surface. NotConfigured: no configure has succeeded on the surface, a programming
// error: configure it first. Closed and NotConfigured are the package's own; webgpu.h has no such status. (The design's
// OutOfMemory is not here: neither leg's webgpu.h reports it any more.)
type enum SurfaceError implements Error {
    Occluded, Outdated, Lost, Timeout, Failed, Closed, NotConfigured;

    public const fn string message() {
        return match (this) {
            case Occluded: "the window is occluded";
            case Outdated: "the surface is out of date: configure it again";
            case Lost: "the surface was lost: configure it again";
            case Timeout: "no texture came in time";
            case Failed: "the surface failed";
            case Closed: "the window is closed: drop the surface";
            case NotConfigured: "the surface is not configured: configure it first";
        };
    }
}

// When a surface's frames reach the screen (webgpu.h's `WGPUPresentMode`). Fifo waits for the display's refresh, never
// tears, and every surface offers it; FifoRelaxed shows a late frame at once, and may tear; Immediate never waits, and
// may tear; Mailbox never tears and never waits, the newest frame winning. The web offers Fifo only.
type enum PresentMode {
    Fifo, FifoRelaxed, Immediate, Mailbox;

    public const fn string name() {
        return match (this) {
            case Fifo: "Fifo";
            case FifoRelaxed: "FifoRelaxed";
            case Immediate: "Immediate";
            case Mailbox: "Mailbox";
        };
    }
}

fn int32 presentValue(PresentMode m) {
    return match (m) {
        case Fifo: WGPUPresentMode::Fifo;
        case FifoRelaxed: WGPUPresentMode::FifoRelaxed;
        case Immediate: WGPUPresentMode::Immediate;
        case Mailbox: WGPUPresentMode::Mailbox;
    };
}

fn Optional<PresentMode> presentModeOf(int32 v) {
    if (v == WGPUPresentMode::Fifo) { return Optional::Some(value: PresentMode::Fifo); }
    if (v == WGPUPresentMode::FifoRelaxed) { return Optional::Some(value: PresentMode::FifoRelaxed); }
    if (v == WGPUPresentMode::Immediate) { return Optional::Some(value: PresentMode::Immediate); }
    if (v == WGPUPresentMode::Mailbox) { return Optional::Some(value: PresentMode::Mailbox); }
    return Optional::None;
}

// How a surface's alpha is composited (webgpu.h's `WGPUCompositeAlphaMode`). Its `Auto` is left out, since webgpu.h
// gives it two meanings ("an alias for the first element" of a surface's alpha modes, and "Inherit in native, Opaque in
// Wasm"); `preferred()` names the surface's first instead.
type enum AlphaMode {
    Opaque, Premultiplied, Unpremultiplied, Inherit;

    public const fn string name() {
        return match (this) {
            case Opaque: "Opaque";
            case Premultiplied: "Premultiplied";
            case Unpremultiplied: "Unpremultiplied";
            case Inherit: "Inherit";
        };
    }
}

fn int32 alphaValue(AlphaMode m) {
    return match (m) {
        case Opaque: WGPUCompositeAlphaMode::Opaque;
        case Premultiplied: WGPUCompositeAlphaMode::Premultiplied;
        case Unpremultiplied: WGPUCompositeAlphaMode::Unpremultiplied;
        case Inherit: WGPUCompositeAlphaMode::Inherit;
    };
}

fn Optional<AlphaMode> alphaModeOf(int32 v) {
    if (v == WGPUCompositeAlphaMode::Opaque) { return Optional::Some(value: AlphaMode::Opaque); }
    if (v == WGPUCompositeAlphaMode::Premultiplied) { return Optional::Some(value: AlphaMode::Premultiplied); }
    if (v == WGPUCompositeAlphaMode::Unpremultiplied) { return Optional::Some(value: AlphaMode::Unpremultiplied); }
    if (v == WGPUCompositeAlphaMode::Inherit) { return Optional::Some(value: AlphaMode::Inherit); }
    return Optional::None;
}

// Why a surface was not configured. The package checks a configuration before WebGPU sees it, because wgpu-native
// aborts the process on one it refuses (measured 2026-11-10, for each of these).
type enum ConfigureError implements Error {
    NoArea,                    // a width or height of 0, as a minimised window has: configure again when it has an area
    TooLarge(uint32 most),     // wider or taller than the device's maxTextureDimension2D, `most`, which DeviceOptions raise
    NotOffered(string words),  // a choice the surface does not offer, named
    Closed,                    // the window is closed, and nothing reaches it again: drop the surface
    NoWindow;                  // an adopted surface has no window to size it: its maker configures it

    public const fn string message() {
        return match (this) {
            case NoArea: "the window has no area: configure again when it has one";
            case TooLarge(most: m): "larger than the device allows: ${m} texels on a side at most";
            case NotOffered(words: w): copy w;
            case Closed: "the window is closed: drop the surface";
            case NoWindow: "an adopted surface has no window to take its size from: its maker configures it";
        };
    }
}

fn string joined(const ref string acc, const ref string next) {
    if (acc.isEmpty()) { return copy next; }
    return "${acc}, ${next}";
}

// A texture's usages by name.
fn string usageNames(TextureUsage usage) {
    string acc = "";
    if (usage.has(flags: TextureUsage::RenderAttachment)) { acc = joined(acc: acc, next: "RenderAttachment"); }
    if (usage.has(flags: TextureUsage::TextureBinding)) { acc = joined(acc: acc, next: "TextureBinding"); }
    if (usage.has(flags: TextureUsage::StorageBinding)) { acc = joined(acc: acc, next: "StorageBinding"); }
    if (usage.has(flags: TextureUsage::CopySrc)) { acc = joined(acc: acc, next: "CopySrc"); }
    if (usage.has(flags: TextureUsage::CopyDst)) { acc = joined(acc: acc, next: "CopyDst"); }
    if (acc.isEmpty()) { return "none"; }
    return acc;
}

// How a surface is configured. Made by `SurfaceCapabilities.preferred()`, and a program may change a field;
// `Surface.configure` checks it against what the surface offers before WebGPU sees it.
type value SurfaceConfig {
    public TextureFormat format;       // the format of the surface's textures
    public TextureFormat viewFormat;   // the format frames are drawn through: `format`, or its sRGB or linear form
    public PresentMode present;
    public AlphaMode alpha;
    public TextureUsage usage;         // what the surface's textures are used for

    friend SurfaceCapabilities::preferred[make];

    ctor make(TextureFormat format, TextureFormat viewFormat, PresentMode present, AlphaMode alpha, TextureUsage usage) {
        this.format = format;
        this.viewFormat = viewFormat;
        this.present = present;
        this.alpha = alpha;
        this.usage = usage;
    }
}

// What a surface offers an adapter (webgpu.h's `WGPUSurfaceCapabilities`): its formats in its own order, which is its
// preference, its present modes and alpha modes, and the usages its textures may have. A format the package does not
// name (an implementation's own extension) is left out, never guessed. Each holds a format, Fifo, an alpha mode and
// RenderAttachment, as webgpu.h promises; an answer without one is refused.
type resource SurfaceCapabilities {
    DynamicArray<TextureFormat> formatList;
    DynamicArray<PresentMode> presentList;
    DynamicArray<AlphaMode> alphaList;
    TextureUsage usageSet;

    friend Surface::configure[refuses];

    // Capabilities from lists: what `Surface.capabilities` reads, and what a test hands in for a surface it cannot open
    // (the web's, natively). Safe to hand in anything, since `configure` checks against the surface's own answer.
    public ctor Result<SurfaceCapabilities, GpuError> make(DynamicArray<TextureFormat> formats,
                                                        DynamicArray<PresentMode> presentModes,
                                                        DynamicArray<AlphaMode> alphaModes, TextureUsage usages) {
        if (formats.length() == 0) { return Result::Err(error: GpuError::Refused(words: "the surface offers no format")); }
        bool fifo = false;
        isize i = 0;
        while (i < presentModes.length()) { if (presentModes[i] == PresentMode::Fifo) { fifo = true; } i = i + 1; }
        if (!fifo) {
            return Result::Err(error: GpuError::Refused(words: "the surface does not offer Fifo, which webgpu.h promises"));
        }
        if (alphaModes.length() == 0) { return Result::Err(error: GpuError::Refused(words: "the surface offers no alpha mode")); }
        if (!usages.has(flags: TextureUsage::RenderAttachment)) {
            return Result::Err(error: GpuError::Refused(words: "the surface does not offer RenderAttachment, which webgpu.h promises"));
        }
        return Result::Ok(value: SurfaceCapabilities.of(formats: give formats, presentModes: give presentModes,
                                                        alphaModes: give alphaModes, usages: usages));
    }
    ctor of(DynamicArray<TextureFormat> formats, DynamicArray<PresentMode> presentModes, DynamicArray<AlphaMode> alphaModes,
            TextureUsage usages) {
        this.formatList = give formats;
        this.presentList = give presentModes;
        this.alphaList = give alphaModes;
        this.usageSet = usages;
    }

    public const fn const ref DynamicArray<TextureFormat> formats() { return this.formatList; }
    public const fn const ref DynamicArray<PresentMode> presentModes() { return this.presentList; }
    public const fn const ref DynamicArray<AlphaMode> alphaModes() { return this.alphaList; }
    public const fn TextureUsage usages() { return this.usageSet; }

    // Where to start: the first format, drawn through its sRGB form when it has one (itself when it is one); Fifo; the
    // first alpha mode; RenderAttachment.
    public const fn SurfaceConfig preferred() {
        TextureFormat f = this.formatList[0];
        Optional<TextureFormat> s = f.srgb();
        TextureFormat view = match (s) { case Some(value: v): v; case None: f; };
        return SurfaceConfig.make(format: f, viewFormat: view, present: PresentMode::Fifo, alpha: this.alphaList[0],
                                  usage: TextureUsage::RenderAttachment);
    }

    // Why the surface would refuse `config`, or "" when it offers everything `config` asks for.
    const fn string refuses(const ref SurfaceConfig config) {
        string formatName = config.format.name();
        bool formatOffered = false;
        string formats = "";
        isize i = 0;
        while (i < this.formatList.length()) {
            if (this.formatList[i] == config.format) { formatOffered = true; }
            string n = this.formatList[i].name();
            formats = joined(acc: formats, next: n);
            i = i + 1;
        }
        if (!formatOffered) { return "the surface does not offer format ${formatName}; it offers ${formats}"; }
        if (config.viewFormat.linear() != config.format.linear()) {
            string viewName = config.viewFormat.name();
            return "view format ${viewName} is not ${formatName} or its sRGB or linear form: a view may change only sRGB-ness";
        }
        bool presentOffered = false;
        string presents = "";
        i = 0;
        while (i < this.presentList.length()) {
            if (this.presentList[i] == config.present) { presentOffered = true; }
            string n = this.presentList[i].name();
            presents = joined(acc: presents, next: n);
            i = i + 1;
        }
        if (!presentOffered) {
            string p = config.present.name();
            return "the surface does not offer present mode ${p}; it offers ${presents}";
        }
        bool alphaOffered = false;
        string alphas = "";
        i = 0;
        while (i < this.alphaList.length()) {
            if (this.alphaList[i] == config.alpha) { alphaOffered = true; }
            string n = this.alphaList[i].name();
            alphas = joined(acc: alphas, next: n);
            i = i + 1;
        }
        if (!alphaOffered) {
            string a = config.alpha.name();
            return "the surface does not offer alpha mode ${a}; it offers ${alphas}";
        }
        if (!this.usageSet.has(flags: config.usage)) {
            string asked = usageNames(usage: config.usage);
            string offered = usageNames(usage: this.usageSet);
            return "the surface does not offer usage ${asked}; it offers ${offered}";
        }
        return "";
    }
}

// The size a configure hands WebGPU. On the web, 0: emdawnwebgpu writes a non-zero size into the canvas's pixels, which
// are the window's to set (@kama/window's WIN-3, decision 6), and a canvas's texture is the canvas's size in any case
// (measured 2026-11-11, AGENTS.gpu.md item 10). Natively, the window's size.
@compileFor(ARCH_WASM32)
fn uint32 handedOver(uint32 pixels) { return 0; }
@compileFor(!ARCH_WASM32)
fn uint32 handedOver(uint32 pixels) { return pixels; }

// emdawnwebgpu (Dawn v20260423) never sets a surface's usages, so on the web the package answers what a WebGPU canvas
// accepts for every format it offers. Once Dawn answers for itself, its answer stands.
@compileFor(ARCH_WASM32)
fn uint64 answeredUsages(uint64 got) {
    if (got != 0) { return got; }
    TextureUsage canvas = TextureUsage::RenderAttachment | TextureUsage::TextureBinding | TextureUsage::CopySrc
                          | TextureUsage::CopyDst;
    return canvas.bits();
}
@compileFor(!ARCH_WASM32)
fn uint64 answeredUsages(uint64 got) { return got; }

// What `surface` offers `adapter`, read out of C and freed there at once. A format the browser refused for a canvas
// (Firefox 160's RGBA16Float, GPU-14) is not offered: the seam learns which, once the page's first device is granted.
unsafe fn Result<SurfaceCapabilities, GpuError> capabilitiesOf(UnsafePtr surface, UnsafePtr adapter) {
    if (adapter == null) { return Result::Err(error: GpuError::Refused(words: "no adapter to ask what the surface offers")); }
    WGPUSurfaceCapabilities raw = WGPUSurfaceCapabilities.zero();
    int32 status = surfaceGetCapabilities(surface: surface, adapter: adapter, capabilities: cast<UnsafePtr>(addr(of: raw)));
    if (status != WGPUStatus::Success) {
        return Result::Err(error: GpuError::Refused(words: "the adapter cannot present to this surface"));
    }
    DynamicArray<TextureFormat> formats = DynamicArray.empty();
    UnsafePtr<int32> fs = cast<UnsafePtr<int32>>(raw.formats);
    isize i = 0;
    while (i < cast<isize>(raw.formatCount)) {
        Optional<TextureFormat> f = TextureFormat::fromValue(value: fs[i]);
        bool taken = surfaceFormatTaken(format: fs[i]) != 0;
        match (f) { case Some(value: x): { if (taken) { formats.add(item: x); } } case None: { } };
        i = i + 1;
    }
    DynamicArray<PresentMode> presents = DynamicArray.empty();
    UnsafePtr<int32> ps = cast<UnsafePtr<int32>>(raw.presentModes);
    i = 0;
    while (i < cast<isize>(raw.presentModeCount)) {
        Optional<PresentMode> p = presentModeOf(v: ps[i]);
        match (p) { case Some(value: x): { presents.add(item: x); } case None: { } };
        i = i + 1;
    }
    DynamicArray<AlphaMode> alphas = DynamicArray.empty();
    UnsafePtr<int32> als = cast<UnsafePtr<int32>>(raw.alphaModes);
    i = 0;
    while (i < cast<isize>(raw.alphaModeCount)) {
        Optional<AlphaMode> a = alphaModeOf(v: als[i]);
        match (a) { case Some(value: x): { alphas.add(item: x); } case None: { } };
        i = i + 1;
    }
    TextureUsage usages = TextureUsage.fromBits(bits: answeredUsages(got: raw.usages));
    surfaceCapabilitiesFreeMembers(surfaceCapabilities: raw);
    return SurfaceCapabilities.make(formats: give formats, presentModes: give presents, alphaModes: give alphas, usages: usages);
}

// What every copy of a surface shares: the native surface, released with the last copy, the window it presents to, held
// so its system window outlives the surface, whether a configure has reached it, and the view format it was last
// configured to be drawn through, so a copy made before a configure draws as the configure asked.
type resource SurfaceState {
    UnsafePtr handle;
    // A configure has reached WebGPU. An adopted surface is taken as configured: its maker vouches for it, as for its
    // window, since webgpu.h cannot be asked.
    bool hasConfig = false;
    int32 view = 0;   // WebGPU's number for the view format; Undefined (0) before a configure, which is the texture's own
    StateHold hold = StateHold.empty();   // the state of the device it was last configured with, which its frames hold
    // The window, held (@kama/window's WIN-1); an adopted surface holds an adopted handle, which is always open.
    NativeWindow onWindow = NativeWindow.adopt(kind: NativeKind::None, display: null, window: null);
    bool adopted = false;   // made elsewhere: no window here to size it

    public unsafe ctor adopt(UnsafePtr raw) { this.handle = raw; this.hasConfig = true; this.adopted = true; }
    public unsafe ctor fromWindow(UnsafePtr raw, NativeWindow window) {
        this.handle = raw;
        this.onWindow = give window;
    }
    public unsafe const fn UnsafePtr raw() { return this.handle; }
    // False once the window's `Window` is dropped: nothing reaches the window after that.
    public unsafe const fn bool windowOpen() { return this.onWindow.isOpen(); }
    public const fn bool isAdopted() { return this.adopted; }
    // The window's size in pixels, as of its last `pump()` (@kama/window's WIN-20).
    public unsafe const fn Size windowSize() { return this.onWindow.framebufferSize(); }
    // Another hold on the window, for a frame or adapter options that hold the native surface too.
    public unsafe const fn NativeWindow heldWindow() { return copy this.onWindow; }
    public const fn bool isConfigured() { return this.hasConfig; }
    public const fn int32 viewFormat() { return this.view; }
    public unsafe const fn UnsafePtr deviceState() { return this.hold.raw(); }
    public unsafe fn void configured(int32 view, UnsafePtr block) {
        this.hasConfig = true;
        this.view = view;
        this.hold = StateHold.make(block: block);
    }

    unsafe ~SurfaceState() { if (this.handle != null) { surfaceRelease(surface: this.handle); } }
}

// A surface on a window, which WebGPU presents into. It holds the window, so the two drop in either order: once the
// window's `Window` is dropped the window is closed, and the surface refuses everything that would reach it (Closed).
// A copy shares the surface, its window and how it was configured.
type resource Surface implements Copyable<This>(bare: give) {
    Shared<SurfaceState> state;

    friend AdapterOptions::withSurface[heldWindow];

    public unsafe ctor Result<Surface, GpuError> make(const ref Instance instance, const ref Window window) {
        NativeWindow n = window.nativeHandle();
        int32 kind = match (n.kind()) {
            case None: 0;
            case Win32: 1;
            case X11: 2;
            case Wayland: 3;
            case Cocoa: 4;
            case Canvas: 5;
        };
        UnsafePtr h = createSurface(instance: instance.raw(), kind: kind, display: n.display(), window: n.window());
        if (h == null) {
            // On the web the seam asks the canvas first, so a NULL there is a canvas the browser gives no WebGPU
            // context: a browser without WebGPU, or a canvas holding another kind of context.
            string words = kind == 5 ? "the browser gives this canvas no WebGPU context" : "no surface for this window on this system";
            return Result::Err(error: GpuError::Refused(words: give words));
        }
        return Result::Ok(value: Surface.fromWindow(raw: h, window: give n));
    }
    unsafe ctor fromWindow(UnsafePtr raw, NativeWindow window) {
        Shared<SurfaceState> s = new SurfaceState.fromWindow(raw: raw, window: give window);
        this.state = give s;
    }
    // A surface made elsewhere: its maker keeps the window alive while this lives, and it is taken as configured, by its
    // maker or by a `configure` here.
    public unsafe ctor adopt(UnsafePtr raw) {
        Shared<SurfaceState> s = new SurfaceState.adopt(raw: raw);
        this.state = give s;
    }
    public unsafe ctor copy(ref Surface source) { this.state = copy source.state; }
    public unsafe const fn UnsafePtr raw() { return this.state.raw(); }
    unsafe const fn NativeWindow heldWindow() { return this.state.heldWindow(); }

    // What the surface offers `adapter`: its formats, present modes, alpha modes and usages. Refused once the window
    // is closed.
    public unsafe const fn Result<SurfaceCapabilities, GpuError> capabilities(const ref Adapter adapter) {
        if (!this.state.windowOpen()) { return Result::Err(error: GpuError::Refused(words: "the window is closed")); }
        return capabilitiesOf(surface: this.raw(), adapter: adapter.raw());
    }

    // Draw into it with `device`, as `config` says, at the window's size in pixels as of its last `pump()`: the window
    // is the one writer of its size (AGENTS.gpu.md item 10, decision 2), as a WebGPU canvas's `configure()` takes none.
    // Configure again when an acquire says Outdated or Lost, or the window is resized. Everything is checked against
    // what the surface offers the device's adapter before WebGPU sees it, and refused in a ConfigureError: NoArea while
    // the window has none (minimised), Closed once the window is closed, which the surface never reaches again, and
    // NoWindow for an adopted surface, which its maker configures.
    public unsafe fn Result<Unit, ConfigureError> configure(const ref Device device, const ref SurfaceConfig config) {
        if (this.state.isAdopted()) { return Result::Err(error: ConfigureError::NoWindow); }
        if (!this.state.windowOpen()) { return Result::Err(error: ConfigureError::Closed); }
        Size px = this.state.windowSize();
        if (px.width <= 0 || px.height <= 0) { return Result::Err(error: ConfigureError::NoArea); }
        uint32 width = cast<uint32>(px.width);
        uint32 height = cast<uint32>(px.height);
        Limits limits = device.limits();
        uint32 most = limits.maxTextureDimension2D;
        if (width > most || height > most) { return Result::Err(error: ConfigureError::TooLarge(most: most)); }
        Result<SurfaceCapabilities, GpuError> asked = capabilitiesOf(surface: this.raw(), adapter: device.adapterHandle());
        SurfaceCapabilities caps = match (give asked) {
            case Ok(value: c): give c;
            case Err(error: e): { string why = e.message(); return Result::Err(error: ConfigureError::NotOffered(words: give why)); }
        };
        string refusal = caps.refuses(config: config);
        if (!refusal.isEmpty()) { return Result::Err(error: ConfigureError::NotOffered(words: give refusal)); }
        WGPUSurfaceConfiguration c = WGPUSurfaceConfiguration.zero();
        c.device = device.raw();
        c.format = config.format.value();
        c.usage = config.usage.bits();
        c.width = handedOver(pixels: width);
        c.height = handedOver(pixels: height);
        InlineArray<int32>#(1) views = [0; 1];
        views[0] = config.viewFormat.value();
        if (config.viewFormat != config.format) {
            c.viewFormatCount = 1;
            c.viewFormats = cast<UnsafePtr>(addr(of: views[0]));
        }
        c.alphaMode = alphaValue(m: config.alpha);
        c.presentMode = presentValue(m: config.present);
        // A browser may refuse by throwing (GPU-14), which the seam catches: the program hears it, and the surface keeps
        // whatever configure it had.
        InlineArray<uint8>#(512) said = [0; 512];
        int32 n = configureSurface(surface: this.raw(), config: cast<UnsafePtr>(addr(of: c)), words: addr(of: said[0]),
                                   capacity: MESSAGE_BYTES);
        if (n >= 0) {
            string words = textOf(buf: said, length: n);
            return Result::Err(error: ConfigureError::NotOffered(words: give words));
        }
        this.state.configured(view: config.viewFormat.value(), block: device.stateBlock());
        return Result::Ok(value: Unit::Unit);
    }

    // The next texture to draw into, or why there is none. Two are answered without asking WebGPU: Closed once the
    // window is closed, since WebGPU would hand out frames for the hidden window that go nowhere, and NotConfigured
    // before a configure has succeeded, since wgpu-native ends the process on that acquire.
    public unsafe fn Result<SurfaceTexture, SurfaceError> acquire() {
        if (!this.state.windowOpen()) { return Result::Err(error: SurfaceError::Closed); }
        if (!this.state.isConfigured()) { return Result::Err(error: SurfaceError::NotConfigured); }
        UnsafePtr texture = null;
        int32 suboptimal = 0;
        UnsafePtr h = this.raw();
        int32 s = acquireSurface(surface: h, texture: addr(of: texture), suboptimal: addr(of: suboptimal));
        if (s == SURFACE_OK) {
            return Result::Ok(value: SurfaceTexture.make(texture: texture, surface: h, suboptimal: suboptimal != 0,
                                                         view: this.state.viewFormat(), block: this.state.deviceState(),
                                                         window: this.state.heldWindow()));
        }
        if (s == SURFACE_OCCLUDED) { return Result::Err(error: SurfaceError::Occluded); }
        if (s == SURFACE_OUTDATED) { return Result::Err(error: SurfaceError::Outdated); }
        if (s == SURFACE_LOST) { return Result::Err(error: SurfaceError::Lost); }
        if (s == SURFACE_TIMEOUT) { return Result::Err(error: SurfaceError::Timeout); }
        return Result::Err(error: SurfaceError::Failed);
    }
}

// One frame's texture. `present()` shows it and spends it; a frame dropped without presenting is skipped, and so is one
// whose window has closed since the acquire.
type resource SurfaceTexture {
    UnsafePtr image;     // the frame's texture, on which it holds the reference the acquire gave
    UnsafePtr surface;   // a reference held while the frame lives, for its present
    bool late;
    int32 viewAs;        // the view format the surface was configured with, or Undefined (0): the texture's own
    StateHold hold = StateHold.empty();   // the state of the device the surface was configured with
    NativeWindow onWindow;                // the surface's window, held while the frame holds the surface

    friend Surface::acquire[make];

    unsafe ctor make(UnsafePtr texture, UnsafePtr surface, bool suboptimal, int32 view, UnsafePtr block, NativeWindow window) {
        this.image = texture;
        this.surface = surface;
        this.late = suboptimal;
        this.viewAs = view;
        surfaceAddRef(surface: surface);
        this.hold = StateHold.make(block: block);
        this.onWindow = give window;
    }

    // The surface still works but no longer matches the window: configure it again soon.
    public const fn bool suboptimal() { return this.late; }

    // A view to render into, in the view format the surface was configured with: sRGB-encoding by default.
    public unsafe fn TextureView view() {
        return TextureView.fromDevice(raw: textureViewIn(texture: this.image, format: this.viewAs), block: this.hold.raw());
    }

    // The frame's texture itself, to copy from when the configured usage allows it.
    public unsafe fn Texture texture() {
        textureAddRef(texture: this.image);
        return Texture.fromDevice(raw: this.image, block: this.hold.raw());
    }

    // Show the frame; it is spent, and its texture released after the present. Once the window is closed it is dropped
    // instead, never presented: nothing reaches a closed window.
    public unsafe give fn void present() {
        if (this.onWindow.isOpen()) { presentSurface(surface: this.surface); }
    }

    unsafe ~SurfaceTexture() {
        if (this.image != null) { textureRelease(texture: this.image); }
        surfaceRelease(surface: this.surface);
    }
}
