// @kama/gpu: the safe WebGPU binding. The design is kama's (ROADMAP_DETAIL.md § 8, s8-gpu-wrapper, KR-25):
//
// - One `type resource` per WebGPU handle. Each owns one reference and releases it in its destructor, so no caller
//   writes a `wgpu*Release`. A copy is another reference (`AddRef`), webgpu.h's own model; a bare hand-off moves.
//   Handles are independent: releasing a device turns its children invalid, which WebGPU defines, rather than
//   dangling.
// - The once-in-order steps are moves: `encoder.finish()` consumes the encoder, `pass.end()` the pass, and
//   `queue.submit(commands:)` the command buffer.
// - The asynchronous steps are polled, never called back into kama. WebGPU's own two steps: `instance.requestAdapter(…)`
//   gives an `AdapterRequest` whose `poll()` says Pending, Ready (with the adapter) or Failed, and
//   `adapter.requestDevice(…)` a `DeviceRequest` the same way (with the device and its queue); `buffer.mapRead(…)` gives
//   a `BufferRead` the same way. Natively `device.poll(wait:)` drives them; on the web the browser's event loop does,
//   between frames.
// - A device gets WebGPU's default limits and no feature unless its `DeviceOptions` raise them, never its adapter's,
//   so a program that runs on one machine does not silently depend on that machine's adapter.
// - `adopt` and `raw` on every handle let a program bind more of webgpu.h with its own externs.
// - A device's uncaptured errors reach that device's holders: `device.takeErrors()` drains its channel, and
//   `device.lost()` answers its loss. The seam keeps a state block per device, and every handle made from the device
//   holds it, since wgpu-native reports a handle's error to its device's callback after the device's last release.
//   `device.pushErrorScope(filter:)` catches the errors of the calls made while it is open; natively the seam keeps the
//   scopes, so none of wgpu-native's aborting scope paths is reachable.
// - A surface is configured from what it offers: `surface.capabilities(adapter:)` answers, `preferred()` makes a
//   `SurfaceConfig` a program may change, and `configure` checks it before WebGPU sees it, refusing in a
//   `ConfigureError` what wgpu-native would abort the process on. Frames are drawn sRGB by default, through a view
//   format where the surface's own format is linear, as a browser's canvas always is.
//
// It starts at what an offscreen clear and its readback touch, and grows toward the whole of webgpu.h.
// `TextureFormat` is generated with the bindings (src/formats.gen.kama).

import {
    TextureFormat,
    std::collections::DynamicArray,
    std::memory::Shared,
    std::encoding::utf8::decode, std::encoding::utf8::Utf8Error,
    gpu::native::createInstance, gpu::native::instanceAddRef, gpu::native::instanceRelease,
    gpu::native::adapterAddRef, gpu::native::adapterRelease, gpu::native::adapterGetLimits,
    gpu::native::deviceAddRef, gpu::native::deviceRelease, gpu::native::deviceGetQueue, gpu::native::deviceGetLimits,
    gpu::native::deviceCreateBuffer, gpu::native::deviceCreateTexture, gpu::native::deviceCreateCommandEncoder,
    gpu::native::queueAddRef, gpu::native::queueRelease, gpu::native::queueSubmit,
    gpu::native::bufferAddRef, gpu::native::bufferRelease, gpu::native::bufferGetSize,
    gpu::native::textureAddRef, gpu::native::textureRelease, gpu::native::textureCreateView,
    gpu::native::textureViewAddRef, gpu::native::textureViewRelease,
    gpu::native::commandEncoderAddRef, gpu::native::commandEncoderRelease, gpu::native::commandEncoderBeginRenderPass,
    gpu::native::commandEncoderCopyTextureToBuffer, gpu::native::encoderFinish,
    gpu::native::renderPassEncoderAddRef, gpu::native::renderPassEncoderRelease, gpu::native::renderPassEncoderEnd,
    gpu::native::commandBufferAddRef, gpu::native::commandBufferRelease,
    gpu::native::WGPUBufferDescriptor, gpu::native::WGPUTextureDescriptor, gpu::native::WGPURenderPassDescriptor,
    gpu::native::WGPURenderPassColorAttachment, gpu::native::WGPUTexelCopyTextureInfo,
    gpu::native::WGPUTexelCopyBufferInfo, gpu::native::WGPUExtent3D,
    gpu::native::WGPUBufferUsage, gpu::native::WGPUTextureUsage, gpu::native::WGPUMapMode,
    gpu::native::WGPUTextureDimension, gpu::native::WGPULoadOp,
    gpu::native::WGPUStoreOp, gpu::native::WGPUTextureAspect, gpu::native::WGPUPowerPreference,
    gpu::native::WGPULimits, gpu::native::WGPUFeatureName, gpu::native::WGPUBackendType, gpu::native::WGPUAdapterType,
    gpu::native::SEAM_PENDING, gpu::native::SEAM_FAILED, gpu::native::SEAM_UNAVAILABLE,
    gpu::native::requestAdapter, gpu::native::adapterRequestPoll, gpu::native::adapterRequestTake,
    gpu::native::adapterRequestMessage, gpu::native::adapterRequestDrop,
    gpu::native::adapterInfoText, gpu::native::adapterInfoNumbers, gpu::native::adapterFeatureNames,
    gpu::native::deviceFeatureNames,
    gpu::native::adapterMarkNew, gpu::native::adapterMarkHold, gpu::native::adapterMarkRelease,
    gpu::native::requestDeviceOf, gpu::native::deviceRequestPoll, gpu::native::deviceRequestConsumed,
    gpu::native::deviceRequestTakeDevice, gpu::native::deviceRequestMessage, gpu::native::deviceRequestDrop,
    gpu::native::mapAsync, gpu::native::mapPoll, gpu::native::mapMessage, gpu::native::mapDrop, gpu::native::mapBytes,
    gpu::native::pollDevice, gpu::native::deviceRequestTakeState, gpu::native::LOSS_DESTROYED,
    gpu::native::stateUnwatched, gpu::native::stateHold, gpu::native::stateRelease, gpu::native::stateWatched,
    gpu::native::stateTakeErrors, gpu::native::errorsCount, gpu::native::errorsDropped, gpu::native::errorsKind,
    gpu::native::errorsLength, gpu::native::errorsMessage, gpu::native::errorsFree, gpu::native::stateLost,
    gpu::native::stateLostLength, gpu::native::stateLostMessage,
    gpu::native::scopePush, gpu::native::scopePop, gpu::native::scopeAbandon, gpu::native::scopePopPoll,
    gpu::native::scopeCaught, gpu::native::scopeKind, gpu::native::scopeLength, gpu::native::scopeMessage,
    gpu::native::scopeDropPopped,
    gpu::native::SURFACE_OK, gpu::native::SURFACE_OCCLUDED, gpu::native::SURFACE_OUTDATED, gpu::native::SURFACE_LOST,
    gpu::native::SURFACE_TIMEOUT, gpu::native::createSurface, gpu::native::acquireSurface, gpu::native::presentSurface,
    gpu::native::surfaceAddRef, gpu::native::surfaceRelease, gpu::native::surfaceConfigure,
    gpu::native::surfaceGetCapabilities, gpu::native::surfaceCapabilitiesFreeMembers, gpu::native::textureViewIn,
    gpu::native::WGPUSurfaceConfiguration, gpu::native::WGPUSurfaceCapabilities, gpu::native::WGPUStatus,
    gpu::native::WGPUCompositeAlphaMode, gpu::native::WGPUPresentMode,
    window::Window, window::NativeWindow, window::NativeKind, window::Size,
};

export {
    Instance, Adapter, AdapterOptions, AdapterRequest, AdapterStatus, AdapterInfo, Backend, AdapterKind,
    Limits, Feature, FeatureSet, DeviceOptions,
    Device, Queue, DeviceRequest, DeviceStatus, GpuError, PowerPreference,
    Buffer, BufferUsage, BufferRead, ReadStatus,
    Texture, TextureUsage, TextureView,
    CommandEncoder, RenderPass, CommandBuffer, Color,
    Surface, SurfaceTexture, SurfaceError, SurfaceCapabilities, SurfaceConfig, PresentMode, AlphaMode, ConfigureError,
    GpuErrorKind, GpuErrorReport, DeviceErrors, DeviceLoss, LossReason, ErrorFilter, ErrorScope, ScopePop, PopStatus,
};

comptime int32 MESSAGE_BYTES = 512;
// webgpu.h's WGPU_DEPTH_SLICE_UNDEFINED, a #define the bindings never see; csrc/gpuseam.c asserts it is this.
comptime uint32 DEPTH_SLICE_UNDEFINED = 0xFFFFFFFF;
// webgpu.h's WGPU_LIMIT_U32_UNDEFINED and _U64_UNDEFINED: a limit a request leaves to WebGPU's default. Asserted likewise.
comptime uint32 LIMIT_U32_UNDEFINED = 0xFFFFFFFF;
comptime uint64 LIMIT_U64_UNDEFINED = 0xFFFFFFFFFFFFFFFF;
// The most features a set holds or a query copies out: webgpu.h names 22, and an implementation may add its own.
comptime int32 FEATURES_MAX = 64;

// ---- errors ----------------------------------------------------------------------------------------------------------

type enum GpuError implements Error {
    NoInstance,             // WebGPU gave no instance
    NoAdapter(string words),// WebGPU has no adapter here for the request (webgpu.h's Unavailable): a browser or system
                            // without WebGPU, or none matching its options. In the implementation's words
    Refused(string words),  // the adapter, the device or a map was refused, in the implementation's words
    Taken,                  // what a request gave was handed over already
    OutOfOrder,             // an error scope was popped while one pushed after it on its thread was still open
    Consumed;               // the adapter had given a device already: WebGPU gives an adapter one, so request another

    public const fn string message() {
        return match (this) {
            case NoInstance: "WebGPU gave no instance";
            case NoAdapter(words: w): copy w;
            case Refused(words: w): copy w;
            case Taken: "what this request gave was already taken";
            case OutOfOrder: "an error scope was popped while one pushed after it on the same thread was still open";
            case Consumed: "the adapter has already given a device: WebGPU gives an adapter one, so request another adapter";
        };
    }
}

// The bytes a seam call copied out, as text.
unsafe fn string textOf(const ref InlineArray<uint8>#(512) buf, int32 length) {
    DynamicArray<uint8> bytes = DynamicArray.empty();
    isize i = 0;
    while (i < cast<isize>(length)) { bytes.add(item: buf[i]); i = i + 1; }
    Result<string, Utf8Error> r = decode(bytes: bytes.view());
    match (give r) {
        case Ok(value: s): { return give s; }
        case Err(error: e): { return "(not UTF-8)"; }
    };
}

// The `length` bytes the seam keeps at `p`, as text.
unsafe fn string textFrom(UnsafeConstPtr<uint8> p, int32 length) {
    if (p == null || length <= 0) { return ""; }
    DynamicArray<uint8> bytes = DynamicArray.empty();
    isize n = cast<isize>(length);
    bytes.reserve(n: n);
    isize i = 0;
    while (i < n) { bytes.add(item: p[i]); i = i + 1; }
    Result<string, Utf8Error> r = decode(bytes: bytes.view());
    match (give r) {
        case Ok(value: s): { return give s; }
        case Err(error: e): { return "(not UTF-8)"; }
    };
}

// ---- a device's errors and its loss (GPU-1; AGENTS.gpu.md item 2) --------------------------------------------------

// What kind of error WebGPU reported; Unknown is anything else.
type enum GpuErrorKind { Validation, OutOfMemory, Internal, Unknown }

fn GpuErrorKind kindFrom(int32 v) {
    if (v == 0) { return GpuErrorKind::Validation; }
    if (v == 1) { return GpuErrorKind::OutOfMemory; }
    if (v == 2) { return GpuErrorKind::Internal; }
    return GpuErrorKind::Unknown;
}

// One error WebGPU reported, in its own words, whole.
type resource GpuErrorReport {
    GpuErrorKind sort;
    string words;

    public ctor of(GpuErrorKind kind, string message) {
        this.sort = kind;
        this.words = give message;
    }
    public const fn GpuErrorKind kind() { return this.sort; }
    public const fn string message() { return copy this.words; }
}

// What `device.takeErrors()` drained: the device's uncaptured errors since the last drain, the oldest first. A full
// channel keeps the oldest 64, since the first error is usually the cause and the later ones its cascade, and counts the
// rest in `dropped()`.
type resource DeviceErrors {
    DynamicArray<GpuErrorReport> items;
    int64 overflow;
    bool wired;

    friend Device::takeErrors[make];

    ctor make(DynamicArray<GpuErrorReport> reports, int64 dropped, bool watched) {
        this.items = give reports;
        this.overflow = dropped;
        this.wired = watched;
    }
    public const fn const ref DynamicArray<GpuErrorReport> reports() { return this.items; }
    public const fn int64 dropped() { return this.overflow; }
    // False for a device adopted from elsewhere: it keeps the error callback its maker gave it (webgpu.h sets one only
    // when a device is made), so its errors reach that callback and never this channel.
    public const fn bool watched() { return this.wired; }
    public const fn bool isEmpty() { return this.items.length() == 0 && this.overflow == 0; }
}

// Why a device was lost: Destroyed when it was destroyed on purpose.
type enum LossReason { Unknown, Destroyed }

// How a device was lost, in the implementation's words.
type resource DeviceLoss {
    LossReason why;
    string words;

    public ctor of(LossReason reason, string message) {
        this.why = reason;
        this.words = give message;
    }
    public const fn LossReason reason() { return this.why; }
    public const fn string message() { return copy this.words; }
}

// Which errors an error scope catches.
type enum ErrorFilter { Validation, OutOfMemory, Internal }

fn int32 filterValue(ErrorFilter f) {
    return match (f) {
        case Validation: 0;
        case OutOfMemory: 1;
        case Internal: 2;
    };
}

// What a popped scope caught: the first error its filter matched, or None.
type enum PopStatus { Pending, Ready(Optional<GpuErrorReport> caught), Failed(GpuError error) }

// An error scope: the errors of the calls made on this thread while it is open, from `device.pushErrorScope(filter:)`
// to `pop()`. It catches the first error its filter matches and swallows the rest, as WebGPU's does; an error it does
// not match goes to the scope beneath it, and past the last to the device's channel. Scopes pop in the reverse of the
// order they were pushed. One dropped unpopped pops itself, and what it caught goes to the channel. Not `Sendable`: a
// scope belongs to the thread that pushed it. Natively the seam keeps the scopes; on the web they are the browser's.
type resource ErrorScope {
    UnsafePtr slot;

    friend Device::pushErrorScope[start];

    unsafe ctor start(UnsafePtr block, UnsafePtr device, ErrorFilter filter) {
        this.slot = scopePush(state: block, device: device, filter: filterValue(f: filter));
    }

    // Close the scope, and ask what it caught. Refused with OutOfOrder while a scope pushed after it on this thread is
    // still open: the scope is spent all the same, is popped once those are, and what it caught goes to the channel.
    public unsafe give fn Result<ScopePop, GpuError> pop() {
        UnsafePtr s = this.slot;
        this.slot = null;
        if (s != null && scopePop(pushed: s) != 0) { return Result::Err(error: GpuError::OutOfOrder); }
        return Result::Ok(value: ScopePop.start(slot: s));
    }

    unsafe ~ErrorScope() { scopeAbandon(pushed: this.slot); }
}

// What a popped scope caught: natively ready at once, on the web a task later.
type resource ScopePop {
    UnsafePtr slot;

    friend ErrorScope::pop[start];

    unsafe ctor start(UnsafePtr slot) { this.slot = slot; }

    public unsafe const fn PopStatus poll() {
        if (this.slot == null) { return PopStatus::Failed(error: GpuError::Refused(words: "out of memory for the scope")); }
        int32 s = scopePopPoll(pushed: this.slot);
        if (s == SEAM_PENDING) { return PopStatus::Pending; }
        string words = textFrom(p: scopeMessage(pushed: this.slot), length: scopeLength(pushed: this.slot));
        if (s == SEAM_FAILED) {
            if (words.isEmpty()) { words = "the scope's pop failed"; }
            return PopStatus::Failed(error: GpuError::Refused(words: give words));
        }
        if (scopeCaught(pushed: this.slot) == 0) { return PopStatus::Ready(caught: Optional::None); }
        GpuErrorReport report = GpuErrorReport.of(kind: kindFrom(v: scopeKind(pushed: this.slot)), message: give words);
        return PopStatus::Ready(caught: Optional::Some(value: give report));
    }

    unsafe ~ScopePop() { scopeDropPopped(pushed: this.slot); }
}

// A hold on a device's state block in the seam: its errors and its loss. Every handle made from a device keeps one,
// since wgpu-native reports a handle's error to its device's callback even after the device's last release
// (tests/facts, `afterrelease`), and the block is freed with the last hold. Empty for a handle adopted from elsewhere.
type resource StateHold implements Copyable<This>(bare: give) {
    UnsafePtr block;

    // A hold the seam counted already: a device request's, or a new block's.
    public unsafe ctor fromSeam(UnsafePtr block) { this.block = block; }
    // Another hold on `block`, which may be null.
    public unsafe ctor make(UnsafePtr block) {
        this.block = block;
        stateHold(state: block);
    }
    public unsafe ctor empty() { this.block = null; }
    public unsafe ctor copy(ref StateHold source) {
        this.block = source.block;
        stateHold(state: this.block);
    }
    public unsafe const fn UnsafePtr raw() { return this.block; }

    unsafe ~StateHold() { stateRelease(state: this.block); }
}

// ---- plain data ------------------------------------------------------------------------------------------------------

type enum PowerPreference { Default, LowPower, HighPerformance }

fn int32 powerValue(PowerPreference p) {
    return match (p) {
        case Default: WGPUPowerPreference::Undefined;
        case LowPower: WGPUPowerPreference::LowPower;
        case HighPerformance: WGPUPowerPreference::HighPerformance;
    };
}

// The API an adapter runs on: WebGPU in a browser, a native one elsewhere.
type enum Backend { Undefined, Null, WebGPU, D3D11, D3D12, Metal, Vulkan, OpenGL, OpenGLES }

fn Backend backendOf(int32 v) {
    if (v == WGPUBackendType::Null) { return Backend::Null; }
    if (v == WGPUBackendType::WebGPU) { return Backend::WebGPU; }
    if (v == WGPUBackendType::D3D11) { return Backend::D3D11; }
    if (v == WGPUBackendType::D3D12) { return Backend::D3D12; }
    if (v == WGPUBackendType::Metal) { return Backend::Metal; }
    if (v == WGPUBackendType::Vulkan) { return Backend::Vulkan; }
    if (v == WGPUBackendType::OpenGL) { return Backend::OpenGL; }
    if (v == WGPUBackendType::OpenGLES) { return Backend::OpenGLES; }
    return Backend::Undefined;
}

// What kind of processor an adapter is.
type enum AdapterKind { DiscreteGPU, IntegratedGPU, CPU, Unknown }

fn AdapterKind kindOf(int32 v) {
    if (v == WGPUAdapterType::DiscreteGPU) { return AdapterKind::DiscreteGPU; }
    if (v == WGPUAdapterType::IntegratedGPU) { return AdapterKind::IntegratedGPU; }
    if (v == WGPUAdapterType::CPU) { return AdapterKind::CPU; }
    return AdapterKind::Unknown;
}

// A feature a device can be asked for (WebGPU's `GPUFeatureName`). The set grows as webgpu.h's does.
type enum Feature {
    CoreFeaturesAndLimits, DepthClipControl, Depth32FloatStencil8, TextureCompressionBC, TextureCompressionBCSliced3D,
    TextureCompressionETC2, TextureCompressionASTC, TextureCompressionASTCSliced3D, TimestampQuery, IndirectFirstInstance,
    ShaderF16, RG11B10UfloatRenderable, BGRA8UnormStorage, Float32Filterable, Float32Blendable, ClipDistances,
    DualSourceBlending, Subgroups, TextureFormatsTier1, TextureFormatsTier2, PrimitiveIndex, TextureComponentSwizzle
}

fn int32 featureValue(Feature f) {
    return match (f) {
        case CoreFeaturesAndLimits: WGPUFeatureName::CoreFeaturesAndLimits;
        case DepthClipControl: WGPUFeatureName::DepthClipControl;
        case Depth32FloatStencil8: WGPUFeatureName::Depth32FloatStencil8;
        case TextureCompressionBC: WGPUFeatureName::TextureCompressionBC;
        case TextureCompressionBCSliced3D: WGPUFeatureName::TextureCompressionBCSliced3D;
        case TextureCompressionETC2: WGPUFeatureName::TextureCompressionETC2;
        case TextureCompressionASTC: WGPUFeatureName::TextureCompressionASTC;
        case TextureCompressionASTCSliced3D: WGPUFeatureName::TextureCompressionASTCSliced3D;
        case TimestampQuery: WGPUFeatureName::TimestampQuery;
        case IndirectFirstInstance: WGPUFeatureName::IndirectFirstInstance;
        case ShaderF16: WGPUFeatureName::ShaderF16;
        case RG11B10UfloatRenderable: WGPUFeatureName::RG11B10UfloatRenderable;
        case BGRA8UnormStorage: WGPUFeatureName::BGRA8UnormStorage;
        case Float32Filterable: WGPUFeatureName::Float32Filterable;
        case Float32Blendable: WGPUFeatureName::Float32Blendable;
        case ClipDistances: WGPUFeatureName::ClipDistances;
        case DualSourceBlending: WGPUFeatureName::DualSourceBlending;
        case Subgroups: WGPUFeatureName::Subgroups;
        case TextureFormatsTier1: WGPUFeatureName::TextureFormatsTier1;
        case TextureFormatsTier2: WGPUFeatureName::TextureFormatsTier2;
        case PrimitiveIndex: WGPUFeatureName::PrimitiveIndex;
        case TextureComponentSwizzle: WGPUFeatureName::TextureComponentSwizzle;
    };
}

// Every feature, in webgpu.h's order.
fn DynamicArray<Feature> everyFeature() {
    DynamicArray<Feature> all = DynamicArray.empty();
    all.add(item: Feature::CoreFeaturesAndLimits);
    all.add(item: Feature::DepthClipControl);
    all.add(item: Feature::Depth32FloatStencil8);
    all.add(item: Feature::TextureCompressionBC);
    all.add(item: Feature::TextureCompressionBCSliced3D);
    all.add(item: Feature::TextureCompressionETC2);
    all.add(item: Feature::TextureCompressionASTC);
    all.add(item: Feature::TextureCompressionASTCSliced3D);
    all.add(item: Feature::TimestampQuery);
    all.add(item: Feature::IndirectFirstInstance);
    all.add(item: Feature::ShaderF16);
    all.add(item: Feature::RG11B10UfloatRenderable);
    all.add(item: Feature::BGRA8UnormStorage);
    all.add(item: Feature::Float32Filterable);
    all.add(item: Feature::Float32Blendable);
    all.add(item: Feature::ClipDistances);
    all.add(item: Feature::DualSourceBlending);
    all.add(item: Feature::Subgroups);
    all.add(item: Feature::TextureFormatsTier1);
    all.add(item: Feature::TextureFormatsTier2);
    all.add(item: Feature::PrimitiveIndex);
    all.add(item: Feature::TextureComponentSwizzle);
    return all;
}

// The feature a WGPUFeatureName names, or None for one this package does not name (an implementation's own).
fn Optional<Feature> featureFrom(int32 v) {
    DynamicArray<Feature> all = everyFeature();
    foreach (Feature f in all.iterator()) { if (featureValue(f: f) == v) { return Optional::Some(value: f); } }
    return Optional::None;
}

// Features, as a set: `FeatureSet.empty().with(feature: Feature::TimestampQuery)`.
type value FeatureSet {
    uint64 bits = 0;   // bit n is the feature whose webgpu.h number is n + 1

    public ctor empty() { }

    // This set and `feature`.
    public const fn FeatureSet with(Feature feature) {
        FeatureSet more = FeatureSet.empty();
        more.bits = this.bits | (cast<uint64>(1) << (featureValue(f: feature) - 1));
        return more;
    }

    public const fn bool has(Feature feature) {
        return (this.bits & (cast<uint64>(1) << (featureValue(f: feature) - 1))) != 0;
    }
}

// The WGPUFeatureNames `count` of which a query copied into `names`, as a set; an implementation's own are left out.
fn FeatureSet featuresFrom(const ref InlineArray<int32>#(64) names, int32 count) {
    FeatureSet s = FeatureSet.empty();
    int32 i = 0;
    while (i < count && i < FEATURES_MAX) {
        Optional<Feature> f = featureFrom(v: names[cast<isize>(i)]);
        match (f) { case Some(value: x): { s = s.with(feature: x); } case None: { } };
        i = i + 1;
    }
    return s;
}

// The most a device may use, as WebGPU's `GPUSupportedLimits` names them: each `max` a ceiling, each `min` alignment a
// floor (lower is more). An adapter answers the most it can give; a device, what it was given.
type value Limits {
    public uint32 maxTextureDimension1D = 0;
    public uint32 maxTextureDimension2D = 0;
    public uint32 maxTextureDimension3D = 0;
    public uint32 maxTextureArrayLayers = 0;
    public uint32 maxBindGroups = 0;
    public uint32 maxBindGroupsPlusVertexBuffers = 0;
    public uint32 maxBindingsPerBindGroup = 0;
    public uint32 maxDynamicUniformBuffersPerPipelineLayout = 0;
    public uint32 maxDynamicStorageBuffersPerPipelineLayout = 0;
    public uint32 maxSampledTexturesPerShaderStage = 0;
    public uint32 maxSamplersPerShaderStage = 0;
    public uint32 maxStorageBuffersPerShaderStage = 0;
    public uint32 maxStorageTexturesPerShaderStage = 0;
    public uint32 maxUniformBuffersPerShaderStage = 0;
    public uint64 maxUniformBufferBindingSize = 0;
    public uint64 maxStorageBufferBindingSize = 0;
    public uint32 minUniformBufferOffsetAlignment = 0;
    public uint32 minStorageBufferOffsetAlignment = 0;
    public uint32 maxVertexBuffers = 0;
    public uint64 maxBufferSize = 0;
    public uint32 maxVertexAttributes = 0;
    public uint32 maxVertexBufferArrayStride = 0;
    public uint32 maxInterStageShaderVariables = 0;
    public uint32 maxColorAttachments = 0;
    public uint32 maxColorAttachmentBytesPerSample = 0;
    public uint32 maxComputeWorkgroupStorageSize = 0;
    public uint32 maxComputeInvocationsPerWorkgroup = 0;
    public uint32 maxComputeWorkgroupSizeX = 0;
    public uint32 maxComputeWorkgroupSizeY = 0;
    public uint32 maxComputeWorkgroupSizeZ = 0;
    public uint32 maxComputeWorkgroupsPerDimension = 0;
    public uint32 maxImmediateSize = 0;

    // WebGPU's defaults, which every adapter meets (the spec's limits table). The tests hold a device asked for them to
    // exactly these on each leg.
    public ctor defaults() {
        this.maxTextureDimension1D = 8192;
        this.maxTextureDimension2D = 8192;
        this.maxTextureDimension3D = 2048;
        this.maxTextureArrayLayers = 256;
        this.maxBindGroups = 4;
        this.maxBindGroupsPlusVertexBuffers = 24;
        this.maxBindingsPerBindGroup = 1000;
        this.maxDynamicUniformBuffersPerPipelineLayout = 8;
        this.maxDynamicStorageBuffersPerPipelineLayout = 4;
        this.maxSampledTexturesPerShaderStage = 16;
        this.maxSamplersPerShaderStage = 16;
        this.maxStorageBuffersPerShaderStage = 8;
        this.maxStorageTexturesPerShaderStage = 4;
        this.maxUniformBuffersPerShaderStage = 12;
        this.maxUniformBufferBindingSize = 65536;
        this.maxStorageBufferBindingSize = 134217728;
        this.minUniformBufferOffsetAlignment = 256;
        this.minStorageBufferOffsetAlignment = 256;
        this.maxVertexBuffers = 8;
        this.maxBufferSize = 268435456;
        this.maxVertexAttributes = 16;
        this.maxVertexBufferArrayStride = 2048;
        this.maxInterStageShaderVariables = 16;
        this.maxColorAttachments = 8;
        this.maxColorAttachmentBytesPerSample = 32;
        this.maxComputeWorkgroupStorageSize = 16384;
        this.maxComputeInvocationsPerWorkgroup = 256;
        this.maxComputeWorkgroupSizeX = 256;
        this.maxComputeWorkgroupSizeY = 256;
        this.maxComputeWorkgroupSizeZ = 64;
        this.maxComputeWorkgroupsPerDimension = 65535;
        this.maxImmediateSize = 64;   // "the size of a 4×4 matrix of f32 values"
    }
}

// What webgpu.h answered, as `Limits`.
fn Limits limitsOf(const ref WGPULimits n) {
    Limits l = Limits.defaults();
    l.maxTextureDimension1D = n.maxTextureDimension1D;
    l.maxTextureDimension2D = n.maxTextureDimension2D;
    l.maxTextureDimension3D = n.maxTextureDimension3D;
    l.maxTextureArrayLayers = n.maxTextureArrayLayers;
    l.maxBindGroups = n.maxBindGroups;
    l.maxBindGroupsPlusVertexBuffers = n.maxBindGroupsPlusVertexBuffers;
    l.maxBindingsPerBindGroup = n.maxBindingsPerBindGroup;
    l.maxDynamicUniformBuffersPerPipelineLayout = n.maxDynamicUniformBuffersPerPipelineLayout;
    l.maxDynamicStorageBuffersPerPipelineLayout = n.maxDynamicStorageBuffersPerPipelineLayout;
    l.maxSampledTexturesPerShaderStage = n.maxSampledTexturesPerShaderStage;
    l.maxSamplersPerShaderStage = n.maxSamplersPerShaderStage;
    l.maxStorageBuffersPerShaderStage = n.maxStorageBuffersPerShaderStage;
    l.maxStorageTexturesPerShaderStage = n.maxStorageTexturesPerShaderStage;
    l.maxUniformBuffersPerShaderStage = n.maxUniformBuffersPerShaderStage;
    l.maxUniformBufferBindingSize = n.maxUniformBufferBindingSize;
    l.maxStorageBufferBindingSize = n.maxStorageBufferBindingSize;
    l.minUniformBufferOffsetAlignment = n.minUniformBufferOffsetAlignment;
    l.minStorageBufferOffsetAlignment = n.minStorageBufferOffsetAlignment;
    l.maxVertexBuffers = n.maxVertexBuffers;
    l.maxBufferSize = n.maxBufferSize;
    l.maxVertexAttributes = n.maxVertexAttributes;
    l.maxVertexBufferArrayStride = n.maxVertexBufferArrayStride;
    l.maxInterStageShaderVariables = n.maxInterStageShaderVariables;
    l.maxColorAttachments = n.maxColorAttachments;
    l.maxColorAttachmentBytesPerSample = n.maxColorAttachmentBytesPerSample;
    l.maxComputeWorkgroupStorageSize = n.maxComputeWorkgroupStorageSize;
    l.maxComputeInvocationsPerWorkgroup = n.maxComputeInvocationsPerWorkgroup;
    l.maxComputeWorkgroupSizeX = n.maxComputeWorkgroupSizeX;
    l.maxComputeWorkgroupSizeY = n.maxComputeWorkgroupSizeY;
    l.maxComputeWorkgroupSizeZ = n.maxComputeWorkgroupSizeZ;
    l.maxComputeWorkgroupsPerDimension = n.maxComputeWorkgroupsPerDimension;
    l.maxImmediateSize = n.maxImmediateSize;
    return l;
}

fn uint32 asked32(uint32 want, uint32 standard) { return want == standard ? LIMIT_U32_UNDEFINED : want; }
fn uint64 asked64(uint64 want, uint64 standard) { return want == standard ? LIMIT_U64_UNDEFINED : want; }

// `want` as a request: each limit left at WebGPU's default is undefined, so the implementation's own default stands,
// and each one raised is asked for.
fn WGPULimits required(const ref Limits want) {
    Limits d = Limits.defaults();
    WGPULimits n = WGPULimits.zero();
    n.maxTextureDimension1D = asked32(want: want.maxTextureDimension1D, standard: d.maxTextureDimension1D);
    n.maxTextureDimension2D = asked32(want: want.maxTextureDimension2D, standard: d.maxTextureDimension2D);
    n.maxTextureDimension3D = asked32(want: want.maxTextureDimension3D, standard: d.maxTextureDimension3D);
    n.maxTextureArrayLayers = asked32(want: want.maxTextureArrayLayers, standard: d.maxTextureArrayLayers);
    n.maxBindGroups = asked32(want: want.maxBindGroups, standard: d.maxBindGroups);
    n.maxBindGroupsPlusVertexBuffers = asked32(want: want.maxBindGroupsPlusVertexBuffers, standard: d.maxBindGroupsPlusVertexBuffers);
    n.maxBindingsPerBindGroup = asked32(want: want.maxBindingsPerBindGroup, standard: d.maxBindingsPerBindGroup);
    n.maxDynamicUniformBuffersPerPipelineLayout = asked32(want: want.maxDynamicUniformBuffersPerPipelineLayout, standard: d.maxDynamicUniformBuffersPerPipelineLayout);
    n.maxDynamicStorageBuffersPerPipelineLayout = asked32(want: want.maxDynamicStorageBuffersPerPipelineLayout, standard: d.maxDynamicStorageBuffersPerPipelineLayout);
    n.maxSampledTexturesPerShaderStage = asked32(want: want.maxSampledTexturesPerShaderStage, standard: d.maxSampledTexturesPerShaderStage);
    n.maxSamplersPerShaderStage = asked32(want: want.maxSamplersPerShaderStage, standard: d.maxSamplersPerShaderStage);
    n.maxStorageBuffersPerShaderStage = asked32(want: want.maxStorageBuffersPerShaderStage, standard: d.maxStorageBuffersPerShaderStage);
    n.maxStorageTexturesPerShaderStage = asked32(want: want.maxStorageTexturesPerShaderStage, standard: d.maxStorageTexturesPerShaderStage);
    n.maxUniformBuffersPerShaderStage = asked32(want: want.maxUniformBuffersPerShaderStage, standard: d.maxUniformBuffersPerShaderStage);
    n.maxUniformBufferBindingSize = asked64(want: want.maxUniformBufferBindingSize, standard: d.maxUniformBufferBindingSize);
    n.maxStorageBufferBindingSize = asked64(want: want.maxStorageBufferBindingSize, standard: d.maxStorageBufferBindingSize);
    n.minUniformBufferOffsetAlignment = asked32(want: want.minUniformBufferOffsetAlignment, standard: d.minUniformBufferOffsetAlignment);
    n.minStorageBufferOffsetAlignment = asked32(want: want.minStorageBufferOffsetAlignment, standard: d.minStorageBufferOffsetAlignment);
    n.maxVertexBuffers = asked32(want: want.maxVertexBuffers, standard: d.maxVertexBuffers);
    n.maxBufferSize = asked64(want: want.maxBufferSize, standard: d.maxBufferSize);
    n.maxVertexAttributes = asked32(want: want.maxVertexAttributes, standard: d.maxVertexAttributes);
    n.maxVertexBufferArrayStride = asked32(want: want.maxVertexBufferArrayStride, standard: d.maxVertexBufferArrayStride);
    n.maxInterStageShaderVariables = asked32(want: want.maxInterStageShaderVariables, standard: d.maxInterStageShaderVariables);
    n.maxColorAttachments = asked32(want: want.maxColorAttachments, standard: d.maxColorAttachments);
    n.maxColorAttachmentBytesPerSample = asked32(want: want.maxColorAttachmentBytesPerSample, standard: d.maxColorAttachmentBytesPerSample);
    n.maxComputeWorkgroupStorageSize = asked32(want: want.maxComputeWorkgroupStorageSize, standard: d.maxComputeWorkgroupStorageSize);
    n.maxComputeInvocationsPerWorkgroup = asked32(want: want.maxComputeInvocationsPerWorkgroup, standard: d.maxComputeInvocationsPerWorkgroup);
    n.maxComputeWorkgroupSizeX = asked32(want: want.maxComputeWorkgroupSizeX, standard: d.maxComputeWorkgroupSizeX);
    n.maxComputeWorkgroupSizeY = asked32(want: want.maxComputeWorkgroupSizeY, standard: d.maxComputeWorkgroupSizeY);
    n.maxComputeWorkgroupSizeZ = asked32(want: want.maxComputeWorkgroupSizeZ, standard: d.maxComputeWorkgroupSizeZ);
    n.maxComputeWorkgroupsPerDimension = asked32(want: want.maxComputeWorkgroupsPerDimension, standard: d.maxComputeWorkgroupsPerDimension);
    n.maxImmediateSize = asked32(want: want.maxImmediateSize, standard: d.maxImmediateSize);
    return n;
}

// What a device is asked for (WebGPU's `GPUDeviceDescriptor`, its `requiredLimits` and `requiredFeatures`): WebGPU's
// default limits and no feature, unless a program raises a limit or adds a feature. A request its adapter cannot meet
// fails, in the implementation's words.
type value DeviceOptions {
    public Limits limits = Limits.defaults();
    public FeatureSet features = FeatureSet.empty();

    public ctor defaults() { }
}

// Usage flags, OR'd together: `BufferUsage::MapRead | BufferUsage::CopyDst`.
type value BufferUsage {
    public comptime uint64 MapRead = WGPUBufferUsage::MapRead;
    public comptime uint64 MapWrite = WGPUBufferUsage::MapWrite;
    public comptime uint64 CopySrc = WGPUBufferUsage::CopySrc;
    public comptime uint64 CopyDst = WGPUBufferUsage::CopyDst;
    public comptime uint64 Index = WGPUBufferUsage::Index;
    public comptime uint64 Vertex = WGPUBufferUsage::Vertex;
    public comptime uint64 Uniform = WGPUBufferUsage::Uniform;
    public comptime uint64 Storage = WGPUBufferUsage::Storage;
    public comptime uint64 Indirect = WGPUBufferUsage::Indirect;
}

type value TextureUsage {
    public comptime uint64 CopySrc = WGPUTextureUsage::CopySrc;
    public comptime uint64 CopyDst = WGPUTextureUsage::CopyDst;
    public comptime uint64 TextureBinding = WGPUTextureUsage::TextureBinding;
    public comptime uint64 StorageBinding = WGPUTextureUsage::StorageBinding;
    public comptime uint64 RenderAttachment = WGPUTextureUsage::RenderAttachment;
}

// A colour, each channel 0 to 1, made memberwise: `Color.of(r: 0.1, g: 0.2, b: 0.3, a: 1.0)`.
@generate(of)
type value Color {
    public float64 r;
    public float64 g;
    public float64 b;
    public float64 a;
}

// ---- the instance and the device -------------------------------------------------------------------------------------

type resource Instance implements Copyable<This>(bare: give) {
    UnsafePtr handle;

    public unsafe ctor Result<Instance, GpuError> make() {
        UnsafePtr h = createInstance(descriptor: null);
        if (h == null) { return Result::Err(error: GpuError::NoInstance); }
        return Result::Ok(value: Instance.adopt(raw: h));
    }
    public unsafe ctor adopt(UnsafePtr raw) { this.handle = raw; }
    public unsafe ctor copy(ref Instance source) { this.handle = source.handle; instanceAddRef(instance: this.handle); }
    public unsafe const fn UnsafePtr raw() { return this.handle; }

    // Ask for an adapter (WebGPU's first step); `poll()` the request until it settles.
    public unsafe fn AdapterRequest requestAdapter(const ref AdapterOptions options) {
        return AdapterRequest.start(instance: this.handle, compatible: options.surface, power: options.power);
    }

    unsafe ~Instance() { if (this.handle != null) { instanceRelease(instance: this.handle); } }
}

// What an adapter is asked for (WebGPU's `GPURequestAdapterOptions`): a power preference, and the surface it must
// present to when there is one, on which it holds a reference, and on its window.
type resource AdapterOptions {
    int32 power;
    UnsafePtr surface;   // null for an adapter that need present nowhere
    NativeWindow onWindow = NativeWindow.adopt(kind: NativeKind::None, display: null, window: null);

    friend Instance::requestAdapter[power, surface];

    public unsafe ctor make(PowerPreference power) { this.power = powerValue(p: power); this.surface = null; }
    public unsafe ctor withSurface(const ref Surface surface, PowerPreference power) {
        this.power = powerValue(p: power);
        this.surface = surface.raw();
        surfaceAddRef(surface: this.surface);
        this.onWindow = surface.heldWindow();
    }

    unsafe ~AdapterOptions() { if (this.surface != null) { surfaceRelease(surface: this.surface); } }
}

type enum AdapterStatus { Pending, Ready(Adapter adapter), Failed(GpuError error) }

// An adapter on its way. Dropping it while it is still pending is safe: the seam frees it when its callback fires.
type resource AdapterRequest {
    UnsafePtr slot;
    UnsafePtr instance;   // the instance it was asked of, alive while the slot is; the adapter keeps a reference

    friend Instance::requestAdapter[start];

    unsafe ctor start(UnsafePtr instance, UnsafePtr compatible, int32 power) {
        this.instance = instance;
        this.slot = requestAdapter(instance: instance, compatible: compatible, power: power);
    }

    // Pending until the adapter has answered; then Ready once, handing the adapter over, or Failed with the
    // implementation's words: NoAdapter when there is none here for the request, Refused otherwise. A poll after Ready
    // is Failed(Taken).
    public unsafe const fn AdapterStatus poll() {
        if (this.slot == null) { return AdapterStatus::Failed(error: GpuError::Refused(words: "out of memory for the request")); }
        int32 s = adapterRequestPoll(request: this.slot);
        if (s == SEAM_PENDING) { return AdapterStatus::Pending; }
        if (s == SEAM_FAILED || s == SEAM_UNAVAILABLE) {
            InlineArray<uint8>#(512) buf = [0; 512];
            int32 n = adapterRequestMessage(request: this.slot, dst: addr(of: buf[0]), capacity: MESSAGE_BYTES);
            string words = textOf(buf: buf, length: n);
            if (s == SEAM_UNAVAILABLE) { return AdapterStatus::Failed(error: GpuError::NoAdapter(words: give words)); }
            return AdapterStatus::Failed(error: GpuError::Refused(words: give words));
        }
        UnsafePtr adapter = adapterRequestTake(request: this.slot);
        if (adapter == null) { return AdapterStatus::Failed(error: GpuError::Taken); }
        return AdapterStatus::Ready(adapter: Adapter.fromRequest(raw: adapter, instance: this.instance));
    }

    unsafe ~AdapterRequest() { adapterRequestDrop(request: this.slot); }
}

// What an adapter is (WebGPU's `GPUAdapterInfo`). A browser may leave the names empty, so a program must not depend
// on them.
type resource AdapterInfo {
    string vendorName = "";
    string architectureName = "";
    string deviceName = "";
    string descriptionText = "";
    Backend api = Backend::Undefined;
    AdapterKind sort = AdapterKind::Unknown;
    uint32 vendorNumber = 0;
    uint32 deviceNumber = 0;

    friend Adapter::info[fromAdapter];

    unsafe ctor fromAdapter(UnsafePtr adapter) {
        InlineArray<uint8>#(512) buf = [0; 512];
        int32 n = adapterInfoText(adapter: adapter, which: 0, dst: addr(of: buf[0]), capacity: MESSAGE_BYTES);
        this.vendorName = textOf(buf: buf, length: n);
        n = adapterInfoText(adapter: adapter, which: 1, dst: addr(of: buf[0]), capacity: MESSAGE_BYTES);
        this.architectureName = textOf(buf: buf, length: n);
        n = adapterInfoText(adapter: adapter, which: 2, dst: addr(of: buf[0]), capacity: MESSAGE_BYTES);
        this.deviceName = textOf(buf: buf, length: n);
        n = adapterInfoText(adapter: adapter, which: 3, dst: addr(of: buf[0]), capacity: MESSAGE_BYTES);
        this.descriptionText = textOf(buf: buf, length: n);
        int32 backend = 0;
        int32 kind = 0;
        uint32 vendorId = 0;
        uint32 deviceId = 0;
        adapterInfoNumbers(adapter: adapter, backend: addr(of: backend), kind: addr(of: kind), vendorId: addr(of: vendorId),
                           deviceId: addr(of: deviceId));
        this.api = backendOf(v: backend);
        this.sort = kindOf(v: kind);
        this.vendorNumber = vendorId;
        this.deviceNumber = deviceId;
    }

    public const fn string vendor() { return copy this.vendorName; }
    public const fn string architecture() { return copy this.architectureName; }
    public const fn string device() { return copy this.deviceName; }
    public const fn string description() { return copy this.descriptionText; }
    public const fn Backend backend() { return this.api; }
    public const fn AdapterKind kind() { return this.sort; }
    public const fn uint32 vendorId() { return this.vendorNumber; }
    public const fn uint32 deviceId() { return this.deviceNumber; }
}

// WebGPU gives an adapter one device (AGENTS.gpu.md item 10, decision 1): once a request of any of its copies is granted,
// the adapter is consumed, and a later request fails with `GpuError::Consumed`, on every leg. A program that wants two
// devices requests two adapters.
type resource Adapter implements Copyable<This>(bare: give) {
    UnsafePtr handle;
    UnsafePtr instance;   // the instance it came from, whose events its requests process; null when adopted
    UnsafePtr mark;       // whether it has given a device, shared by its copies and the requests made of them

    friend AdapterRequest::poll[fromRequest];

    // An adapter made outside this package; it takes over one reference. Its maker vouches that it has given no device.
    public unsafe ctor adopt(UnsafePtr raw) { this.handle = raw; this.instance = null; this.mark = adapterMarkNew(); }
    unsafe ctor fromRequest(UnsafePtr raw, UnsafePtr instance) {
        this.handle = raw;
        this.instance = instance;
        if (instance != null) { instanceAddRef(instance: instance); }
        this.mark = adapterMarkNew();
    }
    public unsafe ctor copy(ref Adapter source) {
        this.handle = source.handle;
        this.instance = source.instance;
        this.mark = source.mark;
        adapterAddRef(adapter: this.handle);
        if (this.instance != null) { instanceAddRef(instance: this.instance); }
        adapterMarkHold(mark: this.mark);
    }
    public unsafe const fn UnsafePtr raw() { return this.handle; }

    // What it is: its names, its backend and its kind.
    public unsafe const fn AdapterInfo info() { return AdapterInfo.fromAdapter(adapter: this.handle); }

    // The most it can give a device.
    public unsafe const fn Limits limits() {
        WGPULimits n = WGPULimits.zero();
        int32 status = adapterGetLimits(adapter: this.handle, limits: cast<UnsafePtr>(addr(of: n)));
        return limitsOf(n: n);
    }

    // The features it can give a device.
    public unsafe const fn FeatureSet features() {
        InlineArray<int32>#(64) names = [0; 64];
        int32 n = adapterFeatureNames(adapter: this.handle, dst: addr(of: names[0]), capacity: FEATURES_MAX);
        return featuresFrom(names: names, count: n);
    }

    // Ask for a device with `options` (WebGPU's second step); `poll()` the request until it settles. Once the adapter
    // has given a device, the request fails with `Consumed` at once.
    public unsafe fn DeviceRequest requestDevice(const ref DeviceOptions options) {
        return DeviceRequest.start(instance: this.instance, adapter: this.handle, mark: this.mark, options: options);
    }

    unsafe ~Adapter() {
        if (this.handle != null) { adapterRelease(adapter: this.handle); }
        if (this.instance != null) { instanceRelease(instance: this.instance); }
        adapterMarkRelease(mark: this.mark);
    }
}

type enum DeviceStatus { Pending, Ready(Device device, Queue queue), Failed(GpuError error) }

// A device on its way. Dropping it while it is still pending is safe: the seam frees it when its callback fires.
type resource DeviceRequest {
    UnsafePtr slot;
    UnsafePtr adapter;   // the adapter it was asked of, on which it holds a reference, handed to the device it gives

    friend Adapter::requestDevice[start];

    unsafe ctor start(UnsafePtr instance, UnsafePtr adapter, UnsafePtr mark, const ref DeviceOptions options) {
        this.adapter = adapter;
        if (adapter != null) { adapterAddRef(adapter: adapter); }
        WGPULimits limits = required(want: options.limits);
        InlineArray<int32>#(64) names = [0; 64];
        int32 count = 0;
        DynamicArray<Feature> all = everyFeature();
        foreach (Feature f in all.iterator()) {
            if (options.features.has(feature: f)) { names[cast<isize>(count)] = featureValue(f: f); count = count + 1; }
        }
        this.slot = requestDeviceOf(instance: instance, adapter: adapter, mark: mark, limits: cast<UnsafePtr>(addr(of: limits)),
                                    features: addr(of: names[0]), featureCount: count);
    }

    // Pending until the device has answered; then Ready once, handing the device and its queue over, or Failed with
    // the implementation's words. A poll after Ready is Failed(Taken).
    public unsafe const fn DeviceStatus poll() {
        if (this.slot == null) { return DeviceStatus::Failed(error: GpuError::Refused(words: "out of memory for the request")); }
        int32 s = deviceRequestPoll(request: this.slot);
        if (s == SEAM_PENDING) { return DeviceStatus::Pending; }
        if (s == SEAM_FAILED) {
            if (deviceRequestConsumed(request: this.slot) != 0) { return DeviceStatus::Failed(error: GpuError::Consumed); }
            InlineArray<uint8>#(512) buf = [0; 512];
            int32 n = deviceRequestMessage(request: this.slot, dst: addr(of: buf[0]), capacity: MESSAGE_BYTES);
            string words = textOf(buf: buf, length: n);
            return DeviceStatus::Failed(error: GpuError::Refused(words: give words));
        }
        UnsafePtr device = deviceRequestTakeDevice(request: this.slot);
        if (device == null) { return DeviceStatus::Failed(error: GpuError::Taken); }
        UnsafePtr state = deviceRequestTakeState(request: this.slot);
        UnsafePtr queue = deviceGetQueue(device: device);
        return DeviceStatus::Ready(device: Device.fromRequest(raw: device, adapter: this.adapter, block: state),
                                   queue: Queue.fromDevice(raw: queue, block: state));
    }

    unsafe ~DeviceRequest() {
        deviceRequestDrop(request: this.slot);
        if (this.adapter != null) { adapterRelease(adapter: this.adapter); }
    }
}

// A device holds a reference on the adapter it came from: webgpu.h cannot answer it (neither leg has
// `wgpuDeviceGetAdapter`), and a surface it configures is checked against what the surface offers that adapter.
type resource Device implements Copyable<This>(bare: give) {
    UnsafePtr handle;
    UnsafePtr adapter;
    StateHold hold = StateHold.empty();   // its errors and its loss, shared with every handle made from it

    friend DeviceRequest::poll[fromRequest];
    friend Surface::configure[adapterHandle, stateBlock];

    // A device made outside this package, with the adapter it was requested of; it takes over one reference. It keeps
    // the callbacks its maker gave it, since webgpu.h sets them only when a device is made, so its errors and its loss
    // reach those and never this package: `takeErrors()` says so (`watched()` is false), and `lost()` answers None.
    public unsafe ctor adopt(UnsafePtr raw, const ref Adapter adapter) {
        this.handle = raw;
        this.adapter = adapter.raw();
        if (this.adapter != null) { adapterAddRef(adapter: this.adapter); }
        this.hold = StateHold.fromSeam(block: stateUnwatched());
    }
    unsafe ctor fromRequest(UnsafePtr raw, UnsafePtr adapter, UnsafePtr block) {
        this.handle = raw;
        this.adapter = adapter;
        if (adapter != null) { adapterAddRef(adapter: adapter); }
        this.hold = StateHold.fromSeam(block: block);
    }
    public unsafe ctor copy(ref Device source) {
        this.handle = source.handle;
        this.adapter = source.adapter;
        deviceAddRef(device: this.handle);
        if (this.adapter != null) { adapterAddRef(adapter: this.adapter); }
        this.hold = copy source.hold;
    }
    public unsafe const fn UnsafePtr raw() { return this.handle; }
    unsafe const fn UnsafePtr adapterHandle() { return this.adapter; }
    unsafe const fn UnsafePtr stateBlock() { return this.hold.raw(); }

    // The uncaptured errors reported since the last call, the oldest first, from the device's calls and from every
    // handle made from it, draining its channel; every copy of the device shares the one channel. Natively an error is
    // here when the call that caused it returns; on the web, a task later.
    public unsafe fn DeviceErrors takeErrors() {
        DynamicArray<GpuErrorReport> list = DynamicArray.empty();
        int64 dropped = 0;
        UnsafePtr drained = stateTakeErrors(state: this.hold.raw());
        if (drained != null) {
            int32 n = errorsCount(errors: drained);
            int32 i = 0;
            while (i < n) {
                string words = textFrom(p: errorsMessage(errors: drained, at: i), length: errorsLength(errors: drained, at: i));
                list.add(item: GpuErrorReport.of(kind: kindFrom(v: errorsKind(errors: drained, at: i)), message: give words));
                i = i + 1;
            }
            dropped = errorsDropped(errors: drained);
            errorsFree(errors: drained);
        }
        return DeviceErrors.make(reports: give list, dropped: dropped, watched: stateWatched(state: this.hold.raw()) != 0);
    }

    // Open an error scope on this thread: it catches the errors of the calls made while it is open (the device's own,
    // and every handle's made from it) that `filter` matches, until it is popped. An adopted device's errors reach its
    // maker's callback, so natively its scopes catch nothing.
    public unsafe fn ErrorScope pushErrorScope(ErrorFilter filter) {
        return ErrorScope.start(block: this.hold.raw(), device: this.handle, filter: filter);
    }

    // How the device was lost, once it is. Natively wgpu-native reports no loss, of a destroy or a release (tests/facts,
    // `noloss`), so this answers None there.
    public unsafe const fn Optional<DeviceLoss> lost() {
        UnsafePtr block = this.hold.raw();
        int32 l = stateLost(state: block);
        if (l == 0) { return Optional::None; }
        string words = textFrom(p: stateLostMessage(state: block), length: stateLostLength(state: block));
        LossReason why = LossReason::Unknown;
        if (l == LOSS_DESTROYED) { why = LossReason::Destroyed; }
        return Optional::Some(value: DeviceLoss.of(reason: why, message: give words));
    }

    // The limits it was given: WebGPU's defaults, unless its request raised them.
    public unsafe const fn Limits limits() {
        WGPULimits n = WGPULimits.zero();
        int32 status = deviceGetLimits(device: this.handle, limits: cast<UnsafePtr>(addr(of: n)));
        return limitsOf(n: n);
    }

    // The features it was given.
    public unsafe const fn FeatureSet features() {
        InlineArray<int32>#(64) names = [0; 64];
        int32 n = deviceFeatureNames(device: this.handle, dst: addr(of: names[0]), capacity: FEATURES_MAX);
        return featuresFrom(names: names, count: n);
    }

    // A buffer of `size` bytes for `usage` (BufferUsage flags OR'd together).
    public unsafe fn Buffer createBuffer(uint64 size, uint64 usage) {
        WGPUBufferDescriptor d = WGPUBufferDescriptor.zero();
        d.size = size;
        d.usage = usage;
        return Buffer.fromDevice(raw: deviceCreateBuffer(device: this.handle, descriptor: cast<UnsafePtr>(addr(of: d))),
                                 block: this.hold.raw());
    }

    // A 2D texture, one mip level, one sample.
    public unsafe fn Texture createTexture(uint32 width, uint32 height, TextureFormat format, uint64 usage) {
        WGPUTextureDescriptor d = WGPUTextureDescriptor.zero();
        d.usage = usage;
        d.dimension = WGPUTextureDimension::N2D;
        d.size.width = width;
        d.size.height = height;
        d.size.depthOrArrayLayers = 1;
        d.format = format.value();
        d.mipLevelCount = 1;
        d.sampleCount = 1;
        return Texture.fromDevice(raw: deviceCreateTexture(device: this.handle, descriptor: cast<UnsafePtr>(addr(of: d))),
                                  block: this.hold.raw());
    }

    public unsafe fn CommandEncoder createCommandEncoder() {
        return CommandEncoder.fromDevice(raw: deviceCreateCommandEncoder(device: this.handle, descriptor: null),
                                         block: this.hold.raw());
    }

    // Natively, finish what the device can and fire its callbacks; `wait` blocks until its queue is empty. On the web
    // the browser's event loop does this between frames, so it does nothing.
    public unsafe const fn void poll(bool wait) {
        int32 w = 0;
        if (wait) { w = 1; }
        pollDevice(device: this.handle, wait: w);
    }

    unsafe ~Device() {
        if (this.handle != null) { deviceRelease(device: this.handle); }
        if (this.adapter != null) { adapterRelease(adapter: this.adapter); }
    }
}

type resource Queue implements Copyable<This>(bare: give) {
    UnsafePtr handle;
    StateHold hold = StateHold.empty();   // its device's state, which its errors reach

    friend DeviceRequest::poll[fromDevice];

    // One made elsewhere; it takes over one reference, and holds no device state.
    public unsafe ctor adopt(UnsafePtr raw) { this.handle = raw; }
    unsafe ctor fromDevice(UnsafePtr raw, UnsafePtr block) {
        this.handle = raw;
        this.hold = StateHold.make(block: block);
    }
    public unsafe ctor copy(ref Queue source) {
        this.handle = source.handle;
        queueAddRef(queue: this.handle);
        this.hold = copy source.hold;
    }
    public unsafe const fn UnsafePtr raw() { return this.handle; }

    // Hand `commands` to the GPU; the command buffer is spent. Natively a command buffer whose finish reported an error
    // is not submitted, since wgpu-native would end the process (tests/facts, `abort-submit`): its error is in the
    // device's channel or a scope already, and a browser refuses the same submit after reporting it.
    public unsafe fn void submit(CommandBuffer commands) {
        if (commands.spoiled()) { return; }
        UnsafePtr one = commands.raw();
        queueSubmit(queue: this.handle, commandCount: 1, commands: cast<UnsafePtr>(addr(of: one)));
    }

    unsafe ~Queue() { if (this.handle != null) { queueRelease(queue: this.handle); } }
}

// ---- buffers ---------------------------------------------------------------------------------------------------------

type resource Buffer implements Copyable<This>(bare: give) {
    UnsafePtr handle;
    StateHold hold = StateHold.empty();   // its device's state, which its errors reach

    friend Device::createBuffer[fromDevice];

    // One made elsewhere; it takes over one reference, and holds no device state.
    public unsafe ctor adopt(UnsafePtr raw) { this.handle = raw; }
    unsafe ctor fromDevice(UnsafePtr raw, UnsafePtr block) {
        this.handle = raw;
        this.hold = StateHold.make(block: block);
    }
    public unsafe ctor copy(ref Buffer source) {
        this.handle = source.handle;
        bufferAddRef(buffer: this.handle);
        this.hold = copy source.hold;
    }
    public unsafe const fn UnsafePtr raw() { return this.handle; }
    public unsafe const fn uint64 size() { return bufferGetSize(buffer: this.handle); }

    // Map `size` bytes from `offset` for reading (a MapRead buffer); `poll()` the read until it is Ready.
    public unsafe fn BufferRead mapRead(uint64 offset, uint64 size) {
        return BufferRead.start(buffer: this.handle, offset: offset, size: size);
    }

    unsafe ~Buffer() { if (this.handle != null) { bufferRelease(buffer: this.handle); } }
}

type enum ReadStatus { Pending, Ready, Failed(GpuError error) }

// A buffer's bytes on their way to the CPU. Dropping it unmaps the buffer, or, while the map is still pending, leaves
// the seam to free it when its callback fires.
type resource BufferRead {
    UnsafePtr slot;
    uint64 length;

    friend Buffer::mapRead[start];

    unsafe ctor start(UnsafePtr buffer, uint64 offset, uint64 size) {
        this.length = size;
        this.slot = mapAsync(buffer: buffer, mode: WGPUMapMode::Read, offset: cast<usize>(offset), size: cast<usize>(size));
    }

    public unsafe const fn ReadStatus poll() {
        if (this.slot == null) { return ReadStatus::Failed(error: GpuError::Refused(words: "out of memory for the map")); }
        int32 s = mapPoll(map: this.slot);
        if (s == SEAM_PENDING) { return ReadStatus::Pending; }
        if (s == SEAM_FAILED) {
            InlineArray<uint8>#(512) buf = [0; 512];
            int32 n = mapMessage(map: this.slot, dst: addr(of: buf[0]), capacity: MESSAGE_BYTES);
            string words = textOf(buf: buf, length: n);
            return ReadStatus::Failed(error: GpuError::Refused(words: give words));
        }
        return ReadStatus::Ready;
    }

    // The mapped bytes, copied out; empty until Ready.
    public unsafe const fn DynamicArray<uint8> bytes() {
        DynamicArray<uint8> acc = DynamicArray.empty();
        if (this.slot == null) { return acc; }
        UnsafeConstPtr<uint8> p = mapBytes(map: this.slot);
        if (p == null) { return acc; }
        isize n = cast<isize>(this.length);
        acc.reserve(n: n);
        isize i = 0;
        while (i < n) { acc.add(item: p[i]); i = i + 1; }
        return acc;
    }

    unsafe ~BufferRead() { mapDrop(map: this.slot); }
}

// ---- textures --------------------------------------------------------------------------------------------------------

type resource Texture implements Copyable<This>(bare: give) {
    UnsafePtr handle;
    StateHold hold = StateHold.empty();   // its device's state, which its errors reach

    friend Device::createTexture[fromDevice];
    friend SurfaceTexture::texture[fromDevice];

    // One made elsewhere; it takes over one reference, and holds no device state.
    public unsafe ctor adopt(UnsafePtr raw) { this.handle = raw; }
    unsafe ctor fromDevice(UnsafePtr raw, UnsafePtr block) {
        this.handle = raw;
        this.hold = StateHold.make(block: block);
    }
    public unsafe ctor copy(ref Texture source) {
        this.handle = source.handle;
        textureAddRef(texture: this.handle);
        this.hold = copy source.hold;
    }
    public unsafe const fn UnsafePtr raw() { return this.handle; }

    // A view of the whole texture.
    public unsafe fn TextureView createView() {
        return TextureView.fromDevice(raw: textureCreateView(texture: this.handle, descriptor: null), block: this.hold.raw());
    }

    unsafe ~Texture() { if (this.handle != null) { textureRelease(texture: this.handle); } }
}

type resource TextureView implements Copyable<This>(bare: give) {
    UnsafePtr handle;
    StateHold hold = StateHold.empty();   // its device's state, which its errors reach

    friend Texture::createView[fromDevice];
    friend SurfaceTexture::view[fromDevice];

    // One made elsewhere; it takes over one reference, and holds no device state.
    public unsafe ctor adopt(UnsafePtr raw) { this.handle = raw; }
    unsafe ctor fromDevice(UnsafePtr raw, UnsafePtr block) {
        this.handle = raw;
        this.hold = StateHold.make(block: block);
    }
    public unsafe ctor copy(ref TextureView source) {
        this.handle = source.handle;
        textureViewAddRef(textureView: this.handle);
        this.hold = copy source.hold;
    }
    public unsafe const fn UnsafePtr raw() { return this.handle; }

    unsafe ~TextureView() { if (this.handle != null) { textureViewRelease(textureView: this.handle); } }
}

// ---- recording -------------------------------------------------------------------------------------------------------

type resource CommandEncoder implements Copyable<This>(bare: give) {
    UnsafePtr handle;
    StateHold hold = StateHold.empty();   // its device's state, which its errors reach

    friend Device::createCommandEncoder[fromDevice];

    // One made elsewhere; it takes over one reference, and holds no device state.
    public unsafe ctor adopt(UnsafePtr raw) { this.handle = raw; }
    unsafe ctor fromDevice(UnsafePtr raw, UnsafePtr block) {
        this.handle = raw;
        this.hold = StateHold.make(block: block);
    }
    public unsafe ctor copy(ref CommandEncoder source) {
        this.handle = source.handle;
        commandEncoderAddRef(commandEncoder: this.handle);
        this.hold = copy source.hold;
    }
    public unsafe const fn UnsafePtr raw() { return this.handle; }

    // A render pass into one color target, cleared to `clear` and stored. `end()` it before `finish()`.
    public unsafe fn RenderPass beginRenderPass(const ref TextureView target, Color clear) {
        WGPURenderPassColorAttachment att = WGPURenderPassColorAttachment.zero();
        att.view = target.raw();
        att.depthSlice = DEPTH_SLICE_UNDEFINED;
        att.loadOp = WGPULoadOp::Clear;
        att.storeOp = WGPUStoreOp::Store;
        att.clearValue.r = clear.r;
        att.clearValue.g = clear.g;
        att.clearValue.b = clear.b;
        att.clearValue.a = clear.a;
        WGPURenderPassDescriptor d = WGPURenderPassDescriptor.zero();
        d.colorAttachmentCount = 1;
        d.colorAttachments = cast<UnsafePtr>(addr(of: att));
        return RenderPass.fromDevice(raw: commandEncoderBeginRenderPass(commandEncoder: this.handle,
                                                                        descriptor: cast<UnsafePtr>(addr(of: d))),
                                     block: this.hold.raw());
    }

    // Copy a `width` × `height` region of `texture`'s first level into `buffer`, `bytesPerRow` apart (a multiple of 256).
    public unsafe fn void copyTextureToBuffer(const ref Texture texture, const ref Buffer buffer, uint32 width,
                                              uint32 height, uint32 bytesPerRow) {
        WGPUTexelCopyTextureInfo src = WGPUTexelCopyTextureInfo.zero();
        src.texture = texture.raw();
        src.aspect = WGPUTextureAspect::All;
        WGPUTexelCopyBufferInfo dst = WGPUTexelCopyBufferInfo.zero();
        dst.buffer = buffer.raw();
        dst.layout.bytesPerRow = bytesPerRow;
        dst.layout.rowsPerImage = height;
        WGPUExtent3D ext = WGPUExtent3D.zero();
        ext.width = width;
        ext.height = height;
        ext.depthOrArrayLayers = 1;
        commandEncoderCopyTextureToBuffer(commandEncoder: this.handle, source: cast<UnsafePtr>(addr(of: src)),
                                          destination: cast<UnsafePtr>(addr(of: dst)),
                                          copySize: cast<UnsafePtr>(addr(of: ext)));
    }

    // The recorded commands; the encoder is spent. An error the recording made is reported here, to the device's
    // channel or the innermost scope that catches it, and natively such a command buffer is then never submitted.
    public unsafe give fn CommandBuffer finish() {
        int32 failed = 0;
        UnsafePtr commands = encoderFinish(encoder: this.handle, state: this.hold.raw(), failed: addr(of: failed));
        return CommandBuffer.fromDevice(raw: commands, block: this.hold.raw(), spoiled: failed != 0);
    }

    unsafe ~CommandEncoder() { if (this.handle != null) { commandEncoderRelease(commandEncoder: this.handle); } }
}

type resource RenderPass implements Copyable<This>(bare: give) {
    UnsafePtr handle;
    StateHold hold = StateHold.empty();   // its device's state, which its errors reach

    friend CommandEncoder::beginRenderPass[fromDevice];

    // One made elsewhere; it takes over one reference, and holds no device state.
    public unsafe ctor adopt(UnsafePtr raw) { this.handle = raw; }
    unsafe ctor fromDevice(UnsafePtr raw, UnsafePtr block) {
        this.handle = raw;
        this.hold = StateHold.make(block: block);
    }
    public unsafe ctor copy(ref RenderPass source) {
        this.handle = source.handle;
        renderPassEncoderAddRef(renderPassEncoder: this.handle);
        this.hold = copy source.hold;
    }
    public unsafe const fn UnsafePtr raw() { return this.handle; }

    // The pass is over; it is spent.
    public unsafe give fn void end() { renderPassEncoderEnd(renderPassEncoder: this.handle); }

    unsafe ~RenderPass() { if (this.handle != null) { renderPassEncoderRelease(renderPassEncoder: this.handle); } }
}

type resource CommandBuffer implements Copyable<This>(bare: give) {
    UnsafePtr handle;
    StateHold hold = StateHold.empty();   // its device's state, which its errors reach
    bool marked = false;                  // natively, its finish reported an error: never submitted

    friend CommandEncoder::finish[fromDevice];
    friend Queue::submit[spoiled];

    // One made elsewhere; it takes over one reference, and holds no device state.
    public unsafe ctor adopt(UnsafePtr raw) { this.handle = raw; }
    unsafe ctor fromDevice(UnsafePtr raw, UnsafePtr block, bool spoiled) {
        this.handle = raw;
        this.hold = StateHold.make(block: block);
        this.marked = spoiled;
    }
    const fn bool spoiled() { return this.marked; }
    public unsafe ctor copy(ref CommandBuffer source) {
        this.handle = source.handle;
        commandBufferAddRef(commandBuffer: this.handle);
        this.hold = copy source.hold;
        this.marked = source.marked;
    }
    public unsafe const fn UnsafePtr raw() { return this.handle; }

    unsafe ~CommandBuffer() { if (this.handle != null) { commandBufferRelease(commandBuffer: this.handle); } }
}

// ---- presenting to a window ------------------------------------------------------------------------------------------

// Why an acquire gave no texture. Occluded: the window is hidden or minimised; natively the acquire slept 32 ms first,
// so a loop that skips the frame does not spin. Outdated or Lost: configure again (at the window's new size). Timeout:
// try the next frame. Failed: anything else webgpu.h reports. Closed: the window's `Window` was dropped, so the surface
// never reaches it again: drop the surface. NotConfigured: no configure has succeeded on the surface, a programming
// error: configure it first. Closed and NotConfigured are the package's own; webgpu.h has no such status. (The design's
// OutOfMemory is not here: neither leg's webgpu.h reports it any more.)
type enum SurfaceError implements Error {
    Occluded, Outdated, Lost, Timeout, Failed, Closed, NotConfigured;

    public const fn string message() {
        return match (this) {
            case Occluded: "the window is occluded";
            case Outdated: "the surface is out of date: configure it again";
            case Lost: "the surface was lost: configure it again";
            case Timeout: "no texture came in time";
            case Failed: "the surface failed";
            case Closed: "the window is closed: drop the surface";
            case NotConfigured: "the surface is not configured: configure it first";
        };
    }
}

// When a surface's frames reach the screen (webgpu.h's `WGPUPresentMode`). Fifo waits for the display's refresh, never
// tears, and every surface offers it; FifoRelaxed shows a late frame at once, and may tear; Immediate never waits, and
// may tear; Mailbox never tears and never waits, the newest frame winning. The web offers Fifo only.
type enum PresentMode {
    Fifo, FifoRelaxed, Immediate, Mailbox;

    public const fn string name() {
        return match (this) {
            case Fifo: "Fifo";
            case FifoRelaxed: "FifoRelaxed";
            case Immediate: "Immediate";
            case Mailbox: "Mailbox";
        };
    }
}

fn int32 presentValue(PresentMode m) {
    return match (m) {
        case Fifo: WGPUPresentMode::Fifo;
        case FifoRelaxed: WGPUPresentMode::FifoRelaxed;
        case Immediate: WGPUPresentMode::Immediate;
        case Mailbox: WGPUPresentMode::Mailbox;
    };
}

fn Optional<PresentMode> presentModeOf(int32 v) {
    if (v == WGPUPresentMode::Fifo) { return Optional::Some(value: PresentMode::Fifo); }
    if (v == WGPUPresentMode::FifoRelaxed) { return Optional::Some(value: PresentMode::FifoRelaxed); }
    if (v == WGPUPresentMode::Immediate) { return Optional::Some(value: PresentMode::Immediate); }
    if (v == WGPUPresentMode::Mailbox) { return Optional::Some(value: PresentMode::Mailbox); }
    return Optional::None;
}

// How a surface's alpha is composited (webgpu.h's `WGPUCompositeAlphaMode`). Its `Auto` is left out, since webgpu.h
// gives it two meanings ("an alias for the first element" of a surface's alpha modes, and "Inherit in native, Opaque in
// Wasm"); `preferred()` names the surface's first instead.
type enum AlphaMode {
    Opaque, Premultiplied, Unpremultiplied, Inherit;

    public const fn string name() {
        return match (this) {
            case Opaque: "Opaque";
            case Premultiplied: "Premultiplied";
            case Unpremultiplied: "Unpremultiplied";
            case Inherit: "Inherit";
        };
    }
}

fn int32 alphaValue(AlphaMode m) {
    return match (m) {
        case Opaque: WGPUCompositeAlphaMode::Opaque;
        case Premultiplied: WGPUCompositeAlphaMode::Premultiplied;
        case Unpremultiplied: WGPUCompositeAlphaMode::Unpremultiplied;
        case Inherit: WGPUCompositeAlphaMode::Inherit;
    };
}

fn Optional<AlphaMode> alphaModeOf(int32 v) {
    if (v == WGPUCompositeAlphaMode::Opaque) { return Optional::Some(value: AlphaMode::Opaque); }
    if (v == WGPUCompositeAlphaMode::Premultiplied) { return Optional::Some(value: AlphaMode::Premultiplied); }
    if (v == WGPUCompositeAlphaMode::Unpremultiplied) { return Optional::Some(value: AlphaMode::Unpremultiplied); }
    if (v == WGPUCompositeAlphaMode::Inherit) { return Optional::Some(value: AlphaMode::Inherit); }
    return Optional::None;
}

// Why a surface was not configured. The package checks a configuration before WebGPU sees it, because wgpu-native
// aborts the process on one it refuses (measured 2026-11-10, for each of these).
type enum ConfigureError implements Error {
    NoArea,                    // a width or height of 0, as a minimised window has: configure again when it has an area
    TooLarge(uint32 most),     // wider or taller than the device's maxTextureDimension2D, `most`, which DeviceOptions raise
    NotOffered(string words),  // a choice the surface does not offer, named
    Closed,                    // the window is closed, and nothing reaches it again: drop the surface
    NoWindow;                  // an adopted surface has no window to size it: its maker configures it

    public const fn string message() {
        return match (this) {
            case NoArea: "the window has no area: configure again when it has one";
            case TooLarge(most: m): "larger than the device allows: ${m} texels on a side at most";
            case NotOffered(words: w): copy w;
            case Closed: "the window is closed: drop the surface";
            case NoWindow: "an adopted surface has no window to take its size from: its maker configures it";
        };
    }
}

fn string joined(const ref string acc, const ref string next) {
    if (acc.isEmpty()) { return copy next; }
    return "${acc}, ${next}";
}

// TextureUsage flags by name.
fn string usageNames(uint64 usage) {
    string acc = "";
    if ((usage & TextureUsage::RenderAttachment) != 0) { acc = joined(acc: acc, next: "RenderAttachment"); }
    if ((usage & TextureUsage::TextureBinding) != 0) { acc = joined(acc: acc, next: "TextureBinding"); }
    if ((usage & TextureUsage::StorageBinding) != 0) { acc = joined(acc: acc, next: "StorageBinding"); }
    if ((usage & TextureUsage::CopySrc) != 0) { acc = joined(acc: acc, next: "CopySrc"); }
    if ((usage & TextureUsage::CopyDst) != 0) { acc = joined(acc: acc, next: "CopyDst"); }
    if (acc.isEmpty()) { return "none"; }
    return acc;
}

// How a surface is configured. Made by `SurfaceCapabilities.preferred()`, and a program may change a field;
// `Surface.configure` checks it against what the surface offers before WebGPU sees it.
type value SurfaceConfig {
    public TextureFormat format;       // the format of the surface's textures
    public TextureFormat viewFormat;   // the format frames are drawn through: `format`, or its sRGB or linear form
    public PresentMode present;
    public AlphaMode alpha;
    public uint64 usage;               // TextureUsage flags, OR'd together

    friend SurfaceCapabilities::preferred[make];

    ctor make(TextureFormat format, TextureFormat viewFormat, PresentMode present, AlphaMode alpha, uint64 usage) {
        this.format = format;
        this.viewFormat = viewFormat;
        this.present = present;
        this.alpha = alpha;
        this.usage = usage;
    }
}

// What a surface offers an adapter (webgpu.h's `WGPUSurfaceCapabilities`): its formats in its own order, which is its
// preference, its present modes and alpha modes, and the usages its textures may have. A format the package does not
// name (an implementation's own extension) is left out, never guessed. Each holds a format, Fifo, an alpha mode and
// RenderAttachment, as webgpu.h promises; an answer without one is refused.
type resource SurfaceCapabilities {
    DynamicArray<TextureFormat> formatList;
    DynamicArray<PresentMode> presentList;
    DynamicArray<AlphaMode> alphaList;
    uint64 usageBits;

    friend Surface::configure[refuses];

    // Capabilities from lists: what `Surface.capabilities` reads, and what a test hands in for a surface it cannot open
    // (the web's, natively). Safe to hand in anything, since `configure` checks against the surface's own answer.
    public ctor Result<SurfaceCapabilities, GpuError> make(DynamicArray<TextureFormat> formats,
                                                        DynamicArray<PresentMode> presentModes,
                                                        DynamicArray<AlphaMode> alphaModes, uint64 usages) {
        if (formats.length() == 0) { return Result::Err(error: GpuError::Refused(words: "the surface offers no format")); }
        bool fifo = false;
        isize i = 0;
        while (i < presentModes.length()) { if (presentModes[i] == PresentMode::Fifo) { fifo = true; } i = i + 1; }
        if (!fifo) {
            return Result::Err(error: GpuError::Refused(words: "the surface does not offer Fifo, which webgpu.h promises"));
        }
        if (alphaModes.length() == 0) { return Result::Err(error: GpuError::Refused(words: "the surface offers no alpha mode")); }
        if ((usages & TextureUsage::RenderAttachment) == 0) {
            return Result::Err(error: GpuError::Refused(words: "the surface does not offer RenderAttachment, which webgpu.h promises"));
        }
        return Result::Ok(value: SurfaceCapabilities.of(formats: give formats, presentModes: give presentModes,
                                                        alphaModes: give alphaModes, usages: usages));
    }
    ctor of(DynamicArray<TextureFormat> formats, DynamicArray<PresentMode> presentModes, DynamicArray<AlphaMode> alphaModes,
            uint64 usages) {
        this.formatList = give formats;
        this.presentList = give presentModes;
        this.alphaList = give alphaModes;
        this.usageBits = usages;
    }

    public const fn const ref DynamicArray<TextureFormat> formats() { return this.formatList; }
    public const fn const ref DynamicArray<PresentMode> presentModes() { return this.presentList; }
    public const fn const ref DynamicArray<AlphaMode> alphaModes() { return this.alphaList; }
    public const fn uint64 usages() { return this.usageBits; }

    // Where to start: the first format, drawn through its sRGB form when it has one (itself when it is one); Fifo; the
    // first alpha mode; RenderAttachment.
    public const fn SurfaceConfig preferred() {
        TextureFormat f = this.formatList[0];
        Optional<TextureFormat> s = f.srgb();
        TextureFormat view = match (s) { case Some(value: v): v; case None: f; };
        return SurfaceConfig.make(format: f, viewFormat: view, present: PresentMode::Fifo, alpha: this.alphaList[0],
                                  usage: TextureUsage::RenderAttachment);
    }

    // Why the surface would refuse `config`, or "" when it offers everything `config` asks for.
    const fn string refuses(const ref SurfaceConfig config) {
        string formatName = config.format.name();
        bool formatOffered = false;
        string formats = "";
        isize i = 0;
        while (i < this.formatList.length()) {
            if (this.formatList[i] == config.format) { formatOffered = true; }
            string n = this.formatList[i].name();
            formats = joined(acc: formats, next: n);
            i = i + 1;
        }
        if (!formatOffered) { return "the surface does not offer format ${formatName}; it offers ${formats}"; }
        if (config.viewFormat.linear() != config.format.linear()) {
            string viewName = config.viewFormat.name();
            return "view format ${viewName} is not ${formatName} or its sRGB or linear form: a view may change only sRGB-ness";
        }
        bool presentOffered = false;
        string presents = "";
        i = 0;
        while (i < this.presentList.length()) {
            if (this.presentList[i] == config.present) { presentOffered = true; }
            string n = this.presentList[i].name();
            presents = joined(acc: presents, next: n);
            i = i + 1;
        }
        if (!presentOffered) {
            string p = config.present.name();
            return "the surface does not offer present mode ${p}; it offers ${presents}";
        }
        bool alphaOffered = false;
        string alphas = "";
        i = 0;
        while (i < this.alphaList.length()) {
            if (this.alphaList[i] == config.alpha) { alphaOffered = true; }
            string n = this.alphaList[i].name();
            alphas = joined(acc: alphas, next: n);
            i = i + 1;
        }
        if (!alphaOffered) {
            string a = config.alpha.name();
            return "the surface does not offer alpha mode ${a}; it offers ${alphas}";
        }
        if (config.usage == 0) { return "no usage: a surface's textures need at least one"; }
        if ((config.usage & this.usageBits) != config.usage) {
            string asked = usageNames(usage: config.usage);
            string offered = usageNames(usage: this.usageBits);
            return "the surface does not offer usage ${asked}; it offers ${offered}";
        }
        return "";
    }
}

// The size a configure hands WebGPU. On the web, 0: emdawnwebgpu writes a non-zero size into the canvas's pixels, which
// are the window's to set (@kama/window's WIN-3, decision 6), and a canvas's texture is the canvas's size in any case
// (measured 2026-11-11, AGENTS.gpu.md item 10). Natively, the window's size.
@compileFor(ARCH_WASM32)
fn uint32 handedOver(uint32 pixels) { return 0; }
@compileFor(!ARCH_WASM32)
fn uint32 handedOver(uint32 pixels) { return pixels; }

// emdawnwebgpu (Dawn v20260423) never sets a surface's usages, so on the web the package answers what a WebGPU canvas
// accepts for every format it offers. Once Dawn answers for itself, its answer stands.
@compileFor(ARCH_WASM32)
fn uint64 answeredUsages(uint64 got) {
    if (got != 0) { return got; }
    return TextureUsage::RenderAttachment | TextureUsage::TextureBinding | TextureUsage::CopySrc | TextureUsage::CopyDst;
}
@compileFor(!ARCH_WASM32)
fn uint64 answeredUsages(uint64 got) { return got; }

// What `surface` offers `adapter`, read out of C and freed there at once.
unsafe fn Result<SurfaceCapabilities, GpuError> capabilitiesOf(UnsafePtr surface, UnsafePtr adapter) {
    if (adapter == null) { return Result::Err(error: GpuError::Refused(words: "no adapter to ask what the surface offers")); }
    WGPUSurfaceCapabilities raw = WGPUSurfaceCapabilities.zero();
    int32 status = surfaceGetCapabilities(surface: surface, adapter: adapter, capabilities: cast<UnsafePtr>(addr(of: raw)));
    if (status != WGPUStatus::Success) {
        return Result::Err(error: GpuError::Refused(words: "the adapter cannot present to this surface"));
    }
    DynamicArray<TextureFormat> formats = DynamicArray.empty();
    UnsafePtr<int32> fs = cast<UnsafePtr<int32>>(raw.formats);
    isize i = 0;
    while (i < cast<isize>(raw.formatCount)) {
        Optional<TextureFormat> f = TextureFormat::fromValue(value: fs[i]);
        match (f) { case Some(value: x): { formats.add(item: x); } case None: { } };
        i = i + 1;
    }
    DynamicArray<PresentMode> presents = DynamicArray.empty();
    UnsafePtr<int32> ps = cast<UnsafePtr<int32>>(raw.presentModes);
    i = 0;
    while (i < cast<isize>(raw.presentModeCount)) {
        Optional<PresentMode> p = presentModeOf(v: ps[i]);
        match (p) { case Some(value: x): { presents.add(item: x); } case None: { } };
        i = i + 1;
    }
    DynamicArray<AlphaMode> alphas = DynamicArray.empty();
    UnsafePtr<int32> als = cast<UnsafePtr<int32>>(raw.alphaModes);
    i = 0;
    while (i < cast<isize>(raw.alphaModeCount)) {
        Optional<AlphaMode> a = alphaModeOf(v: als[i]);
        match (a) { case Some(value: x): { alphas.add(item: x); } case None: { } };
        i = i + 1;
    }
    uint64 usages = answeredUsages(got: raw.usages);
    surfaceCapabilitiesFreeMembers(surfaceCapabilities: raw);
    return SurfaceCapabilities.make(formats: give formats, presentModes: give presents, alphaModes: give alphas, usages: usages);
}

// What every copy of a surface shares: the native surface, released with the last copy, the window it presents to, held
// so its system window outlives the surface, whether a configure has reached it, and the view format it was last
// configured to be drawn through, so a copy made before a configure draws as the configure asked.
type resource SurfaceState {
    UnsafePtr handle;
    // A configure has reached WebGPU. An adopted surface is taken as configured: its maker vouches for it, as for its
    // window, since webgpu.h cannot be asked.
    bool hasConfig = false;
    int32 view = 0;   // WebGPU's number for the view format; Undefined (0) before a configure, which is the texture's own
    StateHold hold = StateHold.empty();   // the state of the device it was last configured with, which its frames hold
    // The window, held (@kama/window's WIN-1); an adopted surface holds an adopted handle, which is always open.
    NativeWindow onWindow = NativeWindow.adopt(kind: NativeKind::None, display: null, window: null);
    bool adopted = false;   // made elsewhere: no window here to size it

    public unsafe ctor adopt(UnsafePtr raw) { this.handle = raw; this.hasConfig = true; this.adopted = true; }
    public unsafe ctor fromWindow(UnsafePtr raw, NativeWindow window) {
        this.handle = raw;
        this.onWindow = give window;
    }
    public unsafe const fn UnsafePtr raw() { return this.handle; }
    // False once the window's `Window` is dropped: nothing reaches the window after that.
    public unsafe const fn bool windowOpen() { return this.onWindow.isOpen(); }
    public const fn bool isAdopted() { return this.adopted; }
    // The window's size in pixels, as of its last `pump()` (@kama/window's WIN-20).
    public unsafe const fn Size windowSize() { return this.onWindow.framebufferSize(); }
    // Another hold on the window, for a frame or adapter options that hold the native surface too.
    public unsafe const fn NativeWindow heldWindow() { return copy this.onWindow; }
    public const fn bool isConfigured() { return this.hasConfig; }
    public const fn int32 viewFormat() { return this.view; }
    public unsafe const fn UnsafePtr deviceState() { return this.hold.raw(); }
    public unsafe fn void configured(int32 view, UnsafePtr block) {
        this.hasConfig = true;
        this.view = view;
        this.hold = StateHold.make(block: block);
    }

    unsafe ~SurfaceState() { if (this.handle != null) { surfaceRelease(surface: this.handle); } }
}

// A surface on a window, which WebGPU presents into. It holds the window, so the two drop in either order: once the
// window's `Window` is dropped the window is closed, and the surface refuses everything that would reach it (Closed).
// A copy shares the surface, its window and how it was configured.
type resource Surface implements Copyable<This>(bare: give) {
    Shared<SurfaceState> state;

    friend AdapterOptions::withSurface[heldWindow];

    public unsafe ctor Result<Surface, GpuError> make(const ref Instance instance, const ref Window window) {
        NativeWindow n = window.nativeHandle();
        int32 kind = match (n.kind()) {
            case None: 0;
            case Win32: 1;
            case X11: 2;
            case Wayland: 3;
            case Cocoa: 4;
            case Canvas: 5;
        };
        UnsafePtr h = createSurface(instance: instance.raw(), kind: kind, display: n.display(), window: n.window());
        if (h == null) {
            // On the web the seam asks the canvas first, so a NULL there is a canvas the browser gives no WebGPU
            // context: a browser without WebGPU, or a canvas holding another kind of context.
            string words = kind == 5 ? "the browser gives this canvas no WebGPU context" : "no surface for this window on this system";
            return Result::Err(error: GpuError::Refused(words: give words));
        }
        return Result::Ok(value: Surface.fromWindow(raw: h, window: give n));
    }
    unsafe ctor fromWindow(UnsafePtr raw, NativeWindow window) {
        Shared<SurfaceState> s = new SurfaceState.fromWindow(raw: raw, window: give window);
        this.state = give s;
    }
    // A surface made elsewhere: its maker keeps the window alive while this lives, and it is taken as configured, by its
    // maker or by a `configure` here.
    public unsafe ctor adopt(UnsafePtr raw) {
        Shared<SurfaceState> s = new SurfaceState.adopt(raw: raw);
        this.state = give s;
    }
    public unsafe ctor copy(ref Surface source) { this.state = copy source.state; }
    public unsafe const fn UnsafePtr raw() { return this.state.raw(); }
    unsafe const fn NativeWindow heldWindow() { return this.state.heldWindow(); }

    // What the surface offers `adapter`: its formats, present modes, alpha modes and usages. Refused once the window
    // is closed.
    public unsafe const fn Result<SurfaceCapabilities, GpuError> capabilities(const ref Adapter adapter) {
        if (!this.state.windowOpen()) { return Result::Err(error: GpuError::Refused(words: "the window is closed")); }
        return capabilitiesOf(surface: this.raw(), adapter: adapter.raw());
    }

    // Draw into it with `device`, as `config` says, at the window's size in pixels as of its last `pump()`: the window
    // is the one writer of its size (AGENTS.gpu.md item 10, decision 2), as a WebGPU canvas's `configure()` takes none.
    // Configure again when an acquire says Outdated or Lost, or the window is resized. Everything is checked against
    // what the surface offers the device's adapter before WebGPU sees it, and refused in a ConfigureError: NoArea while
    // the window has none (minimised), Closed once the window is closed, which the surface never reaches again, and
    // NoWindow for an adopted surface, which its maker configures.
    public unsafe fn Result<Unit, ConfigureError> configure(const ref Device device, const ref SurfaceConfig config) {
        if (this.state.isAdopted()) { return Result::Err(error: ConfigureError::NoWindow); }
        if (!this.state.windowOpen()) { return Result::Err(error: ConfigureError::Closed); }
        Size px = this.state.windowSize();
        if (px.width <= 0 || px.height <= 0) { return Result::Err(error: ConfigureError::NoArea); }
        uint32 width = cast<uint32>(px.width);
        uint32 height = cast<uint32>(px.height);
        Limits limits = device.limits();
        uint32 most = limits.maxTextureDimension2D;
        if (width > most || height > most) { return Result::Err(error: ConfigureError::TooLarge(most: most)); }
        Result<SurfaceCapabilities, GpuError> asked = capabilitiesOf(surface: this.raw(), adapter: device.adapterHandle());
        SurfaceCapabilities caps = match (give asked) {
            case Ok(value: c): give c;
            case Err(error: e): { string why = e.message(); return Result::Err(error: ConfigureError::NotOffered(words: give why)); }
        };
        string refusal = caps.refuses(config: config);
        if (!refusal.isEmpty()) { return Result::Err(error: ConfigureError::NotOffered(words: give refusal)); }
        WGPUSurfaceConfiguration c = WGPUSurfaceConfiguration.zero();
        c.device = device.raw();
        c.format = config.format.value();
        c.usage = config.usage;
        c.width = handedOver(pixels: width);
        c.height = handedOver(pixels: height);
        InlineArray<int32>#(1) views = [0; 1];
        views[0] = config.viewFormat.value();
        if (config.viewFormat != config.format) {
            c.viewFormatCount = 1;
            c.viewFormats = cast<UnsafePtr>(addr(of: views[0]));
        }
        c.alphaMode = alphaValue(m: config.alpha);
        c.presentMode = presentValue(m: config.present);
        surfaceConfigure(surface: this.raw(), config: cast<UnsafePtr>(addr(of: c)));
        this.state.configured(view: config.viewFormat.value(), block: device.stateBlock());
        return Result::Ok(value: Unit::Unit);
    }

    // The next texture to draw into, or why there is none. Two are answered without asking WebGPU: Closed once the
    // window is closed, since WebGPU would hand out frames for the hidden window that go nowhere, and NotConfigured
    // before a configure has succeeded, since wgpu-native ends the process on that acquire.
    public unsafe fn Result<SurfaceTexture, SurfaceError> acquire() {
        if (!this.state.windowOpen()) { return Result::Err(error: SurfaceError::Closed); }
        if (!this.state.isConfigured()) { return Result::Err(error: SurfaceError::NotConfigured); }
        UnsafePtr texture = null;
        int32 suboptimal = 0;
        UnsafePtr h = this.raw();
        int32 s = acquireSurface(surface: h, texture: addr(of: texture), suboptimal: addr(of: suboptimal));
        if (s == SURFACE_OK) {
            return Result::Ok(value: SurfaceTexture.make(texture: texture, surface: h, suboptimal: suboptimal != 0,
                                                         view: this.state.viewFormat(), block: this.state.deviceState(),
                                                         window: this.state.heldWindow()));
        }
        if (s == SURFACE_OCCLUDED) { return Result::Err(error: SurfaceError::Occluded); }
        if (s == SURFACE_OUTDATED) { return Result::Err(error: SurfaceError::Outdated); }
        if (s == SURFACE_LOST) { return Result::Err(error: SurfaceError::Lost); }
        if (s == SURFACE_TIMEOUT) { return Result::Err(error: SurfaceError::Timeout); }
        return Result::Err(error: SurfaceError::Failed);
    }
}

// One frame's texture. `present()` shows it and spends it; a frame dropped without presenting is skipped, and so is one
// whose window has closed since the acquire.
type resource SurfaceTexture {
    UnsafePtr image;     // the frame's texture, on which it holds the reference the acquire gave
    UnsafePtr surface;   // a reference held while the frame lives, for its present
    bool late;
    int32 viewAs;        // the view format the surface was configured with, or Undefined (0): the texture's own
    StateHold hold = StateHold.empty();   // the state of the device the surface was configured with
    NativeWindow onWindow;                // the surface's window, held while the frame holds the surface

    friend Surface::acquire[make];

    unsafe ctor make(UnsafePtr texture, UnsafePtr surface, bool suboptimal, int32 view, UnsafePtr block, NativeWindow window) {
        this.image = texture;
        this.surface = surface;
        this.late = suboptimal;
        this.viewAs = view;
        surfaceAddRef(surface: surface);
        this.hold = StateHold.make(block: block);
        this.onWindow = give window;
    }

    // The surface still works but no longer matches the window: configure it again soon.
    public const fn bool suboptimal() { return this.late; }

    // A view to render into, in the view format the surface was configured with: sRGB-encoding by default.
    public unsafe fn TextureView view() {
        return TextureView.fromDevice(raw: textureViewIn(texture: this.image, format: this.viewAs), block: this.hold.raw());
    }

    // The frame's texture itself, to copy from when the configured usage allows it.
    public unsafe fn Texture texture() {
        textureAddRef(texture: this.image);
        return Texture.fromDevice(raw: this.image, block: this.hold.raw());
    }

    // Show the frame; it is spent, and its texture released after the present. Once the window is closed it is dropped
    // instead, never presented: nothing reaches a closed window.
    public unsafe give fn void present() {
        if (this.onWindow.isOpen()) { presentSurface(surface: this.surface); }
    }

    unsafe ~SurfaceTexture() {
        if (this.image != null) { textureRelease(texture: this.image); }
        surfaceRelease(surface: this.surface);
    }
}
